{
  "workspaces": {
    ".": {
      "project": ["src/**/*.ts", "!src/templates/**"]
    }
  },
  "ignoreDependencies": ["@commitlint/cli", "jscpd", "prettier"],
  "ignoreFiles": [
    "src/test/example.behavioral.test.ts",
    "src/utils/plugin-worker.ts",
    "cucumber.js"
  ],
  "ignoreBinaries": [
    "stryker",
    "vitepress",
    "sonar-scanner",
    "license-checker",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "CC0-1.0",
    "0BSD",
    "Unlicense",
    "Python-2.0"
  ],
  "exclude": ["types", "nsTypes", "enumMembers"],
  "ignoreIssues": {
    "src/graph/history.ts": ["exports"],
    "src/compliance/loader.ts": ["exports"],
    "src/experimental/index.ts": ["exports"],
    "src/kit/index.ts": ["files", "exports"],
    "src/adapters/index.ts": ["files", "exports"]
  }
}
