{
  "workspaces": {
    ".": {
      "entry": [
        "src/cli.ts!",
        "src/types/plugin.ts!",
        "src/invariants/index.ts!",
        "src/compatibility/index.ts!",
        "src/utils/plugin-worker.ts!",
        "scripts/**/*.mjs"
      ],
      "project": ["src/**/*.ts!", "!src/templates/**!", "scripts/**/*.mjs"]
    }
  },
  "ignoreDependencies": ["@commitlint/cli", "jscpd", "minimatch"],
  "ignoreFiles": ["src/test/example.behavioral.test.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "gh",
    "flock",
    "cosign",
    "which",
    "java",
    "python3",
    "gofmt",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "CC0-1.0",
    "0BSD",
    "Unlicense",
    "Python-2.0"
  ]
}
