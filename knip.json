{
  "project": ["src/**/*.ts", "!src/templates/**"],
  "ignoreDependencies": ["prettier", "@commitlint/cli", "jscpd", "madge"],
  "ignoreFiles": ["src/test/example.behavioral.test.ts"],
  "ignoreBinaries": [
    "wait-on",
    "stryker",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "MPL-2.0",
    "CC0-1.0",
    "0BSD",
    "Unlicense",
    "BlueOak-1.0.0",
    "Python-2.0"
  ],
  "exclude": ["types", "nsTypes", "enumMembers"],
  "ignoreIssues": {
    "src/graph/history.ts": ["exports"],
    "src/compliance/loader.ts": ["exports"],
    "src/experimental/index.ts": ["exports"]
  }
}
