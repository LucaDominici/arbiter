{
  "workspaces": {
    ".": {
      "entry": ["src/adapters/index.ts!"],
      "project": ["src/**/*.ts", "!src/templates/**"]
    }
  },
  "ignoreDependencies": ["@commitlint/cli", "jscpd", "minimatch"],
  "ignoreFiles": ["src/test/example.behavioral.test.ts", "src/utils/plugin-worker.ts"],
  "ignoreBinaries": [
    "stryker",
    "which",
    "java",
    "license-checker",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "CC0-1.0",
    "0BSD",
    "Unlicense",
    "Python-2.0"
  ],
  "exclude": ["types", "nsTypes", "enumMembers"]
}
