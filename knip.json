{
  "workspaces": {
    ".": {
      "entry": ["src/utils/plugin-worker.ts!", "scripts/**/*.mjs"],
      "project": ["src/**/*.ts!", "!src/templates/**!", "scripts/**/*.mjs"]
    }
  },
  "ignoreDependencies": ["@commitlint/cli", "jscpd", "minimatch"],
  "ignoreFiles": ["src/test/example.behavioral.test.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "flock",
    "mkfifo",
    "actionlint",
    "go",
    "gofmt",
    "diff",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "CC0-1.0",
    "0BSD",
    "Unlicense",
    "Python-2.0"
  ]
}
