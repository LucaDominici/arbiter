node_modules
node_modules/
dist/
*.log
!.kit-removals.log
.env
.env.github
save-npm-token.sh
coverage/
!src/templates/coverage/
# #1100: docs/REFERENCE/coverage/ holds the generated dim-NN reference stubs —
# tracked docs, not test-coverage output. Directory-level negation is required
# (git cannot re-include a file whose parent dir stays excluded).
!docs/REFERENCE/coverage/
# #1483: __tests__/coverage/ holds coverage-boosting unit tests (tracked source),
# not the v8 coverage/ output dir — same directory-level negation.
!__tests__/coverage/

# Claude Code local settings (user-specific permissions)
.claude/settings.local.json
.claude/.task-*
.claude/.task/
.claude/plans/
.agents-dispatched

# Arbiter local runtime state (logs); manifest + evidence are committed
# Use .arbiter/** (not .arbiter/) so child negations work per git spec
.arbiter/**
!.arbiter/hooks-manifest.json
!.arbiter/self-hooks-manifest.json
# Verification bridge: run history ignored, pointer files committable
.arbiter/plan/runs/**
!.arbiter/plan/PLAN.json
!.arbiter/plan/REVIEW.json
# TDD evidence files are committed so L2 gate works in CI
!.arbiter/evidence/
!.arbiter/evidence/tdd/
!.arbiter/evidence/tdd/*.json
# Journey evidence is committed so the Stop guard's artifact proof is auditable
!.arbiter/evidence/journey/
!.arbiter/evidence/journey/*.json
# Tabletop evidence is committed so check-tabletop-evidence.mjs sees it in CI (#2429)
!.arbiter/evidence/tabletop/
!.arbiter/evidence/tabletop/*.md
# RTM verification envelopes are committed so check-feature-matrix.mjs adjudicates a Verified row
# in CI and on a fresh clone (#2480). Without this the envelope is local-only and the gate reports
# every Verified row as unevidenced — the rule would fail exactly where it matters most.
!.arbiter/evidence/rtm/
!.arbiter/evidence/rtm/*.json
# tech-debt.json files written by `arbiter task record-tech-debt` — whitelist so CI sees them
!.arbiter/evidence/*/
!.arbiter/evidence/*/tech-debt.json
# Self-dogfood workflow exemptions are committed so the gate sees them in CI
!.arbiter/workflow-exemptions.json
# ship-driver self-dogfood artifacts (file-precise: the engine's per-task
# .arbiter/ship/<id>/attempts.json runtime state must STAY ignored)
!.arbiter/ship/
!.arbiter/ship/supervisor.sh
!.arbiter/ship/TICK_PROMPT.md
# Wave audits + their evidence — version-controlled audit history
!.arbiter/wave*/
!.arbiter/wave*/**
# ac-fit per-criterion review verdicts (INV-138) — committed so the PR carries the FIT record
!.arbiter/evidence/ac-fit/
!.arbiter/evidence/ac-fit/*.json
# Rework telemetry ledger (acceptance-anchor P4) — committed dataset, merge=union
# (file-precise: only the ledger is re-included, stray files stay ignored per #1770)
!.arbiter/rework/
!.arbiter/rework/ledger.jsonl
# #1770 (T1): manager state (MILESTONES, DONE, chat-protocol), redteam evidence,
# and other internal-only artifacts stay untracked+ignored ahead of the repo going
# public. docs/design/ is tracked separately for durable design docs.

# Java build artifacts in fixtures
__tests__/**/.gradle/
__tests__/**/bin/

# Rust fixture build artifacts
__tests__/**/target/

# Fixture worktree pollution from test runs
__tests__/fixtures/**/.arbiter/work/
# Worktrees are self-contained checkouts; the parent repo must not lint/track them.
arbiter.worktrees/
.evidence/
report/

# Arbiter backup files created during update
*.arbiter-backup
# Timestamped generated-file backups (anti-recurrence)
*.bak.*

# npm pack output: ignore all packs (#1217 — tracked artifact removed)
*.tgz

# Stray target-project output regenerated into this TS repo root by `arbiter init/update`
# (#1088). Root-anchored so only the alien Java/Gradle artifacts are ignored, never nested
# source. Proper fix = run the self-dogfood flow in a temp dir; until then this keeps the
# working tree clean. Remove the on-disk files with `git clean -fX` after reviewing.
/config/
/gradle/
/spotbugs.gradle
/spotless.gradle
/spotbugs-baseline.json
/src/test/java/
/src/test/resources/
/suppressions/owasp-suppressions.xml
# dogfood-generated target artifacts (arbiter self-run) — see #1088
/suppressions/.trivyignore
/.env.example
/scripts/setup-hooks.sh

# Private maintainer docs (#2053). This was `docs/internal/` — a blanket rule over a
# directory that is 99% AUTHORED, TRACKED content (ADRs, METHOD, SYSTEM, PRODUCT,
# architecture: 137 tracked files). Everything under it predating the rule stayed tracked
# only because it was force-added at creation; every NEW file needed `git add -f` or it
# silently never entered git history. Narrowed to the two files that are genuinely private.
# Enforced both ways by scripts/check-private-paths-ignored.mjs — add a line here AND a
# MUST_IGNORE row there when a new maintainer-private doc is introduced.
docs/internal/coc-enforcement-runbook.md
docs/internal/KIT-GOLD-STANDARD.md
.coverage-tmp/

# Kit Gold Standard — gitignored build artifact and private source attachments
src/kit/derived.json
.arbiter/private/

# CI test artifact output directory (created by --outputFile=test-results/junit.xml)
test-results/

# VitePress build temp output; docs:build regenerates this before L2 dead-code gates.
website/.vitepress/.temp/

# Obsidian vault — per-user UI state (P7)
.obsidian/workspace*.json
.obsidian/attachments/
.obsidian/plugins/
.obsidian/themes/

# LLM-Wiki generated output (T7, #1770: generator stays, output no longer committed — public split)
wiki/

# Graphify AST cache (regenerable)
graphify-out/

# fablize goals discipline — local task-tracking state (transient, never committed)
.fablize/

# tokensave MCP server local code-graph cache (regenerable, machine-local)
.tokensave/

# #2326: self-surface hardness fixtures (written inside the repo so the hooks'
# repo-root scoping matches production; removed in a finally, never committed)
.arb-hardness-tmp*/
