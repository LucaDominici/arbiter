#!/usr/bin/env node
// Arbiter hook: validate SHA-pinned evidence before accepting done claims
// Hook type: UserPromptSubmit — fires before every user prompt
// Hard block (exit 2) — returns stderr to Claude as error context
// Checks .claude/.last-done-evidence.json integrity on completion claims
// Generated by arbiter for project: <%= projectName %>
import { readTaskState, getRepoRoot } from './lib.mjs';
import { readFileSync, existsSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';

const root = getRepoRoot();
const { phase } = readTaskState(root);

// Only guard when a completion claim is made (mirrors guard-task-completion pattern)
let promptText = '';
try {
  const raw = readFileSync(0, 'utf-8');
  promptText = JSON.parse(raw)?.prompt ?? '';
} catch {
  process.exit(0);
}

const COMPLETION_PATTERNS = /\b(task complete|task completed|all phases complete|pr merged|merged to main|wrapping up|ready to (merge|close))\b/i;
if (!COMPLETION_PATTERNS.test(promptText)) process.exit(0);

// Completion claimed — validate evidence integrity
const EVIDENCE_PATH = join(root, '.claude', '.last-done-evidence.json');

function fail(reason) {
  process.stderr.write(
    `━━━ DONE EVIDENCE GUARD ━━━\n` +
    `Completion claim blocked — evidence check failed:\n` +
    `  ${reason}\n\n` +
    `Run: node scripts/done-evidence.mjs\n` +
    `This captures the current gate state + SHA-256 of pinned files.\n` +
    `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n`,
  );
  process.exit(2);
}

if (!existsSync(EVIDENCE_PATH)) {
  fail('evidence file missing — .claude/.last-done-evidence.json not found');
}

let evidence;
try {
  evidence = JSON.parse(readFileSync(EVIDENCE_PATH, 'utf-8'));
} catch {
  fail('evidence file is not valid JSON');
}

if (evidence.all_green !== true) {
  fail(`all_green is ${JSON.stringify(evidence.all_green)} — gate must be green at capture time`);
}

const pinnedFiles = Array.isArray(evidence.pinned_files) ? evidence.pinned_files : [];

for (const entry of pinnedFiles) {
  const absPath = join(root, entry.path);
  if (!existsSync(absPath)) {
    fail(`pinned file not found on disk: ${entry.path}`);
  }
  const currentSha = createHash('sha256').update(readFileSync(absPath)).digest('hex');
  if (currentSha !== entry.sha256) {
    fail(`SHA mismatch — drift detected in ${entry.path} (modified since evidence captured)`);
  }
}

// All checks passed — allow completion claim through
process.exit(0);
