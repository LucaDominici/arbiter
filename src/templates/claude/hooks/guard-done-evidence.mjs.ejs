#!/usr/bin/env node
// Arbiter hook: validate SHA-pinned evidence before accepting done claims
// Hook type: UserPromptSubmit — fires before every user prompt
// Hard block (exit 2) — returns stderr to Claude as error context
// Checks the current task v2 done receipt on completion claims
// Generated by arbiter for project: <%= projectName %>
import { readTaskState, getRepoRoot } from './lib.mjs';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const root = getRepoRoot();

// --- Flag gate (#1872): inert unless the project opts in ---------------------
// This hook is materialized for dogfood regardless of the flag, but stays
// no-op (exit 0) until the owner flips features.evidenceHarness: true in
// arbiter.json. The flag is the owner-flippable one-line activation switch;
// the artifacts (hook + script + wiring) travel with it so the flip alone
// turns enforcement on. Env ARBITER_EVIDENCE_HARNESS overrides for testing/CI:
//   '1'/'true' → on, '0'/'false' → off, unset → read arbiter.json.
// An absent config leaves the optional harness inert; malformed config blocks.
function evidenceHarnessEnabled(repoRoot) {
  const env = process.env.ARBITER_EVIDENCE_HARNESS;
  if (env === '1' || env === 'true') return true;
  if (env === '0' || env === 'false') return false;
  try {
    const cfg = JSON.parse(readFileSync(join(repoRoot, 'arbiter.json'), 'utf-8'))
    if (!cfg || typeof cfg !== 'object' || Array.isArray(cfg)) fail('harness config must be an object')
    return cfg.features?.evidenceHarness === true
  } catch (err) {
    if (err.code === 'ENOENT') return false
    fail(`harness config unreadable or malformed: ${err.message}`)
  }
}
if (!evidenceHarnessEnabled(root)) process.exit(0);

const { phase, taskId } = readTaskState(root);

// Only guard during verification phase (evidence required before claiming done)
if (phase !== 'verification') process.exit(0);

// Only guard when a completion claim is made (mirrors guard-task-completion pattern)
let promptText = '';
let raw;
try {
  raw = readFileSync(0, 'utf-8');
} catch (e) {
  process.stderr.write(`[guard-done-evidence] WARN: could not read stdin (${e.code ?? e.message}) — blocking as fail-safe\n`);
  process.exit(2);
}
try {
  promptText = JSON.parse(raw)?.prompt ?? '';
  // FAIL-OPEN-INTENT: non-JSON stdin is not a hook error — treat as empty prompt (exit 0).
} catch {
  process.exit(0);
}

const COMPLETION_PATTERNS = /\b(task complete|task completed|all phases complete|pr merged|merged to main|wrapping up|ready to (merge|close))\b/i;
if (!COMPLETION_PATTERNS.test(promptText)) process.exit(0);

// Completion claimed — validate evidence integrity

function fail(reason) {
  process.stderr.write(
    `━━━ DONE EVIDENCE GUARD ━━━\n` +
    `Completion claim blocked — evidence check failed:\n` +
    `  ${reason}\n\n` +
    `Run: node scripts/done-evidence.mjs\n` +
    `This captures the current gate state + SHA-256 of pinned files.\n` +
    `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n`,
  );
  process.exit(2);
}

let verifyDoneEvidenceReceipt
try {
  ;({ verifyDoneEvidenceReceipt } = await import('../../scripts/lib/gate-evidence.mjs'))
  if (typeof verifyDoneEvidenceReceipt !== 'function') fail('done receipt verifier unavailable')
} catch (err) {
  fail(`done receipt verifier unavailable: ${err.message}`)
}
const receiptVerdict = verifyDoneEvidenceReceipt({ root, taskId, archetype: '<%= archetype %>' });
if (!receiptVerdict.ok) fail(receiptVerdict.reason);

// All checks passed — allow completion claim through.
process.exit(0)
