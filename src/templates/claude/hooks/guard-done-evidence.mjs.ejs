#!/usr/bin/env node
// Arbiter hook: validate SHA-pinned evidence before accepting done claims
// Hook type: UserPromptSubmit — fires before every user prompt
// Hard block (exit 2) — returns stderr to Claude as error context
// Checks .claude/.last-done-evidence.json integrity on completion claims
// Generated by arbiter for project: <%= projectName %>
import { readTaskState, getRepoRoot } from './lib.mjs';
import { readFileSync, existsSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';

const root = getRepoRoot();
const { phase } = readTaskState(root);

// Only guard during verification phase (evidence required before claiming done)
if (phase !== 'verification') process.exit(0);

// Only guard when a completion claim is made (mirrors guard-task-completion pattern)
let promptText = '';
let raw;
try {
  raw = readFileSync(0, 'utf-8');
} catch (e) {
  process.stderr.write(`[guard-done-evidence] WARN: could not read stdin (${e.code ?? e.message}) — blocking as fail-safe\n`);
  process.exit(2);
}
try {
  promptText = JSON.parse(raw)?.prompt ?? '';
} catch {
  // Non-JSON stdin is not a hook error — treat as empty prompt
  process.exit(0);
}

const COMPLETION_PATTERNS = /\b(task complete|task completed|all phases complete|pr merged|merged to main|wrapping up|ready to (merge|close))\b/i;
if (!COMPLETION_PATTERNS.test(promptText)) process.exit(0);

// Completion claimed — validate evidence integrity
const EVIDENCE_PATH = join(root, '.claude', '.last-done-evidence.json');

function fail(reason) {
  process.stderr.write(
    `━━━ DONE EVIDENCE GUARD ━━━\n` +
    `Completion claim blocked — evidence check failed:\n` +
    `  ${reason}\n\n` +
    `Run: node scripts/done-evidence.mjs\n` +
    `This captures the current gate state + SHA-256 of pinned files.\n` +
    `━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n`,
  );
  process.exit(2);
}

if (!existsSync(EVIDENCE_PATH)) {
  fail('evidence file missing — .claude/.last-done-evidence.json not found');
}

let evidence;
let rawEvidence;
try {
  rawEvidence = readFileSync(EVIDENCE_PATH, 'utf-8');
} catch (e) {
  fail(`could not read evidence file — ${e.code ?? e.message}`);
}
try {
  evidence = JSON.parse(rawEvidence);
} catch (e) {
  fail(`evidence file is not valid JSON — ${e.message}`);
}

if (evidence.all_green !== true) {
  fail(`all_green is ${JSON.stringify(evidence.all_green)} — gate must be green at capture time`);
}

const pinnedFiles = Array.isArray(evidence.pinned_files) ? evidence.pinned_files : [];

if (pinnedFiles.length === 0) {
  fail('pinned_files is empty — no files were pinned at evidence capture time');
}

for (const entry of pinnedFiles) {
  if (!entry || typeof entry.path !== 'string' || typeof entry.sha256 !== 'string') {
    fail(`malformed entry in pinned_files: ${JSON.stringify(entry)}`);
  }
  const absPath = join(root, entry.path);
  if (!existsSync(absPath)) {
    fail(`pinned file not found on disk: ${entry.path}`);
  }
  let currentSha;
  try {
    currentSha = createHash('sha256').update(readFileSync(absPath)).digest('hex');
  } catch (e) {
    fail(`could not read pinned file ${entry.path} — ${e.code ?? e.message}`);
  }
  if (currentSha !== entry.sha256) {
    fail(`SHA mismatch — drift detected in ${entry.path} (modified since evidence captured)`);
  }
}


// --- Reality-contact check (archetype-aware, #1368) -----------------------------------------------
// For archetypes that produce a running artifact, a done claim must include
// proof that the live artifact was exercised -- not just that unit tests passed.
// The archetype is baked in at generation time (EJS).
<% if (archetype === 'backend-web-db') { %>
// backend-web-db: require live API e2e evidence
const rc = evidence.reality_contact;
if (!rc || typeof rc !== 'object') {
  fail(
    'reality-contact evidence missing \u2014 backend-web-db archetype requires live API e2e proof.\n' +
    '  Add to .claude/.last-done-evidence.json:\n' +
    '    "reality_contact": { "archetype": "backend-web-db", "required": true,\n' +
    '      "suite": "live-api-e2e", "recorded_at": "<ISO>", "passed": true }',
  );
}
if (rc.suite !== 'live-api-e2e') {
  fail(
    `reality-contact suite must be "live-api-e2e" for backend-web-db \u2014 got "${rc.suite}".\n` +
    '  Run your Newman/httpx/REST e2e suite against the live binary and record the result.',
  );
}
if (rc.passed !== true) {
  fail(
    `reality-contact passed is ${JSON.stringify(rc.passed)} \u2014 live API e2e suite must have passed.\n` +
    '  Fix the failing e2e tests before claiming done.',
  );
}
<% } else if (archetype === 'frontend-spa') { %>
// frontend-spa: require render-smoke or visual-regression evidence
const rcFe = evidence.reality_contact;
const FE_SUITES = ['render-smoke', 'visual-regression'];
if (!rcFe || typeof rcFe !== 'object') {
  fail(
    'reality-contact evidence missing \u2014 frontend-spa archetype requires render/visual suite proof.\n' +
    '  Add to .claude/.last-done-evidence.json:\n' +
    '    "reality_contact": { "archetype": "frontend-spa", "required": true,\n' +
    '      "suite": "render-smoke", "recorded_at": "<ISO>", "passed": true }',
  );
}
if (!FE_SUITES.includes(rcFe.suite)) {
  fail(
    `reality-contact suite must be one of [${FE_SUITES.join(', ')}] for frontend-spa \u2014 got "${rcFe.suite}".\n` +
    '  Run your render-smoke or visual-regression suite and record the result.',
  );
}
if (rcFe.passed !== true) {
  fail(
    `reality-contact passed is ${JSON.stringify(rcFe.passed)} \u2014 render/visual suite must have passed.\n` +
    '  Fix the failing render/visual tests before claiming done.',
  );
}
<% } %>

// All checks passed — allow completion claim through
process.exit(0);
