#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// Arbiter hook: CLOSER mode enforcement (#A11) — mechanically-checkable subset of the 7 rules
// in `.claude/rules/95-closer-mode.md`. Fires on: PreToolUse → Bash. Only active while the task
// is in its `close` phase (post-implementation, pre-merge, entered via
// `arbiter task advance --to close`) — inert on every other phase.
// Exit 2: block — stderr is returned to Claude as error context.
// Fail-closed contract: phase detection is fail-OPEN (if the task context can't be read the
// guard stays inert, so it never wedges Bash outside a close), but once we know we ARE closing,
// an unexpected error in rule evaluation fails CLOSED (exit 2) rather than waving the command
// through — a safety guard that silently gives up is worse than useless.
// Generated by arbiter for project: <%= projectName %>
import { readTaskState, getRepoRoot, resolveToolInputCommand } from './lib.mjs';
import { spawnSync } from 'node:child_process';

const command = resolveToolInputCommand();
if (command.length === 0) process.exit(0);

// Phase detection — fail OPEN: an unreadable task context means "not demonstrably closing",
// so the guard stays inert rather than blocking every command in a repo it can't reason about.
let root;
let phase;
try {
  root = getRepoRoot();
  ({ phase } = readTaskState(root));
  // FAIL-OPEN-INTENT: an unreadable task context means "not demonstrably closing" — stay inert.
} catch {
  process.exit(0);
}
if (phase !== 'close') process.exit(0); // CLOSER mode is only active in the close phase

const block = (rule, reason) => {
  process.stderr.write(
    `[arbiter] CLOSER MODE: blocked \`${command}\`.\n` +
      `${rule}: ${reason}\n` +
      `See .claude/rules/95-closer-mode.md.\n`,
  );
  process.exit(2);
};

// Rule evaluation — fail CLOSED: while actively closing, any unexpected error blocks the
// command (exit 2) so a crashing guard can't silently permit a forbidden action.
try {
  // Rule 1 (single named target): no switching branches/targets while closing.
  if (/\bgit\s+(checkout|switch)\s+(-b|-c)\b/.test(command)) {
    block('Rule 1 (single named target)', 'no switching branches/targets while closing');
  }

  // Rule 2 (no discovery): opening a new issue mid-close is forbidden — findings go on the
  // PARKING list (`arbiter note`) instead of spawning tracked work.
  if (/\bgh\s+issue\s+create\b/.test(command)) {
    block(
      'Rule 2 (no discovery)',
      'opening a new issue mid-close is forbidden — append the finding to the PARKING list ' +
        '(`arbiter note`) instead',
    );
  }

  // Rule 2 (no gate-appeasement deletions): `git clean -f...` can sweep an untracked file that
  // exists to satisfy a gate (observed: an agent deleted a colleague's untracked deliverable to
  // make a format check pass — report the obstruction instead).
  if (/\bgit\s+clean\b.*-\w*f/.test(command)) {
    block(
      'Rule 2 (no gate-appeasement deletions)',
      '`git clean -f` can delete an untracked file that exists to satisfy a gate — report the ' +
        'obstruction instead of removing the evidence',
    );
  }

  // Rule 2 (cont'd): `rm` targeting a path git currently reports as untracked (`??`) — the same
  // anti-pattern, one file at a time. Tracked-file deletion (part of the diff) is unaffected.
  const rmMatch = command.match(/(?:^|[;&|]\s*)rm\s+(?:-\w+\s+)*(.+?)(?:[;&|]|$)/);
  if (rmMatch) {
    const targets = rmMatch[1].split(/\s+/).filter((t) => t.length > 0 && !t.startsWith('-'));
    for (const target of targets) {
      const status = spawnSync('git', ['status', '--porcelain', '--', target], {
        cwd: root,
        encoding: 'utf-8',
      });
      if (status.status === 0 && /^\?\?/.test(String(status.stdout).trim())) {
        block(
          'Rule 2 (no gate-appeasement deletions)',
          `"${target}" is untracked — deleting it to make a gate pass is forbidden`,
        );
      }
    }
  }
} catch (err) {
  process.stderr.write(
    `[arbiter] CLOSER MODE: guard error while evaluating \`${command}\` — blocking to fail ` +
      `closed: ${err instanceof Error ? err.message : String(err)}\n`,
  );
  process.exit(2);
}

process.exit(0);
