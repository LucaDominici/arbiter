{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-dangerous.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/enforce-read-only.mjs",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-edit-ssot-guard.mjs",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-edit-plan-anchor.mjs",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-commit-check.mjs",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-no-orphan-todo.mjs",
            "timeout": 5
          }<% if (enableSecurityScanning) { %>,
          {
            "type": "command",
            "command": "node .claude/hooks/check-no-pii.mjs",
            "timeout": 5
          }<% } %><% languageHooks.filter(h => h.name !== 'check-no-orphan-todo.mjs').forEach((hook, i) => { %>,
          {
            "type": "command",
            "command": "node .claude/hooks/<%= hook.name %>",
            "timeout": 5
          }<% }); %><% if (governanceLevel !== 'L1') { %>,
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-dispatch.mjs",
            "timeout": 15
          }<% } %>
        ]
      }
    ],
    "PostToolUseFailure": [<% if (governanceLevel !== 'L1') { %>
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/debug-state-on-failure.mjs",
            "timeout": 5
          }
        ]
      }
    <% } %>],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact.mjs",
            "timeout": 3
          }
        ]
      }
    ]<% if (governanceLevel !== 'L1') { %>,
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/skill-forced-eval.mjs",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-task-completion.mjs",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-done-evidence.mjs",
            "timeout": 5
          }
        ]
      }
    ]<% } %>
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(./scripts/*)"<% if (buildTool === 'npm') { %>,
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)"<% } %><% if (buildTool === 'cargo') { %>,
      "Bash(cargo *)"<% } %><% if (buildTool === 'gradle') { %>,
      "Bash(./gradlew *)",
      "Bash(gradle *)"<% } %><% if (buildTool === 'maven') { %>,
      "Bash(mvn *)"<% } %><% if (buildTool === 'go') { %>,
      "Bash(go *)",
      "Bash(golangci-lint *)"<% } %><% if (buildTool === 'pip') { %>,
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(uv *)"<% } %>,
      "Bash(gh *)",
      "Bash(bun run arbiter *)",
      "Bash(arbiter *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo:*)",
      "Bash(git push --force)"
    ]
  }
}
