{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs PreToolUse:Bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs PreToolUse:Edit|Write",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs PostToolUse:Bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs PostToolUse:Edit|Write",
            "timeout": 90
          }
        ]
      }<% if (governanceLevel !== 'L1') { %>,
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs PostToolUse:ExitPlanMode",
            "timeout": 3
          }
        ]
      }<% } %>
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs PostToolUseFailure:Bash",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs PreCompact",
            "timeout": 3
          }
        ]
      }
    ]<% if (governanceLevel !== 'L1') { %>,
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/hooks.mjs Stop",
            "timeout": 5
          }
        ]
      }
    ]<% } %>
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(./scripts/*)"<% if (buildTool === 'npm') { %>,
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)"<% } %><% if (buildTool === 'cargo') { %>,
      "Bash(cargo *)"<% } %><% if (buildTool === 'gradle') { %>,
      "Bash(./gradlew *)",
      "Bash(gradle *)"<% } %><% if (buildTool === 'maven') { %>,
      "Bash(mvn *)"<% } %><% if (buildTool === 'go') { %>,
      "Bash(go *)",
      "Bash(golangci-lint *)"<% } %><% if (buildTool === 'pip') { %>,
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(uv *)"<% } %>,
      "Bash(gh *)",<% if (buildTool === 'bun') { %>
      "Bash(bun run arbiter *)",<% } %>
      "Bash(arbiter *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo:*)",
      "Bash(git push --force)",
      "Bash(*ARBITER_GATE_BYPASS*)",
      "Bash(*ARBITER_PLAN_BYPASS*)",
      "Bash(*ARBITER_SKIP_PLAN_REVIEW*)",
      "Bash(*ARBITER_SKIP_TDD*)",
      "Bash(*ARBITER_SKIP_GATE_MARKER*)",
      "Bash(*ARBITER_SSOT_BYPASS*)",
      "Bash(*ARBITER_PREPUSH_BYPASS*)",
      "Bash(*ARBITER_PREPUSH_SKIP*)",
      "Bash(*ARBITER_NO_EVIDENCE*)",
      "Bash(*ARBITER_SKIP_DOCS*)",
      "Edit(.arbiter/evidence/**)",
      "Edit(.arbiter/gate-pass.json)",
      "Edit(.arbiter/status.json)"
    ]
  }
}
