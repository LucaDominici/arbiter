package <%= locals.basePackage || 'com.example' %>.bdd;

import static org.assertj.core.api.Assertions.assertThat;

import java.util.Optional;
import io.cucumber.java.en.Given;
import io.cucumber.java.en.Then;
import io.cucumber.java.en.When;

/**
 * Step definitions for example.feature — glue code for ExampleBddIT's Cucumber suite. Without
 * these, the scenarios resolve as UNDEFINED and Cucumber-JVM fails the run (strict-by-default), so
 * this file is load-bearing for the generated project's default `test` task, not just
 * documentation.
 */
public class ExampleSteps {

    private static final String EMPTY = "";
    private static final String INVALID_INPUT = "invalid";
    private static final String INVALID_INPUT_ERROR = "invalid input";
    private static final String SUCCESS = "success";
    private static final String VALID_INPUT = "valid";

    private String input = EMPTY;
    private String result = EMPTY;
    private Optional<String> error = Optional.empty();

    @Given("a valid input")
    public void aValidInput() {
        input = VALID_INPUT;
        error = Optional.empty();
    }

    @Given("an invalid input")
    public void anInvalidInput() {
        input = INVALID_INPUT;
        error = Optional.empty();
    }

    @When("the operation is executed")
    public void theOperationIsExecuted() {
        if (VALID_INPUT.equals(input)) {
            result = SUCCESS;
            error = Optional.empty();
        } else {
            result = EMPTY;
            error = Optional.of(INVALID_INPUT_ERROR);
        }
    }

    @Then("the result is successful")
    public void theResultIsSuccessful() {
        assertThat(result).isEqualTo(SUCCESS);
        assertThat(error).isEmpty();
    }

    @Then("an error is returned")
    public void anErrorIsReturned() {
        assertThat(error).contains(INVALID_INPUT_ERROR);
    }
}
