# NOTE: directory is named `setup-node-pnpm` for historical reasons; it sets up
# Node + npm (not pnpm). The name is retained to avoid orphaning the dir in
# already-generated repos on their next `arbiter update` (#1131).
name: Setup Node.js + npm ci
description: >-
  Sets up Node.js from .nvmrc with the npm cache, then runs `npm ci`.
  Set the `install` input to 'false' for setup-only jobs.

inputs:
  node-version-file:
    description: Path to the node version file
    required: false
    default: .nvmrc
  install:
    description: Run `npm ci` after setup (set 'false' to skip install)
    required: false
    default: 'true'

runs:
  using: composite
  steps:
    - name: Setup Node.js
      uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
      with:
<% if (language === 'typescript') { -%>
        node-version-file: ${{ inputs.node-version-file }}
        cache: npm
<% } else { -%>
        node-version-file: ${{ inputs.node-version-file }}
        package-manager-cache: false
<% } -%>
<% if (language === 'typescript') { -%>
    - name: Install dependencies (npm ci)
      if: ${{ inputs.install == 'true' }}
      shell: bash
      run: npm ci
<% } -%>
