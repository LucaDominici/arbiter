<%
// #1723: serviceBucket/isService are injected by withServiceBucket
// (src/utils/render.ts), the single canonical archetype->bucket resolver — do not
// re-declare the archetype map here.
const _bucket = serviceBucket;
const _isService = isService;
const _bs = (typeof branchingStrategy !== 'undefined' ? branchingStrategy : 'github-flow');
%># Reference: docs/REFERENCE/workflow-pr-fast.md
name: PR Extended (T2)

permissions:
  contents: read

on:
  pull_request:
<% if (_bs === 'github-flow-with-develop') { %>
    branches: [main, develop]
<% } else { %>
    branches: [main]
<% } %>
    types: [opened, synchronize, reopened, ready_for_review, labeled]
    paths-ignore:
      - 'docs/**'
      - '*.md'
      - '.gitignore'
      - '.editorconfig'

concurrency:
  group: pr-extended-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

jobs:
<% if (language === 'java' && buildTool === 'maven') { %>  build-reactor:
    name: Build Maven Reactor (#1226)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_BUILD || '["ubuntu-latest"]') }}
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
      - uses: ./.github/actions/setup-java-maven
      - name: Pre-fetch plugins and dependencies (offline cache)
        run: mvn dependency:go-offline --batch-mode -q
      - name: Build reactor (skip tests)
        run: mvn --batch-mode -DskipTests install
      - name: Pack M2 repository
        run: |
          mkdir -p "${{ runner.temp }}/.m2-reactor"
          tar -cf "${{ runner.temp }}/.m2-reactor/m2-reactor.tar" -C "$HOME/.m2" repository
      - name: Upload reactor M2 artifact
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
        with:
          name: reactor-m2-${{ github.run_id }}
          path: ${{ runner.temp }}/.m2-reactor/m2-reactor.tar
          retention-days: 7
          overwrite: true

<% } %>  check-trigger:
    name: Check Extended Trigger
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    outputs:
      should_run: ${{ steps.decide.outputs.should_run }}
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
        with:
          fetch-depth: 0
      - name: Decide whether to run extended CI
        id: decide
        env:
          HAS_EXT_LABEL: ${{ contains(github.event.pull_request.labels.*.name, 'extended-ci') }}
          EVENT_ACTION: ${{ github.event.action }}
          PR_ADDITIONS: ${{ github.event.pull_request.additions }}
          PR_DELETIONS: ${{ github.event.pull_request.deletions }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.sha }}
          # Parameterized LOC threshold (org/repo var, default 100). The sensitive
          # path list is the version-controlled SSOT .github/extended-ci-paths.txt.
          LOC_THRESHOLD: ${{ vars.EXTENDED_CI_LOC_THRESHOLD || '100' }}
        run: |
          SHOULD_RUN=false
          THRESHOLD="${LOC_THRESHOLD:-100}"
          PATHS_FILE=".github/extended-ci-paths.txt"

          [[ "$HAS_EXT_LABEL" == "true" ]] && { echo "Trigger: extended-ci label"; SHOULD_RUN=true; }
          [[ "$EVENT_ACTION" == "ready_for_review" ]] && { echo "Trigger: ready_for_review"; SHOULD_RUN=true; }

          if [[ "$SHOULD_RUN" == "false" ]]; then
            MB=$(git merge-base "$BASE_SHA" "$HEAD_SHA" || echo "$BASE_SHA")
            CHANGED=$(git diff --name-only "$MB" "$HEAD_SHA")
            if [[ -f "$PATHS_FILE" ]]; then
              # SSOT: strip comments/blank lines, then match changed paths against
              # the remaining regexes. Empty list ⇒ no path trigger (LOC still applies).
              PATTERNS=$(grep -vE '^[[:space:]]*(#|$)' "$PATHS_FILE" || true)
              if [[ -n "$PATTERNS" ]] && printf '%s\n' "$CHANGED" | grep -qE -f <(printf '%s\n' "$PATTERNS"); then
                echo "Trigger: sensitive path matched (${PATHS_FILE})"; SHOULD_RUN=true
              fi
            fi
          fi

          if [[ "$SHOULD_RUN" == "false" ]]; then
            LOC=$(( ${PR_ADDITIONS:-0} + ${PR_DELETIONS:-0} ))
            (( LOC >= THRESHOLD )) && { echo "Trigger: PR size ${LOC} LOC >= ${THRESHOLD}"; SHOULD_RUN=true; } || true
          fi

          echo "should_run=${SHOULD_RUN}" >> "$GITHUB_OUTPUT"
          echo "Extended CI: should_run=${SHOULD_RUN}"

<% if (language === 'typescript') { %>  build-workspace:
    name: Build Workspace (cache)
    # E2 (#1500): build the node-workspace ONCE and share it run-id-keyed via the
    # build-cache composite, instead of behavioral + bake each re-running
    # `npm run build`. The composite's restore is non-blocking (cache miss ⇒ rebuild).
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger]
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
      - uses: ./.github/actions/setup-node-pnpm
      - name: Build + cache workspace (shared via run-id key)
        uses: ./.github/actions/build-cache
        with:
          op: save

<% } %><% if (language === 'typescript' || language === 'java') { %>  contract-tests:
    name: Contract Tests (T2)
    # #1875: moved off the always-run 01-pr-fast (T1) lane — this generic
    # `test:contract` suite (distinct from the contractType-specific
    # contract-extended Pact/GraphQL/gRPC checks below) fans out from
    # check-trigger like integration-tests/behavioral-tests, not from `gate`.
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger<% if (language === 'typescript') { %>, build-workspace<% } %>]
    strategy:
      max-parallel: 2
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: Restore cached workspace build (non-blocking)
        uses: ./.github/actions/build-cache
        with:
          op: restore
<% if (locals.ciPreTestBuild) { %>      - run: node scripts/build-kit.mjs
<% } %>      - run: npm run test:contract
<% } else if (language === 'java') { %>
      - uses: ./.github/actions/setup-java-maven
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@d9c87d481d55275bb5441eef3fe0e46805f9ef70  # v3
      - run: ./gradlew contractTest
<% } else { %>
      - name: Download reactor M2 artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
        with:
          name: reactor-m2-${{ github.run_id }}
          path: ${{ runner.temp }}/.m2-reactor
      - run: mvn test -Pcontract --offline
<% } %>
<% } %>

<% } %>  integration-tests:
    name: Integration Tests (T2)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger]
    strategy:
      max-parallel: 2
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - run: npm run test:integration
<% if (_isService) { %>
      - name: Toxiproxy resilience test
        run: npm run test:resilience
<% } %>
<% } else if (language === 'java') { %>
      - uses: ./.github/actions/setup-java-maven
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@d9c87d481d55275bb5441eef3fe0e46805f9ef70  # v3
      - run: ./gradlew integrationTest
<% if (_isService) { %>
      - name: Toxiproxy resilience test
        run: ./gradlew test -Ptests=resilience
<% } %>
<% } else { %>
      - name: Download reactor M2 artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
        with:
          name: reactor-m2-${{ github.run_id }}
          path: ${{ runner.temp }}/.m2-reactor
      - run: mvn test -Pintegration --offline
<% if (_isService) { %>
      - name: Toxiproxy resilience test
        run: mvn test -Presilience
<% } %>
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16  # v6.5.0
        with:
          go-version-file: 'go.mod'
      - run: go test -tags integration ./...
<% if (_isService) { %>
      - name: Toxiproxy resilience test
        run: go test -tags resilience ./...
<% } %>
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1  # v6.3.0
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install -e ".[dev]"
      - run: pytest -m integration
<% if (_isService) { %>
      - name: Toxiproxy resilience test
        run: pytest -m resilience
<% } %>
<% } else if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8  # stable
      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32  # v2
      - run: cargo test --test integration
<% if (_isService) { %>
      - name: Toxiproxy resilience test
        run: cargo test --test resilience
<% } %>
<% } %>

<% if (contractType && contractType !== 'none') { %>
  contract-extended:
    name: Contract Extended (T2)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger]
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
<% if (contractType === 'rest-owned' || contractType === 'rest-public' || contractType === 'message-queue') { %>
      - name: Pact can-i-deploy
        if: vars.PACT_BROKER_BASE_URL != ''
        run: npx pact-broker can-i-deploy --pacticipant <%= projectName %> --latest
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } else if (contractType === 'graphql') { %>
      - name: GraphQL schema diff
        run: npx graphql-inspector diff schema.graphql
<% } else if (contractType === 'grpc') { %>
      - name: Protobuf breaking check
        run: npx buf breaking --against .git#branch=main
<% } %>
<% } else if (language === 'java') { %>
      - uses: ./.github/actions/setup-java-maven
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@d9c87d481d55275bb5441eef3fe0e46805f9ef70  # v3
<% } %>
<% if (contractType === 'rest-owned' || contractType === 'rest-public' || contractType === 'message-queue') { %>
      - name: Pact can-i-deploy
        if: vars.PACT_BROKER_BASE_URL != ''
        run: <%= buildTool === 'gradle' ? './gradlew pactPublish pactVerify' : 'mvn pact:publish pact:verify' %>
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } else if (contractType === 'graphql') { %>
      - name: GraphQL contract test
        run: <%= buildTool === 'gradle' ? './gradlew test --tests *.graphql.*' : 'mvn test -Dtest=*GraphQL*' %>
<% } else if (contractType === 'grpc') { %>
      - name: gRPC contract test
        run: <%= buildTool === 'gradle' ? './gradlew test --tests *.grpc.*' : 'mvn test -Dtest=*Grpc*' %>
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16  # v6.5.0
        with:
          go-version-file: 'go.mod'
      - name: Contract tests
        run: go test -tags contract -run Contract ./...
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1  # v6.3.0
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install -e ".[dev]"
      - name: Contract tests
        run: pytest tests/contract/
<% } else if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8  # stable
      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32  # v2
      - name: Contract tests
        run: cargo test --test contract
<% } %>

<% } %>
<% if (_isService) { %>
  container-scan:
    name: Container Scan (T2)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger]
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
        with:
          fetch-depth: 0
      - name: Check Dockerfile changed
        id: dockerfile-check
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.sha }}
        run: |
          MB=$(git merge-base "$BASE_SHA" "$HEAD_SHA" || echo "$BASE_SHA")
          if git diff --name-only "$MB" "$HEAD_SHA" | grep -qE '^Dockerfile'; then
            echo "changed=true" >> "$GITHUB_OUTPUT"
          else
            echo "changed=false" >> "$GITHUB_OUTPUT"
          fi
      - name: Build image for scan
        if: steps.dockerfile-check.outputs.changed == 'true'
        run: docker build -t scan-target:${{ github.sha }} .
      - name: Trivy container scan
        if: steps.dockerfile-check.outputs.changed == 'true'
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25  # v0.36.0
        with:
          image-ref: 'scan-target:${{ github.sha }}'
          severity: 'HIGH,CRITICAL'
          exit-code: '1'
          trivyignores: .trivyignore

  # E4 (#1502): DAST (ZAP baseline) and k6 load-smoke are deploy/nightly-cadence
  # tools — they need a running application and add minutes to every extended PR.
  # They moved OFF the PR path: DAST baseline now runs against the ephemeral env in
  # 04-deploy-test.yml (consolidated into 06-nightly's dast-full), and load testing
  # runs at deploy-test (post-deploy-smoke) + nightly cadence. The PR path keeps only
  # the conditional container-scan + license-scan gates.

<% } %>
  license-scan:
    name: License Scan (T2)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger]
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: License check
        run: npx license-checker --production --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;Python-2.0' --excludePackages 'buffers@0.1.1'
<%# #1803: kotlin shares this branch — the license-report Gradle/Maven plugin
    task is language-agnostic (it inspects the dependency graph, not source
    files), so it reports identically for a Kotlin-sourced build (confirmed
    during the #1724 cross-language-matrix audit). -%>
<% } else if (language === 'java' || language === 'kotlin') { %>
      - uses: ./.github/actions/setup-java-maven
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@d9c87d481d55275bb5441eef3fe0e46805f9ef70  # v3
      - name: License report
        run: ./gradlew generateLicenseReport
<% } else { %>
      - name: License report
        run: mvn license:third-party-report -Dlicense.excludedScopes=test
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16  # v6.5.0
        with:
          go-version-file: 'go.mod'
      - name: Install go-licenses
        run: go install github.com/google/go-licenses@latest
      - name: License check
        run: go-licenses check ./... --disallowed_types forbidden,restricted
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1  # v6.3.0
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install pip-licenses
      - name: License check
        run: pip-licenses --allow-only="MIT License;ISC License (ISC);Apache Software License;BSD License;Python Software Foundation License;The Unlicense (Unlicense)" --with-system --from=all
<% } else if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8  # stable
      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32  # v2
      - name: Install cargo-deny
        run: cargo install cargo-deny
      - name: License check
        run: cargo deny check licenses
<% } %>

  behavioral-tests:
    name: Behavioral Tests (T2)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger<% if (language === 'typescript') { %>, build-workspace<% } %>]
    strategy:
      max-parallel: 2
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: Restore cached workspace build (non-blocking)
        uses: ./.github/actions/build-cache
        with:
          op: restore
<% if (locals.ciPreTestBuild) { %>      - run: node scripts/build-kit.mjs
<% } %>      - run: npm run test:behavioral
<% } else if (language === 'java') { %>
      - uses: ./.github/actions/setup-java-maven
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@d9c87d481d55275bb5441eef3fe0e46805f9ef70  # v3
      - run: ./gradlew behavioralTest
<% } else { %>
      - run: mvn test -Pbehavioral
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16  # v6.5.0
        with:
          go-version-file: 'go.mod'
      - run: go test -tags behavioral ./...
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1  # v6.3.0
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install -e ".[dev]"
      - run: pytest -m behavioral
<% } else if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8  # stable
      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32  # v2
      - run: cargo test --test behavioral
<% } %>

<% if (language === 'typescript') { %>
  bake-e2e-tests:
    name: Bake E2E (T2)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [check-trigger, build-workspace]
    if: needs.check-trigger.outputs.should_run == 'true'
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0  # v7.0.0
      - uses: ./.github/actions/setup-node-pnpm
      - name: Restore cached workspace build (non-blocking)
        uses: ./.github/actions/build-cache
        with:
          op: restore
<% if (locals.ciPreTestBuild) { %>      - run: node scripts/build-kit.mjs
<% } %>      - run: npm run test:e2e:bake
<% } %>

  extended-required:
    name: Extended Required
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
<%
  const _extNeeds = ['check-trigger', 'integration-tests', 'license-scan', 'behavioral-tests'];
  if (language === 'typescript' || language === 'java') _extNeeds.push('contract-tests');
  if (language === 'typescript') _extNeeds.push('build-workspace', 'bake-e2e-tests');
  if (contractType && contractType !== 'none') _extNeeds.push('contract-extended');
  if (_isService) _extNeeds.push('container-scan');
%>
    needs: [<%= _extNeeds.join(', ') %>]
    if: always()
    steps:
      - run: |
          if [[ "${{ needs.integration-tests.result }}" == "failure" ]]; then
            echo "integration-tests failed"; exit 1
          fi
          if [[ "${{ needs.license-scan.result }}" == "failure" ]]; then
            echo "license-scan failed"; exit 1
          fi
          if [[ "${{ needs.behavioral-tests.result }}" == "failure" ]]; then
            echo "behavioral-tests failed"; exit 1
          fi
<% if (language === 'typescript' || language === 'java') { %>
          if [[ "${{ needs.contract-tests.result }}" == "failure" ]]; then
            echo "contract-tests failed"; exit 1
          fi
<% } %><% if (language === 'typescript') { %>
          if [[ "${{ needs.build-workspace.result }}" == "failure" ]]; then
            echo "build-workspace failed"; exit 1
          fi
          if [[ "${{ needs.bake-e2e-tests.result }}" == "failure" ]]; then
            echo "bake-e2e-tests failed"; exit 1
          fi
<% } %>
<% if (contractType && contractType !== 'none') { %>
          if [[ "${{ needs.contract-extended.result }}" == "failure" ]]; then
            echo "contract-extended failed"; exit 1
          fi
<% } %>
<% if (_isService) { %>
          if [[ "${{ needs.container-scan.result }}" == "failure" ]]; then
            echo "container-scan failed"; exit 1
          fi
<% } %>
          echo "Extended CI passed or skipped"
