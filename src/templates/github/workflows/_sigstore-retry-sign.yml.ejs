name: Sigstore retry sign (reusable)

# Reusable retry wrapper for cosign keyless signing.
# Sigstore's Fulcio/Rekor endpoints are occasionally flaky under load;
# this wrapper retries up to 3 times with exponential back-off before failing.
# workflow_dispatch mode: OCI image re-sign for post-outage recovery (H3-S1).
#
# Generated by arbiter (#885). CANON-18 compliant.
# INV-76: all third-party action refs are SHA-pinned.

on:
  workflow_call:
    inputs:
      artifact-path:
        description: Local path to the artifact file to sign
        required: true
        type: string
      max-attempts:
        description: Maximum signing attempts (default 3)
        required: false
        type: number
        default: 3
  workflow_dispatch:
    inputs:
      image_ref:
        description: "OCI image reference to re-sign (e.g. ghcr.io/org/app@sha256:...)"
        required: true
        type: string
      justification:
        description: "Reason for manual re-sign (audit trail — required)"
        required: true
        type: string

jobs:
  sign-with-retry:
    name: Sign artifact (cosign keyless, retry)
    if: github.event_name == 'workflow_call'
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
        with:
          name: ${{ inputs.artifact-path }}

      - name: Install cosign
        uses: sigstore/cosign-installer@d7d6bc7722e7ddfa5e8ede2a605eb4c14fa96b50  # v3.8.1

      - name: Sign artifact (keyless OIDC, max-attempts=${{ inputs.max-attempts }})
        shell: bash
        run: |
          ARTIFACT="${{ inputs.artifact-path }}"
          MAX="${{ inputs.max-attempts }}"
          attempt=0
          delay=10
          until cosign sign-blob --yes "$ARTIFACT" --bundle "${ARTIFACT}.bundle"; do
            attempt=$((attempt + 1))
            if [ "$attempt" -ge "$MAX" ]; then
              echo "::error::cosign sign-blob failed after $MAX attempts"
              exit 1
            fi
            echo "::warning::cosign sign-blob attempt $attempt failed; retrying in ${delay}s"
            sleep "$delay"
            delay=$((delay * 2))
          done
          echo "Signed: ${ARTIFACT}.bundle"

      - name: Upload signature bundle
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
        with:
          name: ${{ inputs.artifact-path }}-bundle
          path: ${{ inputs.artifact-path }}.bundle
          retention-days: 90

  resign-oci-image:
    name: Re-sign OCI image (manual dispatch, post-outage)
    if: github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
      packages: write
    steps:
      - name: Owner-only guard
        run: |
          if [[ "${{ github.actor }}" != "${{ github.repository_owner }}" ]]; then
            echo "::error::Only the repository owner may trigger manual OCI re-sign"
            exit 1
          fi

      - name: Install cosign
        uses: sigstore/cosign-installer@d7d6bc7722e7ddfa5e8ede2a605eb4c14fa96b50  # v3.8.1

      - name: Sigstore preflight check
        run: |
          STATUS=$(curl -sf https://status.sigstore.dev/api/v2/status.json \
            --max-time 10 | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('status',{}).get('indicator','unknown'))" 2>/dev/null || echo "unknown")
          if [[ "$STATUS" != "none" ]]; then
            echo "::warning::Sigstore status is '${STATUS}' — cosign sign may fail"
          fi
          if [[ "$STATUS" == "major" || "$STATUS" == "critical" ]]; then
            echo "::error::Sigstore is degraded (${STATUS}) — aborting re-sign"
            exit 1
          fi
          echo "sigstore-status=$STATUS"

      - name: Configure Docker credential store (macOS keychain bypass)
        if: runner.os == 'macOS'
        run: |
          mkdir -p "$HOME/.docker"
          echo '{"credsStore":""}' > "$HOME/.docker/config.json"

      - name: Log in to container registry
        uses: docker/login-action@74a5d142397b4f367a81961eba4e8cd7edddf772  # v3
        with:
          registry: ${{ vars.CONTAINER_REGISTRY || 'ghcr.io' }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: cosign sign OCI image (keyless OIDC)
        env:
          COSIGN_EXPERIMENTAL: "1"
        run: cosign sign --yes "${{ inputs.image_ref }}"

      - name: cosign verify OCI image
        run: |
          cosign verify \
            --certificate-identity-regexp "https://github.com/${{ github.repository }}/" \
            --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
            "${{ inputs.image_ref }}"

      - name: Audit log
        run: |
          {
            echo "## OCI Re-sign Audit Log"
            echo ""
            echo "| Field | Value |"
            echo "| --- | --- |"
            echo "| Image | \`${{ inputs.image_ref }}\` |"
            echo "| Actor | \`${{ github.actor }}\` |"
            echo "| Justification | ${{ inputs.justification }} |"
            echo "| Run | ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }} |"
            echo "| Timestamp | $(date -u +%Y-%m-%dT%H:%M:%SZ) |"
          } >> "$GITHUB_STEP_SUMMARY"
