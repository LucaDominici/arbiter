name: Sigstore retry sign (reusable)

# Reusable retry wrapper for cosign keyless signing.
# Sigstore's Fulcio/Rekor endpoints are occasionally flaky under load;
# this wrapper retries up to 3 times with exponential back-off before failing.
#
# Generated by arbiter (#885). CANON-18 compliant.
# INV-76: all third-party action refs are SHA-pinned.

on:
  workflow_call:
    inputs:
      artifact-path:
        description: Local path to the artifact file to sign
        required: true
        type: string
      max-attempts:
        description: Maximum signing attempts (default 3)
        required: false
        type: number
        default: 3

jobs:
  sign-with-retry:
    name: Sign artifact (cosign keyless, retry)
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
        with:
          name: ${{ inputs.artifact-path }}

      - name: Install cosign
        uses: sigstore/cosign-installer@d7d6bc7722e7ddfa5e8ede2a605eb4c14fa96b50  # v3.8.1

      - name: Sign artifact (keyless OIDC, max-attempts=${{ inputs.max-attempts }})
        shell: bash
        run: |
          ARTIFACT="${{ inputs.artifact-path }}"
          MAX="${{ inputs.max-attempts }}"
          attempt=0
          delay=10
          until cosign sign-blob --yes "$ARTIFACT" --bundle "${ARTIFACT}.bundle"; do
            attempt=$((attempt + 1))
            if [ "$attempt" -ge "$MAX" ]; then
              echo "::error::cosign sign-blob failed after $MAX attempts"
              exit 1
            fi
            echo "::warning::cosign sign-blob attempt $attempt failed; retrying in ${delay}s"
            sleep "$delay"
            delay=$((delay * 2))
          done
          echo "Signed: ${ARTIFACT}.bundle"

      - name: Upload signature bundle
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
        with:
          name: ${{ inputs.artifact-path }}-bundle
          path: ${{ inputs.artifact-path }}.bundle
          retention-days: 90
