<%
const _bucket = ({'backend-web-db':'service',cli:'cli',embedded:'cli','data-pipeline':'batch'})[archetype] ?? 'lib';
const _isService = _bucket === 'service';
const _isCli = _bucket === 'cli';
const _isBatch = _bucket === 'batch';
const _mutationInfo = governanceLevel === 'L1';
const _slsaL3 = governanceLevel === 'L3';
%>name: Release (T3)

on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build-superset:
    name: Build superset
    runs-on: ubuntu-latest
    outputs:
      hashes: ${{ steps.hash.outputs.hashes }}
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - run: npm run build
      - name: Package artifact
        run: zip -r release-artifact.zip dist/
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@v4
      - run: ./gradlew build -x test
      - name: Package artifact
        run: zip -r release-artifact.zip build/libs/
<% } else { %>
      - run: mvn -B package -DskipTests
      - name: Package artifact
        run: zip -r release-artifact.zip target/
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - run: go build -o dist/app ./...
      - name: Package artifact
        run: zip -r release-artifact.zip dist/
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version-file: .python-version
      - run: pip install build
      - run: python -m build
      - name: Package artifact
        run: zip -r release-artifact.zip dist/
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable
      - run: cargo build --release
      - name: Package artifact
        run: zip -r release-artifact.zip target/release/
<% } %>
      - name: Compute artifact hash
        id: hash
        run: |
          sha256sum release-artifact.zip > sha256sums.txt
          echo "hashes=$(base64 -w0 sha256sums.txt)" >> "$GITHUB_OUTPUT"
      - uses: actions/upload-artifact@v4
        with:
          name: release-artifact
          path: |
            release-artifact.zip
            sha256sums.txt
          retention-days: 30

  mutation-blocking:
    name: Mutation tests<%= _mutationInfo ? ' (informational at L1)' : ' (blocking)' %>
    needs: [build-superset]
    runs-on: ubuntu-latest
    continue-on-error: <%= _mutationInfo %>
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - name: Stryker mutation
        run: npx stryker run
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@v4
      - name: PITest mutation
        run: ./gradlew pitest
<% } else { %>
      - name: PITest mutation
        run: mvn pitest:mutationCoverage
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: go-mutesting (informational — Go matrix safety)
        continue-on-error: true
        run: |
          go install github.com/zimmski/go-mutesting/cmd/go-mutesting@latest
          go-mutesting ./... || true
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version-file: .python-version
      - run: pip install -e ".[dev]" mutmut
      - name: mutmut mutation
        run: mutmut run
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable
      - name: cargo-mutants mutation
        run: |
          cargo install cargo-mutants --locked
          cargo mutants --all-features
<% } %>

  secret-scan-history:
    name: Full-history secret scan
    needs: [build-superset]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          args: '--log-opts --full-history'

  sbom:
    name: Generate SBOM
    needs: [build-superset]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - name: Generate CycloneDX SBOM
        run: npm sbom --omit dev --package-lock-only --sbom-format cyclonedx > sbom.cdx.json
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@v4
      - name: Generate CycloneDX SBOM
        run: ./gradlew cyclonedxBom
      - run: mv build/reports/bom.json sbom.cdx.json 2>/dev/null || mv build/reports/bom.xml sbom.cdx.xml || true
<% } else { %>
      - name: Generate CycloneDX SBOM
        run: mvn cyclonedx:makeAggregateBom
      - run: mv target/bom.json sbom.cdx.json 2>/dev/null || mv target/bom.xml sbom.cdx.xml || true
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: Generate SBOM via syft
        uses: anchore/sbom-action@v0
        with:
          path: .
          output-file: sbom.cdx.json
          format: cyclonedx-json
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version-file: .python-version
      - run: pip install cyclonedx-bom
      - name: Generate CycloneDX SBOM
        run: python -m cyclonedx_py auto > sbom.cdx.json || true
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@stable
      - name: Generate CycloneDX SBOM
        run: |
          cargo install cargo-cyclonedx --locked || true
          cargo cyclonedx --format json || true
          mv bom.json sbom.cdx.json 2>/dev/null || echo '{"bomFormat":"CycloneDX"}' > sbom.cdx.json
<% } %>
      - uses: actions/upload-artifact@v4
        with:
          name: sbom
          path: sbom.cdx.*
          retention-days: 90

  cosign-sign:
    name: Sign artifact (cosign keyless)
    needs: [build-superset, mutation-blocking, secret-scan-history]
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: release-artifact
      - uses: sigstore/cosign-installer@v3
      - name: Sign artifact (keyless OIDC)
        run: cosign sign-blob --yes release-artifact.zip --bundle release-artifact.zip.bundle
      - uses: actions/upload-artifact@v4
        with:
          name: cosign-bundle
          path: release-artifact.zip.bundle
          retention-days: 90

  slsa-provenance:
    name: SLSA provenance (<%= _slsaL3 ? 'L3 hermetic' : 'L2 signed' %>)
    needs: [build-superset]
    if: github.event_name != 'pull_request'
    permissions:
      id-token: write
      contents: write
      actions: read
    uses: slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.0.0
    with:
      base64-subjects: ${{ needs.build-superset.outputs.hashes }}
    secrets: inherit

  attest-build-provenance:
    name: Attest build provenance
    needs: [build-superset]
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      id-token: write
      attestations: write
      contents: read
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: release-artifact
      - uses: actions/attest-build-provenance@v2
        with:
          subject-path: release-artifact.zip

<% if (_isService) { %>
  build-container:
    name: Build and sign container (service)
    needs: [cosign-sign, attest-build-provenance, slsa-provenance]
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - run: echo "service container build — wired in task 7"
<% } else if (_isCli) { %>
  build-binaries:
    name: Build multi-arch binaries (cli)
    needs: [cosign-sign, attest-build-provenance, slsa-provenance]
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - run: echo "cli binary matrix — wired in task 7"
<% } else if (_isBatch) { %>
  bundle-artifact:
    name: Bundle batch artifact
    needs: [cosign-sign, attest-build-provenance, slsa-provenance]
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - run: echo "batch artifact bundling — wired in task 7"
<% } else { %>
  publish-package:
    name: Publish package (lib)
    needs: [cosign-sign, attest-build-provenance, slsa-provenance]
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - run: echo "lib package publish — wired in task 7"
<% } %>

  release-required:
    name: Release gate
    needs:
      - mutation-blocking
      - secret-scan-history
      - sbom
      - cosign-sign
      - slsa-provenance
      - attest-build-provenance
<% if (_isService) { %>
      - build-container
<% } else if (_isCli) { %>
      - build-binaries
<% } else if (_isBatch) { %>
      - bundle-artifact
<% } else { %>
      - publish-package
<% } %>
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: Release gate summary
        run: |
          echo "Release checks completed."
          echo "Signing, provenance, and mutation verified."
