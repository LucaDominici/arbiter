# A1 (#1817): tier — weekly. Budget — unbounded (no dev is waiting on this run; the
# ceiling below is GitHub's hosted-runner limit, not a tier SLA). Deep/slow checks
# live here so they never inflate the nightly or PR-blocking budget (AGENTS.md
# INV-136 tier-assignment rule). A red tolerated more than 48h must be fixed,
# demoted, or deleted.
# A6 (#1817): scheduled-lane failures update ONE sticky issue (append run link +
# counter) instead of filing a new issue per failure; auto-closed on green.
name: Weekly

on:
  schedule:
    - cron: '0 3 * * 0'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

# Scheduled lane: never cancel a run in favor of the next scheduled tick.
concurrency:
  group: weekly
  cancel-in-progress: false

jobs:
  weekly-gate:
    name: Weekly Gate (L4)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 360
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
<% if (language === 'typescript') { -%>
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version-file: '.nvmrc'
          cache: 'npm'
      - run: npm ci
<% } else if (language === 'java') { -%>
      - uses: actions/setup-java@03ad4de0992f5dab5e18fcb136590ce7c4a0ac95 # v5.6.0
        with:
          distribution: temurin
          java-version: '21'
<% } else if (language === 'rust') { -%>
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32 # v2
<% } else if (language === 'go') { -%>
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: 'go.mod'
<% } else if (language === 'python') { -%>
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install -e ".[dev]"
<% } -%>
      - name: Run gate (L4)
        id: gate
        run: node scripts/check-all.mjs L4
      - name: Record sticky failure issue
        if: failure() && steps.gate.outcome == 'failure'
        env:
          GH_TOKEN: ${{ github.token }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: .github/scripts/sticky-failure-issue.sh record weekly
      - name: Close sticky failure issue (green)
        if: success()
        env:
          GH_TOKEN: ${{ github.token }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: .github/scripts/sticky-failure-issue.sh close weekly
