# A1 (#1817): tier — release-seal. Budget — on tag (runs once, at the moment that
# matters: before a version ships). Not scheduled, so A6's sticky-issue mechanism
# does not apply here — a release-seal red blocks THIS tag, it does not accumulate
# a streak (AGENTS.md INV-136 tier-assignment rule).
name: Release Seal

on:
  push:
    tags: ['v*']

permissions:
  contents: read

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

jobs:
  release-gate:
    name: Release Gate (L2)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
<% if (language === 'typescript') { -%>
      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version-file: '.nvmrc'
          cache: 'npm'
      - run: npm ci
<% } else if (language === 'java') { -%>
      - uses: actions/setup-java@0f481fcb613427c0f801b606911222b5b6f3083a # v5.5.0
        with:
          distribution: temurin
          java-version: '21'
<% } else if (language === 'rust') { -%>
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32 # v2
<% } else if (language === 'go') { -%>
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: 'go.mod'
<% } else if (language === 'python') { -%>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
          cache: 'pip'
      - run: pip install -e ".[dev]"
<% } -%>
      - name: Run gate (L2, release seal)
        run: node scripts/check-all.mjs L2
