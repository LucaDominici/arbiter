name: Issue State Automation

# Automated issue label transitions driven by PR lifecycle.
# Cycle: in-progress (manual) → in-review (auto) → closed (auto on merge to main)
#
# Requirements:
#   - PR body must contain "closes #N" / "fixes #N" / "resolves #N"
#     for the in-review and close transitions.
#
# Security: PR body is read via env: (never interpolated directly into
# run: blocks) to prevent template injection.

on:
  pull_request:
    types: [opened, ready_for_review, closed]
    branches: [main]

permissions:
  issues: write
  pull-requests: read

jobs:
  update-state:
    name: Update issue state
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}

    steps:
      - name: Extract linked issue number
        id: issue
        env:
          PR_BODY: ${{ github.event.pull_request.body }}
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b  # v7
        with:
          result-encoding: string
          script: |
            const body = process.env.PR_BODY || '';
            const m = body.match(/(?:closes?|fixes?|resolves?)\s+#(\d+)/i);
            if (m) {
              console.log(`Linked issue: #${m[1]}`);
              return m[1];
            }
            console.log('No linked issue found in PR body -- skipping');
            return '';

      - name: "→ In Review"
        if: |
          steps.issue.outputs.result != '' &&
          (github.event.action == 'opened' || github.event.action == 'ready_for_review')
        env:
          ISSUE_NUMBER: ${{ steps.issue.outputs.result }}
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b  # v7
        with:
          script: |
            const issueNumber = parseInt(process.env.ISSUE_NUMBER);
            await github.rest.issues.addLabels({
              ...context.repo,
              issue_number: issueNumber,
              labels: ['in-review']
            });
            try {
              await github.rest.issues.removeLabel({
                ...context.repo,
                issue_number: issueNumber,
                name: 'in-progress'
              });
            } catch { /* label might not be set */ }
            console.log(`Issue #${issueNumber} → in-review`);

      - name: "→ Done"
        if: |
          steps.issue.outputs.result != '' &&
          github.event.action == 'closed' &&
          github.event.pull_request.merged == true &&
          github.event.pull_request.base.ref == 'main'
        env:
          ISSUE_NUMBER: ${{ steps.issue.outputs.result }}
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b  # v7
        with:
          script: |
            const issueNumber = parseInt(process.env.ISSUE_NUMBER);
            await github.rest.issues.update({
              ...context.repo,
              issue_number: issueNumber,
              state: 'closed'
            });
            try {
              await github.rest.issues.removeLabel({
                ...context.repo,
                issue_number: issueNumber,
                name: 'in-review'
              });
            } catch { /* label might not be set */ }
            console.log(`Issue #${issueNumber} → closed`);
