name: _label-sync

on:
  push:
    branches: [main]
    paths:
      - .github/labels.yml

# Only the latest labels.yml on main matters — supersede older in-flight syncs.
concurrency:
  group: label-sync-${{ github.ref }}
  cancel-in-progress: true

permissions:
  issues: write

jobs:
  sync:
    name: Sync repository labels
    # Opt-out: a repo that manages its own labels manually (e.g. the framework
    # source repo with its own taxonomy) sets the DISABLE_LABEL_SYNC variable to
    # 'true' so labels.yml is NOT applied to that repo's live label set (#1131).
    if: ${{ vars.DISABLE_LABEL_SYNC != 'true' }}
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
      - name: Sync labels from .github/labels.yml
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          python3 - <<'PYEOF2'
          import subprocess, os, yaml
          with open('.github/labels.yml') as f:
              data = yaml.safe_load(f)
          for label in data.get('labels', []):
              name = str(label['name'])
              color = str(label.get('color', 'ededed'))
              desc = str(label.get('description', ''))
              result = subprocess.run(
                  ['gh', 'label', 'create', name,
                   '--color', color,
                   '--description', desc,
                   '--repo', os.environ['GH_REPO'],
                   '--force'],
                  check=False,
                  capture_output=True,
                  text=True)
              if result.returncode != 0:
                  import sys
                  sys.stderr.write(f'[label-sync] ERROR: gh label create "{name}" failed (exit {result.returncode}): {result.stderr.strip()}\n')
                  sys.exit(result.returncode)
          print('Label sync complete.')
          PYEOF2
