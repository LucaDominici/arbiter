<% const _collabMode = (typeof collaborationMode !== 'undefined' && collaborationMode) ? collaborationMode : undefined; const _humanApproval = _collabMode !== 'trunk-solo'; /* trunk-solo: the sole human is the PR author and cannot self-approve — standing owner approval satisfies INV-91 */ %>name: Label on approve (bot)

# Apply approved-by-human label when a human reviewer approves a PR.
# Idempotent: gh pr edit --add-label is a no-op if label already present.
# Generated by arbiter (INV-91, #884).

on:
  pull_request_review:
    types: [submitted]

permissions:
  contents: read

jobs:
<% if (_humanApproval) { %>
  apply-label:
    name: Apply approved-by-human label
    if: >-
      github.event.review.state == 'approved' &&
      github.event.review.user.login != github.event.pull_request.user.login &&
      github.event.review.user.type != 'Bot'
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    permissions:
      pull-requests: write
    steps:
      - name: Ensure approved-by-human label exists in repo
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          gh label create approved-by-human \
            --description "PR approved by a human reviewer" \
            --color "0e8a16" \
            --repo "$GH_REPO" \
            --force

      - name: Apply approved-by-human label (idempotent)
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          gh pr edit "$PR_NUMBER" \
            --add-label approved-by-human \
            --repo "$GH_REPO"
<% } else { %>
  standing-owner-approval:
    name: Standing owner approval (INV-91)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - run: |
          echo 'INV-91 amended: trunk-solo — standing owner approval (sole developer)'
<% } %>
