name: License Scan (T5)

on:
  schedule:
    - cron: '0 5 * * 1'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: license-scan
  # Audit run: a cancelled license/compliance scan silently loses its required result (a false-green).
  cancel-in-progress: false

jobs:
  license-scan:
    name: Dependency license compliance scan
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
<%# #1803: kotlin fell through this strict-equality java/multi check — no
    dedicated arm, job rendered checkout-only, silently producing no license
    report. Gradle/Maven license-report plugins operate on the build's
    dependency graph, not the source language, so kotlin shares this arm
    (same fix shape as the #1803 fuzz job). -%>
<% if (locals.language === 'java' || locals.language === 'kotlin' || locals.language === 'multi') { %>
      - uses: actions/setup-java@0f481fcb613427c0f801b606911222b5b6f3083a  # v5.5.0
        with:
          distribution: temurin
          java-version: '21'
<% if (locals.buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a  # v4
      - name: License report (Gradle)
        run: ./gradlew generateLicenseReport
<% } else { %>
      - name: License report (Maven)
        run: mvn license:aggregate-add-third-party
<% } %>
<% } %>
<% if (locals.language === 'typescript' || locals.language === 'multi') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: License check (license-checker)
        run: npx license-checker --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense'
<% } %>
