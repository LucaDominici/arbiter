      - name: Install cosign (keyless OIDC)
        uses: sigstore/cosign-installer@d7d6bc7722e7ddfa5e8ede2a605eb4c14fa96b50  # v3.8.1

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@e3dd6a429d7300a6a4c196c26e071d42e0343502  # v4
        with:
          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION || 'us-east-1' }}

      - name: ECR login (TEST + PROD registries)
        env:
          ECR_TEST_REGISTRY: ${{ vars.ECR_TEST_REGISTRY }}
          ECR_PROD_REGISTRY: ${{ vars.ECR_PROD_REGISTRY }}
        run: |
          if grep -qi 'PLACEHOLDER-' <<< "${ECR_TEST_REGISTRY:-PLACEHOLDER-unset}"; then
            echo "::error::ECR_TEST_REGISTRY contains PLACEHOLDER- — configure the variable before enabling deploy"
            exit 1
          fi
          if grep -qi 'PLACEHOLDER-' <<< "${ECR_PROD_REGISTRY:-PLACEHOLDER-unset}"; then
            echo "::error::ECR_PROD_REGISTRY contains PLACEHOLDER- — configure the variable before enabling deploy"
            exit 1
          fi
          # Login to both registries (may be in same or different accounts/regions)
          aws ecr get-login-password --region "${AWS_DEFAULT_REGION}" \
            | docker login --username AWS --password-stdin "${ECR_TEST_REGISTRY}"
          aws ecr get-login-password --region "${AWS_DEFAULT_REGION}" \
            | docker login --username AWS --password-stdin "${ECR_PROD_REGISTRY}"

      - name: Resolve IMAGE_SHA from TEST ECR
        id: resolve-sha
        env:
          ECR_TEST_REGISTRY: ${{ vars.ECR_TEST_REGISTRY }}
          ECR_REPOSITORY: ${{ vars.ECR_REPOSITORY || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          IMAGE_SHA=$(aws ecr describe-images \
            --repository-name "${ECR_REPOSITORY}" \
            --image-ids imageTag="${RELEASE_TAG}" \
            --query 'imageDetails[0].imageDigest' --output text 2>/dev/null || echo "")
          if [ -z "${IMAGE_SHA}" ] || [ "${IMAGE_SHA}" = "None" ]; then
            echo "::error::Could not resolve digest for ${ECR_TEST_REGISTRY}/${ECR_REPOSITORY}:${RELEASE_TAG}. Ensure the image was published by the TEST deploy workflow."
            exit 1
          fi
          echo "IMAGE_SHA=${IMAGE_SHA}" >> "$GITHUB_ENV"
          echo "digest=${IMAGE_SHA}" >> "$GITHUB_OUTPUT"

      - name: cosign copy TEST ECR → PROD ECR
        # cosign copy required — docker/crane tag drops OCI referrers (signatures, SBOM)
        env:
          ECR_TEST_REGISTRY: ${{ vars.ECR_TEST_REGISTRY }}
          ECR_PROD_REGISTRY: ${{ vars.ECR_PROD_REGISTRY }}
          ECR_REPOSITORY: ${{ vars.ECR_REPOSITORY || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          cosign copy \
            "${ECR_TEST_REGISTRY}/${ECR_REPOSITORY}@${IMAGE_SHA}" \
            "${ECR_PROD_REGISTRY}/${ECR_REPOSITORY}:${RELEASE_TAG}"

      - name: cosign verify PROD image (ECR)
        env:
          ECR_PROD_REGISTRY: ${{ vars.ECR_PROD_REGISTRY }}
          ECR_REPOSITORY: ${{ vars.ECR_REPOSITORY || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          cosign verify \
            --certificate-identity-regexp 'https://github\.com/<%= githubOwner %>/<%= githubRepo %>/.*' \
            --certificate-oidc-issuer https://token.actions.githubusercontent.com \
            "${ECR_PROD_REGISTRY}/${ECR_REPOSITORY}:${RELEASE_TAG}"
