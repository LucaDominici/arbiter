      - name: Install cosign (keyless OIDC)
        uses: sigstore/cosign-installer@d7d6bc7722e3daa8354c50bcb52f4837da5e9b6a  # v3.8.1

      - name: Resolve IMAGE_SHA from TEST image
        id: resolve-sha
        env:
          REGISTRY: ${{ vars.CONTAINER_REGISTRY || 'ghcr.io' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail
          # jq (preinstalled on GitHub runners) keeps digest extraction on one line — a
          # multi-line `python3 -c` body at column 0 would break the `run: |` block scalar.
          IMAGE_SHA=$(docker manifest inspect "${REGISTRY}/${IMAGE_NAME}:${RELEASE_TAG}" 2>/dev/null \
            | jq -r '([.manifests[]? | select(.Platform.os == "linux") | .Digest][0]) // .config.digest // ""' 2>/dev/null || echo "")
          if [ -z "${IMAGE_SHA}" ]; then
            echo "::error::Could not resolve digest for ${REGISTRY}/${IMAGE_NAME}:${RELEASE_TAG}. Ensure the image was published by the TEST deploy workflow."
            exit 1
          fi
          echo "IMAGE_SHA=${IMAGE_SHA}" >> "$GITHUB_ENV"
          echo "digest=${IMAGE_SHA}" >> "$GITHUB_OUTPUT"

      - name: cosign copy TEST → PROD (GHCR)
        # cosign copy required — docker/crane tag drops OCI referrers (signatures, SBOM)
        env:
          REGISTRY: ${{ vars.CONTAINER_REGISTRY || 'ghcr.io' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail
          cosign copy \
            "${REGISTRY}/${IMAGE_NAME}@${IMAGE_SHA}" \
            "${REGISTRY}/${IMAGE_NAME}:${RELEASE_TAG}"

      - name: Resolve PROD digest (pin for verify + deploy)
        env:
          REGISTRY: ${{ vars.CONTAINER_REGISTRY || 'ghcr.io' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail
          DEST_DIGEST=$(docker manifest inspect "${REGISTRY}/${IMAGE_NAME}:${RELEASE_TAG}" 2>/dev/null \
            | jq -r '([.manifests[]? | select(.Platform.os == "linux") | .Digest][0]) // .config.digest // ""' 2>/dev/null || echo "")
          if [ -z "${DEST_DIGEST}" ]; then
            echo "::error::Could not resolve PROD digest after cosign copy"
            exit 1
          fi
          # Export pinned ref: deploy partial uses IMAGE_TAG from $GITHUB_ENV (avoids TOCTOU on mutable tag)
          echo "IMAGE_TAG=${REGISTRY}/${IMAGE_NAME}@${DEST_DIGEST}" >> "$GITHUB_ENV"
          echo "DEST_DIGEST=${DEST_DIGEST}" >> "$GITHUB_ENV"

      - name: cosign verify PROD image
        env:
          REGISTRY: ${{ vars.CONTAINER_REGISTRY || 'ghcr.io' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
        run: |
          set -euo pipefail
          cosign verify \
            --certificate-identity-regexp 'https://github\.com/<%= githubOwner %>/<%= githubRepo %>/.github/workflows/05-release\.yml@refs/tags/v.*' \
            --certificate-oidc-issuer https://token.actions.githubusercontent.com \
            "${REGISTRY}/${IMAGE_NAME}@${DEST_DIGEST}"
