      - name: Install cosign (keyless OIDC)
        uses: sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6  # v4.1.2

      - name: Google auth (Workload Identity Federation)
        uses: google-github-actions/auth@c200f3691d83b41bf9bbd8638997a462592937ed  # v2
        with:
          workload_identity_provider: ${{ vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ vars.GCP_SERVICE_ACCOUNT }}

      - name: Configure Docker for GAR (TEST + PROD locations)
        env:
          GAR_TEST_LOCATION: ${{ vars.GAR_TEST_LOCATION }}
          GAR_PROD_LOCATION: ${{ vars.GAR_PROD_LOCATION }}
          GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
        run: |
          set -euo pipefail
          for VAR in GAR_TEST_LOCATION GAR_PROD_LOCATION GCP_PROJECT_ID; do
            VALUE="${!VAR:-PLACEHOLDER-unset}"
            if grep -qi 'PLACEHOLDER-' <<< "${VALUE}"; then
              echo "::error::${VAR} contains PLACEHOLDER- — configure the variable before enabling deploy"
              exit 1
            fi
          done
          gcloud auth configure-docker "${GAR_TEST_LOCATION}-docker.pkg.dev" --quiet
          gcloud auth configure-docker "${GAR_PROD_LOCATION}-docker.pkg.dev" --quiet

      - name: Resolve IMAGE_SHA from TEST GAR
        id: resolve-sha
        env:
          GAR_TEST_LOCATION: ${{ vars.GAR_TEST_LOCATION }}
          GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
          GAR_TEST_REPOSITORY: ${{ vars.GAR_TEST_REPOSITORY || 'app' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail
          TEST_IMAGE="${GAR_TEST_LOCATION}-docker.pkg.dev/${GCP_PROJECT_ID}/${GAR_TEST_REPOSITORY}/${IMAGE_NAME}:${RELEASE_TAG}"
          # gcloud artifacts docker images describe is the correct command for Artifact Registry
          IMAGE_SHA=$(gcloud artifacts docker images describe "${TEST_IMAGE}" \
            --format 'value(image_summary.digest)') || {
            echo "::error::Could not resolve digest for ${TEST_IMAGE}. Ensure the image was published by the TEST deploy workflow."
            exit 1
          }
          if [ -z "${IMAGE_SHA}" ]; then
            echo "::error::Digest is empty for ${TEST_IMAGE}"
            exit 1
          fi
          echo "IMAGE_SHA=${IMAGE_SHA}" >> "$GITHUB_ENV"
          echo "digest=${IMAGE_SHA}" >> "$GITHUB_OUTPUT"

      - name: cosign copy TEST GAR → PROD GAR
        # cosign copy required — docker/crane tag drops OCI referrers (signatures, SBOM)
        env:
          GAR_TEST_LOCATION: ${{ vars.GAR_TEST_LOCATION }}
          GAR_PROD_LOCATION: ${{ vars.GAR_PROD_LOCATION }}
          GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
          GAR_TEST_REPOSITORY: ${{ vars.GAR_TEST_REPOSITORY || 'app' }}
          GAR_PROD_REPOSITORY: ${{ vars.GAR_PROD_REPOSITORY || 'app' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail
          cosign copy \
            "${GAR_TEST_LOCATION}-docker.pkg.dev/${GCP_PROJECT_ID}/${GAR_TEST_REPOSITORY}/${IMAGE_NAME}@${IMAGE_SHA}" \
            "${GAR_PROD_LOCATION}-docker.pkg.dev/${GCP_PROJECT_ID}/${GAR_PROD_REPOSITORY}/${IMAGE_NAME}:${RELEASE_TAG}"

      - name: Resolve PROD digest (pin for verify + deploy)
        env:
          GAR_PROD_LOCATION: ${{ vars.GAR_PROD_LOCATION }}
          GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
          GAR_PROD_REPOSITORY: ${{ vars.GAR_PROD_REPOSITORY || 'app' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
          RELEASE_TAG: ${{ github.event.release.tag_name }}
        run: |
          set -euo pipefail
          PROD_REF="${GAR_PROD_LOCATION}-docker.pkg.dev/${GCP_PROJECT_ID}/${GAR_PROD_REPOSITORY}/${IMAGE_NAME}:${RELEASE_TAG}"
          DEST_DIGEST=$(gcloud artifacts docker images describe "${PROD_REF}" \
            --format 'value(image_summary.digest)') || {
            echo "::error::Could not resolve PROD digest after cosign copy"
            exit 1
          }
          if [ -z "${DEST_DIGEST}" ]; then
            echo "::error::PROD digest is empty after cosign copy"
            exit 1
          fi
          # Export pinned ref: deploy partial uses IMAGE_TAG from $GITHUB_ENV (avoids TOCTOU on mutable tag)
          PROD_BASE="${GAR_PROD_LOCATION}-docker.pkg.dev/${GCP_PROJECT_ID}/${GAR_PROD_REPOSITORY}/${IMAGE_NAME}"
          echo "IMAGE_TAG=${PROD_BASE}@${DEST_DIGEST}" >> "$GITHUB_ENV"
          echo "DEST_DIGEST=${DEST_DIGEST}" >> "$GITHUB_ENV"

      - name: cosign verify PROD image (GAR)
        env:
          GAR_PROD_LOCATION: ${{ vars.GAR_PROD_LOCATION }}
          GCP_PROJECT_ID: ${{ vars.GCP_PROJECT_ID }}
          GAR_PROD_REPOSITORY: ${{ vars.GAR_PROD_REPOSITORY || 'app' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
        run: |
          set -euo pipefail
          cosign verify \
            --certificate-identity-regexp 'https://github\.com/<%= githubOwner %>/<%= githubRepo %>/.github/workflows/05-release\.yml@refs/tags/v.*' \
            --certificate-oidc-issuer https://token.actions.githubusercontent.com \
            "${GAR_PROD_LOCATION}-docker.pkg.dev/${GCP_PROJECT_ID}/${GAR_PROD_REPOSITORY}/${IMAGE_NAME}@${DEST_DIGEST}"
