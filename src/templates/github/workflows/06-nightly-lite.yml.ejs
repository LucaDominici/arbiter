<%
const _cm = (typeof collaborationMode !== 'undefined' ? collaborationMode : 'trunk-solo');
const _runner = (_cm === 'gated-review' && (governanceLevel === 'L3' || governanceLevel === 'L4'))
  ? "${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}"
  : "${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}";
const _isSoloL3Plus = _cm === 'trunk-solo' && (governanceLevel === 'L3' || governanceLevel === 'L4');
%>name: Nightly Lite (T4-lite)

on:
  schedule:
    - cron: '0 3 * * *'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: nightly-lite
  cancel-in-progress: false

jobs:
  integration-full:
    name: Full integration tests
    runs-on: <%- _runner %>
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: Integration tests (full)
        run: npm run test:integration
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - name: Integration tests (full)
        run: ./gradlew integrationTest
<% } else { %>
      - name: Integration tests (full)
        run: mvn verify -P integration
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: Integration tests (full)
        run: go test -tags integration -count=1 ./...
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version-file: .python-version
      - run: pip install -e ".[dev]"
      - name: Integration tests (full)
        run: pytest -m integration
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # branch:stable @ 2026-05-24
      - name: Integration tests (full)
        run: cargo test --test '*' -- --include-ignored
<% } %>

  dep-cve-refresh:
    name: Dependency CVE refresh
    runs-on: <%- _runner %>
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: npm audit
        run: npm audit --omit=dev --audit-level=high
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: OWASP Dependency-Check
        uses: dependency-check/Dependency-Check_Action@1e54355a8b4c8abaa8cc7d0b70aa655a3bb15a6c  # main @ 2026-05-28
        with:
          project: '${{ github.repository }}'
          path: '.'
          format: HTML
          args: '--failOnCVSS 7'
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: govulncheck
        uses: golang/govulncheck-action@b625fbe08f3bccbe446d94fbf87fcc875a4f50ee  # v1
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version-file: .python-version
      - run: pip install pip-audit
      - name: pip-audit
        run: pip-audit --strict
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # branch:stable @ 2026-05-24
      - name: cargo-audit
        run: |
          cargo install cargo-audit --locked
          cargo audit
<% } %>
<% if (_isSoloL3Plus) { %>
  solo-reactivation-check:
    name: Solo reactivation check (§11.10(k))
    runs-on: <%- _runner %>
    timeout-minutes: 5
    steps:
      # #1311: self-hosted persistent workspaces can keep a stale
      # .git/refs/**/*.lock from an interrupted run, which makes the
      # deep checkout below fail with "cannot lock ref". No-op on
      # ephemeral runners. Keep as a separate hunk: Wave-2 #1319 edits
      # the checkout step's name:/SHA pin below, not this guard.
      - name: Clean stale git ref locks (self-hosted)
        # FAIL-OPEN-INTENT: best-effort stale ref-lock sweep; a real failure still surfaces at checkout
        run: find "$GITHUB_WORKSPACE/.git/refs" -name '*.lock' -delete 2>/dev/null || true
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          fetch-depth: 0
      - name: Check solo-dev reactivation trigger
        run: node scripts/check-solo-reactivation.mjs
        env:
          EXTERNAL_AUDIT: ${{ vars.EXTERNAL_AUDIT || 'false' }}
<% } %>
