<%
const _cm = (typeof collaborationMode !== 'undefined' ? collaborationMode : 'trunk-solo');
const _runner = (_cm === 'gated-review' && isL3Plus)
  ? "${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}"
  : "${{ fromJSON(vars.RUNNER_LABELS_TEST || '[\"ubuntu-latest\"]') }}";
const _isSoloL3Plus = _cm === 'trunk-solo' && isL3Plus;
%>name: Nightly Lite (T4-lite)

on:
  schedule:
    - cron: '0 3 * * *'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: nightly-lite
  cancel-in-progress: false

jobs:
  integration-full:
    name: Full integration tests
    runs-on: <%- _runner %>
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: Integration tests (full)
        run: npm run test:integration
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - name: Integration tests (full)
        run: ./gradlew integrationTest
<% } else { %>
      - name: Integration tests (full)
        run: mvn verify -P integration
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: Integration tests (full)
        run: go test -tags integration -count=1 ./...
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version-file: .python-version
      - run: pip install -e ".[dev]"
      - name: Integration tests (full)
        run: pytest -m integration
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
      - name: Integration tests (full)
        run: cargo test --test '*' -- --include-ignored
<% } %>

  dep-cve-refresh:
    name: Dependency CVE refresh
    # #1756: pinned to a LITERAL GitHub-hosted runner, not the usual _runner
    # self-hosted-capable fallback. The java branch below uses
    # dependency-check/Dependency-Check_Action, a docker-container action — on a
    # self-hosted runner whose own process runs inside a container, the action's
    # workspace bind-mount resolves against the DOCKER HOST path, not the runner's own
    # checkout. GitHub-hosted runners are not containerized this way and are
    # unaffected. Enforced by scripts/check-docker-action-runner-safety.mjs.
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: npm audit
        run: npm audit --omit=dev --audit-level=high
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: OWASP Dependency-Check
        uses: dependency-check/Dependency-Check_Action@1e54355a8b4c8abaa8cc7d0b70aa655a3bb15a6c  # main @ 2026-05-28
        with:
          project: '${{ github.repository }}'
          path: '.'
          format: HTML
          args: '--failOnCVSS 7'
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: govulncheck
        uses: golang/govulncheck-action@b625fbe08f3bccbe446d94fbf87fcc875a4f50ee  # v1
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version-file: .python-version
      - run: pip install pip-audit
      - name: pip-audit
        run: pip-audit --strict
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
      - name: cargo-audit
        run: |
          cargo install cargo-audit --locked
          cargo audit
<% } %>
<% if (_isSoloL3Plus) { %>
  solo-reactivation-check:
    name: Solo reactivation check (§11.10(k))
    runs-on: <%- _runner %>
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0
      - name: Check solo-dev reactivation trigger
        run: node scripts/check-solo-reactivation.mjs
        env:
          EXTERNAL_AUDIT: ${{ vars.EXTERNAL_AUDIT || 'false' }}
<% } %>
