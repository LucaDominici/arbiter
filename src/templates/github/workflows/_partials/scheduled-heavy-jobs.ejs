<%# #1693 (ADR-101): the fuzz + soak-e2e heavy scheduled jobs, extracted into a
    shared partial so they render identically whether included from _nightly.yml
    (runnerProfile 'fleet', the default) or _weekly.yml (runnerProfile 'solo').
    References bare `language`/`buildTool` — inherited from the parent's locals
    via EJS include scope (renderTemplate passes { filename }, with(locals) is on). -%>
  fuzz:
    name: Fuzz testing
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: fast-check fuzz (property-based)
        run: npm run test:fuzz
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: jqwik property-based tests
        run: |
<% if (buildTool === 'gradle') { %>
          ./gradlew test -Djqwik.database=false
<% } else { %>
          mvn test -Djqwik.database=false
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: Go native fuzz (30 min budget)
        run: |
          FUZZ_FUNCS=$(grep -r 'func Fuzz' --include='*.go' -l . || true)
          if [ -n "$FUZZ_FUNCS" ]; then
            for f in $(grep -r 'func Fuzz' --include='*.go' -l .); do
              PKG=$(dirname "$f")
              FUNC=$(grep 'func Fuzz' "$f" | head -1 | sed 's/func //' | sed 's/(.*//')
              go test -fuzz="$FUNC" -fuzztime=5m "./$PKG" || true
            done
          fi
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version-file: .python-version
      - run: pip install atheris
      - name: atheris fuzz (30 min budget)
        run: |
          FUZZ_SCRIPTS=$(find . -name 'fuzz_*.py' | head -5)
          if [ -n "$FUZZ_SCRIPTS" ]; then
            for s in $FUZZ_SCRIPTS; do
              timeout 360 python "$s" -atheris_runs=100000 || true
            done
          fi
<% } else if (language === 'rust') { %>
      - name: Install Rust nightly + cargo-fuzz
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
      - name: cargo-fuzz (30 min budget)
        run: |
          cargo install cargo-fuzz --locked || true
          TARGETS=$(cargo fuzz list 2>/dev/null || true)
          if [ -n "$TARGETS" ]; then
            for target in $TARGETS; do
              cargo fuzz run "$target" -- -max_total_time=360 || true
            done
          fi
<% } %>

  soak-e2e:
    name: Soak / E2E full suite
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: Bake E2E
        run: npm run test:e2e:bake
      - name: Native E2E
        env:
          VITEST_NATIVE: "1"
        run: npm run test:e2e:native
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: Newman / REST Assured soak (60 min budget)
        run: |
<% if (buildTool === 'gradle') { %>
          ./gradlew test -Dgroups='soak,e2e' || true
<% } else { %>
          mvn test -Dgroups='soak,e2e' || true
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: Go soak tests (60 min budget)
        run: go test -tags e2e,soak -timeout 60m ./... || true
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version-file: .python-version
      - run: pip install -e ".[dev]"
      - name: pytest soak (60 min budget)
        run: pytest -m 'e2e or soak' --timeout=3600 || true
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
      - name: cargo soak tests (60 min budget)
        run: cargo test --test soak -- --nocapture || true
<% } %>
