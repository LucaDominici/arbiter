<%
// #1723: serviceBucket/isService are injected by withServiceBucket
// (src/utils/render.ts), the single canonical archetype->bucket resolver — do not
// re-declare the archetype map here.
const _bucket = serviceBucket;
const _isService = isService;
%>on:
  workflow_call:
    inputs:
      nvd-cache-namespace:
        description: Cache namespace for NVD data (e.g. nightly, weekly)
        type: string
        required: true

permissions:
  contents: read

jobs:
  dast-full:
    name: OWASP ZAP full scan
<% if (!_isService) { %>
    if: false
<% } %>
    continue-on-error: true
    # #1756: pinned to a LITERAL GitHub-hosted runner, not the usual
    # `vars.RUNNER_LABELS_TEST` self-hosted-capable fallback. zaproxy/action-full-scan
    # is a Docker-outside-of-Docker action (it internally runs `docker run` against the
    # ZAP image) — on a self-hosted runner whose own process runs inside a container,
    # the workspace bind-mount resolves against the DOCKER HOST path, not the runner's
    # own checkout. GitHub-hosted runners are not containerized this way and are
    # unaffected. Enforced by scripts/check-docker-action-runner-safety.mjs.
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
      # E4 (#1502): the PR-path dast-baseline (02-pr-extended) consolidated here at
      # nightly cadence. Start the application so the full active scan has a live
      # target — the prior nightly scan pointed at localhost:8080 with nothing running.
      - name: Start application
        run: docker compose up -d --wait
      - name: ZAP full scan
        uses: zaproxy/action-full-scan@d2a07475d467566c9a3e3c700f31f47724aa1060  # v0.10.0
        with:
          target: 'http://localhost:8080'
          fail_action: false
          artifact_name: zap-full-report
      - name: Stop application
        if: always()
        run: docker compose down

  dep-cve-refresh:
    name: Dependency CVE refresh
    # #1756: pinned to a LITERAL GitHub-hosted runner, not the usual
    # `vars.RUNNER_LABELS_TEST` self-hosted-capable fallback. The java branch below
    # uses dependency-check/Dependency-Check_Action, a docker-container action — on a
    # self-hosted runner whose own process runs inside a container, the action's
    # workspace bind-mount resolves against the DOCKER HOST path, not the runner's own
    # checkout. GitHub-hosted runners are not containerized this way and are
    # unaffected. Enforced by scripts/check-docker-action-runner-safety.mjs.
    # #1767: that assumption does not hold in every environment — literal
    # `ubuntu-latest` has been observed resolving to self-hosted infra. The
    # typescript branch's osv-scanner step below was switched to a static
    # binary as a result; other docker-container actions here remain latent
    # risk, tracked in #1785.
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: npm audit
        run: npm audit --omit=dev --audit-level=high
      - name: Install osv-scanner (pinned static binary)
        # #1767: google/osv-scanner-action is a Docker-outside-of-Docker
        # action — same defect class as the java branch's
        # Dependency-Check_Action below. A static binary has no workspace
        # bind-mount to break, sidestepping the class of bug entirely.
        run: |
          mkdir -p "$RUNNER_TEMP/bin"
          curl -sSfL -o "$RUNNER_TEMP/bin/osv-scanner" \
            https://github.com/google/osv-scanner/releases/download/v2.3.8/osv-scanner_linux_amd64
          echo "bc98e15319ed0d515e3f9235287ba53cdc5535d576d24fd573978ecfe9ab92dc  $RUNNER_TEMP/bin/osv-scanner" | sha256sum -c -
          chmod +x "$RUNNER_TEMP/bin/osv-scanner"
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - name: osv-scanner (prod-dependency gate; dev-only findings warn, not block)
        # #1786: dev-only vulnerable packages are reported but non-blocking,
        # matching the npm-audit step's --omit=dev prod-only policy.
        run: |
          # FAIL-OPEN-INTENT: osv-scanner exits non-zero whenever ANY vuln is found (incl. dev-only); the real gate is the prod-only check below.
          osv-scanner scan source --lockfile=package-lock.json --format json --output-file osv-results.json || true
          PROD=$(jq '[.results[]?.packages[]? | select((.vulnerabilities // []) | length > 0) | select((.dependency_groups // []) | index("dev") | not)] | length' osv-results.json)
          DEV=$(jq '[.results[]?.packages[]? | select((.vulnerabilities // []) | length > 0) | select((.dependency_groups // []) | index("dev"))] | length' osv-results.json)
          if [ "$DEV" -gt 0 ]; then
            echo "::warning::osv-scanner: $DEV dev-only vulnerable package(s), not gating"
            jq -r '.results[]?.packages[]? | select((.vulnerabilities // []) | length > 0) | select((.dependency_groups // []) | index("dev")) | "  - \(.package.name)@\(.package.version)"' osv-results.json
          fi
          if [ "$PROD" -gt 0 ]; then
            echo "::error::osv-scanner: $PROD production-impacting vulnerable package(s)"
            jq -r '.results[]?.packages[]? | select((.vulnerabilities // []) | length > 0) | select((.dependency_groups // []) | index("dev") | not) | "  - \(.package.name)@\(.package.version)"' osv-results.json
            exit 1
          fi
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: OWASP Dependency-Check
        uses: dependency-check/Dependency-Check_Action@1e54355a8b4c8abaa8cc7d0b70aa655a3bb15a6c  # main @ 2026-05-28
        with:
          project: '${{ github.repository }}'
          path: '.'
          format: HTML
          args: '--failOnCVSS 7'
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: govulncheck
        uses: golang/govulncheck-action@b625fbe08f3bccbe446d94fbf87fcc875a4f50ee  # v1
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version-file: .python-version
      - run: pip install pip-audit
      - name: pip-audit
        run: pip-audit --strict
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
      - name: cargo-audit
        run: |
          cargo install cargo-audit --locked
          cargo audit
<% } %>
