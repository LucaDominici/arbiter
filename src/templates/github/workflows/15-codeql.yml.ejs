<%
const _cm = (typeof collaborationMode !== 'undefined' ? collaborationMode : 'peer-review');
const _runner = (_cm === 'gated-review' && isL3Plus)
  ? "${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}"
  : "${{ fromJSON(vars.RUNNER_LABELS_TEST || '[\"ubuntu-latest\"]') }}";
// #1624: a single immutable language string defaulting to 'javascript-typescript' false-greens
// the entire compiled-language backend of a polyglot (language === 'multi') repo - CodeQL would
// scan only the TS frontend while the JVM backend goes unscanned behind a passing check. Resolve
// the FULL set of CodeQL languages the detected stack contains and analyze each as its own matrix
// leg, so every language present is actually scanned. `multi` is the TS-frontend + JVM-backend
// monorepo (src/detectors/language.ts) - treat it as the superset of its parts, never a single
// interpreted language. `kotlin` maps to CodeQL's java-kotlin pack (a bare 'kotlin' fell through
// to the TS default before, scanning a Kotlin codebase as TypeScript).
const _codeqlLangMap = {
  typescript: ['javascript-typescript'],
  java: ['java-kotlin'],
  kotlin: ['java-kotlin'],
  go: ['go'],
  python: ['python'],
  multi: ['java-kotlin', 'javascript-typescript'],
};
const _codeqlLangs = _codeqlLangMap[language] || ['javascript-typescript'];
// For `multi` the JVM build lives under backend/ (not the repo root); single-language JVM stacks
// build at the root. CodeQL must compile the JVM leg to trace it, so point the build there.
const _jvmDir = (language === 'multi') ? 'backend' : null;
-%>
name: CodeQL SAST (T1)

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    - cron: '0 4 * * 1'

permissions:
  contents: read
  security-events: write

concurrency:
  group: codeql-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

jobs:
  analyze:
    name: CodeQL analysis (${{ matrix.language }})
    runs-on: <%- _runner %>
    timeout-minutes: 30
    strategy:
      # One leg per CodeQL language present in the stack. fail-fast: false so a build break in
      # one language leg does not mask (cancel) the SAST of the others (#1624).
      fail-fast: false
      matrix:
        language: <%- JSON.stringify(_codeqlLangs) %>
    steps:
      # #1311: self-hosted persistent workspaces can keep a stale
      # .git/refs/**/*.lock from an interrupted run, which makes the
      # deep checkout below fail with "cannot lock ref". No-op on
      # ephemeral runners.
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          fetch-depth: 0

      - name: Initialize CodeQL
        uses: github/codeql-action/init@4f3212b61783c3c68e8309a0f18a699764811cda # v3.28.8
        with:
          languages: ${{ matrix.language }}
<% if (_codeqlLangs.includes('java-kotlin')) { -%>

      - name: Set up Java
        if: matrix.language == 'java-kotlin'
        uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { -%>
      - name: Set up Gradle
        if: matrix.language == 'java-kotlin'
        uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - name: Build (Gradle)
        if: matrix.language == 'java-kotlin'
<% if (_jvmDir) { -%>
        working-directory: <%- _jvmDir %>
<% } -%>
        run: ./gradlew classes testClasses
<% } else { -%>
      - name: Build (Maven)
        if: matrix.language == 'java-kotlin'
<% if (_jvmDir) { -%>
        working-directory: <%- _jvmDir %>
<% } -%>
        run: mvn compile test-compile -DskipTests
<% } -%>
<% } -%>
<% if (_codeqlLangs.includes('go')) { -%>

      - name: Set up Go
        if: matrix.language == 'go'
        uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: Build (Go)
        if: matrix.language == 'go'
        run: go build ./...
<% } -%>
<% if (_codeqlLangs.includes('javascript-typescript')) { -%>

      - name: Set up Node
        if: matrix.language == 'javascript-typescript'
        uses: ./.github/actions/setup-node-pnpm
<% } -%>

      - name: Perform CodeQL analysis
        uses: github/codeql-action/analyze@4f3212b61783c3c68e8309a0f18a699764811cda # v3.28.8
        with:
          category: '/language:${{ matrix.language }}'
