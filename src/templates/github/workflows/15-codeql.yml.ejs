<%
const _cm = (typeof collaborationMode !== 'undefined' ? collaborationMode : 'peer-review');
const _runner = (_cm === 'gated-review' && (governanceLevel === 'L3' || governanceLevel === 'L4'))
  ? "${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}"
  : "${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}";
const _codeqlLang = language === 'typescript' ? 'javascript-typescript'
  : language === 'java' ? 'java-kotlin'
  : language === 'go' ? 'go'
  : language === 'python' ? 'python'
  : 'javascript-typescript';
%>name: CodeQL SAST (T1)

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  schedule:
    - cron: '0 4 * * 1'

permissions:
  contents: read
  security-events: write

concurrency:
  group: codeql-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

jobs:
  analyze:
    name: CodeQL analysis
    runs-on: <%- _runner %>
    timeout-minutes: 30
    steps:
      # #1311: self-hosted persistent workspaces can keep a stale
      # .git/refs/**/*.lock from an interrupted run, which makes the
      # deep checkout below fail with "cannot lock ref". No-op on
      # ephemeral runners. Keep as a separate hunk: Wave-2 #1319 edits
      # the checkout step's name:/SHA pin below, not this guard.
      - name: Clean stale git ref locks (self-hosted)
        # FAIL-OPEN-INTENT: best-effort stale ref-lock sweep; a real failure still surfaces at checkout
        run: find "$GITHUB_WORKSPACE/.git/refs" -name '*.lock' -delete 2>/dev/null || true
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
        with:
          fetch-depth: 0

      - name: Initialize CodeQL
        uses: github/codeql-action/init@4f3212b61783c3c68e8309a0f18a699764811cda # v3.28.8
        with:
          languages: <%- _codeqlLang %>

<% if (language === 'java') { %>
      - uses: actions/setup-java@c1e323688fd81a25caa38c78aa6df2d33d3e20d9 # v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a # v4
      - name: Build
        run: ./gradlew classes testClasses
<% } else { %>
      - name: Build
        run: mvn compile test-compile -DskipTests
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version-file: go.mod
      - name: Build
        run: go build ./...
<% } else if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
<% } %>

      - name: Perform CodeQL analysis
        uses: github/codeql-action/analyze@4f3212b61783c3c68e8309a0f18a699764811cda # v3.28.8
        with:
          category: '/language:<%- _codeqlLang %>'
