<% const _sonarCmd = (language === 'java' && buildTool === 'gradle') ? './gradlew sonarqube' : (language === 'java') ? 'mvn sonar:sonar' : 'npx sonar-scanner'; %>
      - name: SonarCloud Scan (PR decoration — incremental new-code analysis)
        # E1 (#1502): on PRs Sonar runs in pull-request mode — it decorates the PR
        # with new-code findings only (incremental), NOT a full deep scan. The full
        # branch baseline runs on merge-to-main below and nightly (06-nightly
        # `sonar-deep-scan`), keeping the PR path fast.
        if: env.SONAR_TOKEN != '' && github.event_name == 'pull_request'
        env:
