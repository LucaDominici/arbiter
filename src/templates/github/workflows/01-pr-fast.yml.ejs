          PR_BRANCH: ${{ github.head_ref }}
          PR_BASE: ${{ github.base_ref }}
        run: |
          <%= _sonarCmd %> -Dsonar.token="$SONAR_TOKEN" \
            -Dsonar.pullrequest.key="$PR_KEY" \
            -Dsonar.pullrequest.branch="$PR_BRANCH" \
            -Dsonar.pullrequest.base="$PR_BASE"
      - name: SonarCloud Scan (full branch baseline)
        # Push to a long-lived branch refreshes the full-project baseline so the
        # PR decoration above has a fresh reference to diff new code against.
        if: env.SONAR_TOKEN != '' && github.event_name != 'pull_request'
        env:
