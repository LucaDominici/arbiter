<% const _lanes = Array.isArray(lanes) ? lanes : []; const _multiLane = _lanes.length >= 2; const _bs = (typeof branchingStrategy !== 'undefined' ? branchingStrategy : 'github-flow'); %><% const _collabMode = (typeof collaborationMode !== 'undefined' && collaborationMode) ? collaborationMode : undefined; const _humanApproval = _collabMode !== 'trunk-solo'; /* trunk-solo: the sole human is the PR author and cannot self-approve — drop the impossible gate (INV-74) */ %># Reference: docs/REFERENCE/workflow-pr-fast.md
name: PR Fast (T1)

permissions:
  contents: read

on:
  push:
<% if (_bs === 'github-flow-with-develop') { %>
    branches: [main, develop, "task/**"]
<% } else { %>
    branches: [main, "task/**"]
<% } %>
  pull_request:
    types: [opened, synchronize, reopened, labeled, ready_for_review, unlabeled]
<% if (_bs === 'github-flow-with-develop') { %>
    branches: [main, develop]
<% } else { %>
    branches: [main]
<% } %>
    paths-ignore:
      - 'docs/**'
      - '*.md'
      - '.gitignore'
      - '.editorconfig'

# Cancel in-progress runs on the same ref; main always completes (#357).
concurrency:
  group: pr-fast-${{ github.head_ref || github.ref }}
<% if (_bs === 'github-flow-with-develop') { %>
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' && github.ref != 'refs/heads/develop' }}
<% } else { %>
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
<% } %>

jobs:
  config-lint:
    name: Config Lint (yaml + shell)
    # gold-align (#1506 yamllint / #1507 shellcheck): a language-agnostic style/
    # structure lint lane. yamllint checks non-workflow YAML (indentation, duplicate
    # keys, trailing spaces, document structure) — complementary to actionlint, which
    # owns .github/workflows *semantics*. shellcheck checks generated *.sh for unquoted
    # expansions / unsafe word-splitting at warning severity. Both BLOCKING; both
    # version-pinned for reproducibility. Each linter no-ops cleanly (green) when the
    # repo carries no matching files. Committed .yamllint.yml / .shellcheckrc (when
    # present) are auto-discovered and make the rules explicit + tunable.
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
      - name: Install shellcheck (pinned)
        run: |
          mkdir -p "$RUNNER_TEMP/bin"
          curl -sSfL https://github.com/koalaman/shellcheck/releases/download/v0.10.0/shellcheck-v0.10.0.linux.x86_64.tar.xz \
            | tar -xJ -C "$RUNNER_TEMP/bin" --strip-components=1 shellcheck-v0.10.0/shellcheck
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - name: shellcheck (generated shell, blocking at warning severity)
        # .shellcheckrc (when present) is auto-discovered. No *.sh ⇒ no-op (green).
        run: |
          files=$(git ls-files '*.sh')
          if [ -n "$files" ]; then
            echo "$files" | xargs shellcheck --severity=warning
          else
            echo "shellcheck: no *.sh files — skipping"
          fi
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5
        with:
          python-version: '3.12'
      - name: Install yamllint (pinned)
        run: pip install yamllint==1.35.1
      - name: yamllint (non-workflow YAML, blocking on errors)
        # actionlint owns .github/workflows semantics; exclude them to avoid overlap.
        # A committed .yamllint.yml (when present) is auto-discovered and authoritative;
        # otherwise fall back to yamllint's built-in `relaxed` preset — both block on
        # ERRORS only (line-length etc. stay advisory warnings). No matching YAML ⇒ no-op.
        run: |
          files=$(git ls-files '*.yml' '*.yaml' ':!.github/workflows/**')
          if [ -n "$files" ]; then
            if [ -f .yamllint.yml ] || [ -f .yamllint.yaml ] || [ -f .yamllint ]; then
              echo "$files" | xargs yamllint
            else
              echo "$files" | xargs yamllint -d relaxed
            fi
          else
            echo "yamllint: no non-workflow YAML — skipping"
          fi
<% if (locals.enableSoloDevMode) { %>
  solo-dev-gate:
    name: Solo-Dev Gate (INV-59)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    steps:
      - run: echo "solo-dev mode — local L2 gate guards merge via INV-59 parity check"
<% } else { %><% if (enableSecurityScanning) { %>
  security-early-fail:
    name: Security (PII + Secrets)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    steps:
      # #1311: self-hosted persistent workspaces can keep a stale
      # .git/refs/**/*.lock from an interrupted run, which makes the
      # deep checkout below fail with "cannot lock ref". No-op on
      # ephemeral runners. Keep as a separate hunk: Wave-2 #1319 edits
      # the checkout step's name:/SHA pin below, not this guard.
      - name: Clean stale git ref locks (self-hosted)
        # FAIL-OPEN-INTENT: best-effort stale ref-lock sweep; a real failure still surfaces at checkout
        run: find "$GITHUB_WORKSPACE/.git/refs" -name '*.lock' -delete 2>/dev/null || true
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
        with:
          fetch-depth: 0
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e  # v6.4.0
        with:
          node-version-file: '.nvmrc'
      - name: PII scan (INV-12, HARD)
        run: node scripts/pii-scan.mjs
      - name: Install gitleaks
        run: |
          mkdir -p "$RUNNER_TEMP/bin"
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.27.2/gitleaks_8.27.2_linux_x64.tar.gz | tar -xz -C "$RUNNER_TEMP/bin" gitleaks
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - name: Gitleaks secrets scan (INV-11)
        run: |
          gitleaks detect --source . --config .gitleaks.toml \
            --gitleaks-ignore-path suppressions/.gitleaksignore \
            --exit-code 1 --redact
<% } %>
<% if (governanceLevel !== 'L1' || _multiLane) { %>
  classify-changes:
    name: Classify Changes
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    outputs:
      docs_only: ${{ steps.classify.outputs.docs_only }}
      backend_changed: ${{ steps.classify.outputs.backend_changed }}
      frontend_changed: ${{ steps.classify.outputs.frontend_changed }}
      infra_changed: ${{ steps.classify.outputs.infra_changed }}
      high_risk: ${{ steps.classify.outputs.high_risk }}
    steps:
      # #1311: self-hosted persistent workspaces can keep a stale
      # .git/refs/**/*.lock from an interrupted run, which makes the
      # deep checkout below fail with "cannot lock ref". No-op on
      # ephemeral runners. Keep as a separate hunk: Wave-2 #1319 edits
      # the checkout step's name:/SHA pin below, not this guard.
      - name: Clean stale git ref locks (self-hosted)
        # FAIL-OPEN-INTENT: best-effort stale ref-lock sweep; a real failure still surfaces at checkout
        run: find "$GITHUB_WORKSPACE/.git/refs" -name '*.lock' -delete 2>/dev/null || true
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
        with:
          fetch-depth: 0
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e  # v6.4.0
        with:
          node-version-file: '.nvmrc'
      - id: classify
        if: hashFiles('scripts/ci-classify-changes.mjs') != ''
        run: node scripts/ci-classify-changes.mjs
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha || 'origin/main' }}
          HEAD_SHA: ${{ github.sha }}
<% } %>
<% if (_multiLane) { %>
  cross-stack-guard:
    name: Cross-Stack Guard
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [classify-changes]
    if: github.event_name == 'pull_request'
    permissions:
      pull-requests: write
    steps:
<% if (governanceLevel === 'L3' || governanceLevel === 'L4') { %>
      - name: Enforce cross-stack split
        if: needs.classify-changes.outputs.backend_changed == 'true' && needs.classify-changes.outputs.frontend_changed == 'true'
        run: |
          echo "::error::This PR touches both frontend and backend lanes. Split into separate PRs."
          exit 1
<% } else { %>
      - name: Warn cross-stack changes
        if: needs.classify-changes.outputs.backend_changed == 'true' && needs.classify-changes.outputs.frontend_changed == 'true'
        continue-on-error: true
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3  # v9.0.0
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: '> [!WARNING]\n> This PR touches both **frontend** and **backend** lanes. Consider splitting into separate PRs for cleaner review and safer deployment.'
            })
<% } %>
<% } %>
<% if (enableSecurityScanning) { %>  dependency-review:
    name: Dependency Review (supply-chain)
    # A1 (#1502): the canonical FAST PR supply-chain gate. dependency-review-action
    # diffs the PR's dependency-manifest changes and fails on a newly-introduced
    # vulnerable dependency — keeping slow full-tree scanners off the always-path.
    # PR-only (the action diffs base...head and errors on push). Fail severity is
    # configurable via the DEPENDENCY_REVIEW_FAIL_SEVERITY repo variable (default: high).
    # Floor: enableSecurityScanning — the same always-path gate as security-early-fail.
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    if: github.event_name == 'pull_request'
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
      - name: Dependency review (fail on newly-introduced high-severity deps)
        uses: actions/dependency-review-action@a1d282b36b6f3519aa1f3fc636f609c47dddb294  # v5.0.0
        with:
          fail-on-severity: ${{ vars.DEPENDENCY_REVIEW_FAIL_SEVERITY || 'high' }}
<% } %>
<% if (governanceLevel !== 'L1' || _multiLane) { %>  iac-scan:
    name: IaC Scan (infra-changed)
    # A1 (#1502): consume the classify-changes `infra_changed` signal (previously
    # classified but UNUSED) — scan terraform / kubernetes / dockerfile only when the
    # PR actually touches infrastructure-as-code, keeping the always-path lean.
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    needs: [classify-changes]
    if: needs.classify-changes.outputs.infra_changed == 'true'
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
      - name: Checkov IaC scan (terraform, kubernetes, dockerfile)
        uses: bridgecrewio/checkov-action@99bb2caf247dfd9f03cf984373bc6043d4e32ebf  # v12.1347.0
        with:
          directory: .
          framework: terraform,kubernetes,dockerfile
          quiet: true
          soft_fail: false
      # #1509 gold-align: Checkov scans for known misconfigurations; tflint is the
      # Terraform-specific *linter* (provider-aware deprecations, invalid arg
      # combinations, unused declarations). Reference-grade IaC pipelines run it
      # BLOCKING — no soft-fail. `--recursive` exits 0 when the repo carries no
      # `.tf` files, so non-Terraform infra changes (k8s/dockerfile) stay green.
      - name: Setup tflint (Terraform linter)
        uses: terraform-linters/setup-tflint@b480b8fcdaa6f2c577f8e4fa799e89e756bb7c93  # v6.2.2
      - name: tflint (Terraform lint, blocking)
        run: tflint --recursive --no-color
<% } %>
<% if (language === 'typescript') { %>
<% const _tsNeeds=[]; if(enableSecurityScanning) _tsNeeds.push('security-early-fail'); if(governanceLevel !== 'L1' || _multiLane) _tsNeeds.push('classify-changes'); %>
