  docs-check:
    name: Docs Check
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    timeout-minutes: 60
    if: github.event_name == 'pull_request'
    steps:
      # #1311: self-hosted persistent workspaces can keep a stale
      # .git/refs/**/*.lock from an interrupted run, which makes the
      # deep checkout below fail with "cannot lock ref". No-op on
      # ephemeral runners. Keep as a separate hunk: Wave-2 #1319 edits
      # the checkout step's name:/SHA pin below, not this guard.
      - name: Clean stale git ref locks (self-hosted)
        # FAIL-OPEN-INTENT: best-effort stale ref-lock sweep; a real failure still surfaces at checkout
        run: find "$GITHUB_WORKSPACE/.git/refs" -name '*.lock' -delete 2>/dev/null || true
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
        with:
          fetch-depth: 0
      - name: Check docs updated with code changes
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          # #356: rebased-aware via merge-base; bypass via [skip-docs] commit token.
          MB=$(git merge-base "$BASE_SHA" "$HEAD_SHA" || echo "$BASE_SHA")
          CHANGED=$(git diff --name-only "$MB" "$HEAD_SHA")
          LOG=$(git log --format=%B "$MB..$HEAD_SHA" || true)

          HAS_CODE=$(echo "$CHANGED" | grep -E '^(src/|__tests__/)' || true)
          HAS_DOCS=$(echo "$CHANGED" | grep -E '^(docs/|README\.md)' || true)
          BYPASS=$(echo "$LOG" | grep -F '[skip-docs]' || true)

          if [ -n "$HAS_CODE" ] && [ -z "$HAS_DOCS" ] && [ -z "$BYPASS" ]; then
            echo "::error::Code changed without documentation update"
            echo ""
            echo "Files changed in src/ or __tests__/:"
            echo "$HAS_CODE"
            echo ""
            echo "Please update docs/ or README.md, or add [skip-docs] to a commit message to bypass."
            exit 1
          fi
          echo "Docs check passed."
<% } %>

