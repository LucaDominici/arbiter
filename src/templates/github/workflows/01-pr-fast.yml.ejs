<% if (contractType && contractType !== 'none' && governanceLevel !== 'L1') { %>

  contract-verify:
    name: Contract Verify
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    needs: [gate]
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
<% if (contractType === 'rest-owned' || contractType === 'rest-public') { %>
      - name: Run Pact contract tests
        if: vars.PACT_BROKER_BASE_URL != ''
        run: npx pact-broker can-i-deploy --pacticipant <%= projectName %> --latest
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } else if (contractType === 'graphql') { %>
      - name: Run GraphQL schema contract tests
        run: npx graphql-inspector diff schema.graphql
<% } else if (contractType === 'grpc') { %>
      - name: Run gRPC contract tests
        run: npx buf breaking --against .git#branch=main
<% } else if (contractType === 'message-queue') { %>
      - name: Run Pact messaging contract tests
        if: vars.PACT_BROKER_BASE_URL != ''
        run: npx pact-broker can-i-deploy --pacticipant <%= projectName %> --latest
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } %>
<% } else if (language === 'java') { %>
      - uses: ./.github/actions/setup-java-maven
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@d9c87d481d55275bb5441eef3fe0e46805f9ef70  # v3
<% } %>
<% if (contractType === 'rest-owned' || contractType === 'rest-public' || contractType === 'message-queue') { %>
      - name: Run Pact contract tests
        if: vars.PACT_BROKER_BASE_URL != ''
        run: <%= buildTool === 'gradle' ? './gradlew pactPublish pactVerify' : 'mvn pact:publish pact:verify' %>
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } else if (contractType === 'graphql') { %>
      - name: Run GraphQL contract tests
        run: <%= buildTool === 'gradle' ? './gradlew test --tests *.graphql.*' : 'mvn test -Dtest=*GraphQL*' %>
<% } else if (contractType === 'grpc') { %>
      - name: Run gRPC contract tests
        run: <%= buildTool === 'gradle' ? './gradlew test --tests *.grpc.*' : 'mvn test -Dtest=*Grpc*' %>
<% } %>
<% } else if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8  # stable
      - uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32  # v2
      - name: Run contract tests
        run: cargo test --test '*contract*'
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff  # v5
        with:
          go-version-file: 'go.mod'
      - name: Run contract tests
        run: go test -tags contract -run Contract ./...
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065  # v5
