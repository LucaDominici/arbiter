<% } %>
<% } %>
<% if (governanceLevel !== 'L1') { %>
  gate-full:
    name: Full Gate (L2, INV-59)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
<%  { const _n=[]; if(enableSecurityScanning) _n.push('security-early-fail'); _n.push('classify-changes'); %>
    needs: [<%= _n.join(', ') %>]
    if: needs.classify-changes.outputs.docs_only != 'true'
<%  } %>
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10  # v6.0.3
        with:
          fetch-depth: 0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
<% } else { %>
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e  # v6.4.0
        with:
          node-version-file: '.nvmrc'
          cache: 'npm'
      - run: npm ci
<% } %>
      - name: Install gitleaks
        run: |
          mkdir -p "$RUNNER_TEMP/bin"
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.27.2/gitleaks_8.27.2_linux_x64.tar.gz | tar -xz -C "$RUNNER_TEMP/bin" gitleaks
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - name: Install actionlint
        run: |
          mkdir -p "$RUNNER_TEMP/bin"
          curl -sSfL https://github.com/rhysd/actionlint/releases/download/v1.7.3/actionlint_1.7.3_linux_amd64.tar.gz | tar -xz -C "$RUNNER_TEMP/bin" actionlint
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
      - name: Build
        run: npm run build && node scripts/build-kit.mjs
      - name: Run full L2 gate (== pre-push)
        run: node scripts/check-all.mjs --level L2 --json gate-result.json
      - name: Upload gate-result artifact (activates INV-59 runtime parity)
        if: always()
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
        with:
          name: gate-result
          path: gate-result.json
          retention-days: 7
<% } %>

<% if (_humanApproval) { %>  human-approval-required:
    name: Human Approval Required (INV-74)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    if: github.event_name == 'pull_request'
    steps:
      - name: Assert approved-by-human label (anti-bot gate)
        uses: actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3  # v9.0.0
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const labels = context.payload.pull_request.labels.map(l => l.name);
            if (!labels.includes('approved-by-human')) {
              core.setFailed(
                'PR requires the "approved-by-human" label applied by a human reviewer. ' +
                'See 03-human-approval.yml — a bot approval does not satisfy this check.'
              );
            }
<% } %>
  ci-required:
    name: CI Required
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
<%
  const _ciNeeds = ['gate'];
  if (_humanApproval) _ciNeeds.push('human-approval-required');
  if (language === 'java' && buildTool === 'maven') _ciNeeds.push('build-reactor');
  if (language === 'typescript' || language === 'java') {
    _ciNeeds.push('unit-tests', 'contract-tests', 'integration-tests', 'behavioral-tests');
  }
  if (enableSecurityScanning) _ciNeeds.push('security-early-fail');
  if (governanceLevel !== 'L1') _ciNeeds.push('docs-check', 'sonar-scan', 'gate-full');
  if (enableDebtGates) _ciNeeds.push('debt-gates', 'debt-ratchet');
  if (contractType && contractType !== 'none' && governanceLevel !== 'L1') _ciNeeds.push('contract-verify');
  if (governanceLevel !== 'L1' || _multiLane) _ciNeeds.push('classify-changes');
  if (_multiLane) _ciNeeds.push('cross-stack-guard');
%>
    needs: [<%= _ciNeeds.join(', ') %>]
    if: always()
    steps:
      - run: |
          if [[ "${{ needs.gate.result }}" != "success" ]]; then
            echo "gate failed"
            exit 1
          fi
<% if (language === 'java' && buildTool === 'maven') { %>
          if [[ "${{ needs.build-reactor.result }}" != "success" ]]; then
            echo "build-reactor failed"
            exit 1
          fi
<% } if (language === 'typescript' || language === 'java') { %>
          if [[ "${{ needs.unit-tests.result }}" != "success" ]]; then
            echo "unit-tests failed"
            exit 1
          fi
          if [[ "${{ needs.contract-tests.result }}" != "success" ]]; then
            echo "contract-tests failed"
            exit 1
          fi
          if [[ "${{ needs.integration-tests.result }}" != "success" ]]; then
            echo "integration-tests failed"
            exit 1
          fi
          if [[ "${{ needs.behavioral-tests.result }}" != "success" ]]; then
            echo "behavioral-tests failed"
            exit 1
          fi
<% } %><% if (enableSecurityScanning) { %>
          if [[ "${{ needs.security-early-fail.result }}" != "success" ]]; then
            echo "security-early-fail failed"
            exit 1
          fi<% } %><% if (governanceLevel !== 'L1') { %>
          if [[ "${{ needs.docs-check.result }}" == "failure" ]]; then
            echo "docs-check failed"
            exit 1
          fi
          if [[ "${{ needs.sonar-scan.result }}" == "failure" ]]; then
            echo "sonar-scan failed"
            exit 1
          fi<% } %><% if (enableDebtGates) { %>
          if [[ "${{ needs.debt-gates.result }}" != "success" ]]; then
            echo "debt-gates failed"
            exit 1
          fi
          if [[ "${{ needs.debt-ratchet.result }}" != "success" ]]; then
            echo "debt-ratchet failed"
            exit 1
          fi<% } %><% if (governanceLevel !== 'L1') { %>
          if [[ "${{ needs.gate-full.result }}" != "success" && "${{ needs.gate-full.result }}" != "skipped" ]]; then
            echo "gate-full (L2) failed or was cancelled"
            exit 1
          fi<% } %><% if (contractType && contractType !== 'none' && governanceLevel !== 'L1') { %>
          if [[ "${{ needs.contract-verify.result }}" != "success" ]]; then
            echo "contract-verify failed"
            exit 1
          fi<% } %><% if (_multiLane) { %>
          if [[ "${{ needs.cross-stack-guard.result }}" == "failure" ]]; then
            echo "cross-stack-guard failed"
            exit 1
          fi<% } %>
<% if (_humanApproval) { %>          if [[ "${{ needs.human-approval-required.result }}" == "failure" ]]; then
            echo "human-approval-required failed — PR needs approved-by-human label"
            exit 1
          fi
<% } %><% } %>
