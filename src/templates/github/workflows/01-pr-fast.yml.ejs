<% if(_tsNeeds.length){ %>    needs: [<%= _tsNeeds.join(', ') %>]
<% } if(governanceLevel !== 'L1' || _multiLane){ %>    if: needs.classify-changes.outputs.docs_only != 'true'
<% } %>    steps:
