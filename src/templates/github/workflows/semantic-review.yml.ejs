<% /* CANON-04: template guards use governanceLevel, not hardcoded levels */ %>
<% /* CANON-13: guard structure: outer condition first, content inside */ %>
<% if (governanceLevel !== 'L1') { %>name: Semantic Review

on:
  pull_request:
    branches: [main]

permissions:
  contents: read
  pull-requests: read

jobs:
  semantic-review:
    name: Semantic Diff Review (INV graph)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5  # v4
        with:
          fetch-depth: 0

      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020  # v4
        with:
          node-version-file: '.nvmrc'

      - name: Install dependencies
        run: npm ci

      - name: Build arbiter
        run: npm run build

      - name: Build graph (base)
        run: |
          git checkout ${{ github.event.pull_request.base.sha }} --quiet
          node dist/cli.js graph build --output /tmp/graph-base.json || true
          git checkout ${{ github.sha }} --quiet

      - name: Build graph (head)
        run: node dist/cli.js graph build --output /tmp/graph-head.json || true

      - name: Semantic diff
        id: diff
        run: |
          node dist/cli.js review diff \
            --base /tmp/graph-base.json \
            --head /tmp/graph-head.json \
            --json > /tmp/review-diff.json 2>&1 || true
          cat /tmp/review-diff.json

      - name: Post review comment
        if: always()
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b  # v7
        with:
          script: |
            const fs = require('fs')
            let body = '**Semantic Review**: analysis unavailable'
            try {
              const diff = JSON.parse(fs.readFileSync('/tmp/review-diff.json', 'utf8'))
              const rec = diff.recommendation ?? 'UNKNOWN'
              const delta = diff.risk_delta ?? 'unknown'
              body = `## Semantic Review: ${rec}\n\n**Risk delta:** ${delta}\n\n`
              if (diff.changes?.enforcement_changes?.length > 0) {
                body += `**Enforcement changes:** ${diff.changes.enforcement_changes.length}\n`
              }
              if (diff.changes?.removed_provers?.length > 0) {
                body += `**Removed provers (BLOCK):** ${diff.changes.removed_provers.join(', ')}\n`
              }
            } catch {}
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body,
            })
<% } %>
