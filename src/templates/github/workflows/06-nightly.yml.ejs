<%
const _bucket = ({'backend-web-db':'service',cli:'cli',embedded:'cli','data-pipeline':'batch'})[archetype] ?? 'lib';
const _isService = _bucket === 'service';
%>name: Nightly (T4)

on:
  schedule:
    - cron: '0 2 * * *'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

concurrency:
  group: nightly
  cancel-in-progress: false

jobs:
  mutation-deep:
    name: Deep mutation testing
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          fetch-depth: 0
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: Stryker mutation (full suite)
        run: npx stryker run
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e32368a7ca79e19b34aa7e28d3de3a8b47c8ea # v4
        with:
          distribution: temurin
          java-version: '21'
<% if (buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@50e97c2cd7a37755bbfafc9c5b7cafaece252f6e # v6.1.0
      - name: PITest mutation (full suite)
        run: ./gradlew pitest
<% } else { %>
      - name: PITest mutation (full suite)
        run: mvn test-compile org.pitest:pitest-maven:mutationCoverage
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582dade4d2f1c86a3da5e27c02b98fee3ec0 # v5
        with:
          go-version-file: go.mod
      - name: Install go-mutesting
        run: go install github.com/zimmski/go-mutesting/cmd/go-mutesting@latest
      - name: Mutation testing (informational)
        run: go-mutesting ./... || true
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69b4fde46a5e1776bf3f1b1e6dd8f0dd5ca # v5
        with:
          python-version-file: .python-version
      - run: pip install -e ".[dev]"
      - name: mutmut full run
        run: mutmut run
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef335eb45f53c3dc45d8f50abf17af8e2b0bd # branch:stable @ 2026-05-24
      - name: cargo-mutants (full suite)
        run: |
          cargo install cargo-mutants --locked
          cargo mutants --all-features
<% } %>

  dast-full:
    name: OWASP ZAP full scan
<% if (!_isService) { %>
    if: false
<% } %>
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
      - name: ZAP full scan
        uses: zaproxy/action-full-scan@d2a07475d467566c9a3e3c700f31f47724aa1060  # v0.10.0
        with:
          target: 'http://localhost:8080'
          fail_action: false
          artifact_name: zap-full-report

  dep-cve-refresh:
    name: Dependency CVE refresh
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: npm audit
        run: npm audit --omit=dev --audit-level=high
      - name: osv-scanner
        uses: google/osv-scanner-action@9a498708959aeaef5ef730655706c5a1df1edbc2 # v2.3.8
        with:
          scan-args: '--lockfile=package-lock.json'
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e32368a7ca79e19b34aa7e28d3de3a8b47c8ea # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: OWASP Dependency-Check
        uses: dependency-check/Dependency-Check_Action@1e54355a8b4c8abaa8cc7d0b70aa655a3bb15a6c  # main @ 2026-05-28
        with:
          project: '${{ github.repository }}'
          path: '.'
          format: HTML
          args: '--failOnCVSS 7'
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582dade4d2f1c86a3da5e27c02b98fee3ec0 # v5
        with:
          go-version-file: go.mod
      - name: govulncheck
        uses: golang/govulncheck-action@b625fbe08f3bccbe446d94fbf87fcc875a4f50ee  # v1
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69b4fde46a5e1776bf3f1b1e6dd8f0dd5ca # v5
        with:
          python-version-file: .python-version
      - run: pip install pip-audit
      - name: pip-audit
        run: pip-audit --strict
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef335eb45f53c3dc45d8f50abf17af8e2b0bd # branch:stable @ 2026-05-24
      - name: cargo-audit
        run: |
          cargo install cargo-audit --locked
          cargo audit
<% } %>

  fuzz:
    name: Fuzz testing
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: fast-check fuzz (property-based)
        run: npm run test:fuzz
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e32368a7ca79e19b34aa7e28d3de3a8b47c8ea # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: jqwik property-based tests
        run: |
<% if (buildTool === 'gradle') { %>
          ./gradlew test -Djqwik.database=false
<% } else { %>
          mvn test -Djqwik.database=false
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582dade4d2f1c86a3da5e27c02b98fee3ec0 # v5
        with:
          go-version-file: go.mod
      - name: Go native fuzz (30 min budget)
        run: |
          FUZZ_FUNCS=$(grep -r 'func Fuzz' --include='*.go' -l . || true)
          if [ -n "$FUZZ_FUNCS" ]; then
            for f in $(grep -r 'func Fuzz' --include='*.go' -l .); do
              PKG=$(dirname "$f")
              FUNC=$(grep 'func Fuzz' "$f" | head -1 | sed 's/func //' | sed 's/(.*//')
              go test -fuzz="$FUNC" -fuzztime=5m "./$PKG" || true
            done
          fi
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69b4fde46a5e1776bf3f1b1e6dd8f0dd5ca # v5
        with:
          python-version-file: .python-version
      - run: pip install atheris
      - name: atheris fuzz (30 min budget)
        run: |
          FUZZ_SCRIPTS=$(find . -name 'fuzz_*.py' | head -5)
          if [ -n "$FUZZ_SCRIPTS" ]; then
            for s in $FUZZ_SCRIPTS; do
              timeout 360 python "$s" -atheris_runs=100000 || true
            done
          fi
<% } else if (language === 'rust') { %>
      - name: Install Rust nightly + cargo-fuzz
        uses: dtolnay/rust-toolchain@29eef335eb45f53c3dc45d8f50abf17af8e2b0bd # branch:stable @ 2026-05-24
      - name: cargo-fuzz (30 min budget)
        run: |
          cargo install cargo-fuzz --locked || true
          TARGETS=$(cargo fuzz list 2>/dev/null || true)
          if [ -n "$TARGETS" ]; then
            for target in $TARGETS; do
              cargo fuzz run "$target" -- -max_total_time=360 || true
            done
          fi
<% } %>

  soak-e2e:
    name: Soak / E2E full suite
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
      - name: Bake E2E
        run: npm run test:e2e:bake
      - name: Native E2E
        env:
          VITEST_NATIVE: "1"
        run: npm run test:e2e:native
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e32368a7ca79e19b34aa7e28d3de3a8b47c8ea # v4
        with:
          distribution: temurin
          java-version: '21'
      - name: Newman / REST Assured soak (60 min budget)
        run: |
<% if (buildTool === 'gradle') { %>
          ./gradlew test -Dgroups='soak,e2e' || true
<% } else { %>
          mvn test -Dgroups='soak,e2e' || true
<% } %>
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582dade4d2f1c86a3da5e27c02b98fee3ec0 # v5
        with:
          go-version-file: go.mod
      - name: Go soak tests (60 min budget)
        run: go test -tags e2e,soak -timeout 60m ./... || true
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69b4fde46a5e1776bf3f1b1e6dd8f0dd5ca # v5
        with:
          python-version-file: .python-version
      - run: pip install -e ".[dev]"
      - name: pytest soak (60 min budget)
        run: pytest -m 'e2e or soak' --timeout=3600 || true
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef335eb45f53c3dc45d8f50abf17af8e2b0bd # branch:stable @ 2026-05-24
      - name: cargo soak tests (60 min budget)
        run: cargo test --test soak -- --nocapture || true
<% } %>

<% if (locals.enableNativeBakeE2E) { %>
  bake-e2e-native:
    name: Native fixture smoke (${{ matrix.stack }})
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    timeout-minutes: 20
    strategy:
      fail-fast: false
      matrix:
        include:
          - stack: ts
            fixture: ts-library
          - stack: python
            fixture: python-library
          - stack: go
            fixture: go-library
          - stack: java
            fixture: java-library-gradle
          - stack: rust
            fixture: rust-library
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3

      - uses: ./.github/actions/setup-node-pnpm

      - uses: actions/setup-python@a26af69b4fde46a5e1776bf3f1b1e6dd8f0dd5ca # v5
        if: matrix.stack == 'python'
        with:
          python-version: '3.12'

      - uses: actions/setup-go@40f1582dade4d2f1c86a3da5e27c02b98fee3ec0 # v5
        if: matrix.stack == 'go'
        with:
          go-version-file: __tests__/fixtures/real-projects/go-library/go.mod

      - uses: actions/setup-java@c1e32368a7ca79e19b34aa7e28d3de3a8b47c8ea # v4
        if: matrix.stack == 'java'
        with:
          distribution: temurin
          java-version: '21'

      - uses: gradle/actions/setup-gradle@50e97c2cd7a37755bbfafc9c5b7cafaece252f6e # v6.1.0
        if: matrix.stack == 'java'

      - uses: dtolnay/rust-toolchain@29eef335eb45f53c3dc45d8f50abf17af8e2b0bd # branch:stable @ 2026-05-24
        if: matrix.stack == 'rust'
        with:
          toolchain: stable

      - name: Native smoke (${{ matrix.stack }})
        env:
          FIXTURE: ${{ matrix.fixture }}
        run: VITEST_NATIVE=1 npx vitest run --config vitest.integration.config.ts __tests__/integration/e2e/native/ -t "$FIXTURE"

<% } %>
<% if (_isService) { %>
  toxiproxy-resilience:
    name: Toxiproxy resilience (service only)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
<% if (language === 'typescript') { %>
      - uses: ./.github/actions/setup-node-pnpm
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@c1e32368a7ca79e19b34aa7e28d3de3a8b47c8ea # v4
        with:
          distribution: temurin
          java-version: '21'
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@40f1582dade4d2f1c86a3da5e27c02b98fee3ec0 # v5
        with:
          go-version-file: go.mod
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@a26af69b4fde46a5e1776bf3f1b1e6dd8f0dd5ca # v5
        with:
          python-version-file: .python-version
      - run: pip install -e ".[dev]"
<% } else if (language === 'rust') { %>
      - name: Install Rust toolchain
        uses: dtolnay/rust-toolchain@29eef335eb45f53c3dc45d8f50abf17af8e2b0bd # branch:stable @ 2026-05-24
<% } %>
      - name: Start Toxiproxy
        # #1086: the upstream Toxiproxy GitHub Action was deleted (repo 404s), so
        # the action reference failed at runtime. Pin + run the official
        # toxiproxy-server release binary directly instead.
        run: |
          curl -fsSL https://github.com/Shopify/toxiproxy/releases/download/v2.12.0/toxiproxy-server-linux-amd64 \
            -o /usr/local/bin/toxiproxy-server
          chmod +x /usr/local/bin/toxiproxy-server
          /usr/local/bin/toxiproxy-server &
          for i in $(seq 1 30); do
            curl -sf http://localhost:8474/version && break
            sleep 1
          done
      - name: DB stall + network partition resilience test
        run: |
<% if (language === 'typescript') { %>
          npm run test:resilience
<% } else if (language === 'java' && buildTool === 'gradle') { %>
          ./gradlew test -Dgroups='resilience'
<% } else if (language === 'java') { %>
          mvn test -Dgroups='resilience'
<% } else if (language === 'go') { %>
          go test -tags resilience ./...
<% } else if (language === 'python') { %>
          pytest -m resilience
<% } else if (language === 'rust') { %>
          cargo test --test resilience
<% } %>

<% } %>
  gitleaks-history:
    name: Secret scan (full history)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
        with:
          fetch-depth: 0
      - name: Gitleaks full history scan
        uses: gitleaks/gitleaks-action@dcedce43c6f43de0b836d1fe38946645c9c638dc  # v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          args: detect --source . --log-opts="--all --full-history"

  evidence-collect:
    name: Upload nightly evidence artifacts
    needs:
      - mutation-deep
      - dep-cve-refresh
      - fuzz
      - soak-e2e
      - gitleaks-history
<% if (locals.enableNativeBakeE2E) { %>
      - bake-e2e-native
<% } %>
    if: always()
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
      - name: Collect evidence summary
        run: |
          mkdir -p nightly-evidence
          echo "Nightly run: $(date -u +%Y-%m-%dT%H:%M:%SZ)" > nightly-evidence/summary.txt
          echo "Ref: ${{ github.sha }}" >> nightly-evidence/summary.txt
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: nightly-evidence-${{ github.run_id }}
          path: nightly-evidence/
          retention-days: 90

  nightly-required:
    name: Nightly gate
    needs:
      - mutation-deep
      - dep-cve-refresh
      - fuzz
      - soak-e2e
      - gitleaks-history
<% if (_isService) { %>
      - toxiproxy-resilience
<% } %>
<% if (locals.enableNativeBakeE2E) { %>
      - bake-e2e-native
<% } %>
    if: always()
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}
    steps:
      - name: Assert no hard failures
        run: |
          RESULTS=(
            "${{ needs.mutation-deep.result }}"
            "${{ needs.dep-cve-refresh.result }}"
            "${{ needs.fuzz.result }}"
            "${{ needs.soak-e2e.result }}"
            "${{ needs.gitleaks-history.result }}"
<% if (locals.enableNativeBakeE2E) { %>
            "${{ needs.bake-e2e-native.result }}"
<% } %>
          )
          FAILED=0
          for r in "${RESULTS[@]}"; do
            if [ "$r" = "failure" ]; then
              FAILED=1
            fi
          done
          if [ "$FAILED" = "1" ]; then
            echo "::error::One or more nightly hard-failure jobs failed."
            exit 1
          fi
          echo "Nightly gate passed."

      - name: File issue on failure
        if: failure()
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          EXISTING=$(gh issue list \
            --label nightly-regression \
            --state open \
            --limit 1 \
            --json number \
            --repo "$GH_REPO" \
            --jq '.[0].number // empty')
          if [ -z "$EXISTING" ]; then
            gh issue create \
              --title "[nightly] regression detected (${{ github.run_id }})" \
              --body "Nightly workflow failed. Run: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}" \
              --label nightly-regression \
              --repo "$GH_REPO"
          fi
