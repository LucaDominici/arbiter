          CONCLUSION=$(echo "$RUN_INFO" | jq -r '.[0].conclusion // empty')

          if [ -z "$CREATED_AT" ]; then
<% if (locals.pipelineStyle === 'starter' || locals.ciTierMode === 'baseline') { %>
            echo "WARN: weekly workflow not yet present (baseline mode — will enforce when complete)"
            exit 0
<% } else { %>
            echo "::error::No weekly run found. Heartbeat FAIL — weekly workflow has never run."
            exit 1
<% } %>
          fi

          CREATED_EPOCH=$(date -d "$CREATED_AT" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$CREATED_AT" +%s)
          NOW_EPOCH=$(date +%s)
          AGE_DAYS=$(( (NOW_EPOCH - CREATED_EPOCH) / 86400 ))

          echo "Last weekly: $CREATED_AT (${AGE_DAYS}d ago, conclusion: $CONCLUSION)"

          if [ "$AGE_DAYS" -gt 8 ]; then
<% if (locals.pipelineStyle === 'starter' || locals.ciTierMode === 'baseline') { %>
            echo "WARN: weekly ran ${AGE_DAYS}d ago — baseline mode, not enforcing yet"
<% } else { %>
            echo "::error::Weekly workflow last ran ${AGE_DAYS}d ago — exceeds 8-day threshold."
            exit 1
<% } %>
