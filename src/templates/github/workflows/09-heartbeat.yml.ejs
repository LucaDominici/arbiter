name: Heartbeat (T6)

on:
  schedule:
    - cron: '0 6 * * *'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

concurrency:
  group: heartbeat
  cancel-in-progress: true

jobs:
  assert-nightly-freshness:
    name: Assert nightly ran within 26h
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - name: Check nightly workflow freshness
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          RUN_INFO=$(gh run list \
            --workflow=06-nightly.yml \
            --limit 1 \
            --json conclusion,createdAt \
            --repo "$GH_REPO" 2>/dev/null || echo '[]')

          CREATED_AT=$(echo "$RUN_INFO" | jq -r '.[0].createdAt // empty')
          CONCLUSION=$(echo "$RUN_INFO" | jq -r '.[0].conclusion // empty')

          if [ -z "$CREATED_AT" ]; then
<% if (locals.pipelineStyle === 'starter' || locals.ciTierMode === 'baseline') { %>
            echo "WARN: nightly workflow not yet present (baseline mode — will enforce when complete)"
            exit 0
<% } else { %>
            echo "::error::No nightly run found. Heartbeat FAIL — nightly workflow has never run."
            exit 1
<% } %>
          fi

          CREATED_EPOCH=$(date -d "$CREATED_AT" +%s 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "$CREATED_AT" +%s)
          NOW_EPOCH=$(date +%s)
          AGE_HOURS=$(( (NOW_EPOCH - CREATED_EPOCH) / 3600 ))

          echo "Last nightly: $CREATED_AT (${AGE_HOURS}h ago, conclusion: $CONCLUSION)"

          if [ "$AGE_HOURS" -gt 26 ]; then
<% if (locals.pipelineStyle === 'starter' || locals.ciTierMode === 'baseline') { %>
            echo "WARN: nightly ran ${AGE_HOURS}h ago — baseline mode, not enforcing yet"
<% } else { %>
            echo "::error::Nightly workflow last ran ${AGE_HOURS}h ago — exceeds 26h threshold."
            exit 1
<% } %>
          fi

          echo "Nightly freshness OK — last run ${AGE_HOURS}h ago."

      - name: File or close heartbeat issue on failure
        if: failure()
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          EXISTING=$(gh issue list \
            --label heartbeat-nightly-missed \
            --state open \
            --limit 1 \
            --json number \
            --repo "$GH_REPO" \
            --jq '.[0].number // empty')

          if [ -z "$EXISTING" ]; then
            gh issue create \
              --title "[heartbeat] nightly workflow missed" \
              --body "The nightly workflow (06-nightly.yml) has not run within the expected 26h window. Investigate immediately." \
              --label heartbeat-nightly-missed \
              --repo "$GH_REPO"
          else
            echo "Existing heartbeat issue #$EXISTING already open — skipping duplicate."
          fi

  assert-weekly-freshness:
    name: Assert weekly ran within 8 days
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
