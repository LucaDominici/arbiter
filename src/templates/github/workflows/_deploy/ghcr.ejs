      - name: Deploy — GHCR (customize infra/deploy.sh)
        env:
          REGISTRY: ${{ vars.CONTAINER_REGISTRY || 'ghcr.io' }}
          IMAGE_NAME: ${{ vars.IMAGE_NAME || 'app' }}
        run: |
          # IMAGE_TAG is set by caller context (build-and-sign output or RELEASE_TAG)
          RESOLVED_TAG="${IMAGE_TAG:-${REGISTRY}/${IMAGE_NAME}:${RELEASE_TAG}}"
          echo "::notice::Image at ghcr.io — tag=${RESOLVED_TAG}"
          # Customize infra/deploy.sh for your runtime:
          #   k8s:       kubectl set image deployment/app app="${RESOLVED_TAG}"
          #   ECS:       aws ecs update-service --force-new-deployment --cluster CLUSTER --service SERVICE
          #   Cloud Run: gcloud run services update SERVICE --image "${RESOLVED_TAG}"
          if [ -f infra/deploy.sh ]; then
            bash infra/deploy.sh "${RESOLVED_TAG}"
          else
            echo "::notice::infra/deploy.sh not found — skipping platform deploy (SCAFFOLD)"
            echo "Copy infra/deploy.sh.template to infra/deploy.sh and implement your deploy command"
          fi
