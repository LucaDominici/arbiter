name: Monthly (T5b)

on:
  schedule:
    - cron: '0 4 1 * *'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

concurrency:
  group: monthly
  cancel-in-progress: false

jobs:
  monthly:
    name: Monthly jobs
    uses: ./.github/workflows/_monthly.yml
    permissions:
      contents: read
      issues: write
    secrets: inherit
