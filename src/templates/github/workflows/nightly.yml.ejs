name: Nightly Deep Validation

on:
  schedule:
    - cron: '0 2 * * *'
  workflow_dispatch:

jobs:
<% if (language === 'typescript') { %>
  mutation:
    name: Mutation Testing (Stryker)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npx stryker run
<% } %><% if (language === 'java') { %>
  mutation:
    name: Mutation Testing (pitest)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
      - run: ./gradlew pitest
<% } else { %>      - run: mvn org.pitest:pitest-maven:mutationCoverage
<% } %><% } %><% if (language === 'rust') { %>
  mutation:
    name: Mutation Testing (cargo-mutants)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - run: cargo install cargo-mutants
      - run: cargo mutants --config cargo-mutants.toml
<% } %><% if (language === 'python') { %>
  mutation:
    name: Mutation Testing (mutmut)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]" mutmut
      - run: mutmut run
      - run: python scripts/parse-mutmut.py --threshold 85
<% } %>
  e2e-full:
    name: E2E Full Suite
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npx playwright install --with-deps
      - run: npx playwright test
<% } %><% if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
      - run: ./gradlew integrationTest -Dtest.suite=full
<% } else { %>      - run: mvn verify -Pintegration-full
<% } %><% } %><% if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - run: cargo test --test '*' -- --include-ignored
<% } %><% if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
      - run: pytest tests/e2e/ -v
<% } %><% if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
      - run: go test -tags=integration ./... -v
<% } %>

  security-deep:
    name: Security Deep Scan (Trivy)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - name: Run Trivy filesystem scan
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: 'fs'
          scan-ref: '.'
          severity: 'CRITICAL,HIGH'
          exit-code: '1'
      - name: Run Trivy config scan
        uses: aquasecurity/trivy-action@master
        with:
          scan-type: 'config'
          scan-ref: '.'
          exit-code: '1'

  load-test:
    name: Load Test (k6)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - name: Install k6
        run: |
          curl -L https://github.com/grafana/k6/releases/download/v0.54.0/k6-v0.54.0-linux-amd64.tar.gz | tar xz
          sudo mv k6-v0.54.0-linux-amd64/k6 /usr/local/bin/
      - name: Run load test
        run: k6 run <%= k6ScriptPath || 'tests/load/default.js' %>

  evidence-collect:
    name: Collect Evidence
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [e2e-full, security-deep, load-test<% if (language !== 'go') { %>, mutation<% } %>]
    if: always()
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
<% } %><% if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% } %><% if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
<% } %><% if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
<% } %>
      - name: Collect evidence
        run: node scripts/evidence-collect.mjs
        env:
          NIGHTLY_JOB_STATUS: ${{ needs.e2e-full.result }}
      - uses: actions/upload-artifact@v4
        with:
          name: evidence-${{ github.run_id }}
          path: .evidence/
          retention-days: 30
