<%
const _cm = (typeof collaborationMode !== 'undefined' ? collaborationMode : 'gated-review');
const _runner = (_cm === 'gated-review' && isL3Plus)
  ? "${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}"
  : "${{ fromJSON(vars.RUNNER_LABELS_TEST || '[\"ubuntu-latest\"]') }}";
%>name: OSSF Scorecard

on:
  push:
    branches: [main]
  schedule:
    - cron: '0 5 * * 1'
  workflow_dispatch:

permissions:
  contents: read
  security-events: write
  actions: read
  id-token: write

concurrency:
  group: scorecard
  cancel-in-progress: false

jobs:
  analyze:
    name: Scorecard analysis
    runs-on: <%- _runner %>
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Run OSSF Scorecard
        uses: ossf/scorecard-action@ff5dd8929f96a8a4dc67d13f32b8c75057829621 # v2.4.0
        with:
          results_file: scorecard-results.sarif
          results_format: sarif
          publish_results: false

      - name: Upload Scorecard results to code-scanning
        uses: github/codeql-action/upload-sarif@4f3212b61783c3c68e8309a0f18a699764811cda # v3.28.8
        with:
          sarif_file: scorecard-results.sarif
          category: ossf-scorecard
