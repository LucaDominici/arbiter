name: Mutation Testing — Scheduled (T5)

on:
  schedule:
    - cron: '0 3 * * 1'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: mutation-scheduled
  cancel-in-progress: true

jobs:
<% if (locals.language === 'java' || locals.language === 'multi') { %>
  java-mutation:
    name: PITest mutation run
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
<% if (locals.buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@v4
      - name: PITest mutation (full suite)
        run: ./gradlew pitest
<% } else { %>
      - name: PITest mutation (full suite)
        run: mvn test-compile org.pitest:pitest-maven:mutationCoverage
<% } %>
<% } %>
<% if (locals.language === 'typescript' || locals.language === 'multi') { %>
  typescript-mutation:
    name: Stryker mutation run
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci
      - name: Stryker mutation (full suite)
        run: npx stryker run
<% } %>
