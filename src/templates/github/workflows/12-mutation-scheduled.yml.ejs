name: Mutation Testing — Scheduled (T5)

on:
  schedule:
    - cron: '0 3 * * 1'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: mutation-scheduled
  # Audit run: a cancelled mutation run silently loses its required result (a false-green).
  cancel-in-progress: false

jobs:
<% if (locals.language === 'java' || locals.language === 'multi') { %>
  java-mutation:
    name: PITest mutation run
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-java@03ad4de0992f5dab5e18fcb136590ce7c4a0ac95  # v5.6.0
        with:
          distribution: temurin
          java-version: '21'
<% if (locals.buildTool === 'gradle') { %>
      - uses: gradle/actions/setup-gradle@ed408507eac070d1f99cc633dbcf757c94c7933a  # v4
      - name: PITest mutation (full suite)
        run: ./gradlew pitest
<% } else { %>
      - name: PITest mutation (full suite)
        run: mvn test-compile org.pitest:pitest-maven:mutationCoverage
<% } %>
<% } %>
<% if (locals.language === 'typescript' || locals.language === 'multi') { %>
  typescript-mutation:
    name: Stryker mutation run
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: ./.github/actions/setup-node-pnpm
      - name: Stryker mutation (full suite)
        run: npx stryker run
<% } %>
<% if (locals.language === 'rust') { %>
  rust-mutation:
    name: cargo-mutants mutation run
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8  # stable
      - name: cargo-mutants (full suite)
        run: |
          cargo install cargo-mutants --locked
          cargo mutants --all-features
<% } %>
<% if (locals.language === 'python') { %>
  python-mutation:
    name: mutmut mutation run
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97  # v7.0.0
        with:
          python-version-file: .python-version
      - name: mutmut (full suite)
        run: |
          pip install -e ".[dev]" mutmut
          mutmut run
          mutmut results
<% } %>
<% if (locals.language === 'go') { %>
  go-mutation:
    name: go-mutesting mutation run
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e  # v7.0.0
        with:
          go-version-file: go.mod
      - name: go-mutesting (full suite)
        run: |
          go install github.com/zimmski/go-mutesting/cmd/go-mutesting@latest
          go-mutesting ./...
<% } %>
<%
  // Any language without a wired mutation tool above (kept in sync with
  // src/generators/mutation.ts's supported set). Emits a valid no-op job
  // rather than an empty `jobs:` map, which GitHub Actions rejects outright.
  const MUTATION_SUPPORTED_LANGUAGES = ['java', 'typescript', 'rust', 'python', 'go', 'multi']
%>
<% if (!MUTATION_SUPPORTED_LANGUAGES.includes(locals.language)) { %>
  mutation-unsupported:
    name: Mutation testing not available for this stack
    runs-on: ubuntu-latest
    steps:
      - name: No mutation-testing tool wired for <%= locals.language %>
        run: echo "arbiter does not yet wire mutation testing for '<%= locals.language %>'"
<% } %>
