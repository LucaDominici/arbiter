name: CI

on:
  push:
    branches: [main, "task/**"]
  pull_request:
    branches: [main]

jobs:
<% if (language === 'typescript') { %>
  lint-and-test:
    name: Lint + Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npm run typecheck
      - run: npm run lint
      - run: npm test -- --coverage
<% } %><% if (language === 'rust') { %>
  lint-and-test:
    name: Lint + Test (Rust)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt
      - uses: Swatinem/rust-cache@v2
      - run: cargo fmt --check
      - run: cargo clippy -- -D warnings
      - run: cargo test
<% } %><% if (language === 'java') { %>
  lint-and-test:
    name: Lint + Test (Java)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
      - uses: gradle/actions/setup-gradle@v3
      - run: ./gradlew checkstyleMain
      - run: ./gradlew test
<% } %>

  ci-required:
    name: CI Required
    runs-on: ubuntu-latest
    needs: [lint-and-test]
    if: always()
    steps:
      - run: |
          if [[ "${{ needs.lint-and-test.result }}" != "success" ]]; then
            echo "CI failed"
            exit 1
          fi
