<% const _lanes = Array.isArray(lanes) ? lanes : []; const _multiLane = _lanes.length >= 2; %>name: CI

on:
  push:
    branches: [main, "task/**"]
  pull_request:
    branches: [main]

jobs:
<% if (enableSecurityScanning) { %>
  security-early-fail:
    name: Security (PII + Secrets)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: PII scan (INV-12, HARD)
        run: node scripts/pii-scan.mjs
      - name: Install gitleaks
        run: |
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.27.2/gitleaks_8.27.2_linux_x64.tar.gz | tar -xz -C /usr/local/bin gitleaks
      - name: Gitleaks secrets scan (INV-11)
        run: |
          gitleaks detect --source . --config .gitleaks.toml \
            --gitleaks-ignore-path suppressions/.gitleaksignore \
            --exit-code 1 --redact
<% } %>
<% if (governanceLevel !== 'L1' || _multiLane) { %>
  classify-changes:
    name: Classify Changes
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    outputs:
      docs_only: ${{ steps.classify.outputs.docs_only }}
      backend_changed: ${{ steps.classify.outputs.backend_changed }}
      frontend_changed: ${{ steps.classify.outputs.frontend_changed }}
      infra_changed: ${{ steps.classify.outputs.infra_changed }}
      high_risk: ${{ steps.classify.outputs.high_risk }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - id: classify
        run: node scripts/ci-classify-changes.mjs
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha || 'origin/main' }}
          HEAD_SHA: ${{ github.sha }}
<% } %>
<% if (_multiLane) { %>
  cross-stack-guard:
    name: Cross-Stack Guard
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [classify-changes]
    if: github.event_name == 'pull_request'
    permissions:
      pull-requests: write
    steps:
<% if (governanceLevel === 'L3') { %>
      - name: Enforce cross-stack split
        if: needs.classify-changes.outputs.backend_changed == 'true' && needs.classify-changes.outputs.frontend_changed == 'true'
        run: |
          echo "::error::This PR touches both frontend and backend lanes. Split into separate PRs."
          exit 1
<% } else { %>
      - name: Warn cross-stack changes
        if: needs.classify-changes.outputs.backend_changed == 'true' && needs.classify-changes.outputs.frontend_changed == 'true'
        continue-on-error: true
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: '> [!WARNING]\n> This PR touches both **frontend** and **backend** lanes. Consider splitting into separate PRs for cleaner review and safer deployment.'
            })
<% } %>
<% } %>
<% if (language === 'typescript') { %>
  lint-and-test:
    name: Lint + Test
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
<% { const _n=[]; if(enableSecurityScanning) _n.push('security-early-fail'); if(governanceLevel !== 'L1' || _multiLane) _n.push('classify-changes'); if(_n.length){ %>    needs: [<%= _n.join(', ') %>]
<% } if(governanceLevel !== 'L1' || _multiLane){ %>    if: needs.classify-changes.outputs.docs_only != 'true'
<% } } %>    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npm run typecheck
      - run: npm run lint
      - run: npm test -- --coverage<% if (enableDebtGates) { %> --reporter=junit --outputFile=test-results/junit.xml<% } %>
<% if (enableSecurityScanning) { %>
      - name: Dep audit (INV-13)
        run: npm audit --audit-level=high
<% } %>
<% if (enableDebtGates) { %>
      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results-${{ github.run_id }}
          path: test-results/
          retention-days: 7
<% } %>
<% } %><% if (language === 'rust') { %>
  lint-and-test:
    name: Lint + Test (Rust)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
<% { const _n=[]; if(enableSecurityScanning) _n.push('security-early-fail'); if(governanceLevel !== 'L1' || _multiLane) _n.push('classify-changes'); if(_n.length){ %>    needs: [<%= _n.join(', ') %>]
<% } if(governanceLevel !== 'L1' || _multiLane){ %>    if: needs.classify-changes.outputs.docs_only != 'true'
<% } } %>    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt
      - uses: Swatinem/rust-cache@v2
      - run: cargo fmt --check
      - run: cargo clippy -- -D warnings
      - run: cargo test
<% if (enableSecurityScanning) { %>
      - name: Dep audit (INV-13)
        uses: rustsec/audit-check@v1
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
<% } %>
<% } %><% if (language === 'java') { %>
  lint-and-test:
    name: Lint + Test (Java)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
<% { const _n=[]; if(enableSecurityScanning) _n.push('security-early-fail'); if(governanceLevel !== 'L1' || _multiLane) _n.push('classify-changes'); if(_n.length){ %>    needs: [<%= _n.join(', ') %>]
<% } if(governanceLevel !== 'L1' || _multiLane){ %>    if: needs.classify-changes.outputs.docs_only != 'true'
<% } } %>    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
      - run: ./gradlew checkstyleMain
      - run: ./gradlew test
<% if (enableSecurityScanning) { %>
      - name: Dep audit OWASP DC (INV-13)
        run: ./gradlew dependencyCheckAnalyze
<% } %>
<% if (enableDebtGates) { %>
      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results-${{ github.run_id }}
          path: build/test-results/
          retention-days: 7
<% } %>
<% } else { %>      - run: mvn checkstyle:check
      - run: mvn test
<% if (enableSecurityScanning) { %>
      - name: Dep audit OWASP DC (INV-13)
        run: mvn org.owasp:dependency-check-maven:check
<% } %>
<% if (enableDebtGates) { %>
      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results-${{ github.run_id }}
          path: target/surefire-reports/
          retention-days: 7
<% } %>
<% } %><% } %><% if (language === 'go') { %>
  lint-and-test:
    name: Lint + Test (Go)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
<% { const _n=[]; if(enableSecurityScanning) _n.push('security-early-fail'); if(governanceLevel !== 'L1' || _multiLane) _n.push('classify-changes'); if(_n.length){ %>    needs: [<%= _n.join(', ') %>]
<% } if(governanceLevel !== 'L1' || _multiLane){ %>    if: needs.classify-changes.outputs.docs_only != 'true'
<% } } %>    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
      - run: go vet ./...
      - run: golangci-lint run
      - run: go test ./... -race -coverprofile=coverage.out
<% if (enableSecurityScanning) { %>
      - name: Dep audit govulncheck (INV-13)
        uses: golang/govulncheck-action@v1
<% } %>
<% } %><% if (language === 'python') { %>
  lint-and-test:
    name: Lint + Test (Python)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
<% { const _n=[]; if(enableSecurityScanning) _n.push('security-early-fail'); if(governanceLevel !== 'L1' || _multiLane) _n.push('classify-changes'); if(_n.length){ %>    needs: [<%= _n.join(', ') %>]
<% } if(governanceLevel !== 'L1' || _multiLane){ %>    if: needs.classify-changes.outputs.docs_only != 'true'
<% } } %>    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
      - run: ruff check .
      - run: ruff format --check .
      - run: pytest --cov --junitxml=test-results/junit.xml
<% if (enableSecurityScanning) { %>
      - name: Dep audit (INV-13)
        run: pip-audit
<% } %>
<% if (enableDebtGates) { %>
      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results-${{ github.run_id }}
          path: test-results/
          retention-days: 7
<% } %>
<% } %>

<% if (governanceLevel !== 'L1') { %>
  docs-check:
    name: Docs Check
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    if: github.event_name == 'pull_request'
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Check docs updated with code changes
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          CHANGED=$(git diff --name-only "$BASE_SHA" "$HEAD_SHA")

          HAS_CODE=$(echo "$CHANGED" | grep -E '^(src/|__tests__/)' || true)
          HAS_DOCS=$(echo "$CHANGED" | grep -E '^(docs/|README\.md)' || true)

          if [ -n "$HAS_CODE" ] && [ -z "$HAS_DOCS" ]; then
            echo "::error::Code changed without documentation update"
            echo ""
            echo "Files changed in src/ or __tests__/:"
            echo "$HAS_CODE"
            echo ""
            echo "Please update docs/ or README.md to explain the change."
            exit 1
          fi
          echo "Docs check passed."
<% } %>

<% if (enableDebtGates) { %>
<% const threshold = governanceLevel === 'L3' ? 85 : 80; %>
  debt-gates:
    name: Tech Debt Gates
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [lint-and-test]
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npx vitest run --coverage --coverage.thresholds.lines=<%= threshold %>
      - run: npx knip
      - run: npx madge --circular src
<% } %><% if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy
      - uses: Swatinem/rust-cache@v2
      - run: cargo install cargo-tarpaulin
      - run: cargo tarpaulin --fail-under <%= threshold %> --out Html --out Xml --out Lcov --output-dir coverage/
      - run: cargo clippy -- -W clippy::pedantic -D warnings
<% } %><% if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
      - run: ./gradlew jacocoTestCoverageVerification
      - run: ./gradlew pmdMain
      - run: ./gradlew spotbugsMain
      - name: Copy JaCoCo reports to coverage/
        if: always()
        run: |
          mkdir -p coverage
          cp -r build/coverage/html/. coverage/ 2>/dev/null || true
          cp build/coverage/coverage.xml coverage/coverage.xml 2>/dev/null || true
<% } else { %>      - run: mvn verify -Pjacoco
      - run: mvn pmd:check
      - run: mvn spotbugs:check
      - name: Copy JaCoCo reports to coverage/
        if: always()
        run: |
          mkdir -p coverage
          cp -r target/coverage/. coverage/ 2>/dev/null || true
<% } %><% } %><% if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
      - run: go test -coverprofile=coverage.out -covermode=atomic ./...
      - name: Check coverage threshold
        run: |
          PCT=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | tr -d '%')
          if (( $(echo "$PCT < <%= threshold %>" | bc -l) )); then
            echo "Coverage ${PCT}% is below <%= threshold %>%"
            exit 1
          fi
          echo "Coverage ${PCT}% >= <%= threshold %>%"
      - name: Generate HTML coverage report
        run: |
          mkdir -p coverage
          go tool cover -html=coverage.out -o coverage/coverage.html
      - run: golangci-lint run --enable gocyclo,gocognit,deadcode,unused
<% } %><% if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
      - run: pytest --cov --cov-fail-under=<%= threshold %> --cov-report=html:coverage/html --cov-report=xml:coverage/coverage.xml
      - run: ruff check --select C901,PLR0911,PLR0912,PLR0913,PLR0915 .
      - run: ruff check --select F401,F811 .
<% } %>
      - name: Upload coverage reports
        uses: actions/upload-artifact@v4
        if: always()
        with:
          name: coverage-${{ github.run_id }}
          path: coverage/
          retention-days: 30
<% } %>

<% if (enableDebtGates) { %>
  debt-ratchet:
    name: Debt Ratchet
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [lint-and-test]
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
<% } %><% if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
<% } %><% if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
<% } %><% } %><% if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
<% } %><% if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
<% } %>
      - name: Run debt ratchet
        run: node scripts/debt-report.mjs<% if (governanceLevel === 'L3') { %> --require-improvement<% } else { %> --gate<% } %>
<% } %>
<% if (contractType && contractType !== 'none' && governanceLevel !== 'L1') { %>

  contract-verify:
    name: Contract Verify
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [lint-and-test]
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
<% if (contractType === 'rest-owned' || contractType === 'rest-public') { %>
      - name: Run Pact contract tests
        if: vars.PACT_BROKER_BASE_URL != ''
        run: npx pact-broker can-i-deploy --pacticipant <%= projectName %> --latest
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } else if (contractType === 'graphql') { %>
      - name: Run GraphQL schema contract tests
        run: npx graphql-inspector diff schema.graphql
<% } else if (contractType === 'grpc') { %>
      - name: Run gRPC contract tests
        run: npx buf breaking --against .git#branch=main
<% } else if (contractType === 'message-queue') { %>
      - name: Run Pact messaging contract tests
        if: vars.PACT_BROKER_BASE_URL != ''
        run: npx pact-broker can-i-deploy --pacticipant <%= projectName %> --latest
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } %>
<% } else if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
<% } %>
<% if (contractType === 'rest-owned' || contractType === 'rest-public' || contractType === 'message-queue') { %>
      - name: Run Pact contract tests
        if: vars.PACT_BROKER_BASE_URL != ''
        run: <%= buildTool === 'gradle' ? './gradlew pactPublish pactVerify' : 'mvn pact:publish pact:verify' %>
        env:
          PACT_BROKER_BASE_URL: ${{ vars.PACT_BROKER_BASE_URL }}
          PACT_BROKER_TOKEN: ${{ secrets.PACT_BROKER_TOKEN }}
<% } else if (contractType === 'graphql') { %>
      - name: Run GraphQL contract tests
        run: <%= buildTool === 'gradle' ? './gradlew test --tests *.graphql.*' : 'mvn test -Dtest=*GraphQL*' %>
<% } else if (contractType === 'grpc') { %>
      - name: Run gRPC contract tests
        run: <%= buildTool === 'gradle' ? './gradlew test --tests *.grpc.*' : 'mvn test -Dtest=*Grpc*' %>
<% } %>
<% } else if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Run contract tests
        run: cargo test --test '*contract*'
<% } else if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
      - name: Run contract tests
        run: go test -tags contract -run Contract ./...
<% } else if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
      - name: Run contract tests
        run: pytest tests/contract/
<% } %>
<% } %>

  ci-required:
    name: CI Required
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [lint-and-test<% if (enableSecurityScanning) { %>, security-early-fail<% } %><% if (governanceLevel !== 'L1') { %>, docs-check<% } %><% if (enableDebtGates) { %>, debt-gates, debt-ratchet<% } %><% if (contractType && contractType !== 'none' && governanceLevel !== 'L1') { %>, contract-verify<% } %><% if (governanceLevel !== 'L1' || _multiLane) { %>, classify-changes<% } %><% if (_multiLane) { %>, cross-stack-guard<% } %>]
    if: always()
    steps:
      - run: |
          if [[ "${{ needs.lint-and-test.result }}" != "success" ]]; then
            echo "lint-and-test failed"
            exit 1
          fi<% if (enableSecurityScanning) { %>
          if [[ "${{ needs.security-early-fail.result }}" != "success" ]]; then
            echo "security-early-fail failed"
            exit 1
          fi<% } %><% if (governanceLevel !== 'L1') { %>
          if [[ "${{ needs.docs-check.result }}" == "failure" ]]; then
            echo "docs-check failed"
            exit 1
          fi<% } %><% if (enableDebtGates) { %>
          if [[ "${{ needs.debt-gates.result }}" != "success" ]]; then
            echo "debt-gates failed"
            exit 1
          fi
          if [[ "${{ needs.debt-ratchet.result }}" != "success" ]]; then
            echo "debt-ratchet failed"
            exit 1
          fi<% } %><% if (contractType && contractType !== 'none' && governanceLevel !== 'L1') { %>
          if [[ "${{ needs.contract-verify.result }}" != "success" ]]; then
            echo "contract-verify failed"
            exit 1
          fi<% } %><% if (_multiLane) { %>
          if [[ "${{ needs.cross-stack-guard.result }}" == "failure" ]]; then
            echo "cross-stack-guard failed"
            exit 1
          fi<% } %>
