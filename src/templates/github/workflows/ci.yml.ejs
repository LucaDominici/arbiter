name: CI

on:
  push:
    branches: [main, "task/**"]
  pull_request:
    branches: [main]

jobs:
<% if (language === 'typescript') { %>
  lint-and-test:
    name: Lint + Test
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npm run typecheck
      - run: npm run lint
      - run: npm test -- --coverage
<% } %><% if (language === 'rust') { %>
  lint-and-test:
    name: Lint + Test (Rust)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy, rustfmt
      - uses: Swatinem/rust-cache@v2
      - run: cargo fmt --check
      - run: cargo clippy -- -D warnings
      - run: cargo test
<% } %><% if (language === 'java') { %>
  lint-and-test:
    name: Lint + Test (Java)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
      - run: ./gradlew checkstyleMain
      - run: ./gradlew test
<% } else { %>      - run: mvn checkstyle:check
      - run: mvn test
<% } %><% } %><% if (language === 'go') { %>
  lint-and-test:
    name: Lint + Test (Go)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
      - run: go vet ./...
      - run: golangci-lint run
      - run: go test ./... -race -coverprofile=coverage.out
<% } %><% if (language === 'python') { %>
  lint-and-test:
    name: Lint + Test (Python)
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
      - run: ruff check .
      - run: ruff format --check .
      - run: pytest --cov
<% } %>

<% if (governanceLevel !== 'L1') { %>
  docs-check:
    name: Docs Check
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    if: github.event_name == 'pull_request'
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: Check docs updated with code changes
        env:
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          CHANGED=$(git diff --name-only "$BASE_SHA" "$HEAD_SHA")

          HAS_CODE=$(echo "$CHANGED" | grep -E '^(src/|__tests__/)' || true)
          HAS_DOCS=$(echo "$CHANGED" | grep -E '^(docs/|README\.md)' || true)

          if [ -n "$HAS_CODE" ] && [ -z "$HAS_DOCS" ]; then
            echo "::error::Code changed without documentation update"
            echo ""
            echo "Files changed in src/ or __tests__/:"
            echo "$HAS_CODE"
            echo ""
            echo "Please update docs/ or README.md to explain the change."
            exit 1
          fi
          echo "Docs check passed."
<% } %>

<% if (enableDebtGates) { %>
<% const threshold = governanceLevel === 'L3' ? 85 : 80; %>
  debt-gates:
    name: Tech Debt Gates
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [lint-and-test]
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npx vitest run --coverage --coverage.thresholds.lines=<%= threshold %>
      - run: npx knip
      - run: npx madge --circular src
<% } %><% if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy
      - uses: Swatinem/rust-cache@v2
      - run: cargo install cargo-tarpaulin
      - run: cargo tarpaulin --fail-under <%= threshold %>
      - run: cargo clippy -- -W clippy::pedantic -D warnings
<% } %><% if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
      - run: ./gradlew jacocoTestCoverageVerification
      - run: ./gradlew pmdMain
<% } else { %>      - run: mvn verify -Pjacoco
      - run: mvn pmd:check
<% } %><% } %><% if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
      - run: go test -coverprofile=coverage.out -covermode=atomic ./...
      - name: Check coverage threshold
        run: |
          PCT=$(go tool cover -func=coverage.out | grep total | awk '{print $3}' | tr -d '%')
          if (( $(echo "$PCT < <%= threshold %>" | bc -l) )); then
            echo "Coverage ${PCT}% is below <%= threshold %>%"
            exit 1
          fi
          echo "Coverage ${PCT}% >= <%= threshold %>%"
      - run: golangci-lint run --enable gocyclo,gocognit,deadcode,unused
<% } %><% if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
      - run: pytest --cov --cov-fail-under=<%= threshold %>
      - run: ruff check --select C901,PLR0911,PLR0912,PLR0913,PLR0915 .
      - run: ruff check --select F401,F811 .
<% } %>
<% } %>

<% if (enableDebtGates) { %>
  debt-ratchet:
    name: Debt Ratchet
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [lint-and-test]
    steps:
      - uses: actions/checkout@v4
<% if (language === 'typescript') { %>
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
<% } %><% if (language === 'rust') { %>
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
<% } %><% if (language === 'java') { %>
      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'
<% if (buildTool === 'gradle') { %>      - uses: gradle/actions/setup-gradle@v3
<% } %><% } %><% if (language === 'go') { %>
      - uses: actions/setup-go@v5
        with:
          go-version-file: 'go.mod'
<% } %><% if (language === 'python') { %>
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: pip install -e ".[dev]"
<% } %>
      - name: Run debt ratchet
        run: node scripts/debt-report.mjs<% if (governanceLevel === 'L3') { %> --require-improvement<% } else { %> --gate<% } %>
<% } %>

  ci-required:
    name: CI Required
    runs-on: ${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}
    needs: [lint-and-test<% if (governanceLevel !== 'L1') { %>, docs-check<% } %><% if (enableDebtGates) { %>, debt-gates, debt-ratchet<% } %>]
    if: always()
    steps:
      - run: |
          if [[ "${{ needs.lint-and-test.result }}" != "success" ]]; then
            echo "lint-and-test failed"
            exit 1
          fi<% if (governanceLevel !== 'L1') { %>
          if [[ "${{ needs.docs-check.result }}" == "failure" ]]; then
            echo "docs-check failed"
            exit 1
          fi<% } %><% if (enableDebtGates) { %>
          if [[ "${{ needs.debt-gates.result }}" != "success" ]]; then
            echo "debt-gates failed"
            exit 1
          fi
          if [[ "${{ needs.debt-ratchet.result }}" != "success" ]]; then
            echo "debt-ratchet failed"
            exit 1
          fi<% } %>
