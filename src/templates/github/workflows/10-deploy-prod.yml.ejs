# 10-deploy-prod.yml — generated by arbiter — Deploy to PROD via GitHub Environment gate
# Trigger: release published
# Status: SCAFFOLD — environment 'production' not configured by default.
#   Workflow triggers on release:published but immediately enters
#   "Waiting for review" indefinitely until the GitHub Environment is configured.
#
# Security:
#   PROD deploy gated by GitHub Environment 'production' required-reviewer (FREE feature).
#   NOT gated by a bypassable vars flag — environment gate is the only control.
#
# Timeout: 43200 min = 30 days waiting for approval (H2-S5).
# Activation checklist: docs/ci/gate-tier-policy.md#prod-deploy-activation
#
# Ref: docs/SYSTEM/CI-TIER-MODEL.md §2 (slot 10, deploy-prod)

name: Deploy Prod

on:
  release:
    types: [published]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read
  id-token: write
  packages: write
  issues: write

jobs:
  # === GROUP: gate + deploy ===

  deploy-prod:
    name: Deploy to PROD (environment-gated)
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_DEPLOY || '["ubuntu-latest"]') }}
    timeout-minutes: 43200
    environment:
      name: production
      url: ${{ vars.PROD_URL || 'https://example.com' }}
    # NOTE: When environment 'production' is not configured in Settings → Environments,
    # this job enters "Waiting for review" indefinitely — no bypass, no auto-approve.
    steps:
      - name: Checkout
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683  # v4

      - name: Guard — SCAFFOLD activation checklist
        run: |
          echo "=== PROD Deploy SCAFFOLD — Activation Guard ==="
          echo "Reviewer approved. Verifying activation prerequisites..."
          echo ""
          echo "Activation checklist (docs/ci/gate-tier-policy.md#prod-deploy-activation):"
          echo "  1. PROD registry credentials configured in environment 'production'"
          echo "  2. PROD deployment target provisioned (cluster, container app, etc.)"
          echo "  3. Required reviewer assigned in GitHub Environments settings"
          echo "  4. PROD_BASE_URL secret set for smoke test"
          echo "  5. Environment 'production' configured in GitHub repo Settings"
          if [ "${SCAFFOLD_DRY_RUN:-false}" = "true" ]; then
            echo "DRY-RUN mode (SCAFFOLD_DRY_RUN=true). Skipping actual deploy."
            exit 0
          fi

      - name: Resolve release tag
        run: echo "RELEASE_TAG=${{ github.event.release.tag_name }}" >> "$GITHUB_ENV"

<%
// RT-2: coalesce undefined (absent from legacy configs) to 'none' before comparison
// RT-7: whitelist — prevent path traversal if deployTarget is hand-edited
const _dt = ({
  'ghcr': 'ghcr',
  'azure-container-app': 'azure-container-app',
  'aws-ecs': 'aws-ecs',
  'gcp-cloud-run': 'gcp-cloud-run'
})[typeof deployTarget !== 'undefined' ? deployTarget : 'none'] ?? 'none';
%>
<% if (_dt !== 'none') { %>
<%- include('_partials/sigstore-preflight.ejs') %>
<%- include('_cosign-copy/' + _dt + '.ejs') %>
<%- include('_deploy/' + _dt + '.ejs') %>
<% } %>

      # === GROUP: smoke ===

      - name: PROD smoke — k6 LT1 (scaffold)
        run: |
          PROD_URL="${{ secrets.PROD_BASE_URL }}"
          if [ -z "${PROD_URL}" ]; then
            echo "::warning::PROD_BASE_URL not set — skip smoke (SCAFFOLD)"
            exit 0
          fi
          k6 run tests/load/smoke.js \
            --env BASE_URL="${PROD_URL}" \
            --env VUS=1 \
            --env DURATION=30s

  # === GROUP: notify ===

  notify-failure:
    name: Notify PROD deploy failure
    needs: [deploy-prod]
    if: failure()
    uses: ./.github/workflows/_notify.yml
    permissions:
      contents: read
      issues: write
    with:
      workflow_name: "Deploy to PROD"
      area: "deploy"
      severity: "P0"
      branch: ${{ github.ref_name }}
      run_url: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
      failure_summary: "PROD deploy failed for release ${{ github.ref_name }}"
      status: "failure"
