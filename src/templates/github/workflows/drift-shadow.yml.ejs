name: Drift Shadow (INV-59)

on:
  schedule:
    - cron: '0 3 * * *'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  drift-check:
    name: Gate Result Drift Check
    runs-on: ${{ fromJSON(vars.RUNNER_LABELS_TEST || '["ubuntu-latest"]') }}
    # Job-level permissions REPLACE workflow-level (GitHub never merges them):
    # contents: read must be restated here or the checkout below runs with
    # contents: none and fails "Repository not found" on a private repo (#1865).
    permissions:
      contents: read
      issues: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
      - uses: ./.github/actions/setup-node-pnpm
      - name: Emit local L1 gate result
        run: node scripts/check-all.mjs L1 --json .arbiter/gate/local-result.json
      - name: Compare local vs CI parity hash
        id: parity
        run: node scripts/check-local-ci-parity.mjs
        continue-on-error: true
      - name: Open drift issue if mismatch
        if: steps.parity.outcome == 'failure'
        uses: actions/github-script@f28e40c7f34bde8b3046d885e986cb6290c5673b  # v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const title = 'INV-59 drift detected — local/CI gate parity mismatch';
            const { data: issues } = await github.rest.issues.listForRepo({
              owner: context.repo.owner,
              repo: context.repo.repo,
              state: 'open',
              labels: 'inv-59-drift',
            });
            if (issues.length === 0) {
              await github.rest.issues.create({
                owner: context.repo.owner,
                repo: context.repo.repo,
                title,
                body: `Nightly drift shadow detected a parity mismatch between local and CI gate results.\n\nSee the [workflow run](${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}) for details.\n\nResolve before enabling or continuing solo-dev mode (INV-59, #470).`,
                labels: ['inv-59-drift'],
              });
            }
