<%
const _cm = (typeof collaborationMode !== 'undefined' ? collaborationMode : 'peer-review');
const _runner = (_cm === 'gated-review' && (governanceLevel === 'L3' || governanceLevel === 'L4'))
  ? "${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}"
  : "${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}";
%>name: Frontend Quality (T1)

on:
  pull_request:
    branches: [main]
    paths:
      - 'src/**'
      - 'public/**'
      - '*.html'
      - '*.css'
      - 'package.json'

permissions:
  contents: read

concurrency:
  group: frontend-quality-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

jobs:
  lighthouse:
    name: Lighthouse CI
    runs-on: <%- _runner %>
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version-file: .nvmrc
          cache: npm

      - run: npm ci

      - name: Build
        run: npm run build

      - name: Lighthouse CI (lhci)
        uses: treosh/lighthouse-ci-action@1b2e9e309eb8f43e89dc9f6ee37ab38f449e47ef # v12.1.0
        with:
          configPath: '.lighthouserc.json'
          uploadArtifacts: true
          temporaryPublicStorage: false

  axe-accessibility:
    name: axe accessibility
    runs-on: <%- _runner %>
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version-file: .nvmrc
          cache: npm

      - run: npm ci

      - name: Build
        run: npm run build

      - name: axe accessibility scan
        run: npx axe-core-npm/cli --exit http://localhost:3000 || true
