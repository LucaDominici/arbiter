<%
const _cm = (typeof collaborationMode !== 'undefined' ? collaborationMode : 'peer-review');
const _runner = (_cm === 'gated-review' && (governanceLevel === 'L3' || governanceLevel === 'L4'))
  ? "${{ vars.CI_BUILD_RUNNER_LABEL || 'docker-ci-build' }}"
  : "${{ vars.CI_BUILD_RUNNER_LABEL || 'ubuntu-latest' }}";
%>name: Frontend Quality (T1)

on:
  pull_request:
    branches: [main]
    paths:
      - 'src/**'
      - 'public/**'
      - '*.html'
      - '*.css'
      - 'package.json'

permissions:
  contents: read

concurrency:
  group: frontend-quality-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

jobs:
  lighthouse:
    name: Lighthouse CI
    runs-on: <%- _runner %>
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version-file: .nvmrc
          cache: npm

      - run: npm ci

      - name: Build
        run: npm run build

      - name: Lighthouse CI (lhci)
        uses: treosh/lighthouse-ci-action@1b2e9e309eb8f43e89dc9f6ee37ab38f449e47ef # v12.1.0
        with:
          configPath: '.lighthouserc.json'
          uploadArtifacts: true
          temporaryPublicStorage: false

  axe-accessibility:
    name: axe accessibility (WCAG 2.2, INV-61)
    runs-on: <%- _runner %>
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version-file: .nvmrc
          cache: npm

      - run: npm ci

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Build
        run: npm run build

      - name: axe accessibility (Playwright E2E, WCAG 2.2 AA, INV-61)
        # Routes through the Playwright a11y spec which uses the generated
        # run-axe.ts wrapper with wcag2a+wcag2aa+wcag21a+wcag21aa+wcag22aa tags.
        # ephemeral-server starts the app, polls port readiness, runs spec, tears down.
        # Hard gate: a11y failures block the PR (INV-61). No soft-fail permitted.
        run: |
          node scripts/lib/ephemeral-server.mjs \
            --start "${E2E_START_CMD:-npm run start:test}" \
            --test "npx playwright test tests/e2e/a11y.spec.ts" \
            --port "${E2E_PORT:-4173}"
        env:
          E2E_BASE_URL: "http://localhost:${{ vars.E2E_PORT || '4173' }}"

  render-smoke:
    name: render smoke (behavioural gate, INV-127)
    runs-on: <%- _runner %>
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2

      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version-file: .nvmrc
          cache: npm

      - run: npm ci

      # Presence gate first: a frontend project with no render-smoke spec FAILs
      # here (fail-closed) before we build — catches the haben failure mode.
      - name: render-smoke presence (INV-127)
        run: node scripts/check-render-smoke.mjs

      - name: Install Playwright browsers
        run: npx playwright install --with-deps chromium

      - name: Build
        run: npm run build

      - name: render smoke (Playwright E2E — app shell mounts, no console errors)
        # Boots the BUILT SPA via ephemeral-server, runs the render-smoke spec.
        # Hard gate: a broken-layout / console-error render blocks the PR (INV-127).
        run: |
          node scripts/lib/ephemeral-server.mjs \
            --start "${E2E_START_CMD:-npm run start:test}" \
            --test "npx playwright test tests/e2e/render-smoke.spec.ts" \
            --port "${E2E_PORT:-4173}"
        env:
          E2E_BASE_URL: "http://localhost:${{ vars.E2E_PORT || '4173' }}"
