version: 2
updates:
<% if (buildTool === 'npm') { %>
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 3
    labels: ["deps"]
    groups:
      dev-dependencies:
        dependency-type: "development"
      prod-dependencies:
        dependency-type: "production"
<% } %><% if (buildTool === 'cargo') { %>
  - package-ecosystem: "cargo"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %><% if (buildTool === 'gradle') { %>
  - package-ecosystem: "gradle"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 3
    labels: ["deps"]
    groups:
      build-plugins:
        patterns: ["*plugin*", "org.gradle.*"]
      prod-dependencies:
        dependency-type: "production"
<% } %><% if (buildTool === 'maven') { %>
  - package-ecosystem: "maven"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 3
    labels: ["deps"]
    groups:
      prod-dependencies:
        dependency-type: "production"
<% } %><% if (buildTool === 'go') { %>
  - package-ecosystem: "gomod"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %><% if (buildTool === 'pip') { %>
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 3
    labels: ["deps"]
    groups:
      dev-dependencies:
        dependency-type: "development"
      prod-dependencies:
        dependency-type: "production"
<% } %>
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["ci", "deps"]
