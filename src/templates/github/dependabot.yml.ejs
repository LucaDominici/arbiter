version: 2
updates:
<% if (buildTool === 'npm') { %>
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %><% if (buildTool === 'cargo') { %>
  - package-ecosystem: "cargo"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %><% if (buildTool === 'gradle') { %>
  - package-ecosystem: "gradle"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %><% if (buildTool === 'maven') { %>
  - package-ecosystem: "maven"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %><% if (buildTool === 'go') { %>
  - package-ecosystem: "gomod"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %><% if (buildTool === 'pip') { %>
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["deps"]
<% } %>
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    labels: ["ci", "deps"]
