# Canonical label list — managed by arbiter
# Sync to repo: push to main triggers _label-sync workflow
labels:
  # Task size
  - name: "size: XS"
    color: "ededed"
    description: "Extra small: trivial change (< 30 min)"
  - name: "size: S"
    color: "ededed"
    description: "Small: straightforward task (< 2 h)"
  - name: "size: Standard"
    color: "ededed"
    description: "Standard: typical task (< 1 day)"
  # AI governance
  - name: approved-by-human
    color: "0e8a16"
    description: "PR approved by a human reviewer distinct from the author"
  # CI tier
  - name: "tier: T2"
    color: "e4e669"
    description: "Affects T2 PR gate workflows"
  - name: "tier: T3"
    color: "e4e669"
    description: "Affects T3 release workflows"
  - name: "tier: T4"
    color: "e4e669"
    description: "Affects T4/T5 nightly/weekly/heartbeat workflows"
  # Heartbeat alerts
  - name: heartbeat-nightly-missed
    color: "d93f0b"
    description: "Nightly workflow missed its freshness window"
  - name: heartbeat-weekly-missed
    color: "d93f0b"
    description: "Weekly workflow missed its freshness window"
  - name: heartbeat-monthly-missed
    color: "d93f0b"
    description: "Monthly workflow missed its freshness window"
  # Regression issues filed by scheduled workflows
  - name: kit-drift
    color: "0075ca"
    description: "KIT self-canary failure detected"
  - name: probe-writer-drift
    color: "b60205"
    description: "probe≠writer alignment mismatch detected by the weekly audit (#1707)"
  - name: nightly-regression
    color: "b60205"
    description: "Nightly (T4) workflow detected a regression"
  - name: weekly-regression
    color: "b60205"
    description: "Weekly (T5) workflow detected a regression"
  - name: monthly-regression
    color: "b60205"
    description: "Monthly (T5b) workflow detected a regression"
  # Tracks (TRACK_MODEL.md)
  - name: "track: core"
    color: "cccccc"
    description: "Track: TypeScript sources under src/ shipped in the built CLI"
  - name: "track: templates"
    color: "cccccc"
    description: "Track: EJS templates and materialized .claude/.github/.agents/.codex/ outputs"
  - name: "track: kit"
    color: "cccccc"
    description: "Track: tool catalog, archetype manifests, language matrices, adapter coverage"
  - name: "track: docs"
    color: "cccccc"
    description: "Track: hand-authored Markdown under docs/ and root-level docs"
  - name: "track: ci"
    color: "cccccc"
    description: "Track: GitHub Actions workflows, composite actions, CI-tier templates"
  - name: "track: meta"
    color: "cccccc"
    description: "Track: scripts, hooks, gate script, evidence bundles, repo-level config"
  # Lifecycle
  - name: tech-debt
    color: "d93f0b"
    description: "Tracked technical debt item"
  - name: follow-up
    color: "fbca04"
    description: "Requires follow-up in a subsequent issue"
  - name: blocked
    color: "e11d48"
    description: "Blocked on external dependency or decision"
  # Issue & PR state (consumed by issue-state.yml + _pr-staleness.yml automation, #1131)
  - name: in-progress
    color: "1d76db"
    description: "Work in progress; set manually, removed by issue-state on PR open"
  - name: in-review
    color: "fbca04"
    description: "PR open and under review; set by issue-state on PR open, removed on close"
  - name: stale
    color: "795548"
    description: "No activity within the staleness window; managed by _pr-staleness"
  - name: no-stale
    color: "0e8a16"
    description: "Exempts a PR from staleness sweeps; read as a gate by _pr-staleness"
  - name: governance
    color: "5319e7"
    description: "Governance/compliance tracking; applied by the compliance-item issue template"
<% if (locals.kitEnabled) { -%>
  # Quality program (kit-install)
  - name: quality
    color: "7057ff"
    description: "Quality program item"
  - name: deferred
    color: "fbca04"
    description: "Deferred to future wave"
  - name: needs-info
    color: "d876e3"
    description: "Needs more information"
  - name: bug
    color: "d73a4a"
    description: "Something isn't working"
  - name: enhancement
    color: "a2eeef"
    description: "New feature or request"
  - name: chore
    color: "ededed"
    description: "Maintenance task"
  - name: documentation
    color: "0075ca"
    description: "Documentation improvements"
  - name: compliance
    color: "5319e7"
    description: "ISO/regulatory compliance"
  - name: security
    color: "b60205"
    description: "Security issue or improvement"
  - name: performance
    color: "ff6600"
    description: "Performance improvement"
  - name: breaking-change
    color: "e11d48"
    description: "Breaking change"
  - name: P0
    color: "b60205"
    description: "Critical priority"
  - name: P1
    color: "d93f0b"
    description: "High priority"
  - name: P2
    color: "fbca04"
    description: "Medium priority"
  - name: duplicate
    color: "cfd3d7"
    description: "Duplicate issue"
  - name: wontfix
    color: "ffffff"
    description: "Will not fix"
  - name: good first issue
    color: "7057ff"
    description: "Good for newcomers"
  - name: help wanted
    color: "008672"
    description: "Extra attention needed"
  - name: invalid
    color: "e4e669"
    description: "Not valid"
<% } -%>
