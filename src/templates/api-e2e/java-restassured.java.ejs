// Live-API e2e (INV-126): runs against the REAL booted server, no mocks.
// API_BASE_URL points at the running binary (tests/api/run.sh boots it).
package <%- basePackage || 'com.example' %>.api;

import static io.restassured.RestAssured.given;
import static org.hamcrest.Matchers.notNullValue;

import io.restassured.RestAssured;
import org.junit.jupiter.api.BeforeAll;
import org.junit.jupiter.api.Test;

class ApiE2ETest {

  @BeforeAll
  static void configureBaseUri() {
    String base = System.getenv("API_BASE_URL");
    RestAssured.baseURI = (base != null && !base.isEmpty()) ? base : "http://127.0.0.1:8080";
  }

  @Test
  void healthEndpointReturns200FromRunningBinary() {
    given().when().get("/health").then().statusCode(200).body(notNullValue());

