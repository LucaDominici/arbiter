# Live-API e2e (INV-126): runs against the REAL booted server, no mocks.
# API_BASE_URL points at the running binary (tests/api/run.sh boots it).
import os

import httpx

BASE_URL = os.environ.get("API_BASE_URL", "http://127.0.0.1:8080")


def test_health_returns_200_from_running_binary() -> None:
    resp = httpx.get(f"{BASE_URL}/health", timeout=5.0)
    assert resp.status_code == 200

