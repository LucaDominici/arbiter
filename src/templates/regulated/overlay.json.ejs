{
  "$comment": "Regulated / high-assurance compliance overlay policy for <%= projectName %>. Enforced by scripts/check-regulated-overlay.mjs (fail-closed). You MAY tighten any value above the regulated floor; the gate FAILS if you weaken it below the floor or drop a pillar. Generated by arbiter (industryOverlay: regulated).",
  "separationOfDuties": {
    "requireHumanApprovalOnAiAuthoredPR": true,
    "minHumanApprovals": 1,
    "aiAuthorMarkers": [
      "Co-Authored-By: Claude",
      "Co-Authored-By: GitHub Copilot",
      "Generated with"
    ]
  },
  "auditTrail": {
    "retentionDays": 365
  },
  "suppressionExpiry": {
    "mandatory": true,
    "maxValidityDays": 90
  },
  "attestation": {
    "cosign": true,
    "sbom": true
  },
  "mutationCoverage": {
    "minScore": <%= typeof thresholds !== 'undefined' && thresholds && thresholds.mutationScore ? thresholds.mutationScore : 60 %>
  }
}
