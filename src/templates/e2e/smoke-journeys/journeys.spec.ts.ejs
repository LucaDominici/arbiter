//
// Declared in smoke-journeys.json:
//   auth  — Authentication flow        (required)
//   crud  — Core CRUD operation        (required)
//   authz — Authorization enforcement  (n/a for frontend-spa — the backend archetype's floor)

import { test, expect } from '@playwright/test'

const BASE_URL = process.env.E2E_BASE_URL ?? 'http://localhost:4173'

test('auth — a user can complete the login flow (INV-137)', async ({ page }) => {
  const consoleErrors: string[] = []
  page.on('console', (msg) => {
    if (msg.type() === 'error') consoleErrors.push(msg.text())
  })

  // TODO(#2080): drive your real login form. Replace path + selectors + credentials.
  // NOTE: the placeholder below is intentionally not email-shaped (arbiter's own PII
  // scan flags an @-address pattern in scaffolded source, #2257) — swap in a real
  // fixture identity (via E2E_USER) once your login form is wired up.
  await page.goto(`${BASE_URL}/login`, { waitUntil: 'networkidle' })
  await page.getByLabel(/email|username/i).fill(process.env.E2E_USER ?? 'smoke-test-user')
  await page.getByLabel(/password/i).fill(process.env.E2E_PASS ?? 'password')
  await page.getByRole('button', { name: /log ?in|sign ?in/i }).click()

  // The journey succeeds only if the app leaves the login screen for an authed view.
  await expect(page).not.toHaveURL(/\/login\b/)
  expect(consoleErrors, `console errors during login: ${consoleErrors.join('; ')}`).toHaveLength(0)
})

