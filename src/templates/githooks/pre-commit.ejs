#!/usr/bin/env bash
# pre-commit: runs L1 gate before each commit
set -e

# Phase guard: refuse commits during preflight or plan phases. Distinguish an absent document
# (fresh tree → allow) from a corrupt one (→ fail closed) so corruption can't silently bypass.
_phase=$(node -e "const f=require('fs'),p='.claude/.task/status.json';if(!f.existsSync(p)){process.stdout.write('unknown')}else{try{process.stdout.write(JSON.parse(f.readFileSync(p,'utf-8')).phase||'unknown')}catch{process.stdout.write('corrupt')}}" 2>/dev/null || echo "unknown")
case "$_phase" in
  preflight|plan)
    echo "ERROR: cannot commit during phase=$_phase. Run: arbiter task advance --to red" >&2
    exit 1
    ;;
  corrupt)
    echo "ERROR: .claude/.task/status.json is corrupt — fix or delete it before committing." >&2
    exit 1
    ;;
  red)
    # #2051: a genuine RED commit contains a test that FAILS — the L1 gate blocks
    # exactly the commit `arbiter task record-red` must point at. The deadlock is
    # resolved for that one commit shape only: phase=red AND every staged path is a
    # test. Anything else (source staged alongside, or any other phase) still runs the
    # gate, and the GREEN commit that follows runs it over the whole tree.
    # ponytail: path-name heuristic for "is a test" — language-agnostic, and tight enough
    # to reject latest/protest/testing, but a genuine source file named src/.../test.ts
    # would ride along gate-free in this one commit. Upgrade path: ask the project's test
    # config for its test globs. Bounded by the GREEN commit's whole-tree gate.
    _staged_red=$(git diff --cached --name-only)
    if [ -n "$_staged_red" ] && ! printf '%s\n' "$_staged_red" |
      grep -qivE '(^|[^[:alpha:]])(tests?|specs?)([^[:alpha:]]|$)'; then
      echo "[pre-commit] phase=red, staged paths are tests only — L1 gate skipped so the failing RED test can land (#2051)."
      _skip_gate=1
    fi
    ;;
esac

<% if (language === 'typescript') { %>
if [ ! -d "node_modules" ]; then
  echo "Skipping pre-commit: node_modules not installed. Run npm install."
  exit 0
fi
<% } else { %>
if ! command -v node >/dev/null 2>&1; then
  echo "Skipping pre-commit: node not found. Install Node.js to enable git hooks."
  exit 0
fi
<% } %>

# Unset git hook env vars so nested git calls in scripts work correctly.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

# gold-align (#1506 yamllint / #1507 shellcheck): mirror the CI config-lint lane
# locally so YAML/shell style defects fail before CI, not after a round-trip. Each
# linter is best-effort-on-absence (skip with a note when the tool isn't installed,
# matching the node/node_modules guards above) but BLOCKING when present.
_staged=$(git diff --cached --name-only --diff-filter=ACM)
if command -v shellcheck >/dev/null 2>&1; then
  _sh=$(echo "$_staged" | grep -E '\.sh$' || true)
  if [ -n "$_sh" ]; then
    echo "$_sh" | xargs shellcheck --severity=warning || exit 1
  fi
fi
if command -v yamllint >/dev/null 2>&1; then
  _yml=$(echo "$_staged" | grep -E '\.ya?ml$' | grep -v '^\.github/workflows/' || true)
  if [ -n "$_yml" ]; then
    if [ -f .yamllint.yml ] || [ -f .yamllint.yaml ] || [ -f .yamllint ]; then
      echo "$_yml" | xargs yamllint || exit 1
    else
      echo "$_yml" | xargs yamllint -d relaxed || exit 1
    fi
  fi
fi
# #2051: the RED commit is exempt from the gate only — lint and secret scanning above
# still applied to it.
if [ "${_skip_gate:-0}" = "1" ]; then
  exit 0
fi
<% if (language === 'typescript') { %>

# Vite/vitest (v5+) cannot handle '#' in the project root path — it treats '#'
# as a URL fragment and mangles all module IDs. Worktrees named '#NNN' trigger
# this. Rsync to a temporary '#'-free path and run the gate from there.
if [[ "$PWD" == *"#"* ]]; then
  ORIG_DIR="$(pwd)"
  TMP_DIR=$(mktemp -d /tmp/arbiter-hook-XXXXXX)
  trap 'rm -rf "$TMP_DIR"' EXIT
  rsync -a --exclude .git --exclude node_modules --exclude dist . "$TMP_DIR/"
  ln -sfn "$ORIG_DIR/node_modules" "$TMP_DIR/node_modules"
  cd "$TMP_DIR"
  # Reserved: consumed by check-all when worktree-aware gate lands
  ARBITER_HOOK_GIT_CWD="$ORIG_DIR" node scripts/check-all.mjs L1
  exit $?
fi
<% } %>

node scripts/check-all.mjs L1
