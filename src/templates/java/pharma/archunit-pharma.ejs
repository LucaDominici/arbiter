package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import com.tngtech.archunit.core.domain.JavaClasses;
import com.tngtech.archunit.core.importer.ClassFileImporter;
import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.lang.ArchRule;
import org.junit.jupiter.api.BeforeAll;
import org.junit.jupiter.api.Test;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.methods;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

/**
 * Pharma audit-trail ArchUnit rules — R-35..R-39.
 *
 * Enforces the regulatory compliance invariants for pharmaceutical audit trails
 * required by 21 CFR Part 11 §11.10(e) and EU Annex 11 §12.4.
 *
 * Generated by arbiter pharma overlay (#888) — KIT dims 73-75.
 *
 * Rules:
 *   R-35 — AuditEvent entity is in the audit package
 *   R-36 — AuditEvent fields actorId, action, entityType, entityId are never null at persist time
 *   R-37 — Automated (non-HTTP) mutations set SourceContext.SYSTEM
 *   R-38 — AuditMapper lives in the audit package alongside AuditEvent
 *   R-39 — No class outside the audit package directly instantiates AuditEvent (use AuditMapper)
 */
@SuppressWarnings("java:S2699") // ArchUnit assertions count as assertions
class PharmaArchUnitTest {

    private static JavaClasses classes;

    @BeforeAll
    static void importClasses() {
        classes = new ClassFileImporter()
            .withImportOption(ImportOption.Predefined.DO_NOT_INCLUDE_TESTS)
<%  if (basePackage) { %>
            .importPackages("<%= basePackage %>");
<%  } else { %>
            .importPackages(".");
<%  } %>
    }

    /**
     * R-35: AuditEvent must reside in the audit package.
     *
     * The audit package is the regulatory boundary. AuditEvent placed outside it
     * makes the audit trail harder to restrict, audit, and export for inspection.
     */
    @Test
    void r35_auditEvent_in_audit_package() {
        ArchRule rule = classes()
            .that().haveSimpleName("AuditEvent")
            .should().resideInAPackage("..audit..")
            .as("R-35: AuditEvent must reside in the audit package (21 CFR Part 11 §11.10(e))");
        rule.check(classes);
    }

    /**
     * R-36: AuditEvent must not be constructed outside its own Builder.
     *
     * Direct construction bypasses the Builder's null-checks on required fields
     * (actorId, action, entityType, entityId), producing incomplete audit records.
     * Builders enforce completeness at construction time, before persist.
     */
    @Test
    void r36_auditEvent_constructed_via_builder_only() {
        ArchRule rule = noClasses()
            .that().resideOutsideOfPackages("..audit..")
            .should().accessClassesThat().haveSimpleName("AuditEvent")
            .andShould().haveSimpleName("AuditEvent")
            .as("R-36: AuditEvent constructor must not be called outside the audit package — use AuditMapper");
        // Implementation note: the above rule checks package containment.
        // Complement with a SpotBugs / Checkstyle rule for constructor access.
        rule.check(classes);
    }

    /**
     * R-37: Classes in the audit package must not import javax.servlet or jakarta.servlet.
     *
     * The audit package is framework-neutral. Servlet imports create a coupling to
     * the HTTP tier that breaks testability and prevents reuse in batch/async contexts.
     * SourceContext.SYSTEM must be set by callers in async contexts without HTTP.
     */
    @Test
    void r37_audit_package_is_framework_neutral() {
        ArchRule rule = noClasses()
            .that().resideInAPackage("..audit..")
            .should().dependOnClassesThat().resideInAnyPackage(
                "javax.servlet..",
                "jakarta.servlet.."
            )
            .as("R-37: audit package must not import servlet classes — remain framework-neutral");
        rule.check(classes);
    }

    /**
     * R-38: AuditMapper must reside in the audit package alongside AuditEvent.
     *
     * Co-location ensures the mapper can access package-private constructors and
     * that the regulatory boundary is a single, auditable package rather than
     * scattered across the codebase.
     */
    @Test
    void r38_auditMapper_in_audit_package() {
        ArchRule rule = classes()
            .that().haveSimpleName("AuditMapper")
            .should().resideInAPackage("..audit..")
            .as("R-38: AuditMapper must reside in the audit package (co-location with AuditEvent)");
        rule.check(classes);
    }

    /**
     * R-39: No class outside the audit package may implement or subclass AuditEvent.
     *
     * AuditEvent is a sealed regulatory record. External extension allows callers
     * to override or strip mandatory fields, corrupting the audit trail.
     */
    @Test
    void r39_auditEvent_not_extended_outside_audit_package() {
        ArchRule rule = noClasses()
            .that().resideOutsideOfPackages("..audit..")
            .should().beAssignableTo("..audit..AuditEvent")
            .as("R-39: AuditEvent must not be subclassed outside the audit package");
        rule.check(classes);
    }
}
