package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchRule;
import org.junit.jupiter.api.Test;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

/**
 * Hexagonal (ports-and-adapters) architecture enforcement — generated by arbiter (#998).
 *
 * Enforces clean separation of domain / application / infrastructure layers:
 *   - Domain must not depend on application, infrastructure, or adapters
 *   - Application must not depend on infrastructure or adapters
 *   - Infrastructure and adapters communicate only through application ports
 *
 * Generated by arbiter. Re-run `arbiter init` to regenerate.
 */
@SuppressWarnings("java:S2699")
@AnalyzeClasses(
    packages = "<%= basePackage ? basePackage : '.' %>",
    importOptions = ImportOption.DoNotIncludeTests.class
)
class HexagonalArchTest {

    @ArchTest
    static final ArchRule domain_must_not_depend_on_infrastructure =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .should().dependOnClassesThat()
            .resideInAnyPackage(
                "<%= basePackage ? basePackage + '.infrastructure..' : 'infrastructure..' %>",
                "<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>"
            )
            .because("Domain must not depend on infrastructure or adapters — hexagonal architecture.");

    @ArchTest
    static final ArchRule domain_must_not_depend_on_application =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.application..' : 'application..' %>")
            .because("Domain is the innermost layer — it must not depend on application services.");

    @ArchTest
    static final ArchRule application_must_not_depend_on_infrastructure =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.application..' : 'application..' %>")
            .should().dependOnClassesThat()
            .resideInAnyPackage(
                "<%= basePackage ? basePackage + '.infrastructure..' : 'infrastructure..' %>",
                "<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>"
            )
            .because("Application layer orchestrates via ports — it must not depend on infrastructure implementations.");

    @ArchTest
    static final ArchRule adapters_must_not_depend_on_each_other =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .because("Adapters are independent — they communicate only through domain ports.");

    @Test
    void hexagonal_layers_declared() {
    }
}
