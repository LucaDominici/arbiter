package <%= basePackage ? basePackage + '.web.interceptor' : 'web.interceptor' %>;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import org.springframework.web.servlet.HandlerInterceptor;

import java.time.Instant;
import java.time.format.DateTimeFormatter;

/**
 * RFC 8594-compliant deprecation interceptor for Spring MVC.
 * Adds Sunset and Deprecation headers to every matched response.
 *
 * Register via WebMvcConfigurer.addInterceptors() with an addPathPatterns()
 * filter to scope to deprecated API versions only.
 *
 * Generated by arbiter — see issue #215 (RFC 8594 deprecation protocol).
 */
public class DeprecationInterceptor implements HandlerInterceptor {

    private final Instant sunsetDate;
    private final String successorUrl;

    public DeprecationInterceptor(Instant sunsetDate, String successorUrl) {
        this.sunsetDate = sunsetDate;
        this.successorUrl = successorUrl;
    }

    public DeprecationInterceptor(Instant sunsetDate) {
        this(sunsetDate, null);
    }

    @Override
    public void postHandle(
            HttpServletRequest request,
            HttpServletResponse response,
            Object handler,
            org.springframework.web.servlet.ModelAndView modelAndView) {

        response.setHeader("Deprecation", "true");
        response.setHeader(
                "Sunset",
                DateTimeFormatter.RFC_1123_DATE_TIME
                        .format(sunsetDate.atZone(java.time.ZoneOffset.UTC)));

        if (successorUrl != null && !successorUrl.isBlank()) {
            response.setHeader("Link", "<" + successorUrl + ">; rel=\"successor-version\"");
        }
    }
}
