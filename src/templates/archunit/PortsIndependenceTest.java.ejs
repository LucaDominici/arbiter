package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchRule;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

/**
 * Ports independence enforcement — generated by arbiter (M22, hexagonal).
 *
 * Ports (application.port.in / application.port.out) must not depend on adapters
 * or infrastructure. They define the boundary contract for the application core.
 *
 * Generated by arbiter. Edit the template to change enforcement.
 */
@AnalyzeClasses(
    packages = "<%= basePackage ? basePackage : '' %>",
    importOptions = ImportOption.DoNotIncludeTests.class
)
public class PortsIndependenceTest {

    @ArchTest
    public static final ArchRule inbound_ports_must_not_depend_on_adapters =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.application.port.in..' : 'application.port.in..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .because("Inbound ports define the driving-side contract and must not depend on adapters.");

    @ArchTest
    public static final ArchRule outbound_ports_must_not_depend_on_adapters =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.application.port.out..' : 'application.port.out..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .because("Outbound ports define the driven-side contract and must not depend on adapter implementations.");

    @ArchTest
    public static final ArchRule inbound_ports_must_not_depend_on_infrastructure =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.application.port.in..' : 'application.port.in..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.infrastructure..' : 'infrastructure..' %>")
            .because("Inbound ports must not depend on infrastructure details.");

    @ArchTest
    public static final ArchRule outbound_ports_must_not_depend_on_infrastructure =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.application.port.out..' : 'application.port.out..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.infrastructure..' : 'infrastructure..' %>")
            .because("Outbound ports must remain infrastructure-agnostic: implementations live in adapters.");
}
