package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import com.tngtech.archunit.core.domain.JavaClass;
import com.tngtech.archunit.core.domain.JavaMethod;
import com.tngtech.archunit.core.importer.ClassFileImporter;
import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchCondition;
import com.tngtech.archunit.lang.ArchRule;
import com.tngtech.archunit.lang.ConditionEvents;
import com.tngtech.archunit.lang.SimpleConditionEvent;

import org.assertj.core.api.Assertions;
import org.junit.jupiter.api.Test;

import java.util.Set;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.methods;

/**
 * Anti-proforma test gate — enforces that every @Test method contains at least
 * one real assertion (INV-118, §R-41).
 *
 * Detects proforma tests: test methods that do not call any recognized assertion
 * class (AssertJ, JUnit5 Assertions, Mockito verify, REST Assured, MockMvc).
 *
 * Bypass: annotate the method with @AntiProformaExempt("rationale"). Requires
 * CLASS retention so ArchUnit can detect via bytecode.
 *
 * Generated by arbiter (#1249). Edit the template to change enforcement.
 */
@AnalyzeClasses(
    packages = "<%= basePackage ? basePackage : '' %>",
    importOptions = ImportOption.OnlyIncludeTests.class
)
public class AntiProformaTest {

    /** Recognized assertion class name fragments (bytecode-level). */
    private static final Set<String> ASSERTION_CLASS_FRAGMENTS = Set.of(
        "org.assertj.core.api",
        "org.junit.jupiter.api.Assertions",
        "org.mockito.Mockito",
        "io.restassured",
        "org.springframework.test.web.servlet.result"
    );

    private static final ArchCondition<JavaMethod> HAVE_REAL_ASSERTION =
        new ArchCondition<>("have at least one real assertion or be exempt") {

            @Override
            public void check(JavaMethod method, ConditionEvents events) {
                // Skip if annotated with @AntiProformaExempt
                if (method.isAnnotatedWith(AntiProformaExempt.class)) {
                    return;
                }

                boolean hasAssertion = method.getMethodCallsFromSelf().stream()
                    .anyMatch(call -> ASSERTION_CLASS_FRAGMENTS.stream()
                        .anyMatch(fragment -> call.getTargetOwner().getFullName().startsWith(fragment)));

                if (!hasAssertion) {
                    // One-hop transitive check: look for helper method calls in same class
                    boolean hasTransitiveAssertion = method.getMethodCallsFromSelf().stream()
                        .filter(call -> call.getTargetOwner().equals(method.getOwner()))
                        .flatMap(call -> {
                            try {
                                return call.getTargetOwner().getMethods().stream()
                                    .filter(m -> m.getName().equals(call.getName()))
                                    .flatMap(m -> m.getMethodCallsFromSelf().stream());
                            } catch (Exception e) {
                                return java.util.stream.Stream.empty();
                            }
                        })
                        .anyMatch(call -> ASSERTION_CLASS_FRAGMENTS.stream()
                            .anyMatch(fragment -> call.getTargetOwner().getFullName().startsWith(fragment)));

                    if (!hasTransitiveAssertion) {
                        events.add(SimpleConditionEvent.violated(
                            method,
                            String.format(
                                "Method %s in %s has no recognized assertion. " +
                                "Add an assertion or annotate with @AntiProformaExempt(\"rationale\").",
                                method.getName(),
                                method.getOwner().getFullName()
                            )
                        ));
                    }
                }
            }
        };

    @ArchTest
    public static final ArchRule test_methods_must_have_assertions =
        methods()
            .that().areAnnotatedWith(Test.class)
            .or().areAnnotatedWith("org.junit.jupiter.params.ParameterizedTest")
            .or().areAnnotatedWith("org.junit.jupiter.api.RepeatedTest")
            .should(HAVE_REAL_ASSERTION)
            .because(
                "Proforma tests (tests without assertions) provide false confidence — " +
                "they always pass regardless of what the code under test does (INV-118, §R-41)."
            );
}
