import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

/**
 * ArchUnit enforcement of INV-29: No MockMvc — use RestAssured for integration tests.
 *
 * MockMvc tests the controller layer through a mock servlet container, bypassing real HTTP
 * serialization, filter chains, exception handlers, and content negotiation. Use RestAssured
 * with a real embedded server instead.
 *
 * Generated by arbiter. Do not edit — update the arbiter template to change enforcement.
 */
@AnalyzeClasses(
    packages = "<%= basePackage ? basePackage : '' %>",
    importOptions = ImportOption.DoNotIncludeTests.class
)
public class NoMockMvcTest {

    @ArchTest
    public static final ArchRule no_mockmvc_in_production_code =
        noClasses()
            .should().dependOnClassesThat()
            .resideInAPackage("org.springframework.test.web.servlet..")
            .because("MockMvc is forbidden (INV-29). Use RestAssured with @SpringBootTest(webEnvironment=RANDOM_PORT) instead.");

    @ArchTest
    public static final ArchRule no_auto_configure_mockmvc =
        noClasses()
            .should().beAnnotatedWith("org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc")
            .because("@AutoConfigureMockMvc is forbidden (INV-29). Use @SpringBootTest(webEnvironment=RANDOM_PORT) with RestAssured instead.");
}
