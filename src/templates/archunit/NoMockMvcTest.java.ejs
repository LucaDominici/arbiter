package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;

import com.tngtech.archunit.core.importer.ClassFileImporter;
import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchRule;
import org.junit.jupiter.api.Test;

/**
 * ArchUnit enforcement of INV-29: No MockMvc — use RestAssured for integration tests.
 *
 * <p>MockMvc tests the controller layer through a mock servlet container, bypassing real HTTP
 * serialization, filter chains, exception handlers, and content negotiation. Use RestAssured with a
 * real embedded server instead.
 *
 * <p>Generated by arbiter. Do not edit — update the arbiter template to change enforcement.
 */
<%_
  // google-java-format (AOSP) is canonical: it joins this annotation onto one
  // line when it fits the 100-column limit and splits it (8-space continuation)
  // otherwise. Reproduce that decision here so the emitted file passes
  // spotlessCheck verbatim for ANY basePackage length.
  const analyzeOneLine = `@AnalyzeClasses(packages = "${basePackage || ''}", importOptions = ImportOption.DoNotIncludeTests.class)`;
_%>
<%_ if (analyzeOneLine.length <= 100) { _%>
<%- analyzeOneLine %>
<%_ } else { _%>
@AnalyzeClasses(
        packages = "<%= basePackage ? basePackage : '' %>",
        importOptions = ImportOption.DoNotIncludeTests.class)
<%_ } _%>
class NoMockMvcTest {

    @ArchTest
    public static final ArchRule no_mockmvc_in_production_code =
            noClasses()
                    .should()
                    .dependOnClassesThat()
                    .resideInAPackage("org.springframework.test.web.servlet..")
                    .because(
                            "MockMvc is forbidden (INV-29). Use RestAssured with @SpringBootTest(webEnvironment=RANDOM_PORT) instead.");

    @ArchTest
    public static final ArchRule no_auto_configure_mockmvc =
            noClasses()
                    .should()
                    .beAnnotatedWith(
                            "org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc")
                    .because(
                            "@AutoConfigureMockMvc is forbidden (INV-29). Use @SpringBootTest(webEnvironment=RANDOM_PORT) with RestAssured instead.");

    @Test
    void production_code_avoids_mockmvc() {
        var productionClasses =
                new ClassFileImporter()
                        .withImportOption(new ImportOption.DoNotIncludeTests())
                        .importPackages("<%= basePackage ? basePackage : '' %>");

        assertDoesNotThrow(
                () -> {
                    no_mockmvc_in_production_code.check(productionClasses);
                    no_auto_configure_mockmvc.check(productionClasses);
                },
                "production code must comply with the No MockMvc architecture rules");
    }
}
