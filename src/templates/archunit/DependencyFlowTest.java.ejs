package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchRule;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

/**
 * Dependency flow enforcement — generated by arbiter (M22, hexagonal).
 *
 * Enforces the inward dependency rule: adapters → application → domain.
 * No layer may depend on a layer further out in the ring.
 *
 * Generated by arbiter. Edit the template to change enforcement.
 */
@AnalyzeClasses(
    packages = "<%= basePackage ? basePackage : '' %>",
    importOptions = ImportOption.DoNotIncludeTests.class
)
public class DependencyFlowTest {

    @ArchTest
    public static final ArchRule adapters_must_not_depend_on_domain_directly =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .because("Adapters must communicate with the domain only through application ports, not directly.");

    @ArchTest
    public static final ArchRule application_must_not_depend_on_adapters =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.application..' : 'application..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .because("Application layer must not depend on adapters (dependency inversion principle).");

    @ArchTest
    public static final ArchRule domain_must_not_depend_on_application =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.application..' : 'application..' %>")
            .because("Domain layer must be self-contained: no dependency on application layer.");

    @ArchTest
    public static final ArchRule domain_must_not_depend_on_infrastructure =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.infrastructure..' : 'infrastructure..' %>")
            .because("Domain layer must not depend on infrastructure: keep domain portable.");
}
