package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import java.lang.annotation.ElementType;
import java.lang.annotation.Retention;
import java.lang.annotation.RetentionPolicy;
import java.lang.annotation.Target;

/**
 * Exempts a @Test method from the anti-proforma gate (AntiProformaTest, INV-118).
 *
 * Use when the test intentionally has no assertion (e.g., tests that only verify
 * that code does not throw, rely on framework assertions via @Test(expected=...),
 * or are placeholder tests pending implementation).
 *
 * Requires CLASS retention (not SOURCE) so ArchUnit can detect via bytecode.
 *
 * Example:
 *   @Test
 *   @AntiProformaExempt("verifies no exception thrown — contract defined externally")
 *   void no_exception_on_valid_input() {
 *       service.process(VALID_PAYLOAD);
 *   }
 *
 * Generated by arbiter (#1249). Edit the template to change enforcement.
 */
@Retention(RetentionPolicy.CLASS)
@Target(ElementType.METHOD)
public @interface AntiProformaExempt {

    /**
     * Rationale for exempting this test from the anti-proforma gate.
     * Must be a non-empty descriptive string.
     */
    String value();
}
