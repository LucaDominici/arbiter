package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchRule;

import org.junit.jupiter.api.Test;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

/**
 * Architecture style enforcement — generated by arbiter for architectureStyle: <%= architectureStyle %>.
 *
 * Do not edit — update the arbiter template or re-run `arbiter init` to change enforcement.
 * See docs/ADR/021-archetype-axis.md for the policy behind architecture-style gating.
 */
@AnalyzeClasses(
    packages = "<%= basePackage ? basePackage : '' %>",
    importOptions = ImportOption.DoNotIncludeTests.class
)
public class ArchitectureTest {

<% if (architectureStyle === 'hexagonal') { %>
    /**
     * Hexagonal (ports-and-adapters) rules.
     * Domain layer must not depend on infrastructure or adapter packages.
     */
    @ArchTest
    public static final ArchRule domain_must_not_depend_on_infrastructure =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .should().dependOnClassesThat()
            .resideInAnyPackage(
                "<%= basePackage ? basePackage + '.infrastructure..' : 'infrastructure..' %>",
                "<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>"
            )
            .because("Domain layer must not depend on infrastructure or adapters (hexagonal architecture).");

    @ArchTest
    public static final ArchRule adapters_must_not_depend_on_each_other =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.adapter..' : 'adapter..' %>")
            .because("Adapters must be independent — they communicate only through domain ports.");
<% } else if (architectureStyle === 'layered') { %>
    /**
     * Layered architecture rules.
     * Direction: controller → service → repository. No upward dependencies allowed.
     */
    @ArchTest
    public static final ArchRule repositories_must_not_depend_on_services =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.repository..' : 'repository..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.service..' : 'service..' %>")
            .because("Repository layer must not depend on service layer (layered architecture).");

    @ArchTest
    public static final ArchRule services_must_not_depend_on_controllers =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.service..' : 'service..' %>")
            .should().dependOnClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.controller..' : 'controller..' %>")
            .because("Service layer must not depend on controller layer (layered architecture).");
<% } else if (architectureStyle === 'modular-monolith') { %>
    /**
     * Modular-monolith rules.
     * Modules must communicate only through their public API packages.
     * Cross-module imports of internal packages are forbidden.
     */
    @ArchTest
    public static final ArchRule no_cross_module_internal_access =
        noClasses()
            .that().resideOutsideOfPackage("<%= basePackage ? basePackage + '.modules.[^.]+.internal..' : 'modules.[^.]+.internal..' %>")
            .should().accessClassesThat()
            .resideInAPackage("<%= basePackage ? basePackage + '.modules.[^.]+.internal..' : 'modules.[^.]+.internal..' %>")
            .because("Module internal packages are private — access only through the module's public API package.");
<% } else { %>
    @Test
    public void architecture_style_unknown() {
        org.junit.jupiter.api.Assertions.fail(
            "Unknown architectureStyle '<%= architectureStyle %>'. Re-run `arbiter init` and select: hexagonal, layered, or modular-monolith."
        );
    }
<% } %>
}
