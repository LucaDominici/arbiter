package <%= basePackage ? basePackage + '.architecture' : 'architecture' %>;

import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchRule;

import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;

/**
 * Domain purity enforcement — generated by arbiter (M22, hexagonal).
 *
 * The domain layer must be framework-free: no Spring, Jakarta EE, JPA, or Hibernate
 * imports allowed. Domain objects are plain Java — no annotations, no coupling to
 * persistence or web frameworks.
 *
 * Generated by arbiter. Edit the template to change enforcement.
 */
@AnalyzeClasses(
    packages = "<%= basePackage ? basePackage : '' %>",
    importOptions = ImportOption.DoNotIncludeTests.class
)
public class DomainPurityTest {

    @ArchTest
    public static final ArchRule domain_must_not_import_spring =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .should().dependOnClassesThat()
            .resideInAnyPackage(
                "org.springframework..",
                "org.springframework.data.."
            )
            .because("Domain layer must be framework-free: no Spring imports allowed.");

    @ArchTest
    public static final ArchRule domain_must_not_import_jpa =
        noClasses()
            .that().resideInAPackage("<%= basePackage ? basePackage + '.domain..' : 'domain..' %>")
            .should().dependOnClassesThat()
            .resideInAnyPackage(
                "jakarta.persistence..",
                "javax.persistence..",
                "org.hibernate.."
            )
            .because("Domain layer must be framework-free: no JPA/Hibernate imports allowed.");
}
