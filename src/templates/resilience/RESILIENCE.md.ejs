```yaml
# application.yml
resilience4j:
  circuitbreaker:
    instances:
      default:
        failure-rate-threshold: 50          # open at 50 % failure rate
        minimum-number-of-calls: 10         # min calls before evaluating
        wait-duration-in-open-state: 10s
        permitted-number-of-calls-in-half-open-state: 3
        sliding-window-type: COUNT_BASED
        sliding-window-size: 20
  retry:
    instances:
      default:
        max-attempts: 3
        wait-duration: 1s
        enable-exponential-backoff: true
        exponential-backoff-multiplier: 2
        exponential-max-wait-duration: 30s  # 30 s cap
        retry-exception-predicate: com.example.resilience.ServerErrorPredicate
        ignore-exceptions:
          - com.example.resilience.ClientErrorException   # never retry 4xx
  timelimiter:
    instances:
      default:
        timeout-duration: 5s               # per-attempt timeout
```

```java
// ServerErrorPredicate.java
package com.example.resilience;

import java.util.function.Predicate;

/** Retry only on server errors and connectivity failures — never 4xx. */
public class ServerErrorPredicate implements Predicate<Throwable> {
    @Override
    public boolean test(Throwable t) {
        if (t instanceof ClientErrorException) return false; // 4xx — never retry
        if (t instanceof ServerErrorException) return true;  // 5xx — retry
        if (t instanceof java.net.ConnectException) return true;
        if (t instanceof java.net.SocketTimeoutException) return true;
        return false;
    }
}
```

**Critical:** annotate your service method with CB outer, retry inner:

```java
@CircuitBreaker(name = "default", fallbackMethod = "fallback")
@Retry(name = "default")
@TimeLimiter(name = "default")
public CompletableFuture<Response> callExternalService(Request request) {
    // ...
}
```

