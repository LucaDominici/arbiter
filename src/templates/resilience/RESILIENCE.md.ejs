## Circuit Breaker

A circuit breaker prevents cascading failures by opening (stopping calls) once failures exceed
a threshold, then allowing a probe call in half-open state before closing again.

**Critical ordering:** place the circuit breaker as the **outer** decorator wrapping retry.
The CB observes the final result of the whole retry sequence — not each individual attempt.

<% if (language === 'typescript' || language === 'multi') { %>
### TypeScript — cockatiel

```typescript
import {
  ExponentialBackoff,
  SamplingBreaker,
  circuitBreaker,
  handleWhen,
  retry,
  wrap,
} from 'cockatiel'
import type { IPolicy } from 'cockatiel'

/** Error thrown for HTTP 4xx responses — must NOT be retried. */
export class ClientError extends Error {
  constructor(
    public readonly status: number,
    message: string,
  ) {
    super(message)
    this.name = 'ClientError'
  }
}

/** Error thrown for HTTP 5xx / connectivity failures — eligible for retry. */
export class ServerError extends Error {
  constructor(
    public readonly status: number,
    message: string,
  ) {
    super(message)
    this.name = 'ServerError'
  }
}

/**
 * Build a resilience policy: circuit-breaker (outer) wrapping retry (inner).
 * The CB observes the final outcome of the whole retry sequence.
 *
 * IMPORTANT: use handleWhen, not handleAll. handleAll retries every error
 * including 4xx (ClientError). handleWhen lets us exclude 4xx explicitly.
 */
export function buildResiliencePolicy(): IPolicy {
  // Retry only on ServerError and network errors — never ClientError (4xx).
  const retryPolicy = retry(handleWhen((err) => !(err instanceof ClientError)), {
    maxAttempts: 3,
    backoff: new ExponentialBackoff({
      initialDelay: 1_000, // 1 s
      maxDelay: 30_000, // 30 s cap
      exponent: 2,
      random: true, // 50 % jitter
    }),
  })

  // CB observes the final result of the whole retry sequence.
  const cbPolicy = circuitBreaker(handleWhen((err) => !(err instanceof ClientError)), {
    halfOpenAfter: 5_000,
    breaker: new SamplingBreaker({
      threshold: 0.5, // open at 50 % failure rate
      duration: 30_000, // 30 s sampling window
      minimumRps: 10, // minimum calls before evaluating
    }),
  })

  // CB outer, retry inner
  return wrap(cbPolicy, retryPolicy)
}

/** Call an external service with the resilience policy applied. */
const policy = buildResiliencePolicy()

export function callWithResilience<T>(fn: () => Promise<T>): Promise<T> {
  return policy.execute(fn)
}

// Usage:
// const data = await callWithResilience(async () => {
//   const response = await fetch(url, { signal: AbortSignal.timeout(5_000) })
//   if (response.status >= 400 && response.status < 500) {
//     throw new ClientError(response.status, `Client error: ${response.status}`)
//   }
//   if (!response.ok) {
//     throw new ServerError(response.status, `Server error: ${response.status}`)
//   }
//   return response.json() as Promise<T>
// })
```

