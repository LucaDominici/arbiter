# SonarCloud configuration — generated by arbiter (#211)
# Replace PLACEHOLDER values before your first scan.
sonar.organization=PLACEHOLDER_ORG
sonar.projectKey=PLACEHOLDER_PROJECT_KEY
sonar.projectName=<%= projectName %>
sonar.qualitygate.wait=true
<% if (language === 'java') { %>
sonar.sources=src/main/java
sonar.tests=src/test/java
sonar.java.coveragePlugin=jacoco
sonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
sonar.exclusions=**/generated/**,**/target/**,**/node_modules/**
sonar.cpd.exclusions=**/*DTO.java,**/*Request.java,**/*Response.java
<% } else if (language === 'typescript') { %>
sonar.sources=src
sonar.tests=__tests__
sonar.javascript.lcov.reportPaths=coverage/lcov.info
sonar.exclusions=**/node_modules/**,**/dist/**,**/*.test.ts,**/*.spec.ts
<% } else if (language === 'kotlin') { %>
sonar.sources=src/main/kotlin
sonar.tests=src/test/kotlin,src/test/java
sonar.java.coveragePlugin=jacoco
sonar.coverage.jacoco.xmlReportPaths=build/reports/kover/report.xml
sonar.exclusions=**/generated/**,**/build/**
<% } %>
