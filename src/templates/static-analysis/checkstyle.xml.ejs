<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  <%= projectName %> Checkstyle configuration — generated by arbiter (M29)
  Thresholds: CC≤<%= locals.thresholds ? locals.thresholds.cyclomaticComplexity : 15 %>, method≤<%= locals.thresholds ? locals.thresholds.methodLength : 65 %> lines, params≤<%= locals.thresholds ? locals.thresholds.maxParams : 7 %>, classFanOut≤25
  Re-generate: arbiter update
-->
<module name="Checker">
  <property name="severity" value="error"/>

  <!-- Encoding -->
  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>
  <module name="NewlineAtEndOfFile"/>

  <module name="TreeWalker">

    <!-- Complexity -->
    <module name="CyclomaticComplexity">
      <property name="max" value="<%= locals.thresholds ? locals.thresholds.cyclomaticComplexity : 15 %>"/>
    </module>

    <!-- Method length: body only -->
    <module name="MethodLength">
      <property name="max" value="<%= locals.thresholds ? locals.thresholds.methodLength : 65 %>"/>
      <property name="countEmpty" value="false"/>
    </module>

    <!-- Parameter count -->
    <module name="ParameterNumber">
      <property name="max" value="<%= locals.thresholds ? locals.thresholds.maxParams : 7 %>"/>
    </module>

    <!-- Fan-out: max 25 distinct class references -->
    <module name="ClassFanOutComplexity">
      <property name="max" value="25"/>
    </module>

    <!-- Imports: no star imports, no duplicate imports -->
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <!-- Whitespace & formatting. Empty-body allowances match google-java-format
         (spotless), which collapses empty constructors/methods/types to `{}` —
         without them the two generated tools contradict each other and no file
         with an empty body can satisfy both gates. -->
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors" value="true"/>
      <property name="allowEmptyMethods" value="true"/>
      <property name="allowEmptyTypes" value="true"/>
      <property name="allowEmptyLambdas" value="true"/>
      <property name="allowEmptyLoops" value="true"/>
      <property name="allowEmptyCatches" value="true"/>
    </module>
    <module name="WhitespaceAfter"/>
    <module name="NoWhitespaceBefore"/>
    <module name="EmptyLineSeparator">
      <property name="allowNoEmptyLineBetweenFields" value="true"/>
    </module>

    <!-- Braces -->
    <module name="LeftCurly"/>
    <module name="RightCurly"/>
    <module name="NeedBraces"/>

    <!-- Naming conventions -->
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ConstantName"/>
    <module name="LocalVariableName"/>

    <!-- Enable @SuppressWarnings recognition -->
    <module name="SuppressWarningsHolder"/>

  </module>

  <!-- Activates SuppressWarningsHolder annotations at file level -->
  <module name="SuppressWarningsFilter"/>
</module>
