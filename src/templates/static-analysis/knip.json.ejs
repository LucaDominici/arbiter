{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    <%- archetype === 'cli' ? '"src/cli.ts!"' : '"src/index.ts!"' %><% if (hasPublicApi && (language === 'typescript' || language === 'multi')) { %>,
    "src/middleware/deprecation.ts!",
    "src/middleware/410-gone-handler.ts!",
    "src/middleware/error-handler.ts!",
    "src/middleware/correlation-id.ts!",
    "src/middleware/payload-size-limit.ts!"<% } %>
  ],
  "project": ["src/**/*.ts!"],
  "ignoreDependencies": ["jscpd"<% if ((language === 'typescript' || language === 'multi') && (archetype === 'frontend-spa' || archetype === 'backend-web-db')) { %>, "@playwright/test"<% } %><% if ((language === 'typescript' || language === 'multi') && (archetype === 'frontend-spa' || architectureStyle === 'hexagonal')) { %>, "eslint-plugin-boundaries"<% } %>],
  "ignoreBinaries": [
    "knip",
    "madge",
    "license-checker",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "CC0-1.0",
    "0BSD",
    "Unlicense",
    "Python-2.0"
  ]
}
