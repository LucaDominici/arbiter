# <%= projectName %> golangci-lint configuration — generated by arbiter (M29)
# Peer dep: golangci-lint >= 2.0  (v2 config schema)
# Run: golangci-lint run
# Re-generate: arbiter update
version: "2"
run:
  timeout: 5m

linters:
  default: none
  enable:
    # Complexity
    - gocyclo      # cyclomatic complexity
    - gocognit     # cognitive complexity
    - funlen       # function length
    # Dead code & unused
    - unused
    # Constants & duplication
    - goconst      # repeated string literals that should be constants
    # Security
    - gosec        # security issues (G-rules, equivalent to bandit)
    # Compiler-level checks
    - govet        # go vet
    # Error handling
    - errcheck     # unchecked errors
    # Static analysis
    - staticcheck  # comprehensive static analysis (SA rules)
  settings:
    gocyclo:
      min-complexity: <%= locals.thresholds ? locals.thresholds.cyclomaticComplexity : 15 %>
    gocognit:
      min-complexity: <%= locals.thresholds ? locals.thresholds.cyclomaticComplexity : 15 %>
    funlen:
      lines: <%= locals.thresholds ? locals.thresholds.methodLength : 65 %>
      statements: <%= locals.thresholds ? locals.thresholds.methodLength : 65 %>
    goconst:
      min-len: 3
      min-occurrences: 3
    gosec:
      severity: medium
      confidence: medium
    errcheck:
      check-type-assertions: true
      check-blank: true
  exclusions:
    rules:
      # Test files: allow unhandled errors in assertions
      - path: _test\.go
        linters:
          - errcheck
      # Generated protobuf files
      - path: \.pb\.go
        linters:
          - gocyclo
          - gocognit
          - funlen
          - unused
          - goconst
          - gosec
          - govet
          - errcheck
          - staticcheck

formatters:
  enable:
    - gofmt        # Go standard formatter

issues:
  max-issues-per-linter: 50
  max-same-issues: 10
