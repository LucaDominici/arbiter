{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "env": {
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "no-console": "error",
    "complexity": ["error", <%= locals.thresholds ? locals.thresholds.cyclomaticComplexity : 15 %>],
    "max-params": ["error", <%= locals.thresholds ? locals.thresholds.maxParams : 7 %>],
    "max-depth": ["error", 4],
    "max-lines-per-function": [
      "error",
      { "max": <%= locals.thresholds ? locals.thresholds.methodLength : 100 %>, "skipBlankLines": true, "skipComments": true }
    ],
    "max-nested-callbacks": ["error", 3],
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error"
  }
}
