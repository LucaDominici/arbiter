# detekt configuration — generated by arbiter (#1177)
# Static analysis for Kotlin using io.gitlab.arturbosch.detekt 1.23.x
# Run:   ./gradlew detekt
# Docs:  https://detekt.dev/docs/gettingstarted/gradle
# To generate a full config: ./gradlew detektGenerateConfig
build:
  maxIssues: 0

complexity:
  ComplexMethod:
    threshold: 15
  LongMethod:
    threshold: 60
  TooManyFunctions:
    threshold: 15

naming:
  MemberNameEqualsClassName:
    active: true

style:
  MagicNumber:
    active: true
    excludes: ["**/test/**", "**/Test*/**"]
  WildcardImport:
    active: true
