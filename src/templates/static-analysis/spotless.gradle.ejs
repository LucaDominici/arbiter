// <%= projectName %> Spotless formatting — generated by arbiter (M29)
// Wired automatically: arbiter declares the com.diffplug.spotless plugin in the
// root build's plugins block and applies this script from the arbiter-managed
// block (a plugins {} block here would be ILLEGAL — Gradle forbids the plugins
// DSL inside applied scripts).
// Gate: ./gradlew spotlessCheck (L1 — hard fail)
// Fix: ./gradlew spotlessApply
// Re-generate: arbiter update

spotless {
<%_ if (locals.spotlessRatchetFrom) { _%>
    // Brownfield ratchet: enforce formatting ONLY on files changed since
    // <%= spotlessRatchetFrom %>. Legacy files untouched since that ref pass the
    // gate unformatted; touching one requires formatting it. Delete this line to
    // enforce formatting repo-wide (after a one-off ./gradlew spotlessApply).
    ratchetFrom '<%= spotlessRatchetFrom %>'
<%_ } _%>
    java {
        // Google Java Format — production-grade formatting baseline
        googleJavaFormat('1.22.0').aosp()

        // Remove unused imports (complementary to Checkstyle)
        removeUnusedImports()

        // Trim trailing whitespace
        trimTrailingWhitespace()

        // Ensure newline at end of file
        endWithNewline()

        // Target all Java source sets
        target 'src/**/*.java'
    }
}

// Wire spotlessCheck into the standard check lifecycle
// so that ./gradlew check enforces formatting
check.dependsOn spotlessCheck
