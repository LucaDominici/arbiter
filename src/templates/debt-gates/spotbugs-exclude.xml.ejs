<?xml version="1.0" encoding="UTF-8"?>
<!--
  <%= projectName %> SpotBugs exclude filter — generated by arbiter (M29)

  POLICY:
  - Security-category patterns are NEVER suppressed (injection, traversal, crypto, authentication).
  - Framework false-positives (NP_NONNULL_FIELD, EI_EXPOSE_REP, MS_SHOULD_BE_FINAL) are narrowly
    suppressed by class name pattern only, never by bug code alone.

  Re-generate: arbiter update
-->
<FindBugsFilter>

  <!--
    Framework false-positives: Spring/CDI inject null checks
    @Autowired / @Inject fields are initialized by DI container — SpotBugs cannot see this.
    Suppressed ONLY for classes matching DI naming patterns.
  -->
  <Match>
    <Bug code="NP_NONNULL_FIELD"/>
    <Class name="~.*\.(service|handler|controller|repository|adapter|config|configuration)\.[A-Z].*"/>
  </Match>

  <!--
    Framework false-positives: exposing mutable objects via getters
    Collections returned from DI-managed beans are often intentionally mutable.
    Suppressed ONLY for classes matching DI naming patterns.
  -->
  <Match>
    <Bug code="EI_EXPOSE_REP"/>
    <Class name="~.*\.(dto|model|entity|response|request)\.[A-Z].*"/>
  </Match>
  <Match>
    <Bug code="EI_EXPOSE_REP2"/>
    <Class name="~.*\.(dto|model|entity|response|request)\.[A-Z].*"/>
  </Match>

  <!--
    Framework false-positives: static final fields initialized via static block
    Lombok @FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true) patterns.
  -->
  <Match>
    <Bug code="MS_SHOULD_BE_FINAL"/>
    <Class name="~.*\.(constant|constants|config|configuration)\.[A-Z].*"/>
  </Match>

  <!--
    Null safety with @NonNullApi annotations
    Package-level @NonNullApi marks params non-null by default; Spring callbacks
    and mapping methods may legally receive or pass null in specific patterns.
    Suppressed ONLY for classes that explicitly document nullable parameters.
  -->
  <Match>
    <Or>
      <Class name="~.*\.(service|controller|adapter|mapper|config|entity|repository)\.[A-Z].*"/>
    </Or>
    <Or>
      <Bug pattern="NP_NONNULL_PARAM_VIOLATION"/>
      <Bug pattern="NP_PARAMETER_MUST_BE_NONNULL_BUT_MARKED_AS_NULLABLE"/>
      <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Or>
  </Match>

  <!--
    Optional.orElseThrow() and similar safe null-navigation patterns
    SpotBugs cannot trace through Optional chains; these are safe by design.
  -->
  <Match>
    <Or>
      <Class name="~.*\.(service|controller)\.[A-Z].*"/>
    </Or>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>

  <!--
    Constructor validation (Records, Value Objects, Services)
    Throwing in compact record constructors and service precondition guards
    is intentional fail-fast behaviour, not a bug.
  -->
  <Match>
    <Or>
      <Class name="~.*\.(domain\.model|domain\.vo|dto|request|response|command|query)\.[A-Z].*"/>
    </Or>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!--
    Config/Properties unread fields
    Spring Boot @ConfigurationProperties binds fields via reflection; PMD/SpotBugs
    cannot see the binding and reports them as unread.
  -->
  <Match>
    <Or>
      <Class name="~.*\.(config|configuration|properties)\.[A-Z].*"/>
    </Or>
    <Bug pattern="URF_UNREAD_FIELD"/>
  </Match>

  <!--
    Test helper utilities — targeted, not blanket
    Test fixture/helper/config classes may have unread public fields used
    only by test framework reflection (JUnit @Rule, Spring @MockBean, etc.).
  -->
  <Match>
    <Or>
      <Class name="~.*TestConfig"/>
      <Class name="~.*TestHelper"/>
      <Class name="~.*TestFixture"/>
    </Or>
    <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>

  <!--
    SECURITY PATTERNS — NEVER SUPPRESSED
    Injection, traversal, and all security-category bug codes must never appear
    as Match entries in this file. Any suppression of security findings requires
    a separate documented decision with an expiry date.
  -->

</FindBugsFilter>
