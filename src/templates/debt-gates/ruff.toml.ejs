# <%= projectName %> ruff configuration — generated by arbiter (M29)
# Re-generate: arbiter update
<%- architectureStyle === 'hexagonal' ? 'extend = "ruff-boundaries.toml"' : '' %>

[lint]
# Select rules by category prefix:
#   C9xx  — McCabe complexity
#   PLRxx — Pylint refactor (complexity metrics)
#   F4xx  — pyflakes unused imports
#   S     — bandit security (equivalent)
select = [
  "C901",    # McCabe complexity > max-complexity
  "PLR0911", # Too many return statements
  "PLR0912", # Too many branches
  "PLR0913", # Too many arguments
  "PLR0915", # Too many statements
  "F401",    # Unused import
  "F811",    # Redefinition of unused name from import
  "S",       # Security (bandit equivalent — SQL injection, shell injection, etc.)
  "E",       # pycodestyle errors
  "W",       # pycodestyle warnings
]

# Exclude from security rules: test files (S101 assert, S311 random)
[lint.per-file-ignores]
"tests/**" = ["S101", "S311"]
"test_*.py" = ["S101", "S311"]
"*_test.py" = ["S101", "S311"]

[lint.mccabe]
max-complexity = <%= locals.thresholds ? locals.thresholds.cyclomaticComplexity : 15 %>

[format]
# Match Black defaults for consistency
quote-style = "double"
indent-style = "space"
line-ending = "auto"
