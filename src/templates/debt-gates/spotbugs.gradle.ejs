// spotbugs.gradle — generated by arbiter
// Minimal SpotBugs plugin configuration. Projects tune locally after init.
// Re-generate: arbiter update

plugins {
    id "com.github.spotbugs" version "6.0.18"
}

spotbugs {
    effort = 'max'
    reportLevel = 'medium'
    ignoreFailures = true  // capture-debt-baseline.mjs reads the XML report; gate via debt-report.mjs
}

spotbugsMain {
    reports {
        xml {
            required = true
            outputLocation = file("$buildDir/reports/spotbugs/main.xml")
        }
        html { required = false }
    }
}
