{
  "$schema": "https://github.com/GoogleChrome/lighthouse-ci/blob/main/docs/configuration.md",
  "ci": {
    "collect": {
      "url": ["http://localhost:<%= process.env && process.env.E2E_PORT ? process.env.E2E_PORT : '4173' %>"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "screenEmulation": {
          "mobile": false,
          "width": 1350,
          "height": 940,
          "deviceScaleFactor": 1
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],

        "total-blocking-time": "off",

        "interactive": ["error", { "maxNumericValue": 200 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],

        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      },
      "preset": "no-pwa"
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouse-results",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%-report.%%EXTENSION%%"
    }
  }
}
