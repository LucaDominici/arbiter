{
  "$schema": "https://bundlesize.io/schema",
  "$description": <%- JSON.stringify(`Bundle size budgets for ${projectName}. Generated by arbiter (#1127). Enforced by scripts/check-bundle-size.mjs.`) %>,
  "budgets": [
    {
      "name": "main bundle (JS)",
      "path": "dist/assets/*.js",
      "maxSize": "250kb",
      "maxGzipSize": "75kb"
    },
    {
      "name": "vendor chunk (JS)",
      "path": "dist/assets/vendor-*.js",
      "maxSize": "400kb",
      "maxGzipSize": "120kb"
    },
    {
      "name": "main styles (CSS)",
      "path": "dist/assets/*.css",
      "maxSize": "50kb",
      "maxGzipSize": "12kb"
    }
  ],
  "totals": {
    "maxTotalJsSize": "600kb",
    "maxTotalJsGzipSize": "180kb",
    "maxTotalCssSize": "100kb"
  }
}
