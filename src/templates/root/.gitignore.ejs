# <%= projectName %> — generated by arbiter (skipIfExists: never overwritten)
# Add project-specific entries below.

# Dependencies
node_modules/
vendor/

# Build output
dist/
build/
target/
*.egg-info/
__pycache__/
*.pyc

# Test / coverage artifacts
coverage/
.nyc_output/
*.lcov

# jscpd duplication report (CANON-22 gate byproduct)
report/

# VitePress build temp output
website/.vitepress/.temp/

# Environment / secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Arbiter evidence harness (local retention)
.evidence/

# Arbiter local runtime state.
# `/**` and not `/` (#2313): git cannot re-include a file whose PARENT DIRECTORY
# stays excluded, so a blanket `.arbiter/` makes every negation below dead text.
# The TDD evidence files are carved out because the L2 gate reads them from a
# FRESH CI checkout, and because the produced-here guard in
# scripts/check-tdd-evidence.mjs (#2307) diffs them against the merge-base — an
# untracked evidence file makes that guard permanently inert. Everything else
# under .arbiter/ is machine-local runtime state (plan run history, ship attempt
# counters, worktrees, private notes) and stays ignored.
.arbiter/**
!.arbiter/evidence/
!.arbiter/evidence/tdd/
!.arbiter/evidence/tdd/*.json
.agents-dispatched
.claude/.task-*
.claude/.task/
.claude/plans/

# Arbiter backup turds (written by runtime; never commit)
*.arbiter-backup
.arbiter-generated.json.bak.*
<% /* #1407: stack-aware entries — GREENFIELD-PREVENTION ONLY.
      generateEvidenceRetention renders this with skipIfExists:true, so an
      EXISTING .gitignore is never rewritten. The extended repo-hygiene GATE
      (scripts/check-no-tracked-artifacts.mjs) is the retroactive catch for
      already-tracked artifacts; brownfield .gitignore-merge-on-update is OUT
      of scope (see ADR-047 / follow-up). language is always present; guard
      databaseEngine because it is optional in ProjectConfig (EJS with(locals)
      would throw on a bare reference to an absent key). */ %>
<% if (language === 'go') { %>
# Go compiled binary (module-root, named after the project) (#1407)
/<%= projectName %>
<% } %><% if (language === 'rust') { %>
# Rust build output (#1407)
/target/
<% } %><% if (typeof databaseEngine !== 'undefined' && databaseEngine === 'sqlite') { %>
# SQLite data/state files — must never be committed (#1407, INV-129)
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
<% } %>
