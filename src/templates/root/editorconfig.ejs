root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
<% if (language === 'typescript') { %>
[*.{ts,tsx,js,jsx}]
indent_size = 2
<% } %>
<% if (language === 'go') { %>
[*.go]
indent_style = tab
<% } %>
<% if (language === 'python') { %>
[*.py]
indent_size = 4
<% } %>
<% if (language === 'rust') { %>
[*.{rs,toml}]
indent_size = 4
<% } %>
<% if (language === 'java') { %>
[*.{java,gradle,groovy}]
indent_size = 4
<% } %>
