// PIT mutation testing — L3 hard gate (INV-30)
// Wired automatically: arbiter declares the info.solidsoft.pitest plugin in the
// root build's plugins block and applies this script from the arbiter-managed
// block (a plugins {} block here would be ILLEGAL — Gradle forbids the plugins
// DSL inside applied scripts).
// Run: ./gradlew pitest

pitest {
    targetClasses = [
        '<%= basePackage %>.domain.*',
        '<%= basePackage %>.application.service.*',
        '<%= basePackage %>.application.usecase.*'
    ]
    mutationThreshold = <%= mutationThreshold %>
    coverageThreshold = <%= mutationThreshold %>
    timeoutFactor = 2.0
    timeoutConstInMillis = 10000
    avoidCallsTo = ['java.util.logging', 'org.apache.log4j', 'org.slf4j']
    outputFormats = ['XML', 'HTML']
    withHistory = true
    junit5PluginVersion = '1.2.1'
    failWhenNoMutations = true
}
