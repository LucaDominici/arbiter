{
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": <%= mutationThreshold %>,
    "break": <%= mutationThreshold %>
  },
  "coverageAnalysis": "perTest",
  "timeoutMS": 60000,
  "concurrency": 2,
  "reporters": ["progress", "clear-text", "html"]
}
