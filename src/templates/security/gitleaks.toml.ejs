# <%= projectName %> — Gitleaks configuration
# Generated by arbiter. Managed file — do not delete.
# Docs: https://github.com/gitleaks/gitleaks

[extend]
useDefault = true

[allowlist]
description = "Project-level allowlist (see suppressions/.gitleaksignore)"
paths = [
  '''suppressions/\.gitleaksignore''',
  '''\.gitleaks\.toml''',
]

# Paths that gitleaks scans are controlled via .gitleaksignore
# Individual fingerprint suppressions go in suppressions/.gitleaksignore
# (managed by arbiter suppression system with expiry enforcement)
