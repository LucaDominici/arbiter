<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- ZAP baseline authentication context — <%= projectName %> -->
<!-- Generated by arbiter (#898). Customise loginUrl and credentials for your stack. -->
<!-- Reference: https://www.zaproxy.org/docs/desktop/addons/authentication/ -->
<Context>
  <name><%= projectName %>-baseline-auth</name>
  <desc>Authenticated baseline DAST context for <%= projectName %></desc>
  <inscope>true</inscope>
  <incregexes>http://localhost:8080.*</incregexes>

  <authentication>
    <!-- type 2 = Form-based authentication -->
    <type>2</type>
    <strategy>
      <!-- Login URL: replace with your application's login endpoint -->
      <loginUrl>http://localhost:8080/login</loginUrl>
      <!-- Login request POST body: replace field names to match your form -->
      <loginRequestData>username={%username%}&amp;password={%password%}</loginRequestData>
      <!-- Regex that matches on the response when authentication FAILS -->
      <loggedOutIndicatorPattern>(?i)sign.?in|log.?in|authentication.?required|unauthorized</loggedOutIndicatorPattern>
      <!-- Regex that matches on the response when authentication SUCCEEDS -->
      <loggedInIndicatorPattern>(?i)dashboard|welcome|logout|sign.?out</loggedInIndicatorPattern>
    </strategy>
  </authentication>

  <sessionManagement>
    <!-- type 0 = Cookie-based session management (most web apps) -->
    <type>0</type>
  </sessionManagement>

  <users>
    <user>
      <id>1</id>
      <name>zap-test-user</name>
      <!-- Credentials: replace with a non-privileged test account -->
      <credentials>
        <username>zap_test_user</username>
        <password>REPLACE_WITH_TEST_PASSWORD</password>
      </credentials>
      <enabled>true</enabled>
    </user>
  </users>

  <forcedUser>1</forcedUser>

  <technology>
    <!-- Include/exclude technologies as relevant to your stack -->
    <include>Db.MySQL</include>
    <include>Db.PostgreSQL</include>
    <include>Language.Java</include>
    <include>Language.JavaScript</include>
    <include>Language.Python</include>
    <include>OS.Linux</include>
    <include>WS.Apache</include>
    <include>WS.Nginx</include>
    <include>WS.Tomcat</include>
  </technology>
</Context>
