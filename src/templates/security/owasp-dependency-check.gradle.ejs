// <%= projectName %> — OWASP Dependency-Check configuration
// Generated by arbiter. Wire into your root build.gradle with:
//   apply from: 'config/owasp-dependency-check.gradle'
//
// Then run:   ./gradlew dependencyCheckAnalyze
// Hard gate:  CVSS >= 7.0 fails the build

plugins {
    id 'org.owasp.dependencycheck' version '9.0.10'
}

dependencyCheck {
    failBuildOnCVSS = 7.0f
    suppressionFile = 'suppressions/dependency-check-suppressions.xml'
    format = 'HTML'
    outputDirectory = 'build/reports/dependency-check'
    nvd {
        apiKey = System.getenv('NVD_API_KEY') ?: ''
    }
}
