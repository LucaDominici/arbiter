#!/usr/bin/env bash
# run-postman-tests.sh — Execute Postman/Newman contract tests
#
# Generated by arbiter (#894) — F7: Postman/Newman contract test template
# Emitted when contractType=rest-owned for Java projects.
#
# Prerequisites:
#   npm install -g newman
#   POSTMAN_COLLECTION env var must point to a valid .postman_collection.json
#   SERVICE_BASE_URL must be set (e.g. http://localhost:8080)
#
# Exit codes:
#   0 — all tests passed
#   1 — one or more tests failed
#   2 — environment error (missing collection, service not reachable)

set -euo pipefail

# ─── Configuration ────────────────────────────────────────────────────────────

COLLECTION="${POSTMAN_COLLECTION:-postman/<%= projectName ? projectName.replace(/[^a-z0-9_-]/gi, '-').toLowerCase() : 'api' %>.postman_collection.json}"
BASE_URL="${SERVICE_BASE_URL:-http://localhost:8080}"
ENVIRONMENT_FILE="${POSTMAN_ENVIRONMENT:-}"
RESULTS_DIR="${RESULTS_DIR:-.arbiter/evidence/contract}"
REPORTERS="cli,junit"
JUNIT_OUTPUT="${RESULTS_DIR}/newman-results.xml"
TIMEOUT_MS="${NEWMAN_TIMEOUT_MS:-30000}"
MAX_RETRIES="${NEWMAN_MAX_RETRIES:-2}"

# ─── Validation ───────────────────────────────────────────────────────────────

if ! command -v newman &>/dev/null; then
  echo "[run-postman-tests] ERROR: newman not found. Install: npm install -g newman" >&2
  exit 2
fi

if [[ ! -f "${COLLECTION}" ]]; then
  echo "[run-postman-tests] ERROR: collection not found: ${COLLECTION}" >&2
  echo "  Set POSTMAN_COLLECTION to the path of your .postman_collection.json" >&2
  exit 2
fi

# Wait for the service to be reachable (avoids false failures in CI startup races)
HEALTH_URL="${BASE_URL}/actuator/health"
MAX_WAIT=30
elapsed=0
until curl -sf "${HEALTH_URL}" &>/dev/null || [[ ${elapsed} -ge ${MAX_WAIT} ]]; do
  sleep 2
  elapsed=$((elapsed + 2))
done

if ! curl -sf "${HEALTH_URL}" &>/dev/null; then
  echo "[run-postman-tests] WARNING: service health check failed at ${HEALTH_URL}" >&2
  echo "  Continuing with tests — individual failures will surface below." >&2
fi

# ─── Set up output directory ──────────────────────────────────────────────────

mkdir -p "${RESULTS_DIR}"

# ─── Build newman arguments ───────────────────────────────────────────────────

NEWMAN_ARGS=(
  run "${COLLECTION}"
  --base-url "${BASE_URL}"
  --reporters "${REPORTERS}"
  --reporter-junit-export "${JUNIT_OUTPUT}"
  --timeout-request "${TIMEOUT_MS}"
  --bail
)

if [[ -n "${ENVIRONMENT_FILE}" && -f "${ENVIRONMENT_FILE}" ]]; then
  NEWMAN_ARGS+=(--environment "${ENVIRONMENT_FILE}")
fi

if [[ "${INJECT_PACT_SAMPLES:-false}" == "true" ]]; then
  echo "[run-postman-tests] Injecting Pact samples before test run..."
  bash "$(dirname "$0")/inject-pact-samples.sh"
fi

# ─── Execute with retry ───────────────────────────────────────────────────────

attempt=0
exit_code=0

while [[ ${attempt} -le ${MAX_RETRIES} ]]; do
  attempt=$((attempt + 1))
  echo "[run-postman-tests] Attempt ${attempt} / $((MAX_RETRIES + 1))..."
  set +e
  newman "${NEWMAN_ARGS[@]}"
  exit_code=$?
  set -e

  if [[ ${exit_code} -eq 0 ]]; then
    break
  fi

  if [[ ${attempt} -le ${MAX_RETRIES} ]]; then
    echo "[run-postman-tests] Attempt ${attempt} failed (exit ${exit_code}), retrying in 5s..." >&2
    sleep 5
  fi
done

# ─── Summary ──────────────────────────────────────────────────────────────────

if [[ ${exit_code} -eq 0 ]]; then
  echo "[run-postman-tests] All contract tests passed. Results: ${JUNIT_OUTPUT}"
else
  echo "[run-postman-tests] Contract tests failed (exit ${exit_code}). Results: ${JUNIT_OUTPUT}" >&2
fi

exit ${exit_code}
