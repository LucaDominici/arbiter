<%
// #1319.2 — INV-73: the required CI-tier set is the EXACT inverse of the
// generation predicates in src/generators/github.ts. The config is known at
// generation time, so we resolve the set HERE (render-time EJS) instead of
// guessing at runtime via existsSync heuristics.
//
//   required = [01, 02, 03]                                  (always)
//   + 05-release                if style !== 'starter'
//   + 06-nightly,07-weekly,08-monthly
//                               if style !== 'starter' && L3+ && cm !== 'trunk-solo'
//   + 06-nightly-lite           if cm === 'trunk-solo' && L2+
//   + 09-heartbeat              if L3+
//
// style === 'starter' iff resolvePipelineStyle(cm, level) === 'starter'
// (or ciTierMode === 'baseline'); cm is resolved with the enableSoloDevMode alias.
const _level = governanceLevel;
const _isL2Plus = _level === 'L2' || _level === 'L3' || _level === 'L4';
const _isL3Plus = _level === 'L3' || _level === 'L4';
const _cm =
  typeof collaborationMode !== 'undefined' && collaborationMode
    ? collaborationMode
    : (typeof enableSoloDevMode !== 'undefined' && enableSoloDevMode) ? 'trunk-solo' : 'peer-review';
// PIPELINE_STYLE_TABLE (src/config/collaboration-mode-defaults.ts) — only the
// 'starter' verdict matters here.
const _styleTable = {
  'trunk-solo': { L1: 'starter', L2: 'starter', L3: 'standard', L4: 'standard' },
  'peer-review': { L1: 'starter', L2: 'standard', L3: 'standard', L4: 'standard' },
  'gated-review': { L1: 'standard', L2: 'standard', L3: 'industrial', L4: 'industrial' },
};
let _style;
if (typeof pipelineStyle !== 'undefined' && pipelineStyle) {
  _style = pipelineStyle;
} else if (typeof ciTierMode !== 'undefined' && ciTierMode === 'baseline') {
  _style = 'starter';
} else {
  _style = (_styleTable[_cm] && _styleTable[_cm][_level]) || 'standard';
}
const _required = ['01-pr-fast.yml', '02-pr-extended.yml', '03-human-approval.yml'];
if (_style !== 'starter') _required.push('05-release.yml');
if (_style !== 'starter' && _isL3Plus && _cm !== 'trunk-solo') {
  _required.push('06-nightly.yml', '07-weekly.yml', '08-monthly.yml');
}
if (_cm === 'trunk-solo' && _isL2Plus) _required.push('06-nightly-lite.yml');
// PORT A2 (#1502): trunk-solo L3+ gets the lite weekly sweep (07-weekly-lite).
if (_cm === 'trunk-solo' && _isL3Plus) _required.push('07-weekly-lite.yml');
if (_isL3Plus) _required.push('09-heartbeat.yml');
-%>
#!/usr/bin/env node
// <%= projectName %> — CI tier presence gate (INV-73)
// Gate: verify the required CI workflow files exist in .github/workflows/.
// The required set is fixed at generation time as the inverse of the workflow
// generation predicates (collaboration mode <%= _cm %> × governance <%= _level %>).
// Exits 0: all required present.
// Exits 1: one or more missing.
// Part of the anti-drift validator family (W6).
// Usage: node scripts/check-ci-tiers.mjs [--help]
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

if (process.argv.includes('--help') || process.argv.includes('-h')) {
  process.stdout.write('Usage: node scripts/check-ci-tiers.mjs [--help]\nVerify all required CI tier workflow files exist.\n');
  process.exit(0);
}

const CWD = process.cwd();
const WORKFLOWS_DIR = join(CWD, '.github', 'workflows');

// Required CI-tier files for this project (collaboration mode + governance level
// resolved at generation time — INV-73).
const REQUIRED_TIERS = [
<% _required.forEach((f) => { -%>
  '<%= f %>',
<% }); -%>
];

const missing = REQUIRED_TIERS.filter((f) => !existsSync(join(WORKFLOWS_DIR, f)));

<% if (_isL3Plus) { -%>
// ─── INV-73 content strictness (#1720) ───────────────────────────────────────
// Existence alone missed a real regression: a hand-rolled template guard bug
// (05-release.yml.ejs's `_slsaL3` boolean) silently rendered a WEAKER release
// workflow at L4 than at L3 while the file still existed — this gate stayed
// green throughout. At L3+, when 05-release.yml is required and present, also
// assert its CONTENT declares L3 hermetic SLSA provenance, not merely that the
// file is there.
let contentViolation = null;
if (REQUIRED_TIERS.includes('05-release.yml') && !missing.includes('05-release.yml')) {
  const releaseContent = readFileSync(join(WORKFLOWS_DIR, '05-release.yml'), 'utf-8');
  if (!releaseContent.includes('L3 hermetic')) {
    contentViolation = '05-release.yml is present but missing L3 hermetic SLSA provenance (INV-73 content check)';
  }
}
<% } -%>

if (missing.length === 0<% if (_isL3Plus) { %> && !contentViolation<% } %>) {
  console.log(`  check-ci-tiers: all ${REQUIRED_TIERS.length} required CI tier workflow(s) present<% if (_isL3Plus) { %> and content-verified<% } %>`);
  process.exit(0);
}

if (missing.length > 0) {
  console.log(`  check-ci-tiers: ${missing.length} missing workflow file(s):`);
  for (const f of missing) {
    console.log(`    missing: .github/workflows/${f}`);
  }
}
<% if (_isL3Plus) { -%>
if (contentViolation) {
  console.log(`  check-ci-tiers: content violation: ${contentViolation}`);
}
<% } -%>
process.exit(1);
