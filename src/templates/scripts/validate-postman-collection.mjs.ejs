// validate-postman-collection.mjs — Postman collection structural validator
//
// Generated by arbiter (#896) — F9: API contract baselines template
// Emitted when contractType=rest-owned for Java projects.
//
// Purpose:
//   Validates that the project's Postman collection file is structurally complete:
//   - Collection v2.1 schema compliance (required keys present)
//   - All requests have at least one test assertion
//   - No requests reference undefined variables
//   - Newman-compatible (no unsupported auth types)
//
// Usage:
//   node scripts/validate-postman-collection.mjs [--collection <path>]
//
// Exit codes:
//   0 — collection valid
//   1 — structural errors found
//   2 — collection file not found

import { readFileSync, existsSync } from 'node:fs'
import { resolve } from 'node:path'

const args = process.argv.slice(2)
const colIdx = args.indexOf('--collection')
const DEFAULT_COLLECTION = 'postman/<%= projectName ? projectName.replace(/[^a-z0-9_-]/gi, "-").toLowerCase() : "api" %>.postman_collection.json'
const COLLECTION_PATH = resolve(
  colIdx >= 0 ? args[colIdx + 1] : (process.env.POSTMAN_COLLECTION ?? DEFAULT_COLLECTION),
)

if (!existsSync(COLLECTION_PATH)) {
  console.error(`[validate-postman-collection] ERROR: collection not found: ${COLLECTION_PATH}`)
  console.error('  Set POSTMAN_COLLECTION env var or pass --collection <path>')
  process.exit(2)
}

let collection
try {
  collection = JSON.parse(readFileSync(COLLECTION_PATH, 'utf-8'))
} catch (err) {
  console.error(`[validate-postman-collection] ERROR: invalid JSON in collection: ${err.message}`)
  process.exit(1)
}

let exitCode = 0
const errors = []
const warnings = []

// ─── Schema compliance ────────────────────────────────────────────────────────

const info = collection.info ?? {}
if (!info.name) {
  errors.push('collection.info.name is missing')
  exitCode = 1
}
if (!info.schema) {
  warnings.push('collection.info.schema is missing — cannot confirm Postman v2.1 compliance')
} else if (!info.schema.includes('v2.1')) {
  warnings.push(`collection schema is not v2.1: ${info.schema}`)
}

if (!Array.isArray(collection.item)) {
  errors.push('collection.item is missing or not an array — no requests defined')
  exitCode = 1
}

// ─── Request validation ───────────────────────────────────────────────────────

function validateItems(items, path = '') {
  let requestCount = 0
  let assertionCount = 0
  const undefinedVars = new Set()

  for (const item of items ?? []) {
    const itemPath = path ? `${path} > ${item.name}` : item.name
    if (Array.isArray(item.item)) {
      // Folder — recurse
      const sub = validateItems(item.item, itemPath)
      requestCount += sub.requestCount
      assertionCount += sub.assertionCount
      sub.undefinedVars.forEach((v) => undefinedVars.add(v))
      continue
    }
    if (!item.request) continue

    requestCount++

    // Check for test assertions
    const events = item.event ?? []
    const testEvent = events.find((e) => e.listen === 'test')
    if (!testEvent || !testEvent.script?.exec?.join('').includes('pm.test')) {
      warnings.push(`no pm.test assertion in: ${itemPath}`)
    } else {
      assertionCount++
    }

    // Check for undefined variables ({{VAR}} pattern)
    const urlStr = JSON.stringify(item.request.url ?? '')
    const headerStr = JSON.stringify(item.request.header ?? [])
    const bodyStr = JSON.stringify(item.request.body ?? {})
    const combined = urlStr + headerStr + bodyStr
    const varMatches = combined.match(/\{\{([^}]+)\}\}/g) ?? []
    for (const match of varMatches) {
      const varName = match.slice(2, -2)
      // Common environment variables are expected — only flag truly unknown ones
      const knownVars = ['baseUrl', 'BASE_URL', 'host', 'port', 'token', 'authToken', 'apiKey']
      if (!knownVars.includes(varName)) {
        undefinedVars.add(`{{${varName}}} in ${itemPath}`)
      }
    }
  }

  return { requestCount, assertionCount, undefinedVars }
}

const { requestCount, assertionCount, undefinedVars } = validateItems(collection.item)

if (requestCount === 0) {
  errors.push('collection contains no requests')
  exitCode = 1
} else {
  console.log(
    `[validate-postman-collection] ${requestCount} request(s) found, ${assertionCount} with pm.test assertions`,
  )
}

if (undefinedVars.size > 0) {
  console.warn('[validate-postman-collection] WARN: potentially undefined variables:')
  for (const v of undefinedVars) {
    console.warn(`  ${v}`)
  }
}

// ─── Newman compatibility ─────────────────────────────────────────────────────

const authType = collection.auth?.type
const UNSUPPORTED_NEWMAN_AUTH = ['ntlm', 'hawk']
if (authType && UNSUPPORTED_NEWMAN_AUTH.includes(authType)) {
  errors.push(`auth type "${authType}" is not supported by newman`)
  exitCode = 1
}

// ─── Summary ─────────────────────────────────────────────────────────────────

for (const w of warnings) {
  console.warn(`[validate-postman-collection] WARN: ${w}`)
}

if (errors.length > 0) {
  console.error('\n[validate-postman-collection] FAILURES:')
  for (const e of errors) {
    console.error(`  ${e}`)
  }
} else {
  console.log(`[validate-postman-collection] OK: collection "${info.name}" is newman-compatible`)
}

process.exit(exitCode)
