#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// CATALOG: Generates docs/INDEX.md from frontmatter across the target documentation corpus.
// CATALOG: Stays separate from link validation because it writes the canonical inventory artifact.
// CATALOG: The --check mode makes documentation inventory drift a gate failure.
import { readFileSync, writeFileSync, existsSync, readdirSync, statSync } from 'node:fs';
import { join, relative, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';
import { execFileSync } from 'node:child_process';
const SKIP_SEGMENTS = new Set(['report']);
function gitTrackedDocPaths(root) { try { return new Set(execFileSync('git', ['ls-files', 'docs/'], { cwd: root, encoding: 'utf-8' }).split('\n').filter(Boolean)); } catch { return null; } }
function parseFrontmatter(content) { if (!content.startsWith('---\n')) return {}; const end = content.indexOf('\n---', 4); if (end === -1) return {}; const fm = {}; for (const line of content.slice(4, end).split('\n')) { const match = line.match(/^([a-z_]+):\s*(.*)$/); if (!match) continue; const raw = match[2].trim(); fm[match[1]] = raw.startsWith('[') ? [...raw.matchAll(/'([^']+)'|"([^"]+)"/g)].map((item) => item[1] ?? item[2]) : raw.replace(/^['"]|['"]$/g, ''); } return fm; }
function firstH1(content) { return content.match(/^#\s+(.+)$/m)?.[1].trim() ?? ''; }
function walkMarkdown(dir, indexPath) { const out = []; for (const entry of readdirSync(dir)) { const full = join(dir, entry); if (statSync(full).isDirectory()) { if (!SKIP_SEGMENTS.has(entry)) out.push(...walkMarkdown(full, indexPath)); } else if (entry.endsWith('.md') && full !== indexPath) out.push(full); } return out; }
function tableRow(record) { return `| [${record.title}](${record.relPath}) | ${record.id || '—'} | ${record.status} | ${record.kind || '—'} |`; }
export function collectDocs(docsDir, indexPath) { const root = resolve(docsDir, '..'); const tracked = gitTrackedDocPaths(root); return walkMarkdown(docsDir, indexPath).filter((file) => tracked === null || tracked.has(relative(root, file).split(sep).join('/'))).sort().map((file) => { const content = readFileSync(file, 'utf-8'); const fm = parseFrontmatter(content); const relPath = relative(docsDir, file).split(sep).join('/'); const tags = Array.isArray(fm.tags) ? fm.tags : []; return { relPath, title: (fm.title || firstH1(content) || relPath).replace(/\|/g, '\\|'), id: fm.canonical_id || '', status: fm.status || '—', kind: tags.find((tag) => tag.startsWith('kind/')) ?? '', tags }; }); }
export function buildIndex(records) { const groups = new Map(); for (const record of records) { const key = record.relPath.split('/').length > 1 ? record.relPath.split('/')[0] : ''; if (!groups.has(key)) groups.set(key, []); groups.get(key).push(record); } const header = `# Documentation Index\n\n> Generated by \`scripts/gen-doc-index.mjs\` from doc frontmatter. Do not edit by hand;\n> run \`node scripts/gen-doc-index.mjs\` after adding or relabeling a doc.\n\n${records.length} documents.\n\n`; const table = '| title | canonical_id | status | kind |\n|-------|--------------|--------|------|\n'; const rootDocs = groups.get('') ?? []; const dirs = [...groups.entries()].filter(([key]) => key !== '').sort(([a], [b]) => a.localeCompare(b)); const sections = []; if (rootDocs.length) sections.push(`## docs\n\n${table}${rootDocs.map(tableRow).join('\n')}\n`); for (const [dir, docs] of dirs) sections.push(`## ${dir}\n\n${table}${docs.map(tableRow).join('\n')}\n`); return header + sections.join('\n'); }
export async function runCli(docsDir, indexPath, check) { try { const generated = buildIndex(collectDocs(docsDir, indexPath)); if (check) { if ((existsSync(indexPath) ? readFileSync(indexPath, 'utf-8') : '') !== generated) { process.stderr.write('docs/INDEX.md is stale. Run `node scripts/gen-doc-index.mjs` and commit the result.\n'); return 1; } process.stdout.write('docs/INDEX.md is up to date.\n'); return 0; } writeFileSync(indexPath, generated); process.stdout.write(`Wrote ${indexPath}\n`); return 0; } catch (err) { process.stderr.write(`gen-doc-index: ${err instanceof Error ? err.message : String(err)}\n`); return 1; } }
if (process.argv[1] === fileURLToPath(import.meta.url)) { const root = resolve('.'); runCli(join(root, 'docs'), join(root, 'docs', 'INDEX.md'), process.argv.includes('--check')).then((code) => process.exit(code)).catch((err) => { process.stderr.write(`gen-doc-index: ${err instanceof Error ? err.message : String(err)}\n`); process.exit(1); }); }
