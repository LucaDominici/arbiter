#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// CATALOG: Generates the agent-facing llms.txt index from its hand-maintained target config.
// CATALOG: Stays separate from the doc index because it validates curated public entry points.
// CATALOG: The --check mode detects drift without ever rewriting a target during a gate run.
import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
function renderEntry(entry) { const extra = (entry.extraLinks ?? []).map(([label, path]) => `, [${label}](${path})`).join(''); return `- [${entry.label}](${entry.path})${extra}: ${entry.description}`; }
export function buildLlmsTxt(config, { docCount }) { const sections = config.sections.map((section) => `## ${section.heading}\n\n${section.entries.map(renderEntry).join('\n')}`); return (`# ${config.title}\n\n> ${config.summary}\n\n${config.intro}\n\n${sections.join('\n\n')}`).replace(/\{\{docCount\}\}/g, String(docCount)); }
export function readDocCount(indexPath) { const match = readFileSync(indexPath, 'utf-8').match(/^(\d+) documents\.$/m); if (!match) throw new Error(`could not parse doc count ("N documents.") from ${indexPath}`); return Number(match[1]); }
function extractProseLinkTargets(text) { const targets = []; const re = /\[[^\]]*\]\(([^)]+)\)/g; let match; while ((match = re.exec(text))) if (!match[1].startsWith('#') && !/^[a-z]+:/i.test(match[1])) targets.push(match[1]); return targets; }
export function findMissingPaths(config, root) { const missing = []; for (const section of config.sections) for (const entry of section.entries) for (const path of [entry.path, ...(entry.extraLinks ?? []).map(([, extraPath]) => extraPath), ...extractProseLinkTargets(entry.description ?? '')]) if (!existsSync(resolve(root, path.replace(/\/$/, '')))) missing.push(path); return missing; }
function loadConfig(path) { if (!existsSync(path)) return { error: `config not found: ${path}` }; try { return { config: JSON.parse(readFileSync(path, 'utf-8')) }; } catch (err) { return { error: `invalid JSON in ${path}: ${err instanceof Error ? err.message : String(err)}` }; } }
function loadDocCount(path) { try { return { docCount: readDocCount(path) }; } catch (err) { return { error: err instanceof Error ? err.message : String(err) }; } }
function checkDrift(path, generated) { if ((existsSync(path) ? readFileSync(path, 'utf-8') : '') !== generated) { process.stderr.write('llms.txt is stale. Run `node scripts/gen-llms-txt.mjs` and commit the result.\n'); return 1; } process.stdout.write('llms.txt is up to date.\n'); return 0; }
export async function runCli(configPath, indexPath, outPath, check) { try { const { config, error: configErr } = loadConfig(configPath); if (configErr) { process.stderr.write(`gen-llms-txt: ${configErr}\n`); return 2; } const { docCount, error: countErr } = loadDocCount(indexPath); if (countErr) { process.stderr.write(`gen-llms-txt: ${countErr}\n`); return 2; } const missing = findMissingPaths(config, resolve(configPath, '..')); if (missing.length) { process.stderr.write(`gen-llms-txt: path(s) in ${configPath} do not exist: ${missing.join(', ')}. Update the config.\n`); return 2; } const generated = buildLlmsTxt(config, { docCount }); if (check) return checkDrift(outPath, generated); writeFileSync(outPath, generated); process.stdout.write(`Wrote ${outPath}\n`); return 0; } catch (err) { process.stderr.write(`gen-llms-txt: ${err instanceof Error ? err.message : String(err)}\n`); return 2; } }
if (process.argv[1] === fileURLToPath(import.meta.url)) { const arg = (flag) => process.argv.find((value) => value.startsWith(flag))?.split('=')[1]; const root = resolve('.'); const configPath = arg('--config=') ? resolve(arg('--config=')) : resolve(root, 'llms-txt.config.json'); const indexPath = arg('--index=') ? resolve(arg('--index=')) : resolve(root, 'docs/INDEX.md'); const outPath = arg('--out=') ? resolve(arg('--out=')) : resolve(root, 'llms.txt'); runCli(configPath, indexPath, outPath, process.argv.includes('--check')).then((code) => process.exit(code)).catch((err) => { process.stderr.write(`gen-llms-txt: ${err instanceof Error ? err.message : String(err)}\n`); process.exit(2); }); }
