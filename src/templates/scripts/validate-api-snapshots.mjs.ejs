// validate-api-snapshots.mjs — API contract snapshot changeset validator
//
// Generated by arbiter (#896) — F9: API contract baselines template
// Emitted when contractType=rest-owned for Java projects.
//
// Purpose:
//   Verifies that the api-snapshots/ JSON baseline files are structurally sound
//   and reports any missing or malformed snapshot files. Run this before committing
//   snapshot updates to catch accidental contract breakage.
//
// Usage:
//   node scripts/validate-api-snapshots.mjs [--dir src/test/resources/api-snapshots]
//
// Exit codes:
//   0 — all snapshots valid
//   1 — one or more snapshots invalid or missing

import { readFileSync, readdirSync, existsSync } from 'node:fs'
import { join, resolve } from 'node:path'

const args = process.argv.slice(2)
const dirIdx = args.indexOf('--dir')
const SNAPSHOTS_DIR = resolve(
  dirIdx >= 0 ? args[dirIdx + 1] : 'src/test/resources/api-snapshots',
)

// Expected snapshot filenames — update this list when new baselines are added.
const EXPECTED_SNAPSHOTS = [
  'openapi-baseline.json',
  'openapi-paths-baseline.json',
  'openapi-response-status-baseline.json',
  'openapi-content-types-baseline.json',
  'openapi-required-fields-baseline.json',
  'config-response-baseline.json',
  'config-keys-baseline.json',
  'enum-values-baseline.json',
  'error-shape-baseline.json',
  'test-snapshot.json',
]

let exitCode = 0
const errors = []

if (!existsSync(SNAPSHOTS_DIR)) {
  console.error(`[validate-api-snapshots] ERROR: directory not found: ${SNAPSHOTS_DIR}`)
  console.error('  Run the contract test suite once with SNAPSHOT_UPDATE=true to generate baselines.')
  process.exit(1)
}

// Check each expected snapshot exists and is valid JSON
for (const name of EXPECTED_SNAPSHOTS) {
  const filePath = join(SNAPSHOTS_DIR, name)
  if (!existsSync(filePath)) {
    errors.push(`MISSING: ${name}`)
    exitCode = 1
    continue
  }
  try {
    const raw = readFileSync(filePath, 'utf-8')
    JSON.parse(raw)
    console.log(`[validate-api-snapshots] OK: ${name}`)
  } catch {
    errors.push(`INVALID JSON: ${name}`)
    exitCode = 1
  }
}

// Report any unexpected files (informational, not an error)
const actual = readdirSync(SNAPSHOTS_DIR).filter((f) => f.endsWith('.json'))
const unexpected = actual.filter((f) => !EXPECTED_SNAPSHOTS.includes(f))
if (unexpected.length > 0) {
  console.warn(`[validate-api-snapshots] WARN: unexpected snapshot files (not in expected list):`)
  for (const f of unexpected) {
    console.warn(`  ${f}`)
  }
}

if (errors.length > 0) {
  console.error('\n[validate-api-snapshots] FAILURES:')
  for (const e of errors) {
    console.error(`  ${e}`)
  }
}

process.exit(exitCode)
