#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// scripts/audit-toolchain.mjs
// Toolchain audit for <%= projectName %> — generated by arbiter.
// DO NOT EDIT by hand — re-run `arbiter update` to regenerate.
//
// Checks that required CI workflow files, gate scripts, and build toolchain
// are present and functional. Reports pass/fail per check.
//
// Exit codes:
//   0 — all checks pass
//   1 — one or more checks failed
import { existsSync, readFileSync } from 'node:fs'
import { resolve, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = dirname(fileURLToPath(import.meta.url))
const repoRoot = resolve(__dirname, '..')

const GREEN = '\x1b[32m'
const RED = '\x1b[31m'
const RESET = '\x1b[0m'

let passed = 0
let failed = 0

function pass(label) {
  process.stdout.write(`  ${GREEN}PASS${RESET}  ${label}\n`)
  passed++
}

function fail(label, detail) {
  process.stdout.write(`  ${RED}FAIL${RESET}  ${label}${detail ? ` — ${detail}` : ''}\n`)
  failed++
}

function checkExists(label, relPath) {
  const abs = resolve(repoRoot, relPath)
  if (existsSync(abs)) {
    pass(label)
  } else {
    fail(label, `missing: ${relPath}`)
  }
}

// ─── 1. Required CI workflow files ───────────────────────────────────────────

process.stdout.write('\n=== Check: CI workflow files ===\n')

const REQUIRED_WORKFLOWS = [
  '.github/workflows/01-pr-fast.yml',
  '.github/workflows/02-pr-extended.yml',
  '.github/workflows/05-release.yml',
  '.github/workflows/06-nightly.yml',
]

for (const wf of REQUIRED_WORKFLOWS) {
  checkExists(`workflow ${wf}`, wf)
}

// ─── 2. Required gate scripts ─────────────────────────────────────────────────

process.stdout.write('\n=== Check: Gate scripts ===\n')

const REQUIRED_SCRIPTS = [
  'scripts/check-all.mjs',
  'scripts/check-drift.mjs',
  'scripts/check-docs.mjs',
  'scripts/check-doc-links.mjs',
]

for (const s of REQUIRED_SCRIPTS) {
  checkExists(`script ${s}`, s)
}

// ─── 3. CLI buildability ──────────────────────────────────────────────────────

process.stdout.write('\n=== Check: CLI buildability ===\n')

const pkgPath = resolve(repoRoot, 'package.json')
if (!existsSync(pkgPath)) {
  fail('package.json exists', 'not found')
} else {
  pass('package.json exists')

  let pkg
  try {
    pkg = JSON.parse(readFileSync(pkgPath, 'utf-8'))
  } catch {
    pkg = null
  }

  if (pkg && pkg.scripts && pkg.scripts.build) {
    pass('build script defined in package.json')
  } else {
    fail('build script defined in package.json', 'scripts.build missing')
  }
}

// ─── Result ───────────────────────────────────────────────────────────────────

process.stdout.write('\n' + '─'.repeat(52) + '\n')
process.stdout.write(`Passed: ${passed}  Failed: ${failed}\n`)
process.stdout.write('─'.repeat(52) + '\n\n')

process.exit(failed > 0 ? 1 : 0)
