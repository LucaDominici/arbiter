{
<% if (language === 'typescript') { -%>
  complexityViolations: Object.freeze([
    'npx',
    'eslint',
    'src',
    'scripts',
    '--format',
    'json',
    '--rule',
    '{"complexity":["warn",10]}',
  ]),
<% } else if (language === 'rust') { -%>
  complexityViolations: Object.freeze([
    'cargo',
    'clippy',
    '--message-format=json',
    '--',
    '-W',
    'clippy::cognitive_complexity',
    '-W',
    'dead_code',
  ]),
<% } -%>
}
