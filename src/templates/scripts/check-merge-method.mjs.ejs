#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// INV-101 enforcement (generated by arbiter): verify the ff-only merge policy
// flags are present in scripts/apply-branch-protection.mjs. Fails closed — an
// arbiter project that ships the branch-protection script but drops the flags
// (or the whole file) is a policy regression, not a skip.
// Usage: node scripts/check-merge-method.mjs [--config=<path>]

import { readFileSync, existsSync } from 'node:fs'
import { resolve, join } from 'node:path'

const VALUE_PATTERNS = {
  allow_squash_merge: /allow_squash_merge\s*[=:]\s*false/,
  allow_rebase_merge: /allow_rebase_merge\s*[=:]\s*false/,
  required_linear_history: /required_linear_history\s*[=:]\s*true/,
}

function resolveConfigPath(args) {
  const flag = args.find((a) => a.startsWith('--config='))
  if (flag) return resolve(flag.slice('--config='.length))
  return resolve(process.cwd(), 'arbiter.json')
}

try {
  const configPath = resolveConfigPath(process.argv.slice(2))
  const cwd = resolve(process.cwd())

  // Not an arbiter project (no arbiter.json) → nothing to enforce.
  if (!existsSync(configPath)) {
    process.exit(0)
  }

  const bpPath = join(cwd, 'scripts', 'apply-branch-protection.mjs')

  // Fail closed: this is a GitHub-enabled arbiter project, so the branch-protection
  // script must exist. Its absence means the ff-only policy is not enforced.
  if (!existsSync(bpPath)) {
    process.stderr.write(
      `[INV-101] ff-only merge enforcement missing: scripts/apply-branch-protection.mjs not found.\n`,
    )
    process.exit(1)
  }

  const content = readFileSync(bpPath, 'utf-8')
  const missing = Object.entries(VALUE_PATTERNS)
    .filter(([, pattern]) => !pattern.test(content))
    .map(([flag]) => flag)

  if (missing.length > 0) {
    for (const flag of missing) {
      process.stderr.write(
        `[INV-101] scripts/apply-branch-protection.mjs missing ff-only flag '${flag}' with correct value\n`,
      )
    }
    process.stderr.write(
      `[INV-101] ff-only merge enforcement incomplete: allow_squash_merge:false, allow_rebase_merge:false, required_linear_history:true must all be present.\n`,
    )
    process.exit(1)
  }

  process.stdout.write('ff-only merge flags present in scripts/apply-branch-protection.mjs\n')
  process.exit(0)
} catch (err) {
  process.stderr.write(
    `[INV-101] Unexpected error: ${err instanceof Error ? err.message : String(err)}\n`,
  )
  process.exit(1)
}
