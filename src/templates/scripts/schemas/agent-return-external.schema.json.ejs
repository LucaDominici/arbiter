{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arbiter.dev/schemas/agent-return-external/v1",
  "title": "ArbiterExternalAgentReturn",
  "description": "Reduced structured-output projection for an external reviewer. The recorder adds the arbiter-agent-return-v1 envelope and stamps authority fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "confidence", "findings", "refutations"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "confidence": {
      "type": "number"
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Finding" }
    },
    "refutations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Refutation" }
    }
  },
  "$defs": {
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "kind", "claim", "citations"],
      "properties": {
        "id": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["critical", "high", "med", "low", "info"]
        },
        "kind": {
          "type": "string",
          "enum": ["structural", "behavioral", "process", "style"]
        },
        "claim": { "type": "string" },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Citation" }
        }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer" }
      }
    },
    "Refutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "verdict"],
      "properties": {
        "target": { "type": "string" },
        "verdict": {
          "type": "string",
          "enum": ["UPHELD", "REFUTED"]
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Citation" }
        }
      }
    }
  }
}
