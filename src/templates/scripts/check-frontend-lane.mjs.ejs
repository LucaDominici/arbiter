#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// #1330 — per-lane frontend gate (generated by arbiter).
//
// Gates the `frontend/` SUBTREE lane in a polyglot repo whose PRIMARY language is
// NOT the frontend (e.g. a Go/Python/Java/Rust backend with a `frontend/` SPA beside
// it). The primary-language gate in check-all.mjs only covers the backend; without
// this script the FE lane's typecheck/test/build would never run in any generated gate.
//
// Lanes-axis driven: emitted only when arbiter.json declares a `frontend` lane on a
// non-frontend-spa archetype (a root-level frontend-spa app keeps its own root wiring).
//
// Usage: node scripts/check-frontend-lane.mjs [L1|full]
//   L1   (default): typecheck + unit tests inside frontend/.
//   full          : also runs the production build (vite/webpack/etc.).
//
// Every step is GATE-ON-PRESENT: a missing `frontend/` subtree, a missing
// frontend/package.json, or un-installed frontend/node_modules SKIPs cleanly (exit 0)
// rather than false-failing a partial setup. A present step that genuinely fails is a
// HARD failure (exit 1) — no soft-fail for the FE lane.

import { existsSync } from 'node:fs'
import { spawnSync } from 'node:child_process'

const mode = process.argv[2] === 'full' ? 'full' : 'L1'
let failed = 0

function run(name, cmd, args, opts = {}) {
  process.stdout.write(`[FE-LANE] ${name} ... `)
  const r = spawnSync(cmd, args, { encoding: 'utf-8', shell: false, ...opts })
  if (r.error?.code === 'ENOENT') {
    console.log(`SKIP (binary not found: ${cmd})`)
    return
  }
  if (r.status === 0) {
    console.log('PASS')
  } else {
    console.log('FAIL')
    process.stdout.write((r.stdout ?? '') + (r.stderr ?? ''))
    failed++
  }
}

// ── Gate-on-present: the subtree (and its manifest) must exist ────────────────
if (!existsSync('frontend/package.json')) {
  console.log('[FE-LANE] SKIP — no frontend/package.json (frontend lane has no subtree to gate)')
  process.exit(0)
}

// ── Gate-on-present: subtree deps must be installed ──────────────────────────
// Locally the developer may not have run `npm ci --prefix frontend`; the CI
// workflow (18-frontend-lane.yml) installs them first. Skip rather than ENOENT-fail.
if (!existsSync('frontend/node_modules')) {
  console.log(
    '[FE-LANE] SKIP — frontend/node_modules absent (run: npm ci --prefix frontend)',
  )
  process.exit(0)
}

// ── L1: typecheck + unit tests, executed inside the subtree (cwd: 'frontend') ──
run('typecheck', 'npx', ['tsc', '--noEmit'], { cwd: 'frontend' })
run('unit tests', 'npx', ['vitest', 'run'], { cwd: 'frontend' })

// ── full: production build ───────────────────────────────────────────────────
if (mode === 'full') {
  run('build', 'npm', ['run', 'build'], { cwd: 'frontend' })
}

if (failed > 0) {
  console.error(`\n[FE-LANE] FAILED: ${failed} check(s)`)
  process.exit(1)
}
console.log('\n[FE-LANE] ALL PASSED')
