#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// scripts/check-oracle-discrimination.mjs — generated by arbiter (anti-fake-green, #2160).
//
// Oracle-discrimination guard. An E2E wait written as `expect(list.or(empty).or(error)).toBeVisible()`
// asserts only "the page arrived somewhere" — it passes identically whether the feature works or is
// broken, because the error/empty state is folded into the alternative. This is how a green suite
// stops verifying anything: a missing test is visible, this is not. Waiting on ANY terminal state is
// fine — it is the right way to avoid a blind timeout — PROVIDED the code immediately after
// discriminates WHICH state actually appeared and fails naming it.
//
// Port of viafera's scripts/qa/check-oracle-discrimination.mjs (spool N61/N63/N79), generalized: the
// spec directory is discovered the same way check-skip-critical-e2e.mjs finds e2e specs (any
// directory named e2e/playwright/cypress/integration-e2e), not a hardcoded project path.
//
// RATCHET, NOT A WALL: pre-existing non-discriminating oracles live in a baseline. The gate fails
// only if the count GROWS or a new, unbaselined site appears. Fixing a site shrinks the baseline —
// it can only improve. Regenerate with --update-baseline (explicit human intent, never automatic).
// A MISSING baseline is fail-closed (exit 1) — this script never fabricates one at runtime; only an
// explicit --update-baseline run writes it (INV-96).
//
// Exit codes (INV-53): 0=PASS (no regression), 1=FAIL (regression, or baseline missing), 2=ERROR.
// Usage: node scripts/check-oracle-discrimination.mjs [--dir <path>] [--update-baseline] [--help]
import { readFileSync, writeFileSync, readdirSync, statSync, existsSync } from 'node:fs'
import { join, resolve } from 'node:path'

const args = process.argv.slice(2)
if (args.includes('--help') || args.includes('-h')) {
  process.stdout.write(
    'Usage: node scripts/check-oracle-discrimination.mjs [--dir <path>] [--update-baseline]\n' +
      '  Fails when an E2E wait accepts a failure/empty state as success without discriminating\n' +
      '  which state appeared. Baseline-ratcheted: fails only on growth. A missing baseline is a\n' +
      '  fail-closed error, not an auto-generated pass — run --update-baseline explicitly.\n',
  )
  process.exit(0)
}
const dirArgIdx = args.indexOf('--dir')
const ROOT = dirArgIdx >= 0 && args[dirArgIdx + 1] ? resolve(args[dirArgIdx + 1]) : process.cwd()
const UPDATE = args.includes('--update-baseline')
const BASELINE = join(ROOT, 'oracle-discrimination-baseline.json')

// Mirrors check-skip-critical-e2e.mjs's SKIP_DIRS/E2E_DIR_NAMES/SPEC_RE — same convention, same
// project-agnostic e2e-directory discovery.
const SKIP_DIRS = new Set([
  'node_modules',
  '.git',
  'dist',
  'build',
  'coverage',
  '.coverage',
  '.venv',
  'venv',
  '__pycache__',
])
const E2E_DIR_NAMES = new Set(['e2e', 'playwright', 'cypress', 'integration-e2e'])
const SPEC_RE = /\.(?:spec|test|e2e)\.(?:ts|tsx|js|jsx|mjs)$/

/** Testid/name fragments that denote a failed or empty outcome. */
const FAILURE_HINTS = [
  'error-state',
  'error-boundary',
  'errorstate',
  'empty-state',
  'emptystate',
  'not-found',
  'notfound',
  'error-message',
  'errormessage',
  'failure',
]

/** Signals that, after the wait, the state actually gets discriminated. */
const DISCRIMINATORS = ['isVisible(', 'count(', 'innerText(', 'textContent(', 'throw ']

/** How many lines after the wait a discrimination is still accepted. */
const WINDOW = 30

/** Collect spec files that live under an e2e-named directory (same walk as check-skip-critical-e2e). */
function collectE2eSpecs(dir, acc, inE2eTree) {
  let entries
  try {
    entries = readdirSync(dir)
  } catch {
    return
  }
  for (const entry of entries) {
    if (SKIP_DIRS.has(entry)) continue
    const full = join(dir, entry)
    let st
    try {
      st = statSync(full)
    } catch {
      continue
    }
    if (st.isDirectory()) {
      collectE2eSpecs(full, acc, inE2eTree || E2E_DIR_NAMES.has(entry))
    } else if (inE2eTree && SPEC_RE.test(entry)) {
      acc.push(full)
    }
  }
}

/** Identifiers mentioned in a chain, so a variable-named locator can be resolved. */
function namesIn(text) {
  return [...new Set(text.match(/[A-Za-z_$][\w$]*/g) ?? [])]
}

/**
 * Map `const name = ...getByTestId('some-id')...` for the whole file. Without this a locator
 * assigned to a neutrally-named variable (`errore`, `ko`, `alt`) would slip past the inline-testid
 * scan — a demonstrated false negative, not a hypothetical one (viafera reference, spool N63).
 */
function locatorTestIds(src) {
  const map = new Map()
  const re =
    /(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=[^;\n]*?getByTestId\(\s*['"`]([^'"`]+)['"`]/g
  let m
  while ((m = re.exec(src)) !== null) map.set(m[1], m[2])
  const raw = /(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=[^;\n]*?\[data-testid=["']([^"']+)["']\]/g
  while ((m = raw.exec(src)) !== null) map.set(m[1], m[2])
  return map
}

function findViolations(file) {
  let src
  try {
    src = readFileSync(file, 'utf-8')
  } catch {
    return []
  }
  const lines = src.split('\n')
  const rel = file.slice(ROOT.length + 1).replace(/\\/g, '/')
  const testIdOf = locatorTestIds(src)
  const hits = []

  lines.forEach((line, i) => {
    if (!line.includes('.or(')) return

    // The chain may continue over several lines: collect up to the wait's close.
    const chain = lines.slice(i, Math.min(i + 6, lines.length)).join(' ')
    if (!/toBeVisible|toBeAttached|waitFor\b/.test(chain)) return

    // The chain text PLUS the testids of any variable it cites — that is where the failure
    // state hides when the locator has a neutral name.
    const resolved = namesIn(chain)
      .map((n) => testIdOf.get(n))
      .filter(Boolean)
      .join(' ')
    const lower = `${chain} ${resolved}`.toLowerCase()
    const hint = FAILURE_HINTS.find((h) => lower.includes(h))
    if (!hint) return

    const after = lines.slice(i + 1, Math.min(i + 1 + WINDOW, lines.length)).join('\n')
    const chainNames = namesIn(chain)
    const discriminated = DISCRIMINATORS.some(
      (d) => after.includes(d) && (d === 'throw ' || chainNames.some((n) => after.includes(n))),
    )
    if (discriminated) return

    hits.push({ file: rel, line: i + 1, hint, code: line.trim().slice(0, 110) })
  })

  return hits
}

function main() {
  const specs = []
  collectE2eSpecs(ROOT, specs, false)
  const violations = specs.flatMap(findViolations)
  const key = (v) => `${v.file}:${v.line}`

  if (UPDATE) {
    writeFileSync(
      BASELINE,
      JSON.stringify(
        {
          _comment:
            'Pre-existing non-discriminating E2E oracles. The gate fails only if this count GROWS. ' +
            'Fixing a site removes it from here — it can only improve.',
          _generated: 'scripts/check-oracle-discrimination.mjs --update-baseline',
          count: violations.length,
          sites: violations.map(key).sort(),
        },
        null,
        2,
      ) + '\n',
    )
    process.stdout.write(`check-oracle-discrimination: baseline rewritten — ${violations.length} site(s).\n`)
    return 0
  }

  if (!existsSync(BASELINE)) {
    process.stderr.write(
      `check-oracle-discrimination: ERROR — baseline missing (oracle-discrimination-baseline.json). ` +
        `Generate it with --update-baseline.\n`,
    )
    return 1
  }
  let baseline = { count: 0, sites: [] }
  try {
    baseline = JSON.parse(readFileSync(BASELINE, 'utf-8'))
  } catch (e) {
    process.stderr.write(`check-oracle-discrimination: ERROR — baseline unparsable: ${e?.message ?? e}\n`)
    return 1
  }

  const known = new Set(baseline.sites ?? [])
  const fresh = violations.filter((v) => !known.has(key(v)))
  const fixed = (baseline.sites ?? []).filter((s) => !violations.some((v) => key(v) === s))

  process.stdout.write(
    `check-oracle-discrimination: specs=${specs.length} nonDiscriminating=${violations.length} (baseline ${baseline.count ?? 0})\n`,
  )

  if (fresh.length > 0) {
    process.stderr.write(
      `\ncheck-oracle-discrimination: REGRESSION — ${fresh.length} new non-discriminating oracle(s):\n`,
    )
    for (const v of fresh) {
      process.stderr.write(`  ${v.file}:${v.line}  (state "${v.hint}" in the alternative, never discriminated)\n`)
      process.stderr.write(`      ${v.code}\n`)
    }
    process.stderr.write(
      '\nWaiting on any terminal state is fine — right after, establish WHICH one appeared and fail naming it.\n',
    )
    return 1
  }

  if (fixed.length > 0) {
    process.stdout.write(
      `check-oracle-discrimination: OK — no regression. ${fixed.length} site(s) fixed: run --update-baseline to lock in the progress.\n`,
    )
  } else {
    process.stdout.write('check-oracle-discrimination: OK — no regression.\n')
  }
  return 0
}

try {
  process.exit(main())
} catch (e) {
  process.stderr.write(`check-oracle-discrimination: ERROR — ${e?.message ?? e}\n`)
  process.exit(2)
}
