#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
/**
 * check-solo-reactivation.mjs — Single-developer exception reactivation check
 *
 * Enforces the reactivation trigger for trunk-solo+<%= governanceLevel %> projects (#1250).
 * Per docs/governance/SOLO_DEV_EXCEPTION.md §11.10(k):
 *   - Fires (exit 1) when ≥3 distinct authors are active in the trailing 30 days
 *   - Fires (exit 1) when EXTERNAL_AUDIT=true environment variable is set
 *
 * Runs nightly via .github/workflows/06-nightly-lite.yml
 * Generated by arbiter — do not edit manually.
 */
import { execFileSync } from 'node:child_process'

const AUTHOR_THRESHOLD = 3
const LOOKBACK_DAYS = 30

/**
 * Count distinct author emails in git log for the trailing N days.
 * Case-insensitive deduplication (git may emit different casings).
 * Returns 0 if git log produces no output (new repo or no commits in window).
 */
function countDistinctAuthors(days) {
  try {
    const since = `${days} days ago`
    const output = execFileSync('git', ['log', `--since=${since}`, '--format=%ae'], {
      encoding: 'utf-8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim()

    if (!output) return 0

    const emails = output
      .split('\n')
      .map((e) => e.trim().toLowerCase())
      .filter(Boolean)
    return new Set(emails).size
  } catch (err) {
    // git not available or not a git repository — fail closed
    console.error('check-solo-reactivation: git not available or not a git repo — failing closed')
    console.error(err)
    process.exit(1)
  }
}

function main() {
  const externalAudit = process.env['EXTERNAL_AUDIT'] === 'true'
  const authorCount = countDistinctAuthors(LOOKBACK_DAYS)

  const authorThresholdExceeded = authorCount >= AUTHOR_THRESHOLD
  const triggered = authorThresholdExceeded || externalAudit

  if (!triggered) {
    console.log(
      `check-solo-reactivation: OK — ${authorCount} distinct author(s) in trailing ${LOOKBACK_DAYS}d (threshold: ${AUTHOR_THRESHOLD}). External audit: ${externalAudit}.`,
    )
    process.exit(0)
  }

  // Trigger: print clear remediation instructions and exit 1
  console.error('')
  console.error('╔══════════════════════════════════════════════════════════════╗')
  console.error('║  SOLO-DEV EXCEPTION REACTIVATION TRIGGERED                   ║')
  console.error('╚══════════════════════════════════════════════════════════════╝')
  console.error('')

  if (authorThresholdExceeded) {
    console.error(
      `REASON: ${authorCount} distinct author(s) detected in trailing ${LOOKBACK_DAYS} days`,
    )
    console.error(`        (threshold: ≥${AUTHOR_THRESHOLD} authors triggers reactivation)`)
  }

  if (externalAudit) {
    console.error('REASON: EXTERNAL_AUDIT=true environment variable is set')
  }

  console.error('')
  console.error('REQUIRED ACTIONS:')
  console.error('')
  console.error('  1. Add CODEOWNERS file with required reviewers:')
  console.error('     echo "* @your-reviewer" > CODEOWNERS')
  console.error('')
  console.error('  2. Update arbiter.json to require peer review:')
  console.error('     node dist/cli.js configure --set collaborationMode=peer-review')
  console.error('')
  console.error('  3. Regenerate governance files:')
  console.error('     node dist/cli.js update')
  console.error('')
  console.error('  4. Enable branch protection with required reviewer:')
  console.error('     node scripts/apply-branch-protection.mjs')
  console.error('')
  console.error(
    'See docs/governance/SOLO_DEV_EXCEPTION.md for the full reactivation procedure.',
  )
  console.error('')

  process.exit(1)
}

main()
