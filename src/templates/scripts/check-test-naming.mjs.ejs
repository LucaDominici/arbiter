#!/usr/bin/env node
// Test naming convention gate for <%= projectName %>
// Flags test files that don't follow the project's naming convention.
// Exit 1 if violations found (HARD gate — L1+).
import { readdirSync, statSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

let violations = 0;

function walk(dir, fn) {
  let entries;
  try {
    entries = readdirSync(dir);
  } catch {
    return;
  }
  for (const entry of entries) {
    const full = join(dir, entry);
    let stat;
    try {
      stat = statSync(full);
    } catch {
      continue;
    }
    if (stat.isDirectory()) {
      walk(full, fn);
    } else {
      fn(full, entry);
    }
  }
}

function flag(file, message) {
  console.error(`[NAMING] ${file}: ${message}`);
  violations++;
}

<% if (language === 'typescript') { %>
import { walkRepo } from './lib/glob-walk.mjs';
// TypeScript: test files must match *.test.ts or *.spec.ts. Walk via the shared, cycle-safe
// helper (#1521) — its SKIP_DIRS already prune node_modules/.git/dist/build/coverage/.coverage.
function checkTs(root) {
  for (const rel of walkRepo(root)) {
    if (!rel.endsWith('.ts') || rel.endsWith('.d.ts')) continue;
    const full = join(root, rel);
    const looksLikeTest =
      rel.endsWith('.test.ts') || rel.endsWith('.spec.ts');
    let content = '';
    try {
      content = readFileSync(full, 'utf-8');
    } catch {
      continue;
    }
    const hasTestImport =
      content.includes("from 'vitest'") ||
      content.includes('from "vitest"') ||
      content.includes("from '@jest") ||
      content.includes('from "@jest') ||
      (content.includes("describe(") && content.includes("it("));
    if (hasTestImport && !looksLikeTest) {
      flag(full, 'test file must be named *.test.ts or *.spec.ts');
    }
  }
}
checkTs('src');
checkTs('__tests__');

<% } else if (language === 'java') { %>
// Java: unit tests → *Test.java, integration tests → *IT.java. Support/glue
// classes (e.g. Cucumber step definitions — no @Test/@Suite entry point, never
// discovered directly by `useJUnitPlatform()`) legitimately live under
// src/test/java without matching that convention, same as Go's content-based
// exemption below: only flag a file that actually LOOKS like a JUnit/suite
// entry point (#1042).
walk('src/test', (file, name) => {
  if (!name.endsWith('.java')) return;
  if (name.endsWith('Test.java') || name.endsWith('IT.java') || name.endsWith('ArchTest.java')) return;
  let content = '';
  try {
    content = readFileSync(file, 'utf-8');
  } catch {
    return;
  }
  const looksLikeTestEntryPoint =
    /@(Test|ParameterizedTest|RepeatedTest|TestFactory|Suite)\b/.test(content);
  if (looksLikeTestEntryPoint) {
    flag(file, 'test file must match *Test.java, *IT.java, or *ArchTest.java');
  }
});

<% } else if (language === 'rust') { %>
// Rust: integration test files in tests/ must match *_test.rs
walk('tests', (file, name) => {
  if (!name.endsWith('.rs')) return;
  if (!name.endsWith('_test.rs') && name !== 'mod.rs') {
    flag(file, 'integration test file in tests/ must be named *_test.rs');
  }
});

<% } else if (language === 'go') { %>
// Go: all test files must end in _test.go (enforced by the Go toolchain)
walk('.', (file, name) => {
  if (!name.endsWith('.go')) return;
  const dir = file.replace(/\/[^/]+$/, '');
  if (dir.includes('vendor') || dir.includes('.git')) return;
  // A file that imports "testing" but is not named *_test.go is a violation
  let content = '';
  try {
    content = readFileSync(file, 'utf-8');
  } catch {
    return;
  }
  if (content.includes('"testing"') && !name.endsWith('_test.go')) {
    flag(file, 'test file must be named *_test.go');
  }
});

<% } else if (language === 'python') { %>
// Python: test files must match test_*.py. Support/helper modules with no
// `def test_*` of their own (e.g. the a11y `run_axe.py` helper a *_test.py
// file imports — same category as Java's step-definition/glue exemption
// above) legitimately live under tests/ without matching the convention —
// content-based exemption, not a bare filename check (#1840 F4 tranche-3:
// arbiter's OWN generated tests/e2e/a11y/run_axe.py tripped this gate on
// every python web-archetype init before this fix).
walk('tests', (file, name) => {
  if (!name.endsWith('.py')) return;
  if (name === '__init__.py' || name === 'conftest.py') return;
  if (name.startsWith('test_')) return;
  let content = '';
  try {
    content = readFileSync(file, 'utf-8');
  } catch {
    return;
  }
  const looksLikeTestEntryPoint = /^\s*def\s+test_/m.test(content);
  if (looksLikeTestEntryPoint) {
    flag(file, 'test file must be named test_*.py');
  }
});

<% } else { %>
console.error('[NAMING] ERROR: no naming convention configured for language "<%= language %>". Gate cannot run.');
process.exit(1);
<% } %>
if (violations > 0) {
  console.error(`\n[NAMING] ${violations} violation(s) found. Rename files to follow the convention.\n`);
  process.exit(1);
} else {
  console.log('[NAMING] All test files follow naming convention.');
}
