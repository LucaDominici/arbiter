#!/usr/bin/env node
// <%= projectName %> — Rust context-aware INV-04 checker: no .unwrap()/.expect(...) in production code.
// Ported from haben's `scripts/checks/inv-20-no-unwrap.sh` awk pipeline; rewritten in Node for
// cross-platform portability (Windows targets) per issue #360.
//
// Context-aware behavior (mirrors the awk reference):
//   1. Scans every `.rs` file under `src/` recursively.
//   2. Skips `lib.rs` — it is a re-export entrypoint, not behavioral code.
//   3. For each remaining file, takes only the slice BEFORE the first `#[cfg(test)]` line
//      (production code only — `mod tests { ... }` is excluded).
//   4. Strips comment-only lines (lines whose first non-whitespace token is `//`).
//   5. Fails (exit 1) if any remaining line contains `.unwrap()` or `.expect(`.
import { readdirSync, readFileSync, statSync } from 'node:fs';
import { join, basename } from 'node:path';

const SRC_DIR = 'src';

function listRustFiles(dir) {
  const out = [];
  let entries;
  try { entries = readdirSync(dir); } catch { return out; }
  for (const name of entries) {
    const full = join(dir, name);
    let s;
    try { s = statSync(full); } catch { continue; }
    if (s.isDirectory()) {
      out.push(...listRustFiles(full));
    } else if (s.isFile() && name.endsWith('.rs')) {
      out.push(full);
    }
  }
  return out;
}

function productionSlice(text) {
  // Drop everything from the first `#[cfg(test)]` line onward.
  const lines = text.split(/\r?\n/);
  const cutAt = lines.findIndex((l) => /^\s*#\[\s*cfg\s*\(\s*test\s*\)\s*\]/.test(l));
  const kept = cutAt === -1 ? lines : lines.slice(0, cutAt);
  // Strip comment-only lines.
  return kept.filter((l) => !/^\s*\/\//.test(l));
}

const offenders = [];
for (const file of listRustFiles(SRC_DIR)) {
  if (basename(file) === 'lib.rs') continue;
  let text;
  try { text = readFileSync(file, 'utf-8'); } catch { continue; }
  const code = productionSlice(text).join('\n');
  if (code.includes('.unwrap()') || code.includes('.expect(')) {
    offenders.push(file);
  }
}

if (offenders.length > 0) {
  console.error('INV-04 (Rust): .unwrap() / .expect(...) found in production code:');
  for (const f of offenders) console.error('  ' + f);
  console.error('Use `?` or explicit error handling. Test-module usage is allowed inside `#[cfg(test)]`.');
  process.exit(1);
}
console.log('Rust no-unwrap check passed.');
