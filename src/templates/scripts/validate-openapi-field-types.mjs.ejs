// validate-openapi-field-types.mjs — OpenAPI schema field-type validator
//
// Generated by arbiter (#896) — F9: API contract baselines template
// Emitted when contractType=rest-owned for Java projects.
//
// Purpose:
//   Validates that the OpenAPI specification contains no untyped or
//   ambiguously-typed fields. Checks that all schema properties have
//   explicit `type` declarations and that enum fields list their values.
//   Compares against the openapi-baseline.json snapshot to detect drift.
//
// Usage:
//   node scripts/validate-openapi-field-types.mjs [--spec <path>] [--baseline <path>]
//
// Environment:
//   OPENAPI_SPEC_URL — URL to fetch the live OpenAPI spec (default: http://localhost:8080/v3/api-docs)
//   OPENAPI_SPEC_FILE — path to a local spec file (takes precedence over URL)
//
// Exit codes:
//   0 — all field types valid
//   1 — untyped fields or drift detected

import { readFileSync, existsSync } from 'node:fs'
import { resolve } from 'node:path'

const args = process.argv.slice(2)

function argValue(flag) {
  const idx = args.indexOf(flag)
  return idx >= 0 ? args[idx + 1] : null
}

const BASELINE_PATH = resolve(
  argValue('--baseline') ?? 'src/test/resources/api-snapshots/openapi-baseline.json',
)
const SPEC_FILE = process.env.OPENAPI_SPEC_FILE ?? argValue('--spec')
const SPEC_URL = process.env.OPENAPI_SPEC_URL ?? 'http://localhost:8080/v3/api-docs'

let exitCode = 0
const errors = []

/**
 * Recursively find all schema properties that lack an explicit `type`.
 */
function findUntypedProperties(schemas, prefix = '') {
  const untyped = []
  for (const [schemaName, schema] of Object.entries(schemas ?? {})) {
    const props = schema.properties ?? {}
    for (const [propName, propDef] of Object.entries(props)) {
      const path = `${prefix}${schemaName}.${propName}`
      if (!propDef.type && !propDef.$ref && !propDef.allOf && !propDef.oneOf && !propDef.anyOf) {
        untyped.push(path)
      }
    }
  }
  return untyped
}

async function loadSpec() {
  if (SPEC_FILE && existsSync(SPEC_FILE)) {
    console.log(`[validate-openapi-field-types] Loading spec from file: ${SPEC_FILE}`)
    return JSON.parse(readFileSync(SPEC_FILE, 'utf-8'))
  }

  console.log(`[validate-openapi-field-types] Fetching openapi spec from: ${SPEC_URL}`)
  try {
    const res = await fetch(SPEC_URL)
    if (!res.ok) {
      throw new Error(`HTTP ${res.status}`)
    }
    return await res.json()
  } catch (err) {
    console.error(`[validate-openapi-field-types] ERROR: could not load openapi spec: ${err.message}`)
    console.error('  Set OPENAPI_SPEC_FILE to a local spec path, or ensure the service is running.')
    process.exit(2)
  }
}

const spec = await loadSpec()
const schemas = spec?.components?.schemas ?? {}

if (Object.keys(schemas).length === 0) {
  console.warn('[validate-openapi-field-types] WARN: no schemas found in openapi spec — skipping field-type check.')
  process.exit(0)
}

// Check for untyped properties
const untypedFields = findUntypedProperties(schemas)
if (untypedFields.length > 0) {
  console.error('[validate-openapi-field-types] ERROR: untyped schema properties found:')
  for (const f of untypedFields) {
    console.error(`  ${f}`)
  }
  errors.push(`${untypedFields.length} untyped field(s)`)
  exitCode = 1
} else {
  console.log(`[validate-openapi-field-types] OK: all ${Object.keys(schemas).length} schema(s) have typed properties`)
}

// Compare paths against baseline if available
if (existsSync(BASELINE_PATH)) {
  const baseline = JSON.parse(readFileSync(BASELINE_PATH, 'utf-8'))
  const baselineSchemas = Object.keys(baseline?.components?.schemas ?? {}).sort()
  const currentSchemas = Object.keys(schemas).sort()

  const removed = baselineSchemas.filter((s) => !currentSchemas.includes(s))
  if (removed.length > 0) {
    console.error('[validate-openapi-field-types] BREAKING: schemas removed vs baseline:')
    for (const s of removed) {
      console.error(`  ${s}`)
    }
    errors.push(`${removed.length} schema(s) removed`)
    exitCode = 1
  }
} else {
  console.warn(`[validate-openapi-field-types] WARN: baseline not found at ${BASELINE_PATH} — skipping drift check.`)
}

if (errors.length > 0) {
  console.error(`\n[validate-openapi-field-types] FAILURES: ${errors.join(', ')}`)
}

process.exit(exitCode)
