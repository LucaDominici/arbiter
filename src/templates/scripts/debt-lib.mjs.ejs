/**
 * Collect Go debt metrics.
 * @param {string} cwd
 * @returns {Record<string, {value: number, unit: string, direction: string}>}
 */
export function collectMetrics(cwd) {
  const metrics = {};

  // ── Coverage (go test -cover) ─────────────────────────────────────────────
  // Enumerate project packages with `go list ./...` and exclude import paths
  // containing /node_modules/ — npm packages that ship Go source without a
  // nested go.mod (e.g. `flatted`) are otherwise measured as project code,
  // making the debt ratchet dependency-layout-sensitive (#1950). Package paths
  // are passed as separate spawn arguments (shell:false), never concatenated.
  // Fail closed if enumeration fails or yields no usable packages.
  const goList = run('go', ['list', './...'], { cwd });
  if ((goList.status ?? 1) !== 0) {
    throw new Error(
      `go list ./... failed (exit ${goList.status}): ${goList.stderr ?? ''} — refusing to write (fail-closed)`,
    );
  }
  const goPkgs = (goList.stdout ?? '')
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l.length > 0 && !l.includes('/node_modules/'));
  if (goPkgs.length === 0) {
    throw new Error(
      'go list ./... returned no project packages after excluding /node_modules/ — refusing to write (fail-closed)',
    );
  }
  run('go', ['test', '-coverprofile=.coverage-tmp.out', ...goPkgs], { cwd });
  const goCoverRaw = run('go', ['tool', 'cover', '-func=.coverage-tmp.out'], { cwd });
  try {
    const match = goCoverRaw.stdout.match(/total:\s+\(statements\)\s+([\d.]+)%/);
    metrics.coverageLine = { value: match ? parseFloat(match[1]) : 0, unit: 'percent', direction: 'higher-is-better' };
  } catch { metrics.coverageLine = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

  // ── golangci-lint violations ──────────────────────────────────────────────
  const golintRaw = spawnOrSkip('golangciViolations', 'golangci-lint', 'golangci-lint',
    ['run', '--out-format=json'], { cwd });
  if (golintRaw !== null) {
    try {
      const report = JSON.parse(golintRaw.stdout || '{"Issues":[]}');
      metrics.golangciViolations = {
        value: (report.Issues ?? []).length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.golangciViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── govulncheck advisories ────────────────────────────────────────────────
  const govulnRaw = spawnOrSkip('govulncheckAdvisories', 'govulncheck', 'govulncheck',
    ['-json', './...'], { cwd });
  if (govulnRaw !== null) {
    try {
      const lines = (govulnRaw.stdout ?? '').split('\n').filter(Boolean);
      const osvIds = new Set();
      for (const l of lines) {
        try {
          const obj = JSON.parse(l);
          if (obj.osv?.id) osvIds.add(obj.osv.id);
        } catch { /* skip malformed line */ }
      }
      metrics.govulncheckAdvisories = { value: osvIds.size, unit: 'count', direction: 'lower-is-better' };
    } catch { metrics.govulncheckAdvisories = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── Finding-hygiene (un-promoted findings spool, #1405) ───────────────────
  Object.assign(metrics, collectFindingsMetrics(cwd));

  return metrics;
}
