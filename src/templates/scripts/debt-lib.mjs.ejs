      metrics.deadCode = {
        value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code === 'dead_code').length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch {
      metrics.clippyDenyCount = { value: 0, unit: 'count', direction: 'lower-is-better' };
      metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' };
      metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
    }
  }

  // ── cargo audit advisories ────────────────────────────────────────────────
  const auditRaw = spawnOrSkip('cargoAuditAdvisories', 'cargo-audit', 'cargo', ['audit', '--json'], { cwd });
  if (auditRaw !== null) {
    try {
