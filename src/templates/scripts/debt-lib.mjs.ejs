/**
 * Collect Rust debt metrics.
 * @param {string} cwd
 * @returns {Record<string, {value: number, unit: string, direction: string}>}
 */
export function collectMetrics(cwd) {
  const metrics = {};

  // ── Coverage (cargo tarpaulin) ────────────────────────────────────────────
  run('cargo', ['tarpaulin', '--out', 'Json', '--output-dir', '.coverage-tmp'], { cwd });
  try {
    const data = JSON.parse(readFileSync(resolve(cwd, '.coverage-tmp/tarpaulin-report.json'), 'utf-8'));
    metrics.coverageLine = { value: data.coverage, unit: 'percent', direction: 'higher-is-better' };
  } catch { metrics.coverageLine = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

  // ── Clippy errors + complexity + dead code ────────────────────────────────
  const clippyRaw = spawnOrSkip('clippyDenyCount', 'cargo', 'cargo',
    ['clippy', '--message-format=json', '--', '-W', 'clippy::cognitive_complexity', '-W', 'dead_code'], { cwd });
  if (clippyRaw !== null) {
    try {
      const lines = (clippyRaw.stdout ?? '').split('\n').filter(Boolean);
      const msgs = lines.map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
      metrics.clippyDenyCount = {
        value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.level === 'error').length,
        unit: 'count', direction: 'lower-is-better',
      };
      metrics.complexityViolations = {
        value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code?.includes('cognitive_complexity')).length,
        unit: 'count', direction: 'lower-is-better',
      };
      metrics.deadCode = {
        value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code === 'dead_code').length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch {
      metrics.clippyDenyCount = { value: 0, unit: 'count', direction: 'lower-is-better' };
      metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' };
      metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
    }
  }

  // ── cargo audit advisories ────────────────────────────────────────────────
  const auditRaw = spawnOrSkip('cargoAuditAdvisories', 'cargo-audit', 'cargo', ['audit', '--json'], { cwd });
  if (auditRaw !== null) {
    try {
      const report = JSON.parse(auditRaw.stdout || '{}');
      metrics.cargoAuditAdvisories = {
        value: report.vulnerabilities?.found ?? 0,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.cargoAuditAdvisories = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  return metrics;
}
