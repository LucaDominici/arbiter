/**
 * Collect Python debt metrics.
 * @param {string} cwd
 * @returns {Record<string, {value: number, unit: string, direction: string}>}
 */
export function collectMetrics(cwd) {
  const metrics = {};

  // ── Coverage (pytest --cov) ───────────────────────────────────────────────
  run('pytest', ['--cov', '--cov-report=json', '--cov-report=term'], { cwd });
  try {
    const data = JSON.parse(readFileSync(resolve(cwd, 'coverage.json'), 'utf-8'));
    metrics.coverageLine = { value: data.totals?.percent_covered ?? 0, unit: 'percent', direction: 'higher-is-better' };
  } catch { metrics.coverageLine = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

  // ── ruff errors (all rules) ───────────────────────────────────────────────
  const ruffRaw = spawnOrSkip('ruffErrors', 'ruff', 'ruff',
    ['check', '.', '--output-format', 'json'], { cwd });
  if (ruffRaw !== null) {
    try {
      const violations = JSON.parse(ruffRaw.stdout || '[]');
      metrics.ruffErrors = { value: violations.length, unit: 'count', direction: 'lower-is-better' };
    } catch { metrics.ruffErrors = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── mypy strict errors (skip if no mypy config) ───────────────────────────
  const mypyConfigExists = existsSync(resolve(cwd, 'mypy.ini'))
    || existsSync(resolve(cwd, '.mypy.ini'))
    || existsSync(resolve(cwd, 'setup.cfg'));
  if (mypyConfigExists) {
    const mypyRaw = spawnOrSkip('mypyStrictErrors', 'mypy', 'mypy',
      ['--strict', '.', '--no-color-output'], { cwd });
    if (mypyRaw !== null) {
      const errorLines = (mypyRaw.stdout ?? '').split('\n').filter(l => l.includes(': error:'));
      metrics.mypyStrictErrors = { value: errorLines.length, unit: 'count', direction: 'lower-is-better' };
    }
  } else {
    metrics.mypyStrictErrors = { value: 0, unit: 'count', direction: 'lower-is-better' };
  }

  // ── pip-audit advisories ──────────────────────────────────────────────────
  const pipAuditRaw = spawnOrSkip('pipAuditAdvisories', 'pip-audit', 'pip-audit',
    ['--format', 'json'], { cwd });
  if (pipAuditRaw !== null) {
    try {
      const report = JSON.parse(pipAuditRaw.stdout || '{"dependencies":[]}');
      const vulnCount = (report.dependencies ?? []).reduce(
        (acc, dep) => acc + (dep.vulns?.length ?? 0), 0,
      );
      metrics.pipAuditAdvisories = { value: vulnCount, unit: 'count', direction: 'lower-is-better' };
    } catch { metrics.pipAuditAdvisories = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  return metrics;
}
