      const msgs = lines.map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
      metrics.clippyDenyCount = {
        value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.level === 'error').length,
        unit: 'count', direction: 'lower-is-better',
      };
      metrics.complexityViolations = {
        value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code?.includes('cognitive_complexity')).length,
        unit: 'count', direction: 'lower-is-better',
