          const matches = xml.match(/<violation\b/g);
          metrics.pmdViolations = { value: matches ? matches.length : 0, unit: 'count', direction: 'lower-is-better' };
          found = true; break;
        }
      }
      if (!found) metrics.pmdViolations = { value: 0, unit: 'count', direction: 'lower-is-better' };
    } catch { metrics.pmdViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── Checkstyle violations ─────────────────────────────────────────────────
  const csBuildRaw = spawnOrSkip('checkstyleViolations', gradleOrMvn, gradleOrMvn, [checkstyleTask, '-q'], { cwd });
  if (csBuildRaw !== null) {
    try {
      const csXmlPaths = [
        resolve(cwd, 'build/reports/checkstyle/main.xml'),
        resolve(cwd, 'target/checkstyle-result.xml'),
