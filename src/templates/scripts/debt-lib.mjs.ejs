 */
export function collectMetrics(cwd) {
  const metrics = {};
  const gradleOrMvn = '<%= buildTool === "gradle" ? "./gradlew" : "mvn" %>';
  const pmdTask = '<%= buildTool === "gradle" ? "pmdMain" : "pmd:pmd" %>';
  const checkstyleTask = '<%= buildTool === "gradle" ? "checkstyleMain" : "checkstyle:checkstyle" %>';

  // ── JaCoCo line coverage ──────────────────────────────────────────────────
  try {
    const report = readFileSync(resolve(cwd, 'build/reports/jacoco/test/jacocoTestReport.xml'), 'utf-8');
    const lineMatch = report.match(/type="LINE"[^/]*missed="(\d+)"[^/]*covered="(\d+)"/);
    if (lineMatch) {
      const missed = parseInt(lineMatch[1]), covered = parseInt(lineMatch[2]);
      const pct = covered + missed > 0 ? (covered / (covered + missed)) * 100 : 0;
      metrics.coverageLine = { value: Math.round(pct * 10) / 10, unit: 'percent', direction: 'higher-is-better' };
    } else { metrics.coverageLine = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }
<% if (metricsProfile.includeBranchCoverage) { %>
    const branchMatch = report.match(/type="BRANCH"[^/]*missed="(\d+)"[^/]*covered="(\d+)"/);
    if (branchMatch) {
      const missed = parseInt(branchMatch[1]), covered = parseInt(branchMatch[2]);
      const pct = covered + missed > 0 ? (covered / (covered + missed)) * 100 : 0;
      metrics.coverageBranch = { value: Math.round(pct * 10) / 10, unit: 'percent', direction: 'higher-is-better' };
    }
<% } %>
  } catch { metrics.coverageLine = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

  // ── PMD violations ────────────────────────────────────────────────────────
  const pmdBuildRaw = spawnOrSkip('pmdViolations', gradleOrMvn, gradleOrMvn, [pmdTask, '-q'], { cwd });
  if (pmdBuildRaw !== null) {
    try {
      const pmdXmlPaths = [
        resolve(cwd, 'build/reports/pmd/main.xml'),
        resolve(cwd, 'target/pmd.xml'),
      ];
      let found = false;
      for (const p of pmdXmlPaths) {
        if (existsSync(p)) {
