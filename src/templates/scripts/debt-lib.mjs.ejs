/**
 * Fail-closed jscpd v5 scan. jscpd v5 silently ignores the config
 * `pattern`/`path` keys and exits 0 on a 0-file scan, writing a 0% report —
 * so the fileset MUST be passed as positional CLI args. `.jscpd.json#path`
 * is the script-private SSOT for that fileset (jscpd itself disregards the
 * key; this helper and check-duplication.mjs read it).
 * A scan that ran but covered 0 sources is an ERROR, never a recorded 0%.
 * @param {string} cwd
 * @param {{spawn?: (cwd: string, args: string[]) => {status: number|null, stdout: string, stderr: string}}} [opts]
 * @returns {{error?: string, skipped?: boolean, legacyNoReport?: boolean, status?: number, sources?: number, percentage?: number}}
 */
export function jscpdScan(cwd, opts = {}) {
  const configPath = resolve(cwd, '.jscpd.json');
  let cfg;
  try {
    cfg = JSON.parse(readFileSync(configPath, 'utf-8'));
  } catch (err) {
    return { error: `.jscpd.json unreadable at ${configPath}: ${err.message}` };
  }
  const paths = Array.isArray(cfg.path) ? cfg.path.filter((p) => typeof p === 'string' && p) : [];
  if (paths.length === 0) {
    return {
      error: cfg.pattern
        ? 'legacy jscpd v4 .jscpd.json: `pattern` is silently ignored by jscpd v5 — ' +
          'replace it with a "path" array (the scan fileset, passed as positional args). ' +
          'Re-run `arbiter update` or migrate the config by hand.'
        : '.jscpd.json has no "path" array — required as the jscpd v5 fileset SSOT.',
    };
  }
  // Without the json reporter, v5 exits 0 writing no report — indistinguishable
  // from the v4 zero-clones case, so exit-0-plus-no-report could no longer be
  // trusted as a v4 signal. Reject the config up front (fail-closed).
  if (!Array.isArray(cfg.reporters) || !cfg.reporters.includes('json')) {
    return { error: '.jscpd.json "reporters" must include "json" — the scan is parsed from report/jscpd-report.json.' };
  }
  // Honor a custom `output` dir; default matches jscpd's `report/`.
  const reportPath = resolve(cwd, typeof cfg.output === 'string' ? cfg.output : 'report', 'jscpd-report.json');
  // Stale-report poisoning guard: a leftover report from a previous run must
  // never be parsed as if it were produced by this invocation.
  rmSync(reportPath, { force: true });
  const spawn =
    opts.spawn ??
    ((dir, args) => spawnOrSkip('duplicationPercentage', 'jscpd', 'npx', args, { cwd: dir }));
  const r = spawn(cwd, ['--no-install', 'jscpd', ...paths, '--silent']);
  if (r === null) return { skipped: true };
  // `npx --no-install` exits 1 (not ENOENT) when the package is absent — that is
  // the tool-not-installed case (target without jscpd), same contract as
  // spawnOrSkip: skip the collector, never a failed-scan error.
  if ((r.status ?? 0) !== 0 && /npx canceled due to missing packages/.test(r.stderr ?? '')) {
    process.stderr.write('[baseline] skip duplicationPercentage — jscpd not installed\n');
    return { skipped: true };
  }
  if (!existsSync(reportPath)) {
    if ((r.status ?? 0) === 0) {
      // jscpd v4 writes the json report only when clones exist; v5 always
      // writes it. Exit 0 + no report can only be a v4 binary (project not
      // yet bumped to v5) with zero clones.
      return { legacyNoReport: true, status: 0 };
    }
    return { error: `jscpd failed (exit ${r.status}) and wrote no report — fail-closed` };
  }
  let dup;
  try {
    dup = JSON.parse(readFileSync(reportPath, 'utf-8'));
  } catch (err) {
    return { error: `jscpd report unreadable: ${err.message}` };
  }
  const total = dup.statistics?.total ?? {};
  const sources = total.sources ?? 0;
  if (sources === 0) {
    return {
      error:
        'jscpd scanned 0 source files — fileset/config drift; refusing to record 0% ' +
        '(fail-closed). Check the .jscpd.json "path" entries exist in this project.',
      status: r.status ?? 0,
    };
  }
  if (typeof total.percentage !== 'number') {
    return { error: 'jscpd report has no numeric statistics.total.percentage — schema drift; refusing to record 0%.' };
  }
  return { status: r.status ?? 0, sources, percentage: total.percentage };
}

/**
 * Collect TypeScript/JavaScript debt metrics.
 * @param {string} cwd
 * @param {Array<{metric: string, reason: string}>} [collectionErrors]
 *   Sink for tool-ran-but-collection-failed events (distinct from
 *   tool-not-installed, which soft-skips). debt-report --gate hard-fails on
 *   any entry (fail-closed).
 * @returns {Record<string, {value: number, unit: string, direction: string}>}
 */
export function collectMetrics(cwd, collectionErrors = []) {
  const metrics = {};

  // ── Coverage (vitest json reporter) ───────────────────────────────────────
  run('npx', ['vitest', 'run', '--coverage', '--coverage.reporter=json', '--coverage.reportsDirectory=.coverage-tmp'], { cwd });
  try {
    const summary = JSON.parse(readFileSync(resolve(cwd, '.coverage-tmp/coverage-summary.json'), 'utf-8'));
    metrics.coverageLine = { value: summary.total.lines.pct, unit: 'percent', direction: 'higher-is-better' };
<% if (metricsProfile.includeBranchCoverage) { %>
    metrics.coverageBranch = { value: summary.total.branches?.pct ?? 0, unit: 'percent', direction: 'higher-is-better' };
<% } %>
  } catch { metrics.coverageLine = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

  // ── ESLint errors (severity 2) ────────────────────────────────────────────
  const eslintRaw = spawnOrSkip('eslintErrors', 'eslint', 'npx', ['eslint', 'src', '--format', 'json'], { cwd });
  if (eslintRaw !== null) {
    try {
      const report = JSON.parse(eslintRaw.stdout || '[]');
      metrics.eslintErrors = {
        value: report.flatMap(f => f.messages).filter(m => m.severity === 2).length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.eslintErrors = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── TSC strict errors ─────────────────────────────────────────────────────
  const tscRaw = spawnOrSkip('tscStrictErrors', 'tsc', 'npx', ['tsc', '--noEmit'], { cwd });
  if (tscRaw !== null) {
    const output = (tscRaw.stdout ?? '') + (tscRaw.stderr ?? '');
    metrics.tscStrictErrors = {
      value: output.split('\n').filter(l => l.includes('error TS')).length,
      unit: 'count', direction: 'lower-is-better',
    };
  }

  // ── Complexity violations (eslint rule) ───────────────────────────────────
  const eslintComplexRaw = spawnOrSkip('complexityViolations', 'eslint', 'npx',
    ['eslint', 'src', '--format', 'json', '--rule', '{"complexity":["warn",10]}'], { cwd });
  if (eslintComplexRaw !== null) {
    try {
      const report = JSON.parse(eslintComplexRaw.stdout || '[]');
      metrics.complexityViolations = {
        value: report.flatMap(f => f.messages).filter(m => m.ruleId === 'complexity').length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── Dead code (knip) ──────────────────────────────────────────────────────
  const knipRaw = spawnOrSkip('deadCode', 'knip', 'npx', ['knip', '--reporter', 'json'], { cwd });
  if (knipRaw !== null) {
    try {
      const report = JSON.parse(knipRaw.stdout || '{}');
      metrics.deadCode = {
        value: (report.files ?? []).length + (report.exports ?? []).length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── Duplication (jscpd) — CANON-22 DRY ratchet (Lehman entropy) ────────────
  // jscpdScan handles the v5 fileset contract (positional paths from
  // .jscpd.json#path, stale-report cleanup, 0-source rejection). A scan that
  // ran but failed is surfaced via collectionErrors so debt-report --gate can
  // hard-fail instead of soft-skipping as "missing tool" (fail-closed).
  {
    const scan = jscpdScan(cwd);
    if (scan.skipped) {
      // npx/tooling absent on this machine — genuine soft-skip (ENOENT path).
    } else if (scan.error) {
      collectionErrors.push({ metric: 'duplicationPercentage', reason: scan.error });
      process.stderr.write(`[baseline] ERROR: ${scan.error}\n`);
    } else if (scan.legacyNoReport) {
      // v4 binary, zero clones (v5 always writes the report) — genuinely 0%.
      metrics.duplicationPercentage = { value: 0, unit: 'percent', direction: 'lower-is-better' };
    } else {
      metrics.duplicationPercentage = {
        value: scan.percentage,
        unit: 'percent', direction: 'lower-is-better',
      };
    }
  }

<% if (metricsProfile.includeBundleSize) { %>
  // ── Bundle size (frontend-spa only) ───────────────────────────────────────
  if (existsSync(resolve(cwd, 'dist'))) {
    const duRaw = run('du', ['-sb', 'dist/'], { cwd });
    if (!duRaw.error && duRaw.status === 0) {
      const match = duRaw.stdout.match(/^(\d+)/);
      if (match) {
        metrics.bundleSizeKb = {
          value: Math.round(parseInt(match[1]) / 1024),
          unit: 'kb', direction: 'lower-is-better',
        };
      }
    }
  }
<% } %>
<% if (metricsProfile.includePublicApiSurface) { %>
  // ── Public API surface (library archetype — count of top-level exports) ───
  {
    const grepOut = run('grep', ['-rh', '--include=*.ts', '--include=*.mts', '^export', 'src/'], { cwd });
    metrics.publicApiSurface = {
      value: grepOut.stdout ? grepOut.stdout.split('\n').filter(Boolean).length : 0,
      unit: 'count', direction: 'lower-is-better',
    };
  }
<% } %>

  return metrics;
}
