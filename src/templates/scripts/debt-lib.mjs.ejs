/**
 * Collect TypeScript/JavaScript debt metrics.
 * @param {string} cwd
 * @returns {Record<string, {value: number, unit: string, direction: string}>}
 */
export function collectMetrics(cwd) {
  const metrics = {};

  // ── Coverage (vitest json reporter) ───────────────────────────────────────
  run('npx', ['vitest', 'run', '--coverage', '--coverage.reporter=json', '--coverage.reportsDirectory=.coverage-tmp'], { cwd });
  try {
    const summary = JSON.parse(readFileSync(resolve(cwd, '.coverage-tmp/coverage-summary.json'), 'utf-8'));
    metrics.coverageLine = { value: summary.total.lines.pct, unit: 'percent', direction: 'higher-is-better' };
<% if (metricsProfile.includeBranchCoverage) { %>
    metrics.coverageBranch = { value: summary.total.branches?.pct ?? 0, unit: 'percent', direction: 'higher-is-better' };
<% } %>
  } catch { metrics.coverageLine = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

  // ── ESLint errors (severity 2) ────────────────────────────────────────────
  const eslintRaw = spawnOrSkip('eslintErrors', 'eslint', 'npx', ['eslint', 'src', '--format', 'json'], { cwd });
  if (eslintRaw !== null) {
    try {
      const report = JSON.parse(eslintRaw.stdout || '[]');
      metrics.eslintErrors = {
        value: report.flatMap(f => f.messages).filter(m => m.severity === 2).length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.eslintErrors = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── TSC strict errors ─────────────────────────────────────────────────────
  const tscRaw = spawnOrSkip('tscStrictErrors', 'tsc', 'npx', ['tsc', '--noEmit'], { cwd });
  if (tscRaw !== null) {
    const output = (tscRaw.stdout ?? '') + (tscRaw.stderr ?? '');
    metrics.tscStrictErrors = {
      value: output.split('\n').filter(l => l.includes('error TS')).length,
      unit: 'count', direction: 'lower-is-better',
    };
  }

  // ── Complexity violations (eslint rule) ───────────────────────────────────
  const eslintComplexRaw = spawnOrSkip('complexityViolations', 'eslint', 'npx',
    ['eslint', 'src', '--format', 'json', '--rule', '{"complexity":["warn",10]}'], { cwd });
  if (eslintComplexRaw !== null) {
    try {
      const report = JSON.parse(eslintComplexRaw.stdout || '[]');
      metrics.complexityViolations = {
        value: report.flatMap(f => f.messages).filter(m => m.ruleId === 'complexity').length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── Dead code (knip) ──────────────────────────────────────────────────────
  const knipRaw = spawnOrSkip('deadCode', 'knip', 'npx', ['knip', '--reporter', 'json'], { cwd });
  if (knipRaw !== null) {
    try {
      const report = JSON.parse(knipRaw.stdout || '{}');
      metrics.deadCode = {
        value: (report.files ?? []).length + (report.exports ?? []).length,
        unit: 'count', direction: 'lower-is-better',
      };
    } catch { metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
  }

  // ── Duplication (jscpd) — CANON-22 DRY ratchet (Lehman entropy) ────────────
  // jscpd writes report/jscpd-report.json (reporters configured in .jscpd.json);
  // statistics.total.percentage is the duplicated-token ratio. The ratchet blocks
  // any patch that raises it.
  const jscpdRaw = spawnOrSkip('duplicationPercentage', 'jscpd', 'npx', ['jscpd', '--silent'], { cwd });
  if (jscpdRaw !== null) {
    // jscpd writes report/jscpd-report.json ONLY when clones are found: report
    // present → real value; exit 0 + no report → genuinely 0%; ran but failed with
    // no report → OMIT (ratchet skips) rather than record a false 0 (fail-closed).
    const reportPath = resolve(cwd, 'report', 'jscpd-report.json');
    if (existsSync(reportPath)) {
      try {
        const dup = JSON.parse(readFileSync(reportPath, 'utf-8'));
        metrics.duplicationPercentage = {
          value: dup.statistics?.total?.percentage ?? 0,
          unit: 'percent', direction: 'lower-is-better',
        };
      } catch { process.stderr.write('[baseline] warn: jscpd report unreadable — skipping duplicationPercentage\n'); }
    } else if ((jscpdRaw.status ?? 0) === 0) {
      metrics.duplicationPercentage = { value: 0, unit: 'percent', direction: 'lower-is-better' };
    } else {
      process.stderr.write('[baseline] warn: jscpd failed with no report — skipping duplicationPercentage\n');
    }
  }

<% if (metricsProfile.includeBundleSize) { %>
  // ── Bundle size (frontend-spa only) ───────────────────────────────────────
  if (existsSync(resolve(cwd, 'dist'))) {
    const duRaw = run('du', ['-sb', 'dist/'], { cwd });
    if (!duRaw.error && duRaw.status === 0) {
      const match = duRaw.stdout.match(/^(\d+)/);
      if (match) {
        metrics.bundleSizeKb = {
          value: Math.round(parseInt(match[1]) / 1024),
          unit: 'kb', direction: 'lower-is-better',
        };
      }
    }
  }
<% } %>
<% if (metricsProfile.includePublicApiSurface) { %>
  // ── Public API surface (library archetype — count of top-level exports) ───
  {
    const grepOut = run('grep', ['-rh', '--include=*.ts', '--include=*.mts', '^export', 'src/'], { cwd });
    metrics.publicApiSurface = {
      value: grepOut.stdout ? grepOut.stdout.split('\n').filter(Boolean).length : 0,
      unit: 'count', direction: 'lower-is-better',
    };
  }
<% } %>

  return metrics;
}
