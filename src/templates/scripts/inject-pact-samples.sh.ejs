#!/usr/bin/env bash
# inject-pact-samples.sh — Seed Pact interaction samples for Postman/Newman runs
#
# Generated by arbiter (#894) — F7: Postman/Newman contract test template
# Emitted when contractType=rest-owned for Java projects.
#
# This script seeds the running service with the Pact interaction samples so that
# the Newman collection can run against a predictable, consistent set of API behaviors.
#
# When to use:
#   Call this before run-postman-tests.sh when INJECT_PACT_SAMPLES=true,
#   or invoke directly to reset the service state before a contract test session.
#
# Prerequisites:
#   - The service is running and reachable at SERVICE_BASE_URL
#   - pacts/ directory contains at least one Pact JSON file
#   - The service exposes an admin/test endpoint for seeding (or uses a test DB)
#
# Exit codes:
#   0 — samples injected successfully (or no pacts to inject)
#   1 — injection failed
#   2 — environment error

set -euo pipefail

# ─── Configuration ────────────────────────────────────────────────────────────

BASE_URL="${SERVICE_BASE_URL:-http://localhost:8080}"
PACTS_DIR="${PACTS_DIR:-pacts}"
SEED_ENDPOINT="${SEED_ENDPOINT:-${BASE_URL}/api/test/seed}"
SEED_TIMEOUT="${SEED_TIMEOUT_SECONDS:-10}"

# ─── Validation ───────────────────────────────────────────────────────────────

if [[ ! -d "${PACTS_DIR}" ]]; then
  echo "[inject-pact-samples] No pacts directory found at ${PACTS_DIR} — nothing to inject." >&2
  exit 0
fi

pact_files=("${PACTS_DIR}"/*.json)

if [[ ${#pact_files[@]} -eq 0 || ! -f "${pact_files[0]}" ]]; then
  echo "[inject-pact-samples] No Pact JSON files found in ${PACTS_DIR} — nothing to inject." >&2
  exit 0
fi

if ! command -v curl &>/dev/null; then
  echo "[inject-pact-samples] ERROR: curl not found." >&2
  exit 2
fi

# ─── Inject Pact samples ─────────────────────────────────────────────────────

injected=0
failed=0

for pact_file in "${pact_files[@]}"; do
  [[ -f "${pact_file}" ]] || continue

  consumer=$(jq -r '.consumer.name // "unknown"' "${pact_file}" 2>/dev/null || echo "unknown")
  provider=$(jq -r '.provider.name // "unknown"' "${pact_file}" 2>/dev/null || echo "unknown")
  interaction_count=$(jq '.interactions | length' "${pact_file}" 2>/dev/null || echo "0")

  echo "[inject-pact-samples] Injecting: ${pact_file} (${consumer} → ${provider}, ${interaction_count} interactions)"

  http_status=$(curl -sf \
    --max-time "${SEED_TIMEOUT}" \
    -X POST "${SEED_ENDPOINT}" \
    -H "Content-Type: application/json" \
    -H "X-Pact-Consumer: ${consumer}" \
    -H "X-Pact-Provider: ${provider}" \
    --data-binary "@${pact_file}" \
    -o /dev/null \
    -w "%{http_code}" \
    2>/dev/null || echo "000")

  if [[ "${http_status}" =~ ^2 ]]; then
    echo "[inject-pact-samples]   OK (HTTP ${http_status})"
    injected=$((injected + 1))
  else
    echo "[inject-pact-samples]   WARN: seed endpoint returned HTTP ${http_status} for ${pact_file}" >&2
    # Non-fatal: the pact sample injection endpoint may not be present in all environments.
    # Newman tests will still run; failures will surface in the test results.
    failed=$((failed + 1))
  fi
done

echo "[inject-pact-samples] Injected ${injected} pact file(s). ${failed} failed."

# Only hard-fail if ALL injections failed and at least one was attempted
if [[ ${injected} -eq 0 && ${failed} -gt 0 ]]; then
  echo "[inject-pact-samples] ERROR: all pact injections failed. Check SEED_ENDPOINT=${SEED_ENDPOINT}" >&2
  exit 1
fi

exit 0
