#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// <%= projectName %> — docs/GAP.md gap-register gate (#1887-B)
// Generated by arbiter (src/templates/scripts/gen-gap.mjs.ejs)
//
// Portable, SCOPED-DOWN sibling of arbiter's own scripts/gen-gap.mjs. Arbiter's
// version cross-references constraint-scan output, CONVERGENCE-*.md reports, and
// .arbiter/evidence/*/tech-debt.json, then does an exact-byte regeneration diff
// (through prettier) — none of those extra sources have a stable equivalent in an
// arbitrary target project, and an exact-byte diff would be sensitive to that
// project's own prettier config (or absence of one). This version derives ONLY
// from docs/FEATURE_MATRIX.md and checks COVERAGE instead of exact regeneration:
// every Partial/Missing feature_id in FEATURE_MATRIX.md must still be mentioned
// in docs/GAP.md's Feature Gaps table — catching the actual defect class (a gap
// silently dropped from the register) without the byte-fragility.
//
// Modes:
//   --check (default)  fail if a Partial/Missing feature_id is missing from GAP.md
//   --write            regenerate the Feature Gaps table (sentinel-bounded)
//
// Exit codes (INV-53): 0 = PASS, 1 = FAIL (drift), 2 = ERROR (file missing/parse failure)
import { existsSync, readFileSync, writeFileSync } from 'node:fs'
import { resolve } from 'node:path'

const ROOT = process.cwd()
const args = process.argv.slice(2)
const CHECK = !args.includes('--write')

const MATRIX_PATH = resolve(ROOT, 'docs', 'FEATURE_MATRIX.md')
const GAP_PATH = resolve(ROOT, 'docs', 'GAP.md')

const MATRIX_START = '<!-- FEATURE_MATRIX_START -->'
const MATRIX_END = '<!-- FEATURE_MATRIX_END -->'
const GAP_FEATURES_START = '<!-- GAP_FEATURES_START -->'
const GAP_FEATURES_END = '<!-- GAP_FEATURES_END -->'

/** Parse FEATURE_MATRIX.md's sentinel-bounded table into { featureId, capability, status, issueRef, note }[]. */
function parseMatrixRows(text) {
  const start = text.indexOf(MATRIX_START)
  const end = text.indexOf(MATRIX_END)
  if (start === -1 || end === -1 || end <= start) return null

  const block = text.slice(start + MATRIX_START.length, end)
  const rows = []
  for (const line of block.split('\n')) {
    const trimmed = line.trim()
    if (!trimmed.startsWith('|')) continue
    const cells = trimmed
      .split('|')
      .map((c) => c.trim())
      .filter((_, i) => i > 0)
    if (cells.length < 10) continue
    const [featureId, capability, , , status, , , , issueRef, note] = cells
    if (!featureId || featureId === 'feature_id' || /^-+$/.test(featureId)) continue
    if (!status) continue
    rows.push({
      featureId,
      capability: capability ?? '',
      status,
      issueRef: issueRef ?? '',
      note: note ?? '',
    })
  }
  return rows
}

/** feature_id | capability | status | severity | blocks_v1 | issue | notes */
function buildFeatureGapsTable(gapRows) {
  if (gapRows.length === 0) return '_No feature gaps._'
  const lines = gapRows.map((g) => {
    const severity = g.status === 'Missing' ? 'high' : 'medium'
    const blocksV1 = g.status === 'Missing' ? 'yes' : 'no'
    return `| ${g.featureId} | ${g.capability} | ${g.status} | ${severity} | ${blocksV1} | ${g.issueRef || '—'} | ${g.note || '—'} |`
  })
  return [
    '| feature_id | capability | status | severity | blocks_v1 | issue | notes |',
    '| --- | --- | --- | --- | --- | --- | --- |',
    ...lines,
  ].join('\n')
}

if (!existsSync(MATRIX_PATH)) {
  process.stdout.write(`  gen-gap: ERROR — FEATURE_MATRIX.md not found at ${MATRIX_PATH}\n`)
  process.exit(2)
}

let matrixText
try {
  matrixText = readFileSync(MATRIX_PATH, 'utf-8')
} catch (err) {
  process.stdout.write(`  gen-gap: ERROR — cannot read ${MATRIX_PATH}: ${err.message}\n`)
  process.exit(2)
}

const allRows = parseMatrixRows(matrixText)
if (allRows === null) {
  process.stdout.write(`  gen-gap: ERROR — sentinel markers (${MATRIX_START}) not found\n`)
  process.exit(2)
}

const gapRows = allRows.filter((r) => r.status === 'Partial' || r.status === 'Missing')

// ─── WRITE mode: regenerate the Feature Gaps table ────────────────────────────
if (!CHECK) {
  if (!existsSync(GAP_PATH)) {
    process.stdout.write(`  gen-gap: ERROR — GAP.md not found at ${GAP_PATH}\n`)
    process.exit(2)
  }
  const gapText = readFileSync(GAP_PATH, 'utf-8')
  const startIdx = gapText.indexOf(GAP_FEATURES_START)
  const endIdx = gapText.indexOf(GAP_FEATURES_END)
  if (startIdx === -1 || endIdx === -1 || endIdx <= startIdx) {
    process.stdout.write(`  gen-gap: ERROR — sentinel markers (${GAP_FEATURES_START}) not found\n`)
    process.exit(2)
  }
  const table = buildFeatureGapsTable(gapRows)
  const replaced =
    gapText.slice(0, startIdx + GAP_FEATURES_START.length) +
    '\n\n' +
    table +
    '\n\n' +
    gapText.slice(endIdx)
  writeFileSync(GAP_PATH, replaced, 'utf-8')
  process.stdout.write(`  gen-gap: WROTE — Feature Gaps table updated (${gapRows.length} rows)\n`)
  process.exit(0)
}

// ─── CHECK mode: coverage — every Partial/Missing id must be mentioned in GAP.md ──
if (!existsSync(GAP_PATH)) {
  process.stdout.write(`  gen-gap: ERROR — GAP.md not found at ${GAP_PATH}\n`)
  process.exit(2)
}

let gapText
try {
  gapText = readFileSync(GAP_PATH, 'utf-8')
} catch (err) {
  process.stdout.write(`  gen-gap: ERROR — cannot read ${GAP_PATH}: ${err.message}\n`)
  process.exit(2)
}

const dropped = gapRows.filter((g) => !gapText.includes(g.featureId))
if (dropped.length > 0) {
  for (const g of dropped) {
    process.stdout.write(
      `  gen-gap: FAIL — ${g.featureId} (${g.status}) is not mentioned in docs/GAP.md — run 'node scripts/gen-gap.mjs --write'\n`,
    )
  }
  process.exit(1)
}

process.stdout.write(`  gen-gap: OK — ${gapRows.length}/${gapRows.length} gaps tracked in docs/GAP.md\n`)
process.exit(0)
