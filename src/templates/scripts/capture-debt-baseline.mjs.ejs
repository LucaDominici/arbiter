#!/usr/bin/env node
// capture-debt-baseline.mjs — generated by arbiter
// Captures tech debt metrics into debt-baseline.json.
// Run: node scripts/capture-debt-baseline.mjs [--update]
// --update: only tighten metrics (never loosen), safe to run anytime.
import { spawnSync } from 'node:child_process';
import { readFileSync, writeFileSync, existsSync } from 'node:fs';

const updateMode = process.argv.includes('--update');
const BASELINE_FILE = 'debt-baseline.json';

function run(cmd, args) {
  return spawnSync(cmd, args, { encoding: 'utf-8', shell: false });
}

function getCommit() {
  const r = run('git', ['rev-parse', '--short', 'HEAD']);
  return r.status === 0 ? r.stdout.trim() : 'unknown';
}

function countTodos() {
  const r = run('grep', ['-r', '--include=*.{js,ts,java,go,py,rs}', '-l', 'TODO', '.']);
  if (r.status !== 0) return 0;
  const files = r.stdout.trim().split('\n').filter(Boolean);
  let count = 0;
  for (const f of files) {
    try {
      const lines = readFileSync(f, 'utf-8').split('\n');
      count += lines.filter(l => /\bTODO\b/.test(l)).length;
    } catch { /* skip */ }
  }
  return count;
}

const metrics = {};

// ─── Stack-specific metric collection ─────────────────────────────────
<% if (language === 'typescript') { %>
// Coverage: vitest with json reporter
const vitestResult = run('npx', ['vitest', 'run', '--coverage', '--coverage.reporter=json', '--coverage.reportsDirectory=.coverage-tmp']);
try {
  const summary = JSON.parse(readFileSync('.coverage-tmp/coverage-summary.json', 'utf-8'));
  metrics.coverage = { value: summary.total.lines.pct, unit: 'percent', direction: 'higher-is-better' };
} catch { metrics.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity: eslint with json output
const eslintResult = run('npx', ['eslint', 'src', '--format', 'json', '--rule', '{"complexity": ["warn", 10]}']);
try {
  const report = JSON.parse(eslintResult.stdout || '[]');
  const violations = report.flatMap(f => f.messages).filter(m => m.ruleId === 'complexity').length;
  metrics.complexityViolations = { value: violations, unit: 'count', direction: 'lower-is-better' };
} catch { metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }

// Dead code: knip with json reporter
const knipResult = run('npx', ['knip', '--reporter', 'json']);
try {
  const report = JSON.parse(knipResult.stdout || '{}');
  const count = (report.files ?? []).length + (report.exports ?? []).length;
  metrics.deadCode = { value: count, unit: 'count', direction: 'lower-is-better' };
} catch { metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
<% } %><% if (language === 'rust') { %>
// Coverage: cargo tarpaulin
const tarpaulinResult = run('cargo', ['tarpaulin', '--out', 'Json', '--output-dir', '.coverage-tmp']);
try {
  const data = JSON.parse(readFileSync('.coverage-tmp/tarpaulin-report.json', 'utf-8'));
  metrics.coverage = { value: data.coverage, unit: 'percent', direction: 'higher-is-better' };
} catch { metrics.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity + dead code: cargo clippy
const clippyResult = run('cargo', ['clippy', '--message-format=json', '--', '-W', 'clippy::cognitive_complexity', '-W', 'dead_code']);
try {
  const lines = (clippyResult.stdout ?? '').split('\n').filter(Boolean);
  const msgs = lines.map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
  metrics.complexityViolations = { value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code?.includes('cognitive_complexity')).length, unit: 'count', direction: 'lower-is-better' };
  metrics.deadCode = { value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code === 'dead_code').length, unit: 'count', direction: 'lower-is-better' };
} catch {
  metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' };
  metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
}
<% } %><% if (language === 'java') { %>
// Coverage: JaCoCo (read existing report if present)
try {
  const report = readFileSync('build/reports/jacoco/test/jacocoTestReport.xml', 'utf-8');
  const match = report.match(/type="LINE"[^/]*missed="(\d+)"[^/]*covered="(\d+)"/);
  if (match) {
    const missed = parseInt(match[1]), covered = parseInt(match[2]);
    const pct = covered + missed > 0 ? (covered / (covered + missed)) * 100 : 0;
    metrics.coverage = { value: Math.round(pct * 10) / 10, unit: 'percent', direction: 'higher-is-better' };
  } else { metrics.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }
} catch { metrics.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity: PMD
const pmdResult = run('<%= buildTool === "gradle" ? "./gradlew" : "mvn" %>', ['<%= buildTool === "gradle" ? "pmdMain" : "pmd:pmd" %>', '-q']);
metrics.complexityViolations = { value: pmdResult.status !== 0 ? 1 : 0, unit: 'count', direction: 'lower-is-better' };
metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
<% } %><% if (language === 'go') { %>
// Coverage: go test -cover
const goTestResult = run('go', ['test', '-coverprofile=.coverage-tmp.out', './...']);
const goCoverResult = run('go', ['tool', 'cover', '-func=.coverage-tmp.out']);
try {
  const match = goCoverResult.stdout.match(/total:\s+\(statements\)\s+([\d.]+)%/);
  metrics.coverage = { value: match ? parseFloat(match[1]) : 0, unit: 'percent', direction: 'higher-is-better' };
} catch { metrics.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity + dead code: golangci-lint
const golintResult = run('golangci-lint', ['run', '--out-format=json', '--enable', 'gocyclo,deadcode']);
try {
  const report = JSON.parse(golintResult.stdout || '{"Issues":[]}');
  const issues = report.Issues ?? [];
  metrics.complexityViolations = { value: issues.filter(i => i.FromLinter === 'gocyclo').length, unit: 'count', direction: 'lower-is-better' };
  metrics.deadCode = { value: issues.filter(i => i.FromLinter === 'deadcode').length, unit: 'count', direction: 'lower-is-better' };
} catch {
  metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' };
  metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
}
<% } %><% if (language === 'python') { %>
// Coverage: pytest --cov
const pytestResult = run('pytest', ['--cov', '--cov-report=json', '--cov-report=term']);
try {
  const data = JSON.parse(readFileSync('coverage.json', 'utf-8'));
  metrics.coverage = { value: data.totals?.percent_covered ?? 0, unit: 'percent', direction: 'higher-is-better' };
} catch { metrics.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity: ruff C901
const ruffResult = run('ruff', ['check', '--select', 'C901', '--output-format', 'json', '.']);
try {
  const violations = JSON.parse(ruffResult.stdout || '[]');
  metrics.complexityViolations = { value: violations.length, unit: 'count', direction: 'lower-is-better' };
} catch { metrics.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }

// Dead code: ruff F401
const ruffF401Result = run('ruff', ['check', '--select', 'F401,F811', '--output-format', 'json', '.']);
try {
  const violations = JSON.parse(ruffF401Result.stdout || '[]');
  metrics.deadCode = { value: violations.length, unit: 'count', direction: 'lower-is-better' };
} catch { metrics.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
<% } %>

// TODOs: stack-agnostic
metrics.todoCount = { value: countTodos(), unit: 'count', direction: 'lower-is-better' };

// ─── Write or update baseline ──────────────────────────────────────────
const baseline = {
  version: 1,
  capturedAt: new Date().toISOString(),
  commit: getCommit(),
  metrics,
};

if (updateMode && existsSync(BASELINE_FILE)) {
  const existing = JSON.parse(readFileSync(BASELINE_FILE, 'utf-8'));
  // One-way ratchet: only tighten (improve) metrics
  for (const [key, current] of Object.entries(metrics)) {
    const prev = existing.metrics?.[key];
    if (!prev) continue;
    if (current.direction === 'higher-is-better' && current.value < prev.value) {
      baseline.metrics[key] = prev; // keep better value
    }
    if (current.direction === 'lower-is-better' && current.value > prev.value) {
      baseline.metrics[key] = prev; // keep better value
    }
  }
}

writeFileSync(BASELINE_FILE, JSON.stringify(baseline, null, 2) + '\n', 'utf-8');
console.log(`[arbiter] Debt baseline captured → ${BASELINE_FILE}`);
console.log(JSON.stringify(baseline.metrics, null, 2));
