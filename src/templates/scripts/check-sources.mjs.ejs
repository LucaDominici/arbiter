#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// <%= projectName %> — docs/SOURCES.md gate (INV-147)
// Generated by arbiter (src/templates/scripts/check-sources.mjs.ejs)
//
// Ported from arbiter's own scripts/check-sources.mjs (#2480 wave 5). The rule is identical; only
// the registry's path differs, because a governed project keeps its documents flat under docs/
// while arbiter keeps its own under docs/internal/PRODUCT/. Nothing else is scoped down: the
// property this proves needs no arbiter-internal catalog, only a committed excerpt.
//
// scripts/check-sources.mjs
// L1 gate, tier 1: a cited source is quotable, and the quotation checks out.
//
// Why a hash AND a substring check, when either alone looks sufficient:
//   - the substring check alone passes on an excerpt someone edited after the fact, so the
//     evidence could drift away from what was actually read;
//   - the hash alone proves the excerpt is unchanged but says nothing about whether the project's
//     quotation appears in it at all.
// Together they make "this source says X" falsifiable without a network call, which is what lets
// the rule run in a pre-commit hook on a machine with no credentials.
//
// Explicitly NOT done here, and not by accident:
//   - the `url` is recorded provenance, never dereferenced. A gate that fails when a website is
//     down fails for a reason unrelated to the claim it guards; link-liveness is a separate,
//     advisory, networked concern.
//   - relevance ("does this source actually support the decision") is a judgement, not a decidable
//     property. Tier 2 puts that to independent skeptics; tier 1 refuses to pretend it can settle
//     it deterministically.
//
// Usage: node scripts/check-sources.mjs [--dir <repo>] [--json]
// Exit: 0 pass or skip, 1 violation, 2 error (INV-53).
//
// Exports for unit tests: extractSourcesBlock, findDuplicateSourceIds, checkExcerptEvidence

import { readFileSync, existsSync } from 'node:fs'
import { dirname, join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'
import { createHash } from 'node:crypto'
import { loadSchema, validateSchema } from './lib/agent-return-validate.mjs'

const scriptDir = dirname(fileURLToPath(import.meta.url))
const SOURCES_REL = join('docs', 'SOURCES.md')
const SCHEMA_REL = join('schemas', 'source-record.schema.json')
const START = '<!-- SOURCES_START -->'
const END = '<!-- SOURCES_END -->'

/**
 * Pull the fenced JSON out of the sentinel block. Throws on a malformed block: a registry that
 * cannot be parsed is an ERROR, never an empty list, because "no sources" and "the file is broken"
 * must not produce the same green.
 * @param {string} markdown
 * @returns {{ sources: unknown[] }}
 */
export function extractSourcesBlock(markdown) {
  const start = markdown.indexOf(START)
  const end = markdown.indexOf(END)
  if (start < 0 || end < 0 || end < start) {
    throw new Error(`SOURCES.md is missing its ${START} / ${END} sentinel block`)
  }
  const inner = markdown.slice(start + START.length, end)
  const fence = /```(?:json)?\s*([\s\S]*?)```/.exec(inner)
  if (!fence) throw new Error('SOURCES.md sentinel block contains no fenced JSON')
  return JSON.parse(fence[1])
}

/** @param {Array<Record<string, unknown>>} sources @returns {string[]} */
export function findDuplicateSourceIds(sources) {
  const seen = new Set()
  const violations = []
  for (const s of sources) {
    const id = String(s['id'])
    if (seen.has(id)) violations.push(`duplicate source id "${id}"`)
    seen.add(id)
  }
  return violations
}

/**
 * Tier 1 proper, for one source: the excerpt exists, hashes to what was recorded, and contains
 * every quoted span literally.
 * @param {Record<string, unknown>} source
 * @param {string} root
 * @returns {string[]}
 */
export function checkExcerptEvidence(source, root) {
  const id = String(source['id'])
  const rel = String(source['excerpt_path'] ?? '')
  const violations = []
  if (!rel) return [`${id}: no excerpt_path — a source with no committed excerpt cannot be checked`]
  const abs = resolve(root, rel)
  if (!existsSync(abs)) {
    return [
      `${id}: excerpt file ${rel} does not exist — the quotation has nothing to check against`,
    ]
  }
  const raw = readFileSync(abs)
  violations.push(...hashMismatch(id, raw, String(source['content_hash'])))
  violations.push(...unquotedCitations(id, raw.toString('utf-8'), rel, source['citations']))
  return violations
}

/** The excerpt must still BE the excerpt that was read. @returns {string[]} */
function hashMismatch(id, raw, recorded) {
  const actual = createHash('sha256').update(raw).digest('hex')
  if (actual === recorded) return []
  return [
    `${id}: excerpt hash mismatch — recorded ${recorded.slice(0, 16)}…, file now hashes to ` +
      `${actual.slice(0, 16)}…. The committed evidence is no longer the evidence that was read; ` +
      `re-take the excerpt and re-record its hash.`,
  ]
}

/** Every quoted span must appear verbatim — this is the half a hash cannot cover. @returns {string[]} */
function unquotedCitations(id, text, rel, citations) {
  const violations = []
  for (const citation of Array.isArray(citations) ? citations : []) {
    const quoted = String(/** @type {Record<string, unknown>} */ (citation)['quoted_text'] ?? '')
    if (quoted && !text.includes(quoted)) {
      violations.push(
        `${id}: quoted_text is not a literal substring of ${rel} — ` +
          `"${quoted.slice(0, 60)}${quoted.length > 60 ? '…' : ''}"`,
      )
    }
  }
  return violations
}

/** @param {string[]} argv */
function parseArgs(argv) {
  const i = argv.indexOf('--dir')
  return {
    root: i >= 0 && argv[i + 1] ? resolve(argv[i + 1]) : process.cwd(),
    json: argv.includes('--json'),
  }
}

/** @param {boolean} json @param {string} verdict @param {string} message @param {string[]} violations */
function report(json, verdict, message, violations) {
  if (json) {
    process.stdout.write(`${JSON.stringify({ verdict, message, violations }, null, 2)}\n`)
    return
  }
  if (verdict === 'skip') {
    process.stdout.write(`[SKIP] check-sources: ${message}\n`)
    return
  }
  for (const v of violations) process.stderr.write(`check-sources: FAIL — ${v}\n`)
  if (verdict === 'pass') process.stdout.write(`check-sources: PASS — ${message}\n`)
}

/** @param {string[]} argv @returns {number} */
function main(argv) {
  const { root, json } = parseArgs(argv)
  const path = join(root, SOURCES_REL)
  if (!existsSync(path)) {
    report(json, 'skip', `${SOURCES_REL} absent — this project cites no external sources`, [])
    return 0
  }

  let doc
  try {
    doc = extractSourcesBlock(readFileSync(path, 'utf-8'))
  } catch (err) {
    process.stderr.write(`check-sources: ${SOURCES_REL} could not be parsed — ${err.message}\n`)
    return 2
  }

  let schema
  try {
    schema = loadSchema(resolve(scriptDir, '..', SCHEMA_REL))
  } catch (err) {
    process.stderr.write(`check-sources: cannot load ${SCHEMA_REL} — ${err.message}\n`)
    return 2
  }

  const schemaViolations = validateSchema(doc, schema, schema, 'sources')
  if (schemaViolations.length > 0) {
    report(json, 'fail', 'schema violations', schemaViolations)
    return 1
  }

  const sources = /** @type {Array<Record<string, unknown>>} */ (doc.sources)
  const violations = [
    ...findDuplicateSourceIds(sources),
    ...sources.flatMap((s) => checkExcerptEvidence(s, root)),
  ]
  if (violations.length > 0) {
    report(json, 'fail', 'source evidence violations', violations)
    return 1
  }
  const quotes = sources.reduce(
    (n, s) => n + (Array.isArray(s['citations']) ? s['citations'].length : 0),
    0,
  )
  report(json, 'pass', `${sources.length} source(s), ${quotes} quotation(s) verified literal`, [])
  return 0
}

if (import.meta.url === `file://${process.argv[1]}`) {
  try {
    process.exit(main(process.argv.slice(2)))
  } catch (err) {
    process.stderr.write(`check-sources: ${err?.stack ?? err}\n`)
    process.exit(2)
  }
}
