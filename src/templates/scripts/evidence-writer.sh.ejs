#!/usr/bin/env sh
# <%= projectName %> — TDD evidence writer (POSIX shell)
#
# Generated by arbiter (#973) — Port #11: bash evidence-writer for non-Node runners.
#
# Emits a TDD red-phase evidence bundle conforming to the same schema as
# scripts/evidence-collect.mjs (see src/evidence/tdd.ts TddEvidenceV1).
# Intended for minimal CI runner images that lack Node (e.g. some Java/Rust/Go
# images) so they can still produce conformant evidence under L3 governance.
#
# Output: <out-dir>/tdd/<task-id>.json  (single file, idempotent overwrite)
#
# Schema fields (all required by TddEvidenceV1):
#   $schemaVersion    — literal 1
#   task_id           — "#<digits>"
#   test_path         — path to the failing test
#   test_commit_sha   — 40 hex chars (defaults to `git rev-parse HEAD`)
#   test_run_log      — captured test output (from --test-run-log-file or empty)
#   observed_failure  — non-empty failure signature (REQUIRED)
#   recorded_at       — ISO-8601 UTC timestamp (auto-generated)
#
# Exit codes:
#   0 — evidence written successfully
#   1 — runtime error (cannot write, git failed)
#   2 — usage error (missing/invalid arguments)
#
# POSIX-shell only — no bashisms, no zshisms. Tested under dash + bash.

set -eu
# POSIX `set` has no `pipefail`; guard so the script still runs under dash.
# bash/ksh will pick it up; dash silently no-ops the failed set.
( set -o pipefail 2>/dev/null ) && set -o pipefail || true

# ─── Defaults ─────────────────────────────────────────────────────────────────

TASK_ID=""
PHASE="red"
TEST_PATH=""
OUT_DIR=".arbiter/evidence"
TEST_COMMIT_SHA=""
OBSERVED_FAILURE=""
TEST_RUN_LOG_FILE=""

# ─── Usage ────────────────────────────────────────────────────────────────────

usage() {
  cat >&2 <<'USAGE'
Usage: evidence-writer.sh --task-id <id> --test-path <path> --observed-failure <text>
                          [--phase <red|green|refactor>] [--out-dir <dir>]
                          [--test-commit-sha <sha>] [--test-run-log-file <path>]

Required:
  --task-id <id>            Task id; "#" prefix added if absent (e.g. 973 or #973)
  --test-path <path>        Path to the failing test
  --observed-failure <text> Non-empty failure signature

Optional:
  --phase <p>               red | green | refactor (default: red)
  --out-dir <dir>           Evidence root dir (default: .arbiter/evidence)
  --test-commit-sha <sha>   40-hex commit sha (default: git rev-parse HEAD)
  --test-run-log-file <p>   File whose contents become test_run_log (default: empty)
USAGE
}

# ─── Argument parsing ─────────────────────────────────────────────────────────

while [ $# -gt 0 ]; do
  case "$1" in
    --task-id)
      [ $# -ge 2 ] || { echo "[evidence-writer] missing value for --task-id" >&2; exit 2; }
      TASK_ID="$2"; shift 2 ;;
    --phase)
      [ $# -ge 2 ] || { echo "[evidence-writer] missing value for --phase" >&2; exit 2; }
      PHASE="$2"; shift 2 ;;
    --test-path)
      [ $# -ge 2 ] || { echo "[evidence-writer] missing value for --test-path" >&2; exit 2; }
      TEST_PATH="$2"; shift 2 ;;
    --out-dir)
      [ $# -ge 2 ] || { echo "[evidence-writer] missing value for --out-dir" >&2; exit 2; }
      OUT_DIR="$2"; shift 2 ;;
    --test-commit-sha)
      [ $# -ge 2 ] || { echo "[evidence-writer] missing value for --test-commit-sha" >&2; exit 2; }
      TEST_COMMIT_SHA="$2"; shift 2 ;;
    --observed-failure)
      [ $# -ge 2 ] || { echo "[evidence-writer] missing value for --observed-failure" >&2; exit 2; }
      OBSERVED_FAILURE="$2"; shift 2 ;;
    --test-run-log-file)
      [ $# -ge 2 ] || { echo "[evidence-writer] missing value for --test-run-log-file" >&2; exit 2; }
      TEST_RUN_LOG_FILE="$2"; shift 2 ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      echo "[evidence-writer] unknown argument: $1" >&2
      usage
      exit 2 ;;
  esac
done

# ─── Validation ───────────────────────────────────────────────────────────────

if [ -z "$TASK_ID" ]; then
  echo "[evidence-writer] --task-id is required" >&2
  usage; exit 2
fi
if [ -z "$TEST_PATH" ]; then
  echo "[evidence-writer] --test-path is required" >&2
  usage; exit 2
fi
if [ -z "$OBSERVED_FAILURE" ]; then
  echo "[evidence-writer] --observed-failure is required (schema: non-empty)" >&2
  usage; exit 2
fi

case "$PHASE" in
  red|green|refactor) ;;
  *)
    echo "[evidence-writer] --phase must be one of: red, green, refactor (got: $PHASE)" >&2
    exit 2 ;;
esac

# Normalize task_id: prepend "#" if absent. Schema regex: ^#\d+$
case "$TASK_ID" in
  '#'*) ;;
  *) TASK_ID="#$TASK_ID" ;;
esac
# Validate the digits portion (POSIX expr returns 0 when pattern matches)
DIGITS=$(printf '%s' "$TASK_ID" | sed 's/^#//')
case "$DIGITS" in
  ''|*[!0-9]*)
    echo "[evidence-writer] --task-id must match ^#?[0-9]+\$ (got: $TASK_ID)" >&2
    exit 2 ;;
esac

# Default test_commit_sha to git HEAD (40 hex). Fail-closed if git missing.
if [ -z "$TEST_COMMIT_SHA" ]; then
  if ! command -v git >/dev/null 2>&1; then
    echo "[evidence-writer] git not on PATH and --test-commit-sha not provided" >&2
    exit 1
  fi
  TEST_COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null || true)
  if [ -z "$TEST_COMMIT_SHA" ]; then
    echo "[evidence-writer] git rev-parse HEAD failed (not a repo?)" >&2
    exit 1
  fi
fi

# Schema requires exactly 40 hex chars.
case "$TEST_COMMIT_SHA" in
  *[!0-9a-fA-F]*|"")
    echo "[evidence-writer] test_commit_sha must be 40 hex chars (got: $TEST_COMMIT_SHA)" >&2
    exit 2 ;;
esac
SHA_LEN=$(printf '%s' "$TEST_COMMIT_SHA" | wc -c | tr -d ' ')
if [ "$SHA_LEN" -ne 40 ]; then
  echo "[evidence-writer] test_commit_sha must be exactly 40 chars (got $SHA_LEN)" >&2
  exit 2
fi

# Read test_run_log from file if provided; default to empty string.
TEST_RUN_LOG=""
if [ -n "$TEST_RUN_LOG_FILE" ]; then
  if [ ! -f "$TEST_RUN_LOG_FILE" ]; then
    echo "[evidence-writer] --test-run-log-file not found: $TEST_RUN_LOG_FILE" >&2
    exit 1
  fi
  TEST_RUN_LOG=$(cat "$TEST_RUN_LOG_FILE")
fi

# ─── ISO-8601 UTC timestamp ───────────────────────────────────────────────────

# GNU/BSD `date` both support `-u` and these specifiers.
RECORDED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# ─── JSON-string escaping (pure shell, no jq) ─────────────────────────────────
#
# Escape backslash, double-quote, and control chars to satisfy RFC 8259.
# Order matters: backslash must be escaped first so its replacement does not
# get re-escaped by later substitutions.
json_escape() {
  # Read via printf '%s' to avoid echo's backslash interpretation.
  printf '%s' "$1" | awk '
    BEGIN { RS = "\1" }
    {
      gsub(/\\/, "\\\\")
      gsub(/"/, "\\\"")
      gsub(/\r/, "\\r")
      gsub(/\t/, "\\t")
      gsub(/\f/, "\\f")
      gsub(/\b/, "\\b")
      gsub(/\n/, "\\n")
      printf "%s", $0
    }
  '
}

ESC_TASK_ID=$(json_escape "$TASK_ID")
ESC_TEST_PATH=$(json_escape "$TEST_PATH")
ESC_TEST_COMMIT_SHA=$(json_escape "$TEST_COMMIT_SHA")
ESC_TEST_RUN_LOG=$(json_escape "$TEST_RUN_LOG")
ESC_OBSERVED_FAILURE=$(json_escape "$OBSERVED_FAILURE")
ESC_RECORDED_AT=$(json_escape "$RECORDED_AT")

# ─── Write evidence ───────────────────────────────────────────────────────────

TDD_DIR="$OUT_DIR/tdd"
mkdir -p "$TDD_DIR"
OUT_FILE="$TDD_DIR/$TASK_ID.json"

# Compose JSON via heredoc — single source of truth, no jq required.
cat > "$OUT_FILE" <<JSON
{
  "\$schemaVersion": 1,
  "task_id": "$ESC_TASK_ID",
  "test_path": "$ESC_TEST_PATH",
  "test_commit_sha": "$ESC_TEST_COMMIT_SHA",
  "test_run_log": "$ESC_TEST_RUN_LOG",
  "observed_failure": "$ESC_OBSERVED_FAILURE",
  "recorded_at": "$ESC_RECORDED_AT"
}
JSON

echo "[evidence-writer] wrote $OUT_FILE (phase=$PHASE)"
