#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// scripts/check-min-test-execution.mjs — generated by arbiter (anti-fake-green, INV-25).
//
// No-empty-suite / min-execution guard. A test tier that collects ZERO tests yet exits 0 is the
// classic false-green ("100 tests, 0 executed = green"): the gate is green while no test body ever
// ran. The runner's own exit code does not catch it — `vitest run --passWithNoTests`,
// `pytest` on an empty tree (exit 5 swallowed), and a `go test ./...` over a package with no test
// files all report success on zero tests. This guard asks the project's test runner how many tests
// it would run and FAILS when that count is 0.
//
// It uses each runner's COLLECT / LIST mode (no test bodies execute), so it is cheap and never
// double-runs the suite:
//   - vitest : `vitest list`              → one line per collected test (the " > " test-id form)
//   - jest   : `jest --listTests`         → one line per test FILE (file-level proxy)
//   - pytest : `pytest --collect-only -q` → "<N> tests collected" / "no tests collected"
//   - go     : `go test -list '.*' ./...` → one line per Test/Example/Benchmark/Fuzz function
//
// Semantics:
//   - no recognized runner            → NA   (exit 0) — nothing to assert.
//   - runner recognized, not installed→ SKIP (exit 0) — deps not present yet (fresh greenfield);
//                                        the real test gate would fail first if this mattered.
//   - collection errored (build/import
//     failure, unexpected exit)       → ERROR(exit 2) — surfaced loudly, never masked as "0 tests".
//   - collected 0 tests               → FAIL (exit 1) — the empty-suite false-green.
//   - collected > 0 tests             → PASS (exit 0).
//
// This guard targets the EMPTY-collection false-green. Whether an all-skipped suite trips it is the
// runner's call: `vitest list` omits skipped tests (so an all-skipped suite collects 0 and FAILS
// here), while `pytest --collect-only` counts them (so it passes here and is left to the muted-test
// guard, check-muted-test). The two guards overlap by design — defense in depth, never a gap.
//
// Usage: node scripts/check-min-test-execution.mjs [--help]
// Exit codes (INV-53): 0=PASS/NA/SKIP, 1=FAIL (empty suite), 2=ERROR (collector failure / self).
import { existsSync, readFileSync } from 'node:fs'
import { join } from 'node:path'
import { spawnSync } from 'node:child_process'

const args = process.argv.slice(2)
if (args.includes('--help') || args.includes('-h')) {
  process.stdout.write(
    'Usage: node scripts/check-min-test-execution.mjs\n' +
      '  Fails when the project test runner collects 0 tests (the empty-suite false-green).\n' +
      '  Uses the runner collect/list mode (no execution). NA when no recognized runner.\n',
  )
  process.exit(0)
}

// Test seam (INV / anti-vacuous): `--parse <runner>` reads collect output on stdin and prints the
// parsed count (or "null"). Lets the parsers be exercised against real captured runner output
// without invoking the runner — keeping the guard's own test deterministic and toolchain-free.
const parseIdx = args.indexOf('--parse')
if (parseIdx !== -1) {
  const runner = args[parseIdx + 1]
  const counters = { vitest: countVitest, jest: countJest, pytest: countPytest, go: countGo }
  const counter = counters[runner]
  if (!counter) {
    process.stderr.write(`check-min-test-execution: unknown runner "${runner}"\n`)
    process.exit(2)
  }
  let stdin = ''
  try {
    stdin = readFileSync(0, 'utf-8')
  } catch {
    stdin = ''
  }
  const n = counter(stdin)
  process.stdout.write(`${n == null ? 'null' : n}\n`)
  process.exit(0)
}

const ROOT = process.cwd()
const IS_CI = process.env.CI === 'true' || process.env.GITHUB_ACTIONS === 'true'
const IS_WIN = process.platform === 'win32'

function readJson(path) {
  try {
    return JSON.parse(readFileSync(path, 'utf-8'))
  } catch {
    return null
  }
}

function localBin(name) {
  const bin = join(ROOT, 'node_modules', '.bin', IS_WIN ? `${name}.cmd` : name)
  return existsSync(bin) ? bin : null
}

function hasAnyDep(pkg, names) {
  const deps = { ...(pkg?.dependencies ?? {}), ...(pkg?.devDependencies ?? {}) }
  return names.some((n) => Object.prototype.hasOwnProperty.call(deps, n))
}

function hasConfig(prefixes, exts) {
  for (const p of prefixes) {
    for (const e of exts) {
      if (existsSync(join(ROOT, `${p}${e}`))) return true
    }
  }
  return false
}

// ── Runner detection ──────────────────────────────────────────────────────────
// Returns { runner, bin, cmd, args } or null (NA). `bin === null` ⇒ recognized but not installed.
function detectRunner() {
  const pkgPath = join(ROOT, 'package.json')
  if (existsSync(pkgPath)) {
    const pkg = readJson(pkgPath)
    const usesVitest =
      hasAnyDep(pkg, ['vitest']) || hasConfig(['vitest.config'], ['.ts', '.js', '.mjs', '.cts', '.mts'])
    if (usesVitest) return { runner: 'vitest', bin: localBin('vitest'), args: ['list'] }
    const usesJest =
      hasAnyDep(pkg, ['jest']) ||
      pkg?.jest != null ||
      hasConfig(['jest.config'], ['.ts', '.js', '.mjs', '.cjs', '.json'])
    if (usesJest) return { runner: 'jest', bin: localBin('jest'), args: ['--listTests'] }
    // No JS runner in THIS package.json — do NOT early-return NA: a polyglot repo (JS frontend +
    // a Go/Python backend at root) still has a backend suite the empty-suite guard must assert.
    // Fall through to the go.mod / Python markers below; NA is reached only when NO runner matches.
  }
  if (existsSync(join(ROOT, 'go.mod'))) {
    return { runner: 'go', bin: 'go', args: ['test', '-list', '.*', './...'] }
  }
  const pyMarker =
    existsSync(join(ROOT, 'pyproject.toml')) ||
    existsSync(join(ROOT, 'pytest.ini')) ||
    existsSync(join(ROOT, 'setup.cfg')) ||
    existsSync(join(ROOT, 'tox.ini')) ||
    existsSync(join(ROOT, 'conftest.py'))
  if (pyMarker) return { runner: 'pytest', bin: 'pytest', args: ['--collect-only', '-q'] }
  return null
}

// ── Count parsers (per runner) ──────────────────────────────────────────────────
// Each returns a non-negative integer, or null when the output cannot be parsed.
function countVitest(stdout) {
  // `vitest list` prints one collected test per line as "file > [suite > ] name".
  return stdout.split('\n').filter((l) => l.includes(' > ')).length
}
function countJest(stdout) {
  // `jest --listTests` prints one absolute test-FILE path per line.
  return stdout.split('\n').filter((l) => l.trim().length > 0).length
}
function countPytest(stdout) {
  if (/no tests (collected|ran)/i.test(stdout)) return 0
  let m = stdout.match(/(\d+)\s+tests?\s+(?:collected|selected)/i)
  if (m) return Number(m[1])
  m = stdout.match(/collected\s+(\d+)\s+items?/i)
  if (m) return Number(m[1])
  return null
}
function countGo(stdout) {
  // `go test -list` prints one Test/Example/Benchmark/Fuzz function name per line, plus per-package
  // status lines ("ok  pkg", "?   pkg [no test files]") which are NOT test names.
  return stdout.split('\n').filter((l) => /^(Test|Example|Benchmark|Fuzz)\w*\s*$/.test(l.trim()))
    .length
}

function pass(msg) {
  process.stdout.write(`check-min-test-execution: ${msg}\n`)
  process.exit(0)
}
function fail(msg) {
  process.stderr.write(`check-min-test-execution: FAIL — ${msg}\n`)
  process.exit(1)
}
function error(msg) {
  process.stderr.write(`check-min-test-execution: ERROR — ${msg}\n`)
  process.exit(2)
}

function main() {
  const det = detectRunner()
  if (!det) pass('no recognized test runner — NA')
  if (!det.bin) {
    // Recognized runner but the binary is absent. In CI the toolchain is installed, so an absent
    // runner is itself suspicious — but the actual test gate fails first; we stay advisory here.
    pass(`${det.runner} not installed — SKIP (deps not present)${IS_CI ? ' [CI]' : ''}`)
  }

  const r = spawnSync(det.bin, det.args, {
    cwd: ROOT,
    encoding: 'utf-8',
    shell: false,
    timeout: 120_000,
    maxBuffer: 64 * 1024 * 1024,
  })
  if (r.error && r.error.code === 'ENOENT') pass(`${det.runner} not installed — SKIP`)
  if (r.error) error(`${det.runner} collect failed to spawn: ${r.error.message}`)
  const out = `${r.stdout ?? ''}\n${r.stderr ?? ''}`

  // pytest signals "no tests" with exit 5 — that is a legitimate empty collection, not an error.
  const pytestEmpty = det.runner === 'pytest' && r.status === 5
  if (!pytestEmpty && r.status !== 0) {
    error(`${det.runner} collect exited ${r.status} (collection error, not an empty suite):\n${out}`)
  }

  const counters = {
    vitest: countVitest,
    jest: countJest,
    pytest: countPytest,
    go: countGo,
  }
  const count = counters[det.runner](out)
  if (count == null) {
    error(`could not parse ${det.runner} collect output:\n${out}`)
  }
  if (count === 0) {
    fail(
      `${det.runner} collected 0 tests — an empty suite that reports success is a false-green. ` +
        'Add a real test, or remove the empty tier from the gate.',
    )
  }
  pass(`${det.runner} collects ${count} test(s) — OK`)
}

try {
  main()
} catch (e) {
  error(e?.message ?? String(e))
}
