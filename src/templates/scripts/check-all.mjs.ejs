  if (existsSync('scripts/verify-tokens.mjs')) {
    runCheck('token discipline (INV-105)', 'node', ['scripts/verify-tokens.mjs'], { soft: graceActive });
  }
  // ─── L2: i18n raw-literal scan (INV-106, #1127) ───────────────────────────
  // Scans component source for hardcoded text that should use t('key').
  if (existsSync('scripts/i18n-literal-scanner.mjs')) {
    runCheck('i18n literals (INV-106)', 'node', ['scripts/i18n-literal-scanner.mjs'], { soft: graceActive });
  }
  // ─── L2: i18n locale key parity (INV-106, #1127) ─────────────────────────
