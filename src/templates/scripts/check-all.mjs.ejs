        const _entries = readdirSync(_releaseDir);
        for (const _e of _entries) {
          const _full = join(_releaseDir, _e);
          const _st = statSync(_full);
          if (_st.isFile() && (_st.mode & 0o111)) {
            _binPath = _full;
            const _bytes = _st.size;
            if (_bytes > _maxBytes) {
              console.log(graceActive
                ? `WARN (grace period, ${_bytes} > ${_maxBytes})`
                : `FAIL (${_bytes} > ${_maxBytes})`);
              if (!graceActive) { _binSizeStatus = 'FAIL'; }
            } else {
              console.log(`PASS (${_bytes} bytes / ${_maxBytes} cap)`);
            }
            break;
          }
        }
      }
      if (_binPath === null) {
        console.log('SKIP (no release binary built yet)');
      }
    } catch (_e) {
      console.log(graceActive ? 'WARN (grace period, ' + _e.message + ')' : 'FAIL (' + _e.message + ')');
      if (!graceActive) { _binSizeStatus = 'FAIL'; }
    }
    pushResult('binary size', _binSizeStatus, Date.now() - _binSizeStart);
