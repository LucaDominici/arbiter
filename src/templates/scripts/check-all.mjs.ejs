  const _caDesignExemptions = new Set(['npx:commitlint', 'npm:test']);
  function _caIsInfra(cmd) { return _caInfraPrefixes.some((p) => cmd.startsWith(p)); }
  function _caNormalizeKey(cmd, firstArg) {
