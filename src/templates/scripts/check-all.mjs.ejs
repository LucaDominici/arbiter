  const coverResult = spawnSync('go', ['tool', 'cover', '-func=coverage.out'], { encoding: 'utf-8', shell: false });
  let _coverThreshStatus = 'PASS';
  if (coverResult.status !== 0) {
    console.log(graceActive ? 'WARN (grace period)' : 'FAIL (could not parse coverage)');
