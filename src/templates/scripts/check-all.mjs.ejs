#!/usr/bin/env node
// <%= projectName %> quality gate
// Usage: node scripts/check-all.mjs [L1|L2]
// L1: format + lint + unit tests (fast, pre-commit)
// L2: L1 + coverage + audit (full, pre-push)
import { spawnSync } from 'node:child_process';

const level = process.argv[2] ?? 'L2';
let failed = 0;

function runCheck(name, cmd, args) {
  process.stdout.write(`[CHECK] ${name} ... `);
  const r = spawnSync(cmd, args, { encoding: 'utf-8', shell: false });
  if (r.status === 0) {
    console.log('PASS');
  } else {
    console.log('FAIL');
    if (r.stdout) process.stdout.write(r.stdout);
    if (r.stderr) process.stderr.write(r.stderr);
    failed++;
  }
}

console.log('');
console.log(`=== <%= projectName %> Quality Gate: ${level} ===`);
console.log('');

// ─── L1: Fast checks ──────────────────────────────────────────────────────────
<% if (language === 'typescript') { %>
runCheck('typecheck', 'npx', ['tsc', '--noEmit']);
runCheck('format', 'npx', ['prettier', '--check', '.']);
runCheck('lint', 'npx', ['eslint', 'src']);
runCheck('unit tests', 'npm', ['test']);
<% } %><% if (language === 'rust') { %>
runCheck('fmt', 'cargo', ['fmt', '--check']);
runCheck('clippy', 'cargo', ['clippy', '--', '-D', 'warnings']);
runCheck('unit tests', 'cargo', ['test']);
<% } %><% if (language === 'java' && buildTool === 'gradle') { %>
runCheck('checkstyle', './gradlew', ['checkstyleMain', '-q']);
runCheck('unit tests', './gradlew', ['test', '-q']);
<% } %><% if (language === 'java' && buildTool === 'maven') { %>
runCheck('checkstyle', 'mvn', ['checkstyle:check', '-q']);
runCheck('unit tests', 'mvn', ['test', '-q']);
<% } %><% if (language === 'go') { %>
runCheck('vet', 'go', ['vet', './...']);
runCheck('lint', 'golangci-lint', ['run']);
runCheck('unit tests', 'go', ['test', './...']);
<% } %><% if (language === 'python') { %>
runCheck('lint', 'ruff', ['check', '.']);
runCheck('format', 'ruff', ['format', '--check', '.']);
runCheck('unit tests', 'pytest', []);
<% } %>

<% if (enableSuppressions) { %>
// ─── L1: Suppression expiry ───────────────────────────────────────────────────
runCheck('suppressions expiry', 'node', ['scripts/check-suppressions.mjs']);
<% } %>
// ─── L2: Full checks ──────────────────────────────────────────────────────────
if (level === 'L2') {
<% if (language === 'typescript') { %>
  runCheck('audit', 'npm', ['audit', '--audit-level=high']);
<% } %><% if (language === 'rust') { %>
  runCheck('audit', 'cargo', ['audit']);
<% } %><% if (language === 'java' && buildTool === 'gradle') { %>
  runCheck('integration', './gradlew', ['integrationTest', '-q']);
<% } %><% if (language === 'java' && buildTool === 'maven') { %>
  runCheck('integration', 'mvn', ['verify', '-q']);
<% } %><% if (language === 'go') { %>
  runCheck('staticcheck', 'staticcheck', ['./...']);
<% } %><% if (language === 'python') { %>
  runCheck('audit', 'pip-audit', []);
<% } %>
<% if (enableDebtGates) { %>
  // ─── L2: Tech Debt Gates ────────────────────────────────────────────────────
<% if (language === 'typescript') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage threshold', 'npx', ['vitest', 'run', '--coverage', '--coverage.thresholds.lines=<%= coverageThreshold %>']);
<% } %>
  runCheck('dead code', 'npx', ['knip']);
  runCheck('circular deps', 'npx', ['madge', '--circular', 'src']);
<% } %><% if (language === 'rust') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage threshold', 'cargo', ['tarpaulin', '--fail-under', '<%= coverageThreshold %>']);
<% } %>
  runCheck('clippy pedantic', 'cargo', ['clippy', '--', '-W', 'clippy::pedantic', '-D', 'warnings']);
<% } %><% if (language === 'java' && buildTool === 'gradle') { %>
  runCheck('coverage', './gradlew', ['jacocoTestCoverageVerification', '-q']);
  runCheck('pmd', './gradlew', ['pmdMain', '-q']);
  runCheck('mutation testing (pitest)', './gradlew', ['pitest', '-q']);
<% } %><% if (language === 'java' && buildTool === 'maven') { %>
  runCheck('coverage', 'mvn', ['verify', '-Pjacoco', '-q']);
  runCheck('pmd', 'mvn', ['pmd:check', '-q']);
  runCheck('mutation testing (pitest)', 'mvn', ['org.pitest:pitest-maven:mutationCoverage', '-q']);
<% } %><% if (language === 'go') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage profile', 'go', ['test', '-coverprofile=coverage.out', '-covermode=atomic', './...']);
  process.stdout.write('[CHECK] coverage threshold ... ');
  const coverResult = spawnSync('go', ['tool', 'cover', '-func=coverage.out'], { encoding: 'utf-8', shell: false });
  if (coverResult.status !== 0) {
    console.log('FAIL (could not parse coverage)');
    failed++;
  } else {
    const match = coverResult.stdout.match(/total:\s+\(statements\)\s+([\d.]+)%/);
    const pct = match ? parseFloat(match[1]) : 0;
    if (pct < <%= coverageThreshold %>) { console.log(`FAIL (${pct.toFixed(1)}% < <%= coverageThreshold %>%)`); failed++; }
    else { console.log(`PASS (${pct.toFixed(1)}%)`); }
  }
<% } %>
  runCheck('complexity + dead code', 'golangci-lint', ['run', '--enable', 'gocyclo,gocognit,deadcode,unused']);
<% } %><% if (language === 'python') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage threshold', 'pytest', ['--cov', '--cov-fail-under=<%= coverageThreshold %>']);
<% } %>
  runCheck('complexity', 'ruff', ['check', '--select', 'C901,PLR0911,PLR0912,PLR0913,PLR0915', '.']);
  runCheck('unused imports', 'ruff', ['check', '--select', 'F401,F811', '.']);
<% } %>
  // ─── L2: STRIDE/RACI traceability ───────────────────────────────────────────
  runCheck('STRIDE/RACI traceability', 'node', ['scripts/check-stride-traceability.mjs']);
  // ─── L2: Debt Ratchet ────────────────────────────────────────────────────────
  // Compares against baseline if debt-baseline.json exists (skips gracefully if absent)
<% const ratchetFlag = governanceLevel === 'L3' ? '--require-improvement' : '--gate'; %>
  runCheck('debt ratchet', 'node', ['scripts/debt-report.mjs', '<%= ratchetFlag %>']);
<% } %>
}

console.log('');
if (failed > 0) {
  console.error(`=== FAILED: ${failed} check(s) ===\n`);
  process.exit(1);
} else {
  console.log('=== ALL PASSED ===\n');
}
