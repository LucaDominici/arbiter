  // Compares against baseline if debt-baseline.json exists (skips gracefully if absent)
<% const ratchetFlag = governanceLevel === 'L3' ? '--require-improvement' : '--gate'; %>
  runCheck('debt ratchet', 'node', ['scripts/debt-report.mjs', '<%= ratchetFlag %>'], { soft: graceActive });
<% } %>
<% if (governanceLevel === 'L3') { %>
  // ─── L3: Evidence gate (INV-33) ─────────────────────────────────────────────
  // Validates nightly evidence produced by evidence-collect.mjs.
  // Warns when absent (first run); fails when present but obs_gate !== 'PASS'.
  const _evidenceStart = Date.now();
  let _evidenceStatus = 'PASS';
  process.stdout.write('[CHECK] evidence gate (INV-33) ... ');
  {
    const _summaryPath = join(process.cwd(), '.evidence', 'SUMMARY.json');
    if (!existsSync(_summaryPath)) {
      console.log('WARN — .evidence/SUMMARY.json absent (run nightly pipeline first)');
    } else {
      try {
        const _summary = JSON.parse(readFileSync(_summaryPath, 'utf-8'));
        if (_summary.obs_gate === 'PASS') {
          console.log('PASS');
        } else {
          console.log('FAIL (obs_gate=' + _summary.obs_gate + ')');
          _evidenceStatus = 'FAIL';
          failed++;
        }
      } catch {
        console.log('FAIL (could not parse .evidence/SUMMARY.json)');
        _evidenceStatus = 'FAIL';
        failed++;
      }
    }
  }
  results.push({ name: 'evidence gate (INV-33)', status: _evidenceStatus, elapsed: Date.now() - _evidenceStart });
<% } %>
}

// ─── Summary ─────────────────────────────────────────────────────────────────
console.log('');
console.log('=== Summary ===');
console.log('');

const nameWidth = Math.max(6, ...results.map((r) => r.name.length));
const header = `${'Check'.padEnd(nameWidth)}  Status  Elapsed`;
const divider = '-'.repeat(header.length);
console.log(header);
console.log(divider);
let totalElapsed = 0;
for (const r of results) {
  totalElapsed += r.elapsed;
  console.log(`${r.name.padEnd(nameWidth)}  ${r.status.padEnd(6)}  ${r.elapsed}ms`);
}
console.log(divider);
console.log(`${'Total'.padEnd(nameWidth)}          ${totalElapsed}ms`);
console.log('');

// ─── Gate result JSON (arbiter-gate-v1) ──────────────────────────────────────
{
  const _parityGates = results
    .map((r) => ({ name: r.name, pass: r.status === 'PASS' }))
    .sort((a, b) => a.name.localeCompare(b.name));
  const _parityContentHash = createHash('sha256').update(JSON.stringify(_parityGates)).digest('hex');
  const _contentHash = createHash('sha256').update(JSON.stringify(_parityGates)).digest('hex');
  const _artifact = {
    schema: 'arbiter-gate-v1',
    node: process.version,
    level,
    gates: results.map((r) => ({ name: r.name, pass: r.status === 'PASS', durationMs: r.elapsed })),
    parityGates: _parityGates,
    pass: failed === 0,
    parityContentHash: _parityContentHash,
    contentHash: _contentHash,
  };
  const _outPath = (jsonPath !== null && jsonPath !== '') ? jsonPath : resolve(process.cwd(), '.arbiter/gate/local-result.json');
  try {
    mkdirSync(dirname(_outPath), { recursive: true });
    writeFileSync(_outPath, JSON.stringify(_artifact, null, 2) + '\n');
  } catch { /* non-fatal */ }
}

if (failed > 0) {
  console.error(`=== FAILED: ${failed} check(s) ===\n`);
  process.exit(1);
} else {
  console.log('=== ALL PASSED ===\n');
}
