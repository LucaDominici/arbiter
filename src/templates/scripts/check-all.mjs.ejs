#!/usr/bin/env node
// <%= projectName %> quality gate
// Usage: node scripts/check-all.mjs [L1|L2]
// L1: format + lint + unit tests (fast, pre-commit)
// L2: L1 + coverage + audit (full, pre-push)
import { spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const level = process.argv[2] ?? 'L2';
let failed = 0;

function runCheck(name, cmd, args, { soft = false } = {}) {
  process.stdout.write(`[CHECK] ${name} ... `);
  const r = spawnSync(cmd, args, { encoding: 'utf-8', shell: false });
  if (r.error?.code === 'ENOENT') {
    console.log(`FAIL (binary not found: ${cmd})`);
    failed++;
  } else if (r.status === 0) {
    console.log('PASS');
  } else if (soft) {
    console.log('WARN (grace period)');
    if (r.stdout) process.stdout.write(r.stdout);
    if (r.stderr) process.stderr.write(r.stderr);
  } else {
    console.log('FAIL');
    if (r.stdout) process.stdout.write(r.stdout);
    if (r.stderr) process.stderr.write(r.stderr);
    failed++;
  }
}

// ─── Grace Period Guard (ADR-028) ─────────────────────────────────────────────
// If arbiter.json records graceFromLevel==='L1' with a future graceEndsAt,
// all L2 gates become WARN-only for the remainder of the grace period.
let graceActive = false;
const _arbiterJsonPath = join(process.cwd(), 'arbiter.json');
if (existsSync(_arbiterJsonPath)) {
  try {
    const _cfg = JSON.parse(readFileSync(_arbiterJsonPath, 'utf-8'));
    if (
      _cfg.graceFromLevel === 'L1' &&
      _cfg.graceEndsAt &&
      Date.parse(_cfg.graceEndsAt) > Date.now()
    ) {
      graceActive = true;
      const _daysLeft = Math.ceil((Date.parse(_cfg.graceEndsAt) - Date.now()) / 86400000);
      const _endsDate = _cfg.graceEndsAt.slice(0, 10);
      console.log(`[GRACE] Grace period ends in ${_daysLeft} day(s) (${_endsDate}). L2 gates WARN-only until then.`);
    }
  } catch { /* ignore parse errors — arbiter.json absent or malformed */ }
}

console.log('');
console.log(`=== <%= projectName %> Quality Gate: ${level} ===`);
console.log('');

<% if (enableSecurityScanning) { %>
// ─── Early-fail: PII scan (INV-12, HARD — no grace period) ────────────────────
runCheck('PII scan', 'node', ['scripts/pii-scan.mjs']);
<% } %>
// ─── L1: Fast checks ──────────────────────────────────────────────────────────
<% if (language === 'typescript') { %>
runCheck('typecheck', 'npx', ['tsc', '--noEmit']);
runCheck('format', 'npx', ['prettier', '--check', '.']);
runCheck('lint', 'npx', ['eslint', 'src']);
// ─── L1: Static analysis rules (M29) ─────────────────────────────────────────
if (existsSync('.eslintrc-static.json')) {
  runCheck('static analysis', 'npx', ['eslint', '--no-eslintrc', '-c', '.eslintrc-static.json', 'src']);
} else {
  console.log('[CHECK] static analysis ... SKIP (run: arbiter update)');
}
runCheck('unit tests', 'npm', ['test']);
<% } %><% if (language === 'rust') { %>
runCheck('fmt', 'cargo', ['fmt', '--check']);
runCheck('clippy', 'cargo', ['clippy', '--', '-D', 'warnings']);
runCheck('unit tests', 'cargo', ['test']);
<% } %><% if (language === 'java' && buildTool === 'gradle') { %>
runCheck('checkstyle', './gradlew', ['checkstyleMain', '-q']);
runCheck('format (spotless)', './gradlew', ['spotlessCheck', '-q']);
runCheck('unit tests', './gradlew', ['test', '-q']);
<% } %><% if (language === 'java' && buildTool === 'maven') { %>
runCheck('checkstyle', 'mvn', ['checkstyle:check', '-q']);
runCheck('format (spotless)', 'mvn', ['spotless:check', '-q']);
runCheck('unit tests', 'mvn', ['test', '-q']);
<% } %><% if (language === 'go') { %>
runCheck('vet', 'go', ['vet', './...']);
runCheck('lint', 'golangci-lint', ['run']);
runCheck('unit tests', 'go', ['test', './...']);
<% } %><% if (language === 'python') { %>
runCheck('lint', 'ruff', ['check', '.']);
runCheck('format', 'ruff', ['format', '--check', '.']);
runCheck('unit tests', 'pytest', []);
<% } %>

// ─── L1: Test naming convention (M27) ────────────────────────────────────────
runCheck('test naming', 'node', ['scripts/check-test-naming.mjs']);
<% if (archetype === 'frontend-spa' && language === 'typescript') { %>
// ─── L1: Playwright quality rules (M27) ──────────────────────────────────────
// Requires: npm install -D eslint-plugin-playwright
if (existsSync(join('node_modules', 'eslint-plugin-playwright'))) {
  runCheck('playwright rules', 'npx', ['eslint', '--no-eslintrc', '-c', '.eslintrc-playwright.json', 'src/**/*.spec.ts']);
} else {
  console.log('[CHECK] playwright rules ... SKIP (run: npm install -D eslint-plugin-playwright)');
}
<% } %>
<% if (enableSuppressions) { %>
// ─── L1: Suppression expiry ───────────────────────────────────────────────────
runCheck('suppressions expiry', 'node', ['scripts/check-suppressions.mjs']);
<% } %>
// ─── L2: Full checks ──────────────────────────────────────────────────────────
if (level === 'L2') {
<% if (enableSecurityScanning) { %>
  // ─── L2: Security scanning (INV-11/12/13) ──────────────────────────────────
  runCheck('gitleaks', 'gitleaks', ['detect', '--source', '.', '--config', '.gitleaks.toml', '--gitleaks-ignore-path', 'suppressions/.gitleaksignore', '--exit-code', '1'], { soft: graceActive });
<% } %>
<% if (language === 'typescript') { %>
<% if (enableSecurityScanning) { %>
  runCheck('audit', 'npm', ['audit', '--audit-level=high'], { soft: graceActive });
<% } %>
<% if (architectureStyle === 'hexagonal') { %>
  runCheck('boundaries', 'node', ['scripts/check-boundaries.mjs'], { soft: graceActive });
<% } %>
<% if (hasDatabase && governanceLevel !== 'L1') { %>
  runCheck('integration tests', 'npx', ['vitest', 'run', 'integration'], { soft: graceActive });
<% } %>
<% } %><% if (language === 'rust') { %>
<% if (enableSecurityScanning) { %>
  runCheck('audit', 'cargo', ['audit'], { soft: graceActive });
<% } %>
<% if (architectureStyle === 'hexagonal') { %>
  runCheck('boundaries', 'node', ['scripts/check-boundaries.mjs'], { soft: graceActive });
<% } %>
<% if (hasDatabase && governanceLevel !== 'L1') { %>
  runCheck('integration tests', 'cargo', ['test', '--test', '*integration*'], { soft: graceActive });
<% } %>
<% } %><% if (language === 'java' && buildTool === 'gradle') { %>
<% if (hasDatabase && governanceLevel !== 'L1') { %>
  runCheck('integration', './gradlew', ['integrationTest', '-q'], { soft: graceActive });
<% } %>
<% if (architectureStyle === 'hexagonal' && basePackage) { %>
  runCheck('architecture tests', './gradlew', ['test', '--tests', '*.architecture.*', '-q'], { soft: graceActive });
<% } %>
<% if (enableSecurityScanning) { %>
  runCheck('dep audit (OWASP)', './gradlew', ['dependencyCheckAnalyze', '-q'], { soft: graceActive });
<% } %>
<% } %><% if (language === 'java' && buildTool === 'maven') { %>
<% if (hasDatabase && governanceLevel !== 'L1') { %>
  runCheck('integration', 'mvn', ['verify', '-q'], { soft: graceActive });
<% } %>
<% if (enableSecurityScanning) { %>
  runCheck('dep audit (OWASP)', 'mvn', ['org.owasp:dependency-check-maven:check', '-q'], { soft: graceActive });
<% } %>
<% } %><% if (language === 'go') { %>
  runCheck('staticcheck', 'staticcheck', ['./...'], { soft: graceActive });
<% if (enableSecurityScanning) { %>
  runCheck('dep audit', 'govulncheck', ['./...'], { soft: graceActive });
<% } %>
<% if (architectureStyle === 'hexagonal') { %>
  runCheck('boundaries', 'node', ['scripts/check-boundaries.mjs'], { soft: graceActive });
<% } %>
<% if (hasDatabase && governanceLevel !== 'L1') { %>
  runCheck('integration tests', 'go', ['test', '-tags', 'integration', '-run', 'Integration', './...'], { soft: graceActive });
<% } %>
<% } %><% if (language === 'python') { %>
<% if (enableSecurityScanning) { %>
  runCheck('audit', 'pip-audit', [], { soft: graceActive });
<% } %>
<% if (architectureStyle === 'hexagonal') { %>
  runCheck('boundaries', 'node', ['scripts/check-boundaries.mjs'], { soft: graceActive });
<% } %>
<% if (hasDatabase && governanceLevel !== 'L1') { %>
  runCheck('integration tests', 'pytest', ['tests/integration/'], { soft: graceActive });
<% } %>
<% } %>
<% if (enableDebtGates) { %>
  // ─── L2: Tech Debt Gates ────────────────────────────────────────────────────
<% if (language === 'typescript') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage threshold', 'npx', ['vitest', 'run', '--coverage', '--coverage.thresholds.lines=<%= coverageThreshold %>'], { soft: graceActive });
<% } %>
  runCheck('dead code', 'npx', ['knip'], { soft: graceActive });
  runCheck('circular deps', 'npx', ['madge', '--circular', 'src'], { soft: graceActive });
<% } %><% if (language === 'rust') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage threshold', 'cargo', ['tarpaulin', '--fail-under', '<%= coverageThreshold %>'], { soft: graceActive });
<% } %>
  runCheck('clippy pedantic', 'cargo', ['clippy', '--', '-W', 'clippy::pedantic', '-D', 'warnings'], { soft: graceActive });
<% } %><% if (language === 'java' && buildTool === 'gradle') { %>
  runCheck('coverage', './gradlew', ['jacocoTestCoverageVerification', '-q'], { soft: graceActive });
  runCheck('pmd', './gradlew', ['pmdMain', '-q'], { soft: graceActive });
  runCheck('spotbugs', './gradlew', ['spotbugsMain', '-q']);
<% } %><% if (language === 'java' && buildTool === 'maven') { %>
  runCheck('coverage', 'mvn', ['verify', '-Pjacoco', '-q'], { soft: graceActive });
  runCheck('pmd', 'mvn', ['pmd:check', '-q'], { soft: graceActive });
  runCheck('spotbugs', 'mvn', ['com.github.spotbugs:spotbugs-maven-plugin:check', '-q']);
<% } %><% if (language === 'go') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage profile', 'go', ['test', '-coverprofile=coverage.out', '-covermode=atomic', './...'], { soft: graceActive });
  process.stdout.write('[CHECK] coverage threshold ... ');
  const coverResult = spawnSync('go', ['tool', 'cover', '-func=coverage.out'], { encoding: 'utf-8', shell: false });
  if (coverResult.status !== 0) {
    console.log(graceActive ? 'WARN (grace period)' : 'FAIL (could not parse coverage)');
    if (!graceActive) failed++;
  } else {
    const match = coverResult.stdout.match(/total:\s+\(statements\)\s+([\d.]+)%/);
    const pct = match ? parseFloat(match[1]) : 0;
    if (pct < <%= coverageThreshold %>) {
      console.log(graceActive ? `WARN (grace period, ${pct.toFixed(1)}% < <%= coverageThreshold %>%)` : `FAIL (${pct.toFixed(1)}% < <%= coverageThreshold %>%)`);
      if (!graceActive) failed++;
    } else { console.log(`PASS (${pct.toFixed(1)}%)`); }
  }
  if (existsSync('coverage.out')) {
    mkdirSync('coverage', { recursive: true });
    process.stdout.write('[CHECK] coverage HTML report ... ');
    const htmlResult = spawnSync('go', ['tool', 'cover', '-html=coverage.out', '-o', 'coverage/coverage.html'], { encoding: 'utf-8', shell: false });
    if (htmlResult.status !== 0) {
      console.log('FAIL (go tool cover -html)');
      if (htmlResult.stderr) process.stderr.write(htmlResult.stderr);
      if (!graceActive) failed++;
    } else { console.log('PASS'); }
  }
<% } %>
  runCheck('complexity + dead code', 'golangci-lint', ['run', '--enable', 'gocyclo,gocognit,unused'], { soft: graceActive });
<% } %><% if (language === 'python') { %>
<% if (coverageEnabled) { %>
  runCheck('coverage threshold', 'pytest', ['--cov', '--cov-fail-under=<%= coverageThreshold %>', '--cov-report=html:coverage/html', '--cov-report=xml:coverage/coverage.xml'], { soft: graceActive });
<% } %>
  runCheck('complexity', 'ruff', ['check', '--select', 'C901,PLR0911,PLR0912,PLR0913,PLR0915', '.'], { soft: graceActive });
  runCheck('unused imports', 'ruff', ['check', '--select', 'F401,F811', '.'], { soft: graceActive });
<% } %>
  // ─── L2: STRIDE/RACI traceability ───────────────────────────────────────────
  runCheck('STRIDE/RACI traceability', 'node', ['scripts/check-stride-traceability.mjs'], { soft: graceActive });
<% if (contractType && contractType !== 'none') { %>
  // ─── L2: Contract testing gate (INV-35) ──────────────────────────────────────
<% if (language === 'typescript') { %>
<% if (contractType === 'rest-owned' || contractType === 'rest-public') { %>
  runCheck('contract tests (Pact)', 'npx', ['pact-broker', 'can-i-deploy', '--pacticipant', '<%= projectName %>', '--latest'], { soft: graceActive });
<% } else if (contractType === 'graphql') { %>
  runCheck('contract tests (GraphQL schema)', 'npx', ['graphql-inspector', 'diff', 'schema.graphql'], { soft: graceActive });
<% } else if (contractType === 'grpc') { %>
  runCheck('contract tests (gRPC)', 'npx', ['buf', 'breaking', '--against', '.git#branch=main'], { soft: graceActive });
<% } else if (contractType === 'message-queue') { %>
  runCheck('contract tests (Pact messaging)', 'npx', ['pact-broker', 'can-i-deploy', '--pacticipant', '<%= projectName %>', '--latest'], { soft: graceActive });
<% } %>
<% } else if (language === 'java') { %>
<% if (contractType === 'rest-owned' || contractType === 'rest-public') { %>
  runCheck('contract tests (Pact)', '<%= buildTool === "gradle" ? "./gradlew" : "mvn" %>', ['<%= buildTool === "gradle" ? "pactPublish pactVerify" : "pact:publish pact:verify" %>'], { soft: graceActive });
<% } else if (contractType === 'graphql') { %>
  runCheck('contract tests (GraphQL)', '<%= buildTool === "gradle" ? "./gradlew" : "mvn" %>', ['<%= buildTool === "gradle" ? "test --tests *.graphql.*" : "test -Dtest=*GraphQL*" %>'], { soft: graceActive });
<% } else if (contractType === 'grpc') { %>
  runCheck('contract tests (gRPC)', '<%= buildTool === "gradle" ? "./gradlew" : "mvn" %>', ['<%= buildTool === "gradle" ? "test --tests *.grpc.*" : "test -Dtest=*Grpc*" %>'], { soft: graceActive });
<% } else if (contractType === 'message-queue') { %>
  runCheck('contract tests (Pact messaging)', '<%= buildTool === "gradle" ? "./gradlew" : "mvn" %>', ['<%= buildTool === "gradle" ? "pactPublish pactVerify" : "pact:publish pact:verify" %>'], { soft: graceActive });
<% } %>
<% } else if (language === 'rust') { %>
  runCheck('contract tests', 'cargo', ['test', '--test', '*contract*'], { soft: graceActive });
<% } else if (language === 'go') { %>
  runCheck('contract tests', 'go', ['test', '-tags', 'contract', '-run', 'Contract', './...'], { soft: graceActive });
<% } else if (language === 'python') { %>
  runCheck('contract tests (Pact)', 'pytest', ['tests/contract/'], { soft: graceActive });
<% } %>
<% } %>
  // ─── L2: Debt Ratchet ────────────────────────────────────────────────────────
  // Compares against baseline if debt-baseline.json exists (skips gracefully if absent)
<% const ratchetFlag = governanceLevel === 'L3' ? '--require-improvement' : '--gate'; %>
  runCheck('debt ratchet', 'node', ['scripts/debt-report.mjs', '<%= ratchetFlag %>'], { soft: graceActive });
<% } %>
<% if (governanceLevel === 'L3') { %>
  // ─── L3: Evidence gate (INV-33) ─────────────────────────────────────────────
  // Validates nightly evidence produced by evidence-collect.mjs.
  // Warns when absent (first run); fails when present but obs_gate !== 'PASS'.
  process.stdout.write('[CHECK] evidence gate (INV-33) ... ');
  {
    const _summaryPath = join(process.cwd(), '.evidence', 'SUMMARY.json');
    if (!existsSync(_summaryPath)) {
      console.log('WARN — .evidence/SUMMARY.json absent (run nightly pipeline first)');
    } else {
      try {
        const _summary = JSON.parse(readFileSync(_summaryPath, 'utf-8'));
        if (_summary.obs_gate === 'PASS') {
          console.log('PASS');
        } else {
          console.log('FAIL (obs_gate=' + _summary.obs_gate + ')');
          failed++;
        }
      } catch {
        console.log('FAIL (could not parse .evidence/SUMMARY.json)');
        failed++;
      }
    }
  }
<% } %>
}

console.log('');
if (failed > 0) {
  console.error(`=== FAILED: ${failed} check(s) ===\n`);
  process.exit(1);
} else {
  console.log('=== ALL PASSED ===\n');
}
