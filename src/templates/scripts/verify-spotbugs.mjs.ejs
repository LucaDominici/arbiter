#!/usr/bin/env node
// <%= projectName %> — SpotBugs baseline manager
// Generated by arbiter. Re-generate: arbiter update
// Usage:
//   node scripts/verify-spotbugs.mjs               # check against baseline
//   node scripts/verify-spotbugs.mjs --update-baseline  # update baseline with non-security findings
//   node scripts/verify-spotbugs.mjs --report-only      # print findings without failing
//
// Security-category bugs are NEVER baselined (INV-44):
//   SQL_INJECTION, SQL_INJECTION_SPRING_JDBC, XSS_REQUEST_WRAPPER, XSS_SERVLET,
//   COMMAND_INJECTION, XXE_DOCUMENT, XXE_XMLREADER, LDAP_INJECTION, HARD_CODE_PASSWORD

import { readFileSync, writeFileSync, existsSync } from "node:fs";
import { join } from "node:path";
import { parseArgs } from "node:util";

const SECURITY_HARD_BLOCK = new Set([
  "SQL_INJECTION",
  "SQL_INJECTION_SPRING_JDBC",
  "XSS_REQUEST_WRAPPER",
  "XSS_SERVLET",
  "COMMAND_INJECTION",
  "XXE_DOCUMENT",
  "XXE_XMLREADER",
  "LDAP_INJECTION",
  "HARD_CODE_PASSWORD",
]);

const SPOTBUGS_XML = join("build", "reports", "spotbugs", "main.xml");
const BASELINE_JSON = join("spotbugs-baseline.json");

const { values: flags } = parseArgs({
  options: {
    "update-baseline": { type: "boolean", default: false },
    "report-only": { type: "boolean", default: false },
  },
});

const updateBaseline = flags["update-baseline"];
const reportOnly = flags["report-only"];

// ─── Parse SpotBugs XML ──────────────────────────────────────────────────────

if (!existsSync(SPOTBUGS_XML)) {
  console.error(`[spotbugs] XML report not found: ${SPOTBUGS_XML}`);
  console.error("[spotbugs] Run SpotBugs first: ./gradlew spotbugsMain");
  process.exit(1);
}

const xml = readFileSync(SPOTBUGS_XML, "utf-8");

// Extract BugType:ClassName pairs via matchAll (no shell — pure string parsing)
const bugInstancePattern =
  /<BugInstance[^>]+type="([^"]+)"[^>]*>[\s\S]*?<Class[^>]+classname="([^"]+)"/g;

/** @type {{ bugType: string; className: string }[]} */
const findings = [...xml.matchAll(bugInstancePattern)].map((m) => ({
  bugType: m[1],
  className: m[2],
}));

// ─── Load Baseline ───────────────────────────────────────────────────────────

/** @type {{ baselined: string[]; policy: string; maxSuppressions?: number }} */
let baseline = {
  baselined: [],
  policy: "security-category bugs are never baselined",
};
if (existsSync(BASELINE_JSON)) {
  try {
    baseline = JSON.parse(readFileSync(BASELINE_JSON, "utf-8"));
  } catch {
    console.error(
      "[spotbugs] Failed to parse spotbugs-baseline.json — using empty baseline",
    );
  }
}

const baselinedSet = new Set(baseline.baselined);

// ─── Suppression-growth ratchet (INV-44, #1510) ──────────────────────────────
// A suppressed finding never appears in the report, so the finding-baseline above
// cannot see it — quality can silently backslide by ADDING <Match> entries to the
// exclude filter. Ratchet the suppression COUNT: it may only grow with an explicit
// baseline bump (the justification lives in the reviewed commit), never silently.
const EXCLUDE_FILTER = join("config", "spotbugs-exclude.xml");

/** Pure: count <Match> suppression entries in a SpotBugs exclude-filter XML. */
export function countSuppressionMatches(xml) {
  if (typeof xml !== "string") return 0;
  return (xml.match(/<Match\b/g) || []).length;
}

const currentSuppressions = existsSync(EXCLUDE_FILTER)
  ? countSuppressionMatches(readFileSync(EXCLUDE_FILTER, "utf-8"))
  : 0;
const baselineMaxSuppressions =
  typeof baseline.maxSuppressions === "number" ? baseline.maxSuppressions : null;

// ─── Classify Findings ───────────────────────────────────────────────────────

/** @type {string[]} */
const securityFindings = [];
/** @type {string[]} */
const newNonSecurity = [];
/** @type {string[]} */
const baselinedFindings = [];
/** @type {string[]} */
const resolvedFindings = [];

const currentKeys = new Set();
for (const f of findings) {
  const key = `${f.bugType}:${f.className}`;
  currentKeys.add(key);
  if (SECURITY_HARD_BLOCK.has(f.bugType)) {
    securityFindings.push(key);
  } else if (baselinedSet.has(key)) {
    baselinedFindings.push(key);
  } else {
    newNonSecurity.push(key);
  }
}

for (const key of baselinedSet) {
  if (!currentKeys.has(key)) {
    resolvedFindings.push(key);
  }
}

// ─── Report ──────────────────────────────────────────────────────────────────

if (resolvedFindings.length > 0) {
  console.log("[spotbugs] Resolved findings (no longer present):");
  for (const k of resolvedFindings) console.log(`  ✓ ${k}`);
}

if (baselinedFindings.length > 0) {
  console.log("[spotbugs] Baselined findings (known, tracked):");
  for (const k of baselinedFindings) console.log(`  ~ ${k}`);
}

if (securityFindings.length > 0) {
  console.error("[spotbugs] SECURITY FINDINGS — never baselined (INV-44):");
  for (const k of securityFindings) console.error(`  ✗ ${k}`);
}

if (newNonSecurity.length > 0) {
  console.log("[spotbugs] New non-security findings:");
  for (const k of newNonSecurity) console.log(`  ! ${k}`);
}

// ─── Update Baseline ─────────────────────────────────────────────────────────

if (updateBaseline) {
  if (securityFindings.length > 0) {
    console.error(
      "[spotbugs] Cannot update baseline: security-category findings present. Fix them first.",
    );
    process.exit(1);
  }
  const newBaseline = {
    baselined: Array.from(new Set([...baselinedSet, ...newNonSecurity])).sort(),
    policy: baseline.policy,
    // #1510: record the accepted suppression count so future growth is gated.
    maxSuppressions: currentSuppressions,
  };
  writeFileSync(BASELINE_JSON, JSON.stringify(newBaseline, null, 2) + "\n");
  console.log(
    `[spotbugs] Baseline updated: ${newBaseline.baselined.length} entries, ${currentSuppressions} suppression(s)`,
  );
  process.exit(0);
}

// ─── Verdict ─────────────────────────────────────────────────────────────────

if (reportOnly) {
  console.log(
    `[spotbugs] Report-only mode. Total findings: ${findings.length}`,
  );
  process.exit(0);
}

if (securityFindings.length > 0) {
  console.error(
    `[spotbugs] Gate FAILED: ${securityFindings.length} security-category finding(s) — never baselineable.`,
  );
  process.exit(1);
}

if (newNonSecurity.length > 0) {
  console.error(
    `[spotbugs] Gate FAILED: ${newNonSecurity.length} new non-security finding(s). ` +
      "Run with --update-baseline to add to baseline after review.",
  );
  process.exit(1);
}

// #1510: suppression-growth ratchet. First run (no recorded max) seeds the count and
// passes; afterwards an unjustified new <Match> in config/spotbugs-exclude.xml is red.
if (baselineMaxSuppressions === null) {
  const seeded = { ...baseline, maxSuppressions: currentSuppressions };
  writeFileSync(BASELINE_JSON, JSON.stringify(seeded, null, 2) + "\n");
  console.log(
    `[spotbugs] Seeded suppression baseline: ${currentSuppressions} <Match> entry(ies).`,
  );
} else if (currentSuppressions > baselineMaxSuppressions) {
  console.error(
    `[spotbugs] Gate FAILED: suppression count grew ${baselineMaxSuppressions} → ${currentSuppressions} ` +
      "in config/spotbugs-exclude.xml. A new suppression hides a finding — fix the root cause, " +
      "or run --update-baseline to accept it (the justification lives in the reviewed commit).",
  );
  process.exit(1);
}

console.log("[spotbugs] Gate PASSED.");
process.exit(0);
