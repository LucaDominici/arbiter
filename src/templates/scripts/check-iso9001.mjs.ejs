#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
/**
 * check-iso9001.mjs — ISO 9001 quality-process overlay gate (#1253)
 *
 * Fail-closed validation of three controlled documents:
 *   1. docs/quality/REQUIREMENTS_TRACEABILITY.md — requirement→test RTM (status ladder)
 *   2. docs/quality/DOCUMENT_CONTROL.md           — controlled-document register (doc_version + existence)
 *   3. docs/quality/CAPA_LOG.md                   — corrective/preventive-action log (open→issue_ref)
 *
 * Reuses the FEATURE_MATRIX RTM machinery (sentinel-delimited table parse + ref
 * existence) so the requirement→test chain is enforceable, not just prose.
 *
 * Exit codes (INV-53):
 *   0 = PASS   1 = FAIL (drift / missing ref / broken ladder)   2 = ERROR (file/parse)
 *
 * Generated by arbiter — do not edit manually.
 */
import { existsSync, readFileSync } from 'node:fs'
import { resolve } from 'node:path'

const ROOT = process.cwd()
const RTM_PATH = resolve(ROOT, 'docs/quality/REQUIREMENTS_TRACEABILITY.md')
const DOC_CONTROL_PATH = resolve(ROOT, 'docs/quality/DOCUMENT_CONTROL.md')
const CAPA_PATH = resolve(ROOT, 'docs/quality/CAPA_LOG.md')

/** Parse the pipe-table rows between two sentinel markers. Returns null if absent. */
function parseSentinelRows(text, startMarker, endMarker) {
  const start = text.indexOf(startMarker)
  const end = text.indexOf(endMarker)
  if (start === -1 || end === -1 || end <= start) return null
  const block = text.slice(start + startMarker.length, end)
  const rows = []
  for (const line of block.split('\n')) {
    const trimmed = line.trim()
    if (!trimmed.startsWith('|')) continue
    const cells = trimmed
      .split('|')
      .slice(1, -1)
      .map((c) => c.trim())
    if (cells.length === 0) continue
    // skip header + separator rows
    if (/^-+$/.test(cells[0]) || cells[0].endsWith('_id')) continue
    rows.push(cells)
  }
  return rows
}

function readOrError(path, label, failures) {
  if (!existsSync(path)) {
    process.stdout.write(`  check-iso9001: ERROR — ${label} not found at ${path}\n`)
    process.exit(2)
  }
  try {
    return readFileSync(path, 'utf-8')
  } catch (err) {
    process.stdout.write(
      `  check-iso9001: ERROR — cannot read ${label}: ${err instanceof Error ? err.message : String(err)}\n`,
    )
    process.exit(2)
  }
}

const failures = []

// ─── 1. RTM: status ladder (fail-closed) ─────────────────────────────────────
const rtmText = readOrError(RTM_PATH, 'RTM', failures)
const rtmRows = parseSentinelRows(rtmText, '<!-- ISO9001_RTM_START -->', '<!-- ISO9001_RTM_END -->')
if (rtmRows === null) {
  process.stdout.write('  check-iso9001: ERROR — RTM sentinel markers not found\n')
  process.exit(2)
}
if (rtmRows.length === 0) {
  process.stdout.write('  check-iso9001: ERROR — RTM has no data rows\n')
  process.exit(2)
}
for (const r of rtmRows) {
  // requirement_id | requirement | code_ref | test_ref | status | issue_ref | note
  const [id, , codeRef = '', testRef = '', status = '', issueRef = ''] = r
  if (!['Missing', 'Partial', 'Done'].includes(status)) {
    failures.push(`RTM ${id}: unknown status "${status}"`)
    continue
  }
  if (status === 'Missing' && !/^#\d+$/.test(issueRef.trim())) {
    failures.push(`RTM ${id}: Missing status requires issue_ref matching #NNN`)
  }
  if (status === 'Partial' && !codeRef.trim()) {
    failures.push(`RTM ${id}: Partial status requires non-empty code_ref`)
  }
  if (status === 'Done') {
    if (!codeRef.trim()) failures.push(`RTM ${id}: Done requires code_ref`)
    if (!testRef.trim()) failures.push(`RTM ${id}: Done requires test_ref`)
    for (const ref of testRef.split(',').map((s) => s.trim()).filter(Boolean)) {
      if (!ref.includes('*') && !/^https?:/i.test(ref) && !existsSync(resolve(ROOT, ref))) {
        failures.push(`RTM ${id}: Done test_ref file not found: ${ref}`)
      }
    }
  }
}

// ─── 2. Document control: existence + doc_version ────────────────────────────
const docText = readOrError(DOC_CONTROL_PATH, 'document-control register', failures)
const docRows = parseSentinelRows(docText, '<!-- DOC_CONTROL_START -->', '<!-- DOC_CONTROL_END -->')
if (docRows === null) {
  process.stdout.write('  check-iso9001: ERROR — document-control sentinel markers not found\n')
  process.exit(2)
}
for (const r of docRows) {
  // doc_id | controlled_document | doc_version | owner | status | review_due
  const [id, doc = '', version = ''] = r
  if (doc.trim() && !existsSync(resolve(ROOT, doc.trim()))) {
    failures.push(`DOC ${id}: controlled_document not found on disk: ${doc.trim()}`)
  }
  if (!/^\d+\.\d+\.\d+$/.test(version.trim())) {
    failures.push(`DOC ${id}: doc_version must be semver (got "${version.trim()}")`)
  }
}

// ─── 3. CAPA log: open CAPAs require an issue_ref ────────────────────────────
const capaText = readOrError(CAPA_PATH, 'CAPA log', failures)
const capaRows = parseSentinelRows(capaText, '<!-- CAPA_START -->', '<!-- CAPA_END -->')
if (capaRows === null) {
  process.stdout.write('  check-iso9001: ERROR — CAPA sentinel markers not found\n')
  process.exit(2)
}
for (const r of capaRows) {
  // capa_id | nonconformity | corrective_action | preventive_action | status | issue_ref
  const [id, , , , status = '', issueRef = ''] = r
  if (!['open', 'in_progress', 'closed'].includes(status.trim())) {
    failures.push(`CAPA ${id}: unknown status "${status.trim()}"`)
    continue
  }
  if ((status.trim() === 'open' || status.trim() === 'in_progress') && !/^#\d+$/.test(issueRef.trim())) {
    failures.push(`CAPA ${id}: ${status.trim()} status requires a tracking issue_ref matching #NNN`)
  }
}

// ─── Report ──────────────────────────────────────────────────────────────────
if (failures.length === 0) {
  process.stdout.write(
    `  check-iso9001: OK — RTM (${rtmRows.length} rows), doc-control (${docRows.length}), CAPA (${capaRows.length}) all valid\n`,
  )
  process.exit(0)
}
for (const f of failures) process.stdout.write(`  check-iso9001: FAIL — ${f}\n`)
process.exit(1)
