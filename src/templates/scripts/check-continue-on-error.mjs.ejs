#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// scripts/check-continue-on-error.mjs — generated by arbiter (anti-fake-green A3, INV-89).
//
// Parser-backed swallowed-gate guard. A GATING job/step carrying a const-true `continue-on-error`
// swallows its own failure — a red gate goes green with the regression never surfaced. The truthy
// value is read through the YAML 1.1 boolean grammar, so the const-true forms a plain regex misses
// are caught:
//   continue-on-error: on        # YAML-1.1 `on`  → boolean true   (a regex for `true` MISSES this)
//   continue-on-error: yes       # YAML-1.1 `yes` → boolean true
//   continue-on-error: ${{ true }}   # const-true GitHub expression
// js-yaml confirms when installed; otherwise the YAML-1.1 truthy-token set is the tolerant fallback.
// A dynamic expression (`${{ <expr> }}`) is indeterminate ⇒ NOT flagged. The SOLE sanctioned step
// is an artifact up/download (its failure must not block CI); informational workflows
// (heartbeat/nightly/weekly/monthly/notify) and an audited `# arbiter-allow-continue-on-error`
// marker are also exempt. NO-DATA (no workflows) is a PASS.
//
// Usage: node scripts/check-continue-on-error.mjs [--dir <path>] [--help]
// Exit codes (INV-53): 0=PASS, 1=FAIL (swallowed gate), 2=ERROR (self).
import { existsSync, readFileSync, readdirSync } from 'node:fs'
import { join, resolve, basename } from 'node:path'
import { createRequire } from 'node:module'

const args = process.argv.slice(2)
if (args.includes('--help') || args.includes('-h')) {
  process.stdout.write(
    [
      'Usage: node scripts/check-continue-on-error.mjs [--dir <path>]',
      '',
      'Fails when a GATING job/step carries a const-true `continue-on-error` — catching the',
      'YAML-1.1 `on`/`yes` and `${{ true }}` forms a plain regex misses. The sole sanctioned step',
      'is an artifact up/download; informational workflows and an audited',
      '`# arbiter-allow-continue-on-error` marker are exempt. NO-DATA (no workflows) is a PASS.',
      '',
    ].join('\n') + '\n',
  )
  process.exit(0)
}

const dirArg = args.indexOf('--dir')
const ROOT = dirArg >= 0 && args[dirArg + 1] ? resolve(args[dirArg + 1]) : process.cwd()

// js-yaml is OPTIONAL — present in some toolchains, absent in a fresh project. Loaded lazily; the
// guard falls back to the YAML-1.1 token grammar so it never hard-depends on it.
let yamlLib = null
try {
  yamlLib = createRequire(import.meta.url)('js-yaml')
} catch {
  yamlLib = null
}

const INFORMATIONAL_PATTERNS = ['heartbeat', 'nightly', 'weekly', 'monthly', 'notify']
const STEP_SCOPED_ALLOWLIST = { 'drift-shadow.yml': new Set(['parity']) }
const TRUTHY_TOKENS = new Set(['true', 'on', 'yes', 'y'])
const GATE_COMMAND_RE =
  /\b(?:check-all(?:\.mjs)?|scripts\/check-[\w.-]+\.mjs|arbiter\s+(?:verify|gold-audit|anti-fake-green)|npm\s+(?:run\s+)?test|npm\s+run\s+(?:lint|gate|check[\w:-]*)|npx\s+(?:vitest|jest|eslint|tsc|playwright)\b|pnpm\s+(?:run\s+)?test|yarn\s+test|vitest\b|jest\b|pytest\b|cargo\s+(?:test|clippy)\b|go\s+test\b|(?:\.\/)?gradlew\b[^\n]*\b(?:test|check|verify)\b|mvn\b[^\n]*\b(?:test|verify)\b)/

function collectYamlFiles(dir) {
  if (!existsSync(dir)) return []
  const out = []
  let entries
  try {
    entries = readdirSync(dir, { withFileTypes: true })
  } catch {
    return out
  }
  for (const entry of entries) {
    if (entry.isSymbolicLink()) continue
    const full = join(dir, entry.name)
    if (entry.isDirectory()) out.push(...collectYamlFiles(full))
    else if (entry.isFile() && (entry.name.endsWith('.yml') || entry.name.endsWith('.yaml')))
      out.push(full)
  }
  return out
}

function isConstTrueValue(rawValue) {
  let v = String(rawValue)
    .replace(/\s+#.*$/, '')
    .trim()
  if (v === '') return false
  if (/^\$\{\{\s*true\s*\}\}$/i.test(v)) return true
  if (v.includes('${{')) return false // dynamic expression ⇒ indeterminate, not flagged
  v = v.replace(/^["']|["']$/g, '')
  if (TRUTHY_TOKENS.has(v.toLowerCase())) return true
  if (yamlLib && typeof yamlLib.load === 'function') {
    try {
      return yamlLib.load(`v: ${v}`)?.v === true
    } catch {
      return false
    }
  }
  return false
}

function enclosingBlock(lines, i, coeIndent) {
  const isKey = (ln) => /^\s*['"]?[\w.-]+['"]?\s*:/.test(ln)
  const isDash = (ln) => /^(\s*)-\s/.exec(ln)
  const skip = (ln) => ln.trim() === '' || /^\s*#/.test(ln)

  let dashIdx = -1
  let dashIndent = -1
  for (let j = i - 1; j >= 0; j--) {
    const ln = lines[j]
    if (skip(ln)) continue
    const dash = isDash(ln)
    const indent = ln.length - ln.trimStart().length
    if (dash && dash[1].length < coeIndent) {
      dashIdx = j
      dashIndent = dash[1].length
      break
    }
    if (!dash && indent < coeIndent && isKey(ln)) break
  }

  if (dashIdx >= 0) {
    const out = [lines[dashIdx]]
    for (let j = dashIdx + 1; j < lines.length; j++) {
      const ln = lines[j]
      if (ln.trim() === '') {
        out.push(ln)
        continue
      }
      const indent = ln.length - ln.trimStart().length
      const dash = isDash(ln)
      if (dash && dash[1].length === dashIndent) break
      if (!dash && indent <= dashIndent && isKey(ln)) break
      out.push(ln)
    }
    const text = out.join('\n')
    const idM = /^\s*id:\s*(\S+)/m.exec(text)
    const nameM = /^\s*-?\s*name:\s*(.+)$/m.exec(text)
    return {
      kind: 'step',
      text,
      stepId: idM ? idM[1].replace(/['"]/g, '') : null,
      label: nameM ? nameM[1].trim() : '(unnamed step)',
    }
  }

  let jobIdx = -1
  let jobIndent = -1
  for (let j = i - 1; j >= 0; j--) {
    const ln = lines[j]
    if (skip(ln)) continue
    const indent = ln.length - ln.trimStart().length
    if (indent < coeIndent && isKey(ln)) {
      jobIdx = j
      jobIndent = indent
      break
    }
  }
  if (jobIdx < 0)
    return { kind: 'job', text: lines.slice(i, i + 1).join('\n'), stepId: null, label: '(job)' }
  const km = /^(\s*)['"]?([\w.-]+)['"]?\s*:/.exec(lines[jobIdx])
  const out = [lines[jobIdx]]
  for (let j = jobIdx + 1; j < lines.length; j++) {
    const ln = lines[j]
    if (ln.trim() === '') {
      out.push(ln)
      continue
    }
    const indent = ln.length - ln.trimStart().length
    if (indent <= jobIndent && isKey(ln)) break
    out.push(ln)
  }
  return { kind: 'job', text: out.join('\n'), stepId: null, label: km ? km[2] : '(job)' }
}

function findViolations(filePath) {
  const name = basename(filePath)
  if (INFORMATIONAL_PATTERNS.some((p) => name.includes(p))) return []
  let text
  try {
    text = readFileSync(filePath, 'utf-8')
  } catch {
    return []
  }
  const allowedSteps = STEP_SCOPED_ALLOWLIST[name]
  const lines = text.split('\n')
  const findings = []
  for (let i = 0; i < lines.length; i++) {
    const m = /^(\s*)continue-on-error:\s*(.+?)\s*$/.exec(lines[i])
    if (!m) continue
    if (!isConstTrueValue(m[2])) continue
    const block = enclosingBlock(lines, i, m[1].length)
    if (/\b(?:upload|download)-artifact\b/.test(block.text)) continue
    if (/arbiter-allow-continue-on-error/.test(block.text)) continue
    if (allowedSteps && block.stepId && allowedSteps.has(block.stepId)) continue
    if (!GATE_COMMAND_RE.test(block.text)) continue
    findings.push(
      `${filePath}:${i + 1}: continue-on-error swallows a GATING ${block.kind} ("${block.label}") — a swallowed gate is a fake-green`,
    )
  }
  return findings
}

function main() {
  const findings = []
  for (const file of collectYamlFiles(join(ROOT, '.github', 'workflows'))) {
    for (const v of findViolations(file)) findings.push(v)
  }
  if (findings.length > 0) {
    process.stderr.write(
      'check-continue-on-error: FAIL — a GATING job/step swallows its failure via continue-on-error:\n',
    )
    for (const f of findings) process.stderr.write(`    ${f}\n`)
    process.stderr.write(
      '  Fix: let the gate fail the run. If the step is genuinely non-blocking, make it an\n' +
        '  artifact up/download, an informational workflow, or annotate it with an audited\n' +
        '  `# arbiter-allow-continue-on-error: <reason>` marker.\n',
    )
    return 1
  }
  process.stdout.write(
    'check-continue-on-error: no swallowed gates — PASS (NO-DATA when no workflows)\n',
  )
  return 0
}

try {
  process.exit(main())
} catch (e) {
  process.stderr.write(`check-continue-on-error: ERROR — ${e?.message ?? e}\n`)
  process.exit(2)
}
