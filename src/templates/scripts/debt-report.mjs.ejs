#!/usr/bin/env node
// debt-report.mjs — generated by arbiter
// Compares current debt metrics against debt-baseline.json.
// Run: node scripts/debt-report.mjs [--gate] [--require-improvement]
// --gate: exit non-zero if any metric regressed
// --require-improvement: exit non-zero if no metric improved (L3)
import { spawnSync } from 'node:child_process';
import { readFileSync, existsSync } from 'node:fs';

const gateMode = process.argv.includes('--gate');
const requireImprovement = process.argv.includes('--require-improvement');
const BASELINE_FILE = 'debt-baseline.json';

if (!existsSync(BASELINE_FILE)) {
  console.log('[arbiter] No debt-baseline.json found — skipping debt ratchet check.');
  console.log('  Run: node scripts/capture-debt-baseline.mjs');
  process.exit(0);
}

const baseline = JSON.parse(readFileSync(BASELINE_FILE, 'utf-8'));

function run(cmd, args) {
  return spawnSync(cmd, args, { encoding: 'utf-8', shell: false });
}

function countTodos() {
  const r = run('grep', ['-r', '--include=*.{js,ts,java,go,py,rs}', '-l', 'TODO', '.']);
  if (r.status !== 0) return 0;
  const files = r.stdout.trim().split('\n').filter(Boolean);
  let count = 0;
  for (const f of files) {
    try {
      const lines = readFileSync(f, 'utf-8').split('\n');
      count += lines.filter(l => /\bTODO\b/.test(l)).length;
    } catch { /* skip */ }
  }
  return count;
}

// ─── Current metrics collection ───────────────────────────────────────
const current = {};

<% if (language === 'typescript') { %>
// Coverage: vitest with json reporter
const vitestResult = run('npx', ['vitest', 'run', '--coverage', '--coverage.reporter=json', '--coverage.reportsDirectory=.coverage-tmp']);
try {
  const summary = JSON.parse(readFileSync('.coverage-tmp/coverage-summary.json', 'utf-8'));
  current.coverage = { value: summary.total.lines.pct, unit: 'percent', direction: 'higher-is-better' };
} catch { current.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity: eslint with json output
const eslintResult = run('npx', ['eslint', 'src', '--format', 'json', '--rule', '{"complexity": ["warn", 10]}']);
try {
  const report = JSON.parse(eslintResult.stdout || '[]');
  const violations = report.flatMap(f => f.messages).filter(m => m.ruleId === 'complexity').length;
  current.complexityViolations = { value: violations, unit: 'count', direction: 'lower-is-better' };
} catch { current.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }

// Dead code: knip with json reporter
const knipResult = run('npx', ['knip', '--reporter', 'json']);
try {
  const report = JSON.parse(knipResult.stdout || '{}');
  const count = (report.files ?? []).length + (report.exports ?? []).length;
  current.deadCode = { value: count, unit: 'count', direction: 'lower-is-better' };
} catch { current.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
<% } %><% if (language === 'rust') { %>
// Coverage: cargo tarpaulin
const tarpaulinResult = run('cargo', ['tarpaulin', '--out', 'Json', '--output-dir', '.coverage-tmp']);
try {
  const data = JSON.parse(readFileSync('.coverage-tmp/tarpaulin-report.json', 'utf-8'));
  current.coverage = { value: data.coverage, unit: 'percent', direction: 'higher-is-better' };
} catch { current.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity + dead code: cargo clippy
const clippyResult = run('cargo', ['clippy', '--message-format=json', '--', '-W', 'clippy::cognitive_complexity', '-W', 'dead_code']);
try {
  const lines = (clippyResult.stdout ?? '').split('\n').filter(Boolean);
  const msgs = lines.map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
  current.complexityViolations = { value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code?.includes('cognitive_complexity')).length, unit: 'count', direction: 'lower-is-better' };
  current.deadCode = { value: msgs.filter(m => m.reason === 'compiler-message' && m.message?.code?.code === 'dead_code').length, unit: 'count', direction: 'lower-is-better' };
} catch {
  current.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' };
  current.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
}
<% } %><% if (language === 'java') { %>
// Coverage: JaCoCo (read existing report if present)
try {
  const report = readFileSync('build/reports/jacoco/test/jacocoTestReport.xml', 'utf-8');
  const match = report.match(/type="LINE"[^/]*missed="(\d+)"[^/]*covered="(\d+)"/);
  if (match) {
    const missed = parseInt(match[1]), covered = parseInt(match[2]);
    const pct = covered + missed > 0 ? (covered / (covered + missed)) * 100 : 0;
    current.coverage = { value: Math.round(pct * 10) / 10, unit: 'percent', direction: 'higher-is-better' };
  } else { current.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }
} catch { current.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity: PMD
const pmdResult = run('<%= buildTool === "gradle" ? "./gradlew" : "mvn" %>', ['<%= buildTool === "gradle" ? "pmdMain" : "pmd:pmd" %>', '-q']);
current.complexityViolations = { value: pmdResult.status !== 0 ? 1 : 0, unit: 'count', direction: 'lower-is-better' };
current.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
<% } %><% if (language === 'go') { %>
// Coverage: go test -cover
const goTestResult = run('go', ['test', '-coverprofile=.coverage-tmp.out', './...']);
const goCoverResult = run('go', ['tool', 'cover', '-func=.coverage-tmp.out']);
try {
  const match = goCoverResult.stdout.match(/total:\s+\(statements\)\s+([\d.]+)%/);
  current.coverage = { value: match ? parseFloat(match[1]) : 0, unit: 'percent', direction: 'higher-is-better' };
} catch { current.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity + dead code: golangci-lint
const golintResult = run('golangci-lint', ['run', '--out-format=json', '--enable', 'gocyclo,deadcode']);
try {
  const report = JSON.parse(golintResult.stdout || '{"Issues":[]}');
  const issues = report.Issues ?? [];
  current.complexityViolations = { value: issues.filter(i => i.FromLinter === 'gocyclo').length, unit: 'count', direction: 'lower-is-better' };
  current.deadCode = { value: issues.filter(i => i.FromLinter === 'deadcode').length, unit: 'count', direction: 'lower-is-better' };
} catch {
  current.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' };
  current.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' };
}
<% } %><% if (language === 'python') { %>
// Coverage: pytest --cov
const pytestResult = run('pytest', ['--cov', '--cov-report=json', '--cov-report=term']);
try {
  const data = JSON.parse(readFileSync('coverage.json', 'utf-8'));
  current.coverage = { value: data.totals?.percent_covered ?? 0, unit: 'percent', direction: 'higher-is-better' };
} catch { current.coverage = { value: 0, unit: 'percent', direction: 'higher-is-better' }; }

// Complexity: ruff C901
const ruffResult = run('ruff', ['check', '--select', 'C901', '--output-format', 'json', '.']);
try {
  const violations = JSON.parse(ruffResult.stdout || '[]');
  current.complexityViolations = { value: violations.length, unit: 'count', direction: 'lower-is-better' };
} catch { current.complexityViolations = { value: 0, unit: 'count', direction: 'lower-is-better' }; }

// Dead code: ruff F401
const ruffF401Result = run('ruff', ['check', '--select', 'F401,F811', '--output-format', 'json', '.']);
try {
  const violations = JSON.parse(ruffF401Result.stdout || '[]');
  current.deadCode = { value: violations.length, unit: 'count', direction: 'lower-is-better' };
} catch { current.deadCode = { value: 0, unit: 'count', direction: 'lower-is-better' }; }
<% } %>

// TODOs: stack-agnostic
current.todoCount = { value: countTodos(), unit: 'count', direction: 'lower-is-better' };

// ─── Compare and report ────────────────────────────────────────────────
const rows = [];
let regressions = 0;
let improvements = 0;

for (const [key, base] of Object.entries(baseline.metrics)) {
  const curr = current[key];
  if (!curr) { rows.push({ key, base: base.value, curr: 'N/A', delta: '?', status: '⚠️', unit: base.unit }); continue; }
  const delta = curr.value - base.value;
  let status;
  if (base.direction === 'higher-is-better') {
    if (curr.value > base.value) { status = '✅ improved'; improvements++; }
    else if (curr.value < base.value) { status = '❌ regressed'; regressions++; }
    else { status = '➡️ unchanged'; }
  } else {
    if (curr.value < base.value) { status = '✅ improved'; improvements++; }
    else if (curr.value > base.value) { status = '❌ regressed'; regressions++; }
    else { status = '➡️ unchanged'; }
  }
  rows.push({ key, base: base.value, curr: curr.value, delta: delta > 0 ? `+${delta.toFixed(1)}` : delta.toFixed(1), status, unit: base.unit });
}

console.log('\n## Debt Ratchet Report\n');
console.log('| Metric | Baseline | Current | Delta | Status |');
console.log('|--------|----------|---------|-------|--------|');
for (const r of rows) {
  console.log(`| ${r.key} | ${r.base}${r.unit === 'percent' ? '%' : ''} | ${r.curr}${r.unit === 'percent' ? '%' : ''} | ${r.delta} | ${r.status} |`);
}
console.log(`\nBaseline captured: ${baseline.capturedAt} @ ${baseline.commit}\n`);

if (gateMode && regressions > 0) {
  console.error(`[arbiter] GATE FAIL: ${regressions} metric(s) regressed vs baseline.`);
  process.exit(1);
}
if (requireImprovement && improvements === 0) {
  console.error('[arbiter] GATE FAIL: No metrics improved (--require-improvement mode).');
  process.exit(1);
}
if (!gateMode && !requireImprovement) {
  process.exit(regressions > 0 ? 1 : 0);
}
