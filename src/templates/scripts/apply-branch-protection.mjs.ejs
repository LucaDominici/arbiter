#!/usr/bin/env node
// apply-branch-protection.mjs — idempotent GitHub branch protection apply
// Generated by arbiter — run once after repo creation: node scripts/apply-branch-protection.mjs
// Requires: gh CLI authenticated with admin access to the repository
<%
const _requireCodeOwners = isL3Plus;
%>
import { spawnSync } from 'node:child_process'

function gh(...args) {
  const result = spawnSync('gh', args, { encoding: 'utf8' })
  if (result.status !== 0) {
    console.error(`ERROR: gh ${args[0]} failed — ${result.stderr.trim()}`)
    process.exit(1)
  }
  return result.stdout.trim()
}

function ghApi(endpoint, method, body) {
  const input = JSON.stringify(body)
  const result = spawnSync('gh', ['api', '--method', method, endpoint, '--input', '-'], {
    input,
    encoding: 'utf8',
  })
  if (result.status !== 0) {
    console.error(`ERROR: gh api ${method} ${endpoint} failed — ${result.stderr?.trim() ?? ''}`)
    process.exit(1)
  }
}

const repo = gh('repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner')

console.log(`Applying branch protection to ${repo} main branch...`)

const payload = JSON.stringify({
  required_status_checks: {
    strict: true,
    contexts: ['ci-required', 'human-approval-required'],
  },
  enforce_admins: false,
  required_pull_request_reviews: {
    required_approving_review_count: 1,
    dismiss_stale_reviews: true,
    require_code_owner_reviews: <%= _requireCodeOwners %>,
  },
  restrictions: null,
  allow_force_pushes: false,
  allow_deletions: false,
  required_linear_history: true,
})

ghApi(`repos/${repo}/branches/main/protection`, 'PUT', JSON.parse(payload))

// INV-101: disable squash-merge and rebase-merge to preserve cosign SHA attestations.
// allow_merge_commit:true is required — GitHub 422s if all three methods are disabled.
// These settings live on PATCH /repos/{owner}/{repo}, not on the branch protection endpoint.
const repoSettings = JSON.stringify({
  allow_merge_commit: true,
  allow_squash_merge: false,
  allow_rebase_merge: false,
})

ghApi(`repos/${repo}`, 'PATCH', JSON.parse(repoSettings))

console.log('Branch protection and merge settings applied.')
console.log('  Merge method: ff-only (squash-merge=false, rebase-merge=false)')
