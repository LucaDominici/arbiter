#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// CATALOG: INV-106 enforcement — i18n raw-literal scanner (#1127).
// Scans UI source files for hardcoded text strings that should use the
// i18n translation function (t('key')). Framework-aware: uses different
// scanning strategies for Vue SFC templates, React JSX, and Svelte.
// Exit 1 if new violations found not in baseline (.i18n-baseline.json).

import { existsSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs'
import { extname, join, relative } from 'node:path'
<%
const _fw = (typeof frontend !== 'undefined' && frontend && frontend.framework)
  ? frontend.framework : 'react'
const _exts = _fw === 'vue'
  ? ['.ts', '.vue']
  : _fw === 'svelte'
  ? ['.ts', '.svelte']
  : ['.ts', '.tsx', '.jsx']
const _extList = JSON.stringify(_exts)
%>
const ROOT = process.cwd()
const SRC = join(ROOT, 'src')
const BASELINE_FILE = join(ROOT, '.i18n-baseline.json')
const SOURCE_EXTS = new Set(<%- _extList %>)

// Patterns for text that looks like UI prose (not code identifiers or data)
const PROSE_PATTERN = /(?:^|>)\s*([A-Z][a-z]{2,}\s+[a-z]{2,}[^<{]*?)(?:\s*<|\s*$)/gm
const MINIMUM_LENGTH = 5 // minimum string length to flag
const UPDATE_BASELINE = process.argv.includes('--update-baseline')

// Patterns that are always safe (not raw literals)
const ALLOWED_PATTERNS = [
  /^[0-9., %-]+$/, // numbers, percentages
  /^[A-Z]{2,}$/, // acronyms
  /^\s*$/, // whitespace only
  /^https?:\/\//, // URLs
  /^\d{4}-\d{2}-\d{2}/, // dates
  /^v\d+\.\d+/, // version strings
  /^[A-Z0-9_-]+$/, // constants / env var names
]

function isAllowed(text) {
  const trimmed = text.trim()
  if (trimmed.length < MINIMUM_LENGTH) return true
  return ALLOWED_PATTERNS.some((p) => p.test(trimmed))
}

function extractVueTextNodes(content, filePath) {
  const violations = []
  // Find template block
  const templateMatch = content.match(/<template[^>]*>([\s\S]*?)<\/template>/)
  if (!templateMatch) return violations
  const template = templateMatch[1]
  // Scan text content between tags (not in bindings or expressions)
  const lines = template.split('\n')
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i]
    // Skip lines with v-bind, bindings, or i18n calls
    if (line.includes('{{') || line.includes('$t(') || line.includes('t(') || line.includes('v-') || line.includes(':')) continue
    // Match text between tags
    const textMatch = line.match(/>([^<>{}\n]+)</g)
    if (!textMatch) continue
    for (const match of textMatch) {
      const text = match.replace(/^>/, '').replace(/<$/, '').trim()
      if (!isAllowed(text) && /[a-z]{2,}/.test(text)) {
        violations.push({ file: filePath, line: i + 1, text })
      }
    }
  }
  return violations
}

function extractJsxTextNodes(content, filePath) {
  const violations = []
  const lines = content.split('\n')
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i]
    // Skip lines with t() calls or JSX expressions
    if (line.includes('t(') || line.includes('{') || line.includes('//')) continue
    // Match text between JSX tags
    const textMatch = line.match(/>([^<>{}]+)</g)
    if (!textMatch) continue
    for (const match of textMatch) {
      const text = match.replace(/^>/, '').replace(/<$/, '').trim()
      if (!isAllowed(text) && /[a-z]{2,} [a-z]/.test(text)) {
        violations.push({ file: filePath, line: i + 1, text })
      }
    }
  }
  return violations
}

function scanFile(absPath) {
  const rel = relative(ROOT, absPath)
  let content
  try {
    content = readFileSync(absPath, 'utf-8')
  } catch {
    return []
  }
  // Skip test files
  if (rel.includes('__tests__') || rel.includes('.test.') || rel.includes('.spec.')) return []

  const ext = extname(absPath)
  if (ext === '.vue') return extractVueTextNodes(content, rel)
  if (ext === '.tsx' || ext === '.jsx') return extractJsxTextNodes(content, rel)
  return []
}

function walkSrc(dir, violations) {
  if (!existsSync(dir)) return
  let entries
  try {
    entries = readdirSync(dir)
  } catch {
    return
  }
  for (const entry of entries) {
    const full = join(dir, entry)
    let st
    try {
      st = statSync(full)
    } catch {
      continue
    }
    if (st.isDirectory()) {
      if (entry === 'node_modules' || entry === '.git') continue
      walkSrc(full, violations)
    } else if (st.isFile() && SOURCE_EXTS.has(extname(entry))) {
      violations.push(...scanFile(full))
    }
  }
}

const allViolations = []
walkSrc(SRC, allViolations)

// Load or initialize baseline
let baseline = {}
if (existsSync(BASELINE_FILE)) {
  try {
    baseline = JSON.parse(readFileSync(BASELINE_FILE, 'utf-8'))
  } catch {
    baseline = {}
  }
}

const baselineKey = (v) => `${v.file}:${v.line}`
const baselineSet = new Set(Object.keys(baseline))

const newViolations = allViolations.filter((v) => !baselineSet.has(baselineKey(v)))

if (UPDATE_BASELINE) {
  const updated = { ...baseline }
  for (const v of allViolations) {
    updated[baselineKey(v)] = { text: v.text, justification: 'baselined' }
  }
  writeFileSync(BASELINE_FILE, JSON.stringify(updated, null, 2) + '\n')
  process.stdout.write(`[i18n-literal-scanner] baseline updated (${allViolations.length} entries)\n`)
  process.exit(0)
}

if (newViolations.length > 0) {
  for (const v of newViolations) {
    process.stderr.write(`[INV-106] ${v.file}:${v.line}: raw UI text — use t('key'): "${v.text}"\n`)
  }
  process.stderr.write(
    `\n[i18n-literal-scanner] ${newViolations.length} new violation(s) found.\n` +
      `  INV-106: All user-facing strings must use t('key').\n` +
      `  To baseline known violations: node scripts/i18n-literal-scanner.mjs --update-baseline\n`,
  )
  process.exit(1)
}

process.stdout.write('[i18n-literal-scanner] i18n literal scan OK (INV-106)\n')
