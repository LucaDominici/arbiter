#!/usr/bin/env node
// <%= projectName %> — SSOT harness
// Runs the four SSOT gates: ssot-core, doc-links, knowledge-map, canonical-paths.
// Usage: node scripts/harness.mjs [--fast]
// --fast: stop at first gate failure (default: run all and report)
import { spawnSync } from 'node:child_process';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { existsSync } from 'node:fs';

const __dirname = dirname(fileURLToPath(import.meta.url));
const PROJECT_ROOT = join(__dirname, '..');
const fast = process.argv.includes('--fast');

const GATES = [
  'check-ssot-core',
  'check-doc-links',
  'check-knowledge-map',
  'check-canonical-paths',
];

let failed = 0;

for (const gate of GATES) {
  const scriptPath = join(__dirname, `${gate}.mjs`);
  if (!existsSync(scriptPath)) {
    process.stdout.write(`  harness: ${gate} — skip (script not found)\n`);
    continue;
  }
  process.stdout.write(`  harness: ${gate} ... `);
  const r = spawnSync('node', [scriptPath], {
    encoding: 'utf-8',
    cwd: PROJECT_ROOT,
    shell: false,
  });
  if (r.stdout) process.stdout.write(r.stdout);
  if (r.stderr) process.stderr.write(r.stderr);
  if (r.status === 0) {
    process.stdout.write('pass\n');
  } else {
    process.stdout.write(`FAIL (exit ${r.status})\n`);
    failed++;
    if (fast) break;
  }
}

process.exit(failed > 0 ? 1 : 0);
