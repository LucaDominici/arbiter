#!/usr/bin/env node
// <%= projectName %> — CI change classifier
// Reads changed files since origin/main and writes flags to $GITHUB_OUTPUT.
// Advisory only — flag values inform job conditions, never block merge.
// Flags: docs_only, backend_changed, frontend_changed, infra_changed, high_risk, e2e_specs, ssot
// Usage:
//   node scripts/ci-classify-changes.mjs            # diff BASE_SHA..HEAD_SHA
//   node scripts/ci-classify-changes.mjs --stdin    # read paths from stdin
//
// Fail-closed semantics: if resolving the changed set fails for any reason
// (shallow clone, missing refs, git not on PATH), every category flag is
// emitted as `true` so downstream jobs run defensively. "Fail-closed" here
// means "run everything", never skip work because classification broke.
import { spawnSync } from 'node:child_process';
import { appendFileSync, existsSync, readFileSync } from 'node:fs';

const CATEGORY_KEYS = [
  'docs_only',
  'backend_changed',
  'frontend_changed',
  'infra_changed',
  'high_risk',
  'e2e_specs',
  'ssot',
];

const base = process.env.BASE_SHA ?? 'origin/main';
const head = process.env.HEAD_SHA ?? 'HEAD';
const useStdin = process.argv.includes('--stdin');

// A path counts as "docs" ONLY if it lives in a dedicated documentation tree
// (docs/, website/, wiki/) or is a root-level *.md other than AGENTS.md.
// Governance files (AGENTS.md, .claude/rules/*.md, src/templates/**/*.md) are
// markdown but drive enforcement behavior: since docs-only PRs are mergeable
// on green (#1296), classifying them as docs would skip the very tests that
// validate them — so they are explicitly NOT docs (#1299).
function isDocsPath(f) {
  if (f.startsWith('docs/') || f.startsWith('website/') || f.startsWith('wiki/')) return true;
  return !f.includes('/') && f.endsWith('.md') && f !== 'AGENTS.md';
}

const FRONTEND_PATTERNS = [/^src\/(?:ui|frontend|components|pages|views)\//, /\.(tsx?|css|scss|html)$/];
const INFRA_PATTERNS = [/^\.github\//, /^(Dockerfile|docker-compose|terraform|\.tf$)/i, /^k8s\//, /^helm\//];
const HIGH_RISK_PATTERNS = [
  /^src\/(?:auth|security|payment|billing)\//,
  /migrations?\//,
  /schema\.(sql|graphql|proto)$/i,
];
const E2E_PATTERNS = [/^__tests__\/e2e\//, /^tests\/e2e\//];
const SSOT_PATTERNS = [/^docs\/SYSTEM\//, /^docs\/METHOD\/SSOT_CORE_SET\.md$/, /^arbiter\.json$/];
<% if (language === 'typescript') { %>
const BACKEND_PATTERNS = [/^src\//, /\.(ts|js)$/];
<% } %><% if (language === 'java') { %>
const BACKEND_PATTERNS = [/^src\/main\/java\//, /\.(java|kt)$/];
<% } %><% if (language === 'rust') { %>
const BACKEND_PATTERNS = [/^src\//, /\.rs$/];
<% } %><% if (language === 'python') { %>
const BACKEND_PATTERNS = [/^src\//, /\.py$/];
<% } %><% if (language === 'go') { %>
const BACKEND_PATTERNS = [/^(?!.*_test\.go).*\.go$/, /^cmd\//, /^internal\//];
<% } %>

function readStdinPaths() {
  return readFileSync(0, 'utf-8').split('\n').filter(Boolean);
}

function resolveChangedPaths() {
  if (useStdin) return readStdinPaths();
  // No silent fallback: any git failure must propagate so the outer guard
  // can fail-closed (emit true for every category).
  const r = spawnSync('git', ['diff', '--name-only', `${base}...${head}`], {
    encoding: 'utf-8',
    shell: false,
  });
  if (r.error) throw r.error;
  if (typeof r.status === 'number' && r.status !== 0) {
    throw new Error(`git diff exited ${r.status}: ${r.stderr || '(no stderr)'}`);
  }
  return (r.stdout || '').split('\n').filter(Boolean);
}

function emitFlag(key, value) {
  process.stdout.write(`[ci-classify] ${key}=${value}\n`);
  if (process.env.GITHUB_OUTPUT && existsSync(process.env.GITHUB_OUTPUT)) {
    appendFileSync(process.env.GITHUB_OUTPUT, `${key}=${value}\n`);
  }
}

function emitAllTrue() {
  // Run-everything semantics per flag: docs_only=true would SKIP the code jobs,
  // so on an error it must be FALSE — every other category=true runs everything.
  for (const key of CATEGORY_KEYS) emitFlag(key, key !== 'docs_only');
}

let succeeded = false;
try {
  const changed = resolveChangedPaths();
  const match = (patterns) => changed.some((f) => patterns.some((p) => p.test(f)));

  const docs_only = changed.length > 0 && changed.every(isDocsPath);
  const backend_changed = match(BACKEND_PATTERNS);
  const frontend_changed = match(FRONTEND_PATTERNS);
  const infra_changed = match(INFRA_PATTERNS);
  const high_risk = match(HIGH_RISK_PATTERNS);
  const e2e_specs = match(E2E_PATTERNS);
  const ssot = match(SSOT_PATTERNS);

  const flags = { docs_only, backend_changed, frontend_changed, infra_changed, high_risk, e2e_specs, ssot };

  process.stdout.write('[ci-classify] changed files: ' + changed.length + '\n');
  for (const [k, v] of Object.entries(flags)) emitFlag(k, v);
  succeeded = true;
} finally {
  if (!succeeded) {
    process.stderr.write('[ci-classify] ERROR resolving changed set — fail-closed, running everything (docs_only=false)\n');
    emitAllTrue();
  }
  process.exit(0);
}
