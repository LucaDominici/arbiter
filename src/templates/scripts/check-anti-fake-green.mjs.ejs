#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// scripts/check-anti-fake-green.mjs — generated by arbiter (#1428).
// Anti-fake-green guard aggregate runner for this project.
// Delegates to `arbiter anti-fake-green` via npx (no local install required —
// the guard scripts run inside arbiter's own environment).
//
// Usage: node scripts/check-anti-fake-green.mjs [--enforce] [--help]
//
// Exit codes (INV-53): 0=PASS, 1=FAIL (broken/hard guard, or advisory under --enforce), 2=ERROR.
// When invoked by check-all.mjs (advisory, L2) the exit code is informational; the gate never
// hard-fails on the result alone. The gh-audit guards fail OPEN (advisory) when `gh` is absent,
// so a fresh consumer has no day-1 redness; --enforce promotes advisory findings to hard fails.
import { spawnSync } from 'node:child_process'

const args = process.argv.slice(2)

const result = spawnSync('npx', ['--no-install', 'arbiter', 'anti-fake-green', ...args], {
  stdio: 'inherit',
  encoding: 'utf-8',
})

if (result.error) {
  process.stderr.write(
    `[anti-fake-green] spawn error: ${result.error.message}\n`,
  )
  process.exit(2)
}

process.exit(result.status ?? 1)
