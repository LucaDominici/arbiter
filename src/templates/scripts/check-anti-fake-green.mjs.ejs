#!/usr/bin/env node
// SPDX-License-Identifier: Apache-2.0
// scripts/check-anti-fake-green.mjs — generated by arbiter (anti-fake-green aggregate, #1497).
//
// Self-contained anti-fake-green guard aggregate for THIS project. Runs the deterministic
// file-scan guards that arbiter ships into the generated tree against this project's OWN files
// (no `npx`, no arbiter install, no network) and computes one disarm-proof verdict:
//   - a child guard's exit 2 (broken/errored guard) FAILS the aggregate unconditionally — you
//     cannot disarm a guard by breaking it;
//   - a child guard's exit 1 (a real fake-green found) is a hard FAIL;
//   - a guard script that is not present in this project is simply skipped (it was not emitted at
//     this governance level), never a manufactured pass or fail.
// Each guard is independently HARD-wired in check-all.mjs too; this aggregate is the single command
// a developer can run to see the whole anti-fake-green set at once.
//
// Usage: node scripts/check-anti-fake-green.mjs [--enforce] [--help]
// Exit codes (INV-53): 0=PASS, 1=FAIL (a guard found a fake-green, or a guard is broken), 2=ERROR.
import { spawnSync } from 'node:child_process'
import { existsSync } from 'node:fs'

const args = process.argv.slice(2)
if (args.includes('--help') || args.includes('-h')) {
  process.stdout.write(
    'Usage: node scripts/check-anti-fake-green.mjs [--enforce]\n' +
      '  Runs this project\'s anti-fake-green file-scan guards and computes one disarm-proof\n' +
      '  verdict. A broken guard (exit 2) always fails the aggregate. NO-DATA guards pass.\n',
  )
  process.exit(0)
}

// The roster of deterministic file-scan guards shipped into generated projects (#1497). Each is
// NO-DATA-safe (PASS when there is nothing to scan), so a fresh consumer has no day-1 redness.
const GUARDS = [
  { name: 'muted-test', script: 'scripts/check-muted-test.mjs' },
  { name: 'skip-critical-e2e', script: 'scripts/check-skip-critical-e2e.mjs' },
  { name: 'no-stub-redirects', script: 'scripts/check-no-stub-redirects.mjs' },
  { name: 'grace-window', script: 'scripts/check-grace-window.mjs' },
  { name: 'secret-presence', script: 'scripts/check-secret-presence.mjs' },
  { name: 'continue-on-error', script: 'scripts/check-continue-on-error.mjs' },
  // #2160: conditional on an E2E (Playwright) harness — absent for library/cli targets, so the
  // `absent` bucket below reports it rather than fabricating a pass (AC-4).
  { name: 'oracle-discrimination', script: 'scripts/check-oracle-discrimination.mjs' },
]

function main() {
  const broken = [],
    hardFail = [],
    pass = [],
    absent = []
  for (const g of GUARDS) {
    if (!existsSync(g.script)) {
      absent.push(g.name)
      continue
    }
    const r = spawnSync('node', [g.script], { encoding: 'utf-8' })
    if (r.stdout) process.stdout.write(r.stdout)
    if (r.stderr) process.stderr.write(r.stderr)
    const status = r.status
    if (status === 2 || status === null) broken.push(g.name)
    else if (status === 1) hardFail.push(g.name)
    else pass.push(g.name)
  }
  process.stdout.write(
    `check-anti-fake-green: pass=${pass.length} hardFail=${hardFail.length} broken=${broken.length} absent=${absent.length}\n`,
  )
  for (const b of broken)
    process.stderr.write(`    BROKEN (exit 2): ${b} — a broken guard fails the aggregate\n`)
  for (const h of hardFail) process.stderr.write(`    FAIL: ${h} — a fake-green was found\n`)
  if (broken.length > 0 || hardFail.length > 0) return 1
  return 0
}

try {
  process.exit(main())
} catch (e) {
  process.stderr.write(`check-anti-fake-green: ERROR — ${e?.message ?? e}\n`)
  process.exit(2)
}
