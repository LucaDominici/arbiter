## Authentik — Self-hosted SSO + Flows

Python-based identity provider with a rich UI for defining auth flows. Lighter than Keycloak, heavier than Authelia.

### docker-compose.authentik.yml

```yaml
version: '3.8'
services:
  postgresql:
    image: postgres:16
    environment:
      POSTGRES_DB: authentik
      POSTGRES_USER: authentik
      POSTGRES_PASSWORD: ${PG_PASS}
    volumes:
      - authentik-db:/var/lib/postgresql/data
    restart: unless-stopped

  redis:
    image: redis:alpine
    restart: unless-stopped

  authentik-server:
    image: ghcr.io/goauthentik/server:latest
    command: server
    ports:
      - '9000:9000'   # HTTP
      - '9443:9443'   # HTTPS
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_SECRET_KEY: ${AUTHENTIK_SECRET_KEY}
    depends_on: [postgresql, redis]
    restart: unless-stopped

  authentik-worker:
    image: ghcr.io/goauthentik/server:latest
    command: worker
    environment:
      AUTHENTIK_REDIS__HOST: redis
      AUTHENTIK_POSTGRESQL__HOST: postgresql
      AUTHENTIK_POSTGRESQL__USER: authentik
      AUTHENTIK_POSTGRESQL__PASSWORD: ${PG_PASS}
      AUTHENTIK_POSTGRESQL__NAME: authentik
      AUTHENTIK_SECRET_KEY: ${AUTHENTIK_SECRET_KEY}
    depends_on: [postgresql, redis]
    restart: unless-stopped

volumes:
  authentik-db:
```

### OIDC integration

```typescript
import { Issuer } from 'openid-client'

const issuer = await Issuer.discover('http://localhost:9000/application/o/<%= projectName %>/')
const client = new issuer.Client({
  client_id: process.env.AUTHENTIK_CLIENT_ID!,
  client_secret: process.env.AUTHENTIK_CLIENT_SECRET!,
  redirect_uris: [`${process.env.APP_URL}/auth/callback`],
})
```

### Environment variables

```env
PG_PASS=<random-db-password>
AUTHENTIK_SECRET_KEY=<random-50-char-secret>
AUTHENTIK_CLIENT_ID=<client-id-from-authentik-ui>
AUTHENTIK_CLIENT_SECRET=<client-secret-from-authentik-ui>
```
