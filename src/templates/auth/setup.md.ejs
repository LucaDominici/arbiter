## Amazon Cognito — SaaS (AWS-native)

Best for AWS-native stacks. Integrates with API Gateway, Lambda authorizers, IAM.

### Install

```bash
npm install @aws-sdk/client-cognito-identity-provider amazon-cognito-identity-js
```

### Server-side token validation

```typescript
import { CognitoJwtVerifier } from 'aws-jwt-verify'

const verifier = CognitoJwtVerifier.create({
  userPoolId: process.env.COGNITO_USER_POOL_ID!,
  tokenUse: 'access',
  clientId: process.env.COGNITO_CLIENT_ID!,
})

async function verifyToken(token: string) {
  const payload = await verifier.verify(token)
  return payload
}
```

### Middleware

```typescript
import { Request, Response, NextFunction } from 'express'

export async function cognitoAuth(req: Request, res: Response, next: NextFunction) {
  const token = req.headers.authorization?.replace('Bearer ', '')
  if (!token) return res.status(401).json({ error: 'Unauthorized' })
  try {
    const payload = await verifyToken(token)
    req.user = { id: payload.sub, username: payload.username as string }
    next()
  } catch {
    res.status(401).json({ error: 'Invalid token' })
  }
}
```

### Environment variables

```env
COGNITO_USER_POOL_ID=<region>_<pool-id>
COGNITO_CLIENT_ID=<your-app-client-id>
AWS_REGION=<your-region>
```
