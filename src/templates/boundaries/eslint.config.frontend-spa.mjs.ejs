<%
// #1127: framework-aware FSD boundary config — flat-config counterpart of
// .eslintrc-frontend-spa.cjs. ESLint v9 removed --no-eslintrc/-c (the legacy
// eslintrc loader), which broke the `fsd boundaries` gate on every fresh
// frontend-spa init (#1491-class fix, mirrors eslint.config.static.mjs).
// Source of truth: config.frontend.framework ('react'|'vue'|'svelte'|undefined).
const _fw = (typeof frontend !== 'undefined' && frontend && frontend.framework)
  ? frontend.framework
  : 'react'

const _globs = _fw === 'vue'
  ? ['src/**/*.ts', 'src/**/*.vue']
  : _fw === 'svelte'
  ? ['src/**/*.ts', 'src/**/*.svelte']
  : ['src/**/*.ts', 'src/**/*.tsx', 'src/**/*.jsx']
%>
// eslint.config.frontend-spa.mjs — generated by arbiter (#1127, ESLint v9 flat-config).
// Framework: <%- _fw %>
// Run in isolation by check-all.mjs via
// `eslint --config eslint.config.frontend-spa.mjs --no-config-lookup <glob>` so it
// enforces ONLY the FSD boundary rules, independent of your main eslint.config.mjs.
// The legacy .eslintrc-frontend-spa.cjs is retained for tooling that still reads
// eslintrc-format config but is NOT used by the gate.
// Peer dep: npm i -D eslint-plugin-boundaries (auto-injected into devDependencies)
// Re-generate: arbiter update
import tseslint from 'typescript-eslint'
import boundaries from 'eslint-plugin-boundaries'

export default [
  {
    files: <%- JSON.stringify(_globs) %>,
    languageOptions: {
      parser: tseslint.parser,
      ecmaVersion: 2022,
      sourceType: 'module',
    },
    plugins: { boundaries },
    settings: {
      'boundaries/elements': [
        { type: 'app', pattern: 'src/app/**' },
        { type: 'pages', pattern: 'src/pages/**' },
        { type: 'widgets', pattern: 'src/widgets/**' },
        { type: 'features', pattern: 'src/features/**' },
        { type: 'entities', pattern: 'src/entities/**' },
        { type: 'shared', pattern: 'src/shared/**' },
      ],
      'boundaries/include': <%- JSON.stringify(_globs) %>,
    },
    rules: {
      // FSD layer isolation — higher layers may only import from lower layers
      'boundaries/element-types': [
        'error',
        {
          default: 'disallow',
          rules: [
            { from: 'app', allow: ['pages', 'widgets', 'features', 'entities', 'shared'] },
            { from: 'pages', allow: ['widgets', 'features', 'entities', 'shared'] },
            { from: 'widgets', allow: ['features', 'entities', 'shared'] },
            { from: 'features', allow: ['entities', 'shared'] },
            { from: 'entities', allow: ['shared'] },
            { from: 'shared', allow: [] },
          ],
        },
      ],
      'boundaries/no-unknown': 'error',
      'boundaries/no-unknown-files': 'warn',
    },
  },
]
