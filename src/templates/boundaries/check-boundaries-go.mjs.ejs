import { spawnSync } from 'node:child_process';
import { readdirSync, readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

let failed = 0;

// ─── Layer 1: Domain purity scan (pure Node — no external deps) ──────────────
// Scans internal/domain/**/*.go for forbidden framework import paths.
// Runs first so this gate works without golangci-lint installed (e.g. in CI
// matrix tests). Mirrors eslint-plugin-boundaries' role in M22a and the
// domain-purity grep in M22b.
const BANNED_MODULES = [
  'gorm.io/',               // gorm.io/gorm, gorm.io/driver/...
  'github.com/gin-gonic/',  // github.com/gin-gonic/gin
  'github.com/labstack/echo', // echo and echo/v4 (no trailing / catches both)
  'github.com/gofiber/fiber/', // fiber/v2, fiber/v3
  'go.uber.org/fx',
  'go.uber.org/zap',
  'github.com/go-sql-driver/', // go-sql-driver/mysql
  'github.com/lib/pq',
  'github.com/jackc/pgx/',  // pgx/v4, pgx/v5
];
const bannedRe = new RegExp(
  `"(${BANNED_MODULES.map(m => m.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`,
);
const violations = [];

function scanDomain(dir) {
  if (!existsSync(dir)) {
    process.stdout.write(`check-boundaries: internal/domain/ not found — skipping domain purity scan\n`);
    return;
  }
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    const full = join(dir, entry.name);
    if (entry.isDirectory()) {
      scanDomain(full);
    } else if (entry.name.endsWith('.go')) {
      const src = readFileSync(full, 'utf-8');
      for (const line of src.split('\n')) {
        if (bannedRe.test(line)) violations.push(`${full}: ${line.trim()}`);
      }
