  'golangci-lint',
  ['run', '--config', '.golangci-boundaries.yml', './...'],
  { encoding: 'utf-8', shell: false },
);
if (lint.error) {
  process.stderr.write(`check-boundaries: failed to spawn 'golangci-lint': ${lint.error.message}\n`);
  failed++;
} else if (lint.signal !== null) {
  process.stderr.write(`check-boundaries: 'golangci-lint' killed by signal ${lint.signal}\n`);
  if (lint.stdout) process.stdout.write(lint.stdout);
  if (lint.stderr) process.stderr.write(lint.stderr);
  failed++;
} else if (lint.status !== 0) {
  if (lint.stdout) process.stdout.write(lint.stdout);
  if (lint.stderr) process.stderr.write(lint.stderr);
  failed++;
}

