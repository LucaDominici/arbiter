<%
// #1127: framework-aware FSD boundary config.
// Source of truth: config.frontend.framework ('react'|'vue'|'svelte'|undefined).
// Default (undefined): react-like glob set — safe for undetected/unknown frameworks.
const _fw = (typeof frontend !== 'undefined' && frontend && frontend.framework)
  ? frontend.framework
  : 'react'

const _globs = _fw === 'vue'
  ? ['src/**/*.ts', 'src/**/*.vue']
  : _fw === 'svelte'
  ? ['src/**/*.ts', 'src/**/*.svelte']
  : ['src/**/*.ts', 'src/**/*.tsx', 'src/**/*.jsx']

const _a11yPlugin = _fw === 'vue'
  ? 'vuejs-accessibility'
  : _fw === 'svelte'
  ? 'svelte'
  : 'jsx-a11y'
%>
// .eslintrc-frontend-spa.cjs — generated by arbiter (#1127)
// Framework: <%- _fw %>
// Wire in your root ESLint config: extends: ['./.eslintrc-frontend-spa.cjs']
// Re-generate: arbiter update
// Peer deps (react):   npm i -D eslint@^9 eslint-plugin-boundaries eslint-plugin-jsx-a11y @typescript-eslint/parser
// Peer deps (vue):     npm i -D eslint@^9 eslint-plugin-boundaries eslint-plugin-vuejs-accessibility @typescript-eslint/parser
// Peer deps (svelte):  npm i -D eslint@^9 eslint-plugin-boundaries eslint-plugin-svelte @typescript-eslint/parser

/** @type {import('eslint').Linter.Config} */
module.exports = {
  parser: '@typescript-eslint/parser',
  plugins: ['boundaries', '<%- _a11yPlugin %>'],
  settings: {
    'boundaries/elements': [
      { type: 'app',      pattern: 'src/app/**' },
      { type: 'pages',    pattern: 'src/pages/**' },
      { type: 'widgets',  pattern: 'src/widgets/**' },
      { type: 'features', pattern: 'src/features/**' },
      { type: 'entities', pattern: 'src/entities/**' },
      { type: 'shared',   pattern: 'src/shared/**' },
    ],
    'boundaries/include': <%- JSON.stringify(_globs) %>,
  },
  rules: {
    // FSD layer isolation — higher layers may only import from lower layers
    'boundaries/element-types': ['error', {
      default: 'disallow',
      rules: [
        { from: 'app',      allow: ['pages', 'widgets', 'features', 'entities', 'shared'] },
        { from: 'pages',    allow: ['widgets', 'features', 'entities', 'shared'] },
        { from: 'widgets',  allow: ['features', 'entities', 'shared'] },
        { from: 'features', allow: ['entities', 'shared'] },
        { from: 'entities', allow: ['shared'] },
        { from: 'shared',   allow: [] },
      ],
    }],
    'boundaries/no-unknown': 'error',
    'boundaries/no-unknown-files': 'warn',
  },
};
