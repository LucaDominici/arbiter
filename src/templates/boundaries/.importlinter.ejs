# .importlinter — generated by arbiter (M22d)
# Enforces hexagonal layer dependency direction using import-linter.
# Docs: https://import-linter.readthedocs.io/
#
# TODO: replace `yourpkg` below with your actual top-level package name.
# arbiter cannot auto-detect this reliably across src-layout, flat-layout,
# and namespace-package projects. Edit once, commit, forget.
#
# Run: pip install import-linter && lint-imports

[importlinter]
root_packages =
    yourpkg

[importlinter:contract:layers]
name = Hexagonal layer dependency direction
type = layers
layers =
    yourpkg.infrastructure
    yourpkg.adapters
    yourpkg.application
    yourpkg.domain
# Layers are listed high to low. Each layer may import only from layers below it.
# domain imports nothing; application imports only domain; adapters import
# application + domain; infrastructure may import anything.

[importlinter:contract:domain-purity]
name = Domain must not import frameworks
type = forbidden
source_modules =
    yourpkg.domain
forbidden_modules =
    django
    flask
    fastapi
    starlette
    sqlalchemy
    tortoise
    peewee
    pymongo
    redis
    requests
    httpx
    aiohttp
    celery
    boto3
    psycopg
    asyncpg
