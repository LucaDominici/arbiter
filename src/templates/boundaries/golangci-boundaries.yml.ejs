# Generated by arbiter (M22c) — hexagonal architecture boundary enforcement for Go
# Peer dep: golangci-lint >= 1.54  (depguard v2 rules format)
# Run via: golangci-lint run --config .golangci-boundaries.yml ./...
run:
  timeout: 5m

linters:
  disable-all: true
  enable:
    - depguard

linters-settings:
  depguard:
    rules:
      # ── Non-adapter layers: ban framework imports from domain and application ──────
      main:
        files:
          - "!**/internal/adapter/**"
          - "!**/internal/infrastructure/**"
          - "!**/cmd/**"
          - "!**/*_test.go"
        deny:
          - pkg: "gorm.io/gorm"
            desc: "Use repository interfaces (ports); ORM belongs in infrastructure adapters"
          - pkg: "gorm.io/driver"
            desc: "Database drivers belong in infrastructure adapters"
          - pkg: "github.com/gin-gonic/gin"
            desc: "HTTP framework belongs in adapter/in/web; not in domain or application"
          - pkg: "github.com/labstack/echo/v4"
            desc: "HTTP framework belongs in adapter/in/web"
          - pkg: "github.com/labstack/echo"
            desc: "HTTP framework belongs in adapter/in/web"
          - pkg: "github.com/gofiber/fiber"
            desc: "HTTP framework belongs in adapter/in/web"
          - pkg: "go.uber.org/fx"
            desc: "DI framework must not appear in domain or application layers"
          - pkg: "github.com/go-sql-driver/mysql"
            desc: "Database drivers belong in infrastructure adapters"
          - pkg: "github.com/lib/pq"
            desc: "Database drivers belong in infrastructure adapters"
          - pkg: "github.com/jackc/pgx"
            desc: "Database drivers belong in infrastructure adapters"

      # ── Domain layer: stdlib and own domain only ─────────────────────────────────
      domain-purity:
        files:
          - "**/internal/domain/**"
        deny:
          - pkg: "gorm.io/gorm"
            desc: "Domain must not depend on ORM"
          - pkg: "gorm.io/driver"
            desc: "Domain must not depend on database drivers"
          - pkg: "github.com/gin-gonic/gin"
            desc: "Domain must not depend on HTTP frameworks"
          - pkg: "github.com/labstack/echo/v4"
            desc: "Domain must not depend on HTTP frameworks"
          - pkg: "github.com/labstack/echo"
            desc: "Domain must not depend on HTTP frameworks"
          - pkg: "github.com/gofiber/fiber"
            desc: "Domain must not depend on HTTP frameworks"
          - pkg: "go.uber.org/zap"
            desc: "Domain must not depend on logging frameworks"
          - pkg: "go.uber.org/fx"
            desc: "Domain must not depend on DI frameworks"
          - pkg: "github.com/go-sql-driver/mysql"
            desc: "Domain must not depend on database drivers"
          - pkg: "github.com/lib/pq"
            desc: "Domain must not depend on database drivers"
          - pkg: "github.com/jackc/pgx"
            desc: "Domain must not depend on database drivers"
