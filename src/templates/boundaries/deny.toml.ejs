# deny.toml — generated by arbiter (M22b)
# cargo-deny: CVE hygiene + license policy + framework dep bans
# Docs: https://embarkstudios.github.io/cargo-deny/

[advisories]
# Deny known vulnerabilities; update db via `cargo deny fetch`
version = 2
yanked = "deny"

[licenses]
version = 2
allow = [
  "MIT",
  "Apache-2.0",
  "Apache-2.0 WITH LLVM-exception",
  "BSD-2-Clause",
  "BSD-3-Clause",
  "ISC",
  "Unicode-DFS-2016",
  "Zlib",
]
# Uncomment to allow copyleft licenses for internal-only crates
# allow = ["GPL-3.0"]

[bans]
version = 2
# Deny duplicate versions of the same crate (warn by default)
multiple-versions = "warn"

# Framework crates are banned as *direct* dependencies in domain code.
# The grep-scan in scripts/check-boundaries.mjs enforces the module-level rule.
# Add per-crate exceptions below with `[bans.skip]` if needed.
deny = [
  # Relational DB / query builders
  { name = "sqlx" },
  { name = "diesel" },
  { name = "sea-orm" },
  # Web frameworks
  { name = "axum" },
  { name = "actix-web" },
  { name = "rocket" },
  { name = "warp" },
  # HTTP client
  { name = "reqwest" },
  # gRPC
  { name = "tonic" },
  # hyper intentionally excluded: it is a transitive dep of reqwest/axum/tonic,
  # so banning it directly would break any hexagonal project using those frameworks
  # in adapters. The grep-scan and disallowed_types enforce domain isolation instead.
]

[sources]
version = 2
unknown-registry = "warn"
unknown-git = "warn"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
