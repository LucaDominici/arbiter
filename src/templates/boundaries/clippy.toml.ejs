# clippy.toml — generated by arbiter (M22b + M29)
# Hexagonal boundary enforcement + pedantic static analysis rules.
# Run via: cargo clippy -- -D warnings
# Pedantic: cargo clippy -- -W clippy::pedantic -D warnings

# ── Boundary Enforcement (M22b) ────────────────────────────────────────────
# Disallow framework types from leaking into any layer.
# Add suppressions with #[allow(clippy::disallowed_types)] + expiry comment.
disallowed_types = [
  # SQLx
  { path = "sqlx::Pool", reason = "framework type: not allowed in hexagonal domain" },
  { path = "sqlx::PgPool", reason = "framework type: not allowed in hexagonal domain" },
  { path = "sqlx::SqlitePool", reason = "framework type: not allowed in hexagonal domain" },
  # Diesel
  { path = "diesel::PgConnection", reason = "framework type: not allowed in hexagonal domain" },
  { path = "diesel::SqliteConnection", reason = "framework type: not allowed in hexagonal domain" },
  # Axum
  { path = "axum::Router", reason = "framework type: not allowed in hexagonal domain" },
  { path = "axum::Extension", reason = "framework type: not allowed in hexagonal domain" },
  # Actix-web
  { path = "actix_web::App", reason = "framework type: not allowed in hexagonal domain" },
  { path = "actix_web::web::Data", reason = "framework type: not allowed in hexagonal domain" },
  # Reqwest
  { path = "reqwest::Client", reason = "framework type: not allowed in hexagonal domain" },
  # Tonic
  { path = "tonic::transport::Channel", reason = "framework type: not allowed in hexagonal domain" },
]

disallowed_methods = []

disallowed_macros = [
  # Actix-web route macros
  { path = "actix_web::get", reason = "framework macro: not allowed in hexagonal domain" },
  { path = "actix_web::post", reason = "framework macro: not allowed in hexagonal domain" },
  # Axum route macros (if used)
]

# ── Pedantic Static Analysis (M29) ────────────────────────────────────────
# These lints fire when running: cargo clippy -- -W clippy::pedantic -D warnings
# Configured here so they can be suppressed per-item with #[allow(...)] + reason.
[lints.clippy]
# Correctness & panic safety
unwrap_used = "warn"
expect_used = "warn"
panic = "warn"
indexing_slicing = "warn"

# Code quality
pedantic = "warn"
nursery = "warn"
