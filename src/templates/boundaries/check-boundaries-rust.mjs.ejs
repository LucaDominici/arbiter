#!/usr/bin/env node
// check-boundaries.mjs — generated by arbiter (M22b)
// Peer deps: cargo install cargo-deny
import { spawnSync } from 'node:child_process';
import { readdirSync, readFileSync, existsSync, statSync } from 'node:fs';
import { join } from 'node:path';

let failed = 0;

// ─── Layer 1: Domain purity scan (pure Node — no external deps) ──────────────
// Run first so this gate can be verified without cargo installed (e.g. in CI
// matrix tests). Mirrors eslint-plugin-boundaries' role in M22a: scans
// src/domain/**/*.rs for forbidden framework `use` statements. Application
// layer not scanned — async ports legitimately reference tokio:: in trait signatures.
const BANNED_PREFIXES = [
  'sqlx', 'diesel', 'sea_orm', 'axum', 'actix_web',
  'reqwest', 'tonic', 'rocket', 'warp', 'hyper',
];
// Matches bare `use crate::` and re-exports `pub use crate::` / `pub(crate) use crate::`.
const bannedRe = new RegExp(
  `^\\s*(?:pub(?:\\([^)]*\\))?\\s+)?use\\s+(${BANNED_PREFIXES.join('|')})[;:]`,
);
const violations = [];

// Cycle guard (#1555): track visited real directories by device:inode so a
// hardlink / bind-mount cycle under the domain tree terminates instead of
// recursing forever and OOM-ing the consumer's CI/hook. Symlinked entries are
// never descended (and symlinked source files never read), mirroring the
// dependency-free policy #1521 standardized for arbiter's own walkers.
const visitedDomainDirs = new Set();

function scanDomain(dir) {
  if (!existsSync(dir)) {
    process.stdout.write(`check-boundaries: src/domain/ not found — skipping domain purity scan\n`);
    return;
  }
  let dirStat;
  try {
    dirStat = statSync(dir);
  } catch {
    return;
  }
  const key = `${dirStat.dev}:${dirStat.ino}`;
  if (visitedDomainDirs.has(key)) return;
  visitedDomainDirs.add(key);
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (entry.isSymbolicLink()) continue;
    const full = join(dir, entry.name);
    if (entry.isDirectory()) {
      scanDomain(full);
    } else if (entry.name.endsWith('.rs')) {
      const src = readFileSync(full, 'utf-8');
      for (const line of src.split('\n')) {
        if (bannedRe.test(line)) violations.push(`${full}: ${line.trim()}`);
      }
    }
  }
}

scanDomain('src/domain');

if (violations.length > 0) {
  process.stderr.write('check-boundaries: domain purity violations found:\n');
  for (const v of violations) process.stderr.write(`  ${v}\n`);
  failed++;
}

// ─── Layer 2: cargo-deny (CVE + license + dep bans) ──────────────────────────
const deny = spawnSync(
  'cargo',
  ['deny', 'check', 'bans', 'advisories', 'licenses'],
  { encoding: 'utf-8', shell: false },
);
if (deny.error) {
  process.stderr.write(`check-boundaries: failed to spawn 'cargo deny': ${deny.error.message}\n`);
  failed++;
} else if (deny.signal !== null) {
  process.stderr.write(`check-boundaries: 'cargo deny' killed by signal ${deny.signal}\n`);
  if (deny.stdout) process.stdout.write(deny.stdout);
  if (deny.stderr) process.stderr.write(deny.stderr);
  failed++;
} else if (deny.status !== 0) {
  if (deny.stdout) process.stdout.write(deny.stdout);
  if (deny.stderr) process.stderr.write(deny.stderr);
  failed++;
}

// ─── Layer 3: clippy disallowed types/methods (enforces clippy.toml) ─────────
// Runs only the disallowed_* lints from clippy.toml — distinct from the broad
// L1 `cargo clippy -- -D warnings` which does not apply disallowed_types rules
// in non-hexagonal projects. Here we target those rules explicitly.
const clippy = spawnSync(
  'cargo',
  ['clippy', '--', '-D', 'clippy::disallowed_types', '-D', 'clippy::disallowed_methods', '-D', 'clippy::disallowed_macros'],
  { encoding: 'utf-8', shell: false },
);
if (clippy.error) {
  process.stderr.write(`check-boundaries: failed to spawn 'cargo clippy': ${clippy.error.message}\n`);
  failed++;
} else if (clippy.signal !== null) {
  process.stderr.write(`check-boundaries: 'cargo clippy' killed by signal ${clippy.signal}\n`);
  if (clippy.stdout) process.stdout.write(clippy.stdout);
  if (clippy.stderr) process.stderr.write(clippy.stderr);
  failed++;
} else if (clippy.status !== 0) {
  if (clippy.stdout) process.stdout.write(clippy.stdout);
  if (clippy.stderr) process.stderr.write(clippy.stderr);
  failed++;
}

process.exit(failed > 0 ? 1 : 0);
