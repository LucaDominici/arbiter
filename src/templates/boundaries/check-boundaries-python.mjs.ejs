#!/usr/bin/env node
// check-boundaries.mjs — generated by arbiter (M22d)
// Peer deps: pip install import-linter
import { spawnSync } from 'node:child_process';
import { readdirSync, readFileSync, existsSync, statSync } from 'node:fs';
import { join } from 'node:path';

let failed = 0;

// ─── Layer 1: Domain purity scan (pure Node — no external deps) ──────────────
// Runs first so this gate is verifiable without Python tooling installed
// (matrix tests, bootstrap CI). Mirrors M22a/M22b L1 grep approach. Scans
// src/domain/**/*.py for framework imports. Application layer not scanned —
// async ports may legitimately reference httpx/asyncio in Protocol/ABC signatures.
const BANNED_PREFIXES = [
  'django', 'flask', 'fastapi', 'starlette',
  'sqlalchemy', 'tortoise', 'peewee',
  'pymongo', 'redis',
  'requests', 'httpx', 'aiohttp',
  'celery', 'boto3', 'psycopg', 'asyncpg',
];
// Python import forms:
//   import X
//   import X.Y
//   import X as y
//   from X import ...
//   from X.Y import ...
// The banned prefix always follows `from ` or `import ` at line start.
// Terminator (?:\.|[\s(]|$) ensures `sqlalchemy_utils` does not match `sqlalchemy`.
const bannedRe = new RegExp(
  `^\\s*(?:from|import)\\s+(${BANNED_PREFIXES.join('|')})(?:\\.|[\\s(]|$)`,
);
const violations = [];

// Cycle guard (#1555): track visited real directories by device:inode so a
// hardlink / bind-mount cycle under the domain tree terminates instead of
// recursing forever and OOM-ing the consumer's CI/hook. Symlinked entries are
// never descended (and symlinked source files never read), mirroring the
// dependency-free policy #1521 standardized for arbiter's own walkers.
const visitedDomainDirs = new Set();

function scanDomain(dir) {
  if (!existsSync(dir)) {
    process.stdout.write(`check-boundaries: src/domain/ not found — skipping domain purity scan\n`);
    return;
  }
  let dirStat;
  try {
    dirStat = statSync(dir);
  } catch {
    return;
  }
  const key = `${dirStat.dev}:${dirStat.ino}`;
  if (visitedDomainDirs.has(key)) return;
  visitedDomainDirs.add(key);
  for (const entry of readdirSync(dir, { withFileTypes: true })) {
    if (entry.isSymbolicLink()) continue;
    const full = join(dir, entry.name);
    if (entry.isDirectory()) {
      scanDomain(full);
    } else if (entry.name.endsWith('.py')) {
      const src = readFileSync(full, 'utf-8');
      for (const line of src.split('\n')) {
        if (bannedRe.test(line)) violations.push(`${full}: ${line.trim()}`);
      }
    }
  }
}

scanDomain('src/domain');

if (violations.length > 0) {
  process.stderr.write('check-boundaries: domain purity violations found:\n');
  for (const v of violations) process.stderr.write(`  ${v}\n`);
  failed++;
}

// ─── Layer 2: import-linter (dotted-module layer contracts) ──────────────────
const lintImports = spawnSync(
  'lint-imports',
  ['--config', '.importlinter'],
  { encoding: 'utf-8', shell: false },
);
if (lintImports.error) {
  process.stderr.write(`check-boundaries: failed to spawn 'lint-imports': ${lintImports.error.message}\n`);
  failed++;
} else if (lintImports.signal !== null) {
  process.stderr.write(`check-boundaries: 'lint-imports' killed by signal ${lintImports.signal}\n`);
  if (lintImports.stdout) process.stdout.write(lintImports.stdout);
  if (lintImports.stderr) process.stderr.write(lintImports.stderr);
  failed++;
} else if (lintImports.status !== 0) {
  if (lintImports.stdout) process.stdout.write(lintImports.stdout);
  if (lintImports.stderr) process.stderr.write(lintImports.stderr);
  failed++;
}

// ─── Layer 3: ruff banned-api scoped to src/domain/ ──────────────────────────
const ruff = spawnSync(
  'ruff',
  ['check', '--config', 'ruff-boundaries.toml', 'src/domain/'],
  { encoding: 'utf-8', shell: false },
);
if (ruff.error) {
  process.stderr.write(`check-boundaries: failed to spawn 'ruff': ${ruff.error.message}\n`);
  failed++;
} else if (ruff.signal !== null) {
  process.stderr.write(`check-boundaries: 'ruff' killed by signal ${ruff.signal}\n`);
  if (ruff.stdout) process.stdout.write(ruff.stdout);
  if (ruff.stderr) process.stderr.write(ruff.stderr);
  failed++;
} else if (ruff.status !== 0) {
  if (ruff.stdout) process.stdout.write(ruff.stdout);
  if (ruff.stderr) process.stderr.write(ruff.stderr);
  failed++;
}

process.exit(failed > 0 ? 1 : 0);
