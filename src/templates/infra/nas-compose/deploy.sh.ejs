#!/usr/bin/env bash
# deploy.sh — generated by arbiter — pull-by-digest NAS deploy via docker-compose
# (deployTarget: nas-compose). Ported from a proven fleet reference deploy script,
# adapted for a NAS that already holds registry credentials (`docker login` persisted
# in /root/.docker/config.json) — the NAS pulls the signed image itself; no more
# `docker save | ssh | docker load`.
#
# Called by .github/workflows/_deploy/nas-compose.ejs:
#   infra/nas-compose/deploy.sh <IMAGE_REF>   # e.g. ghcr.io/org/<%= projectName %>@sha256:...
#
# Required env (exported by .github/actions/nas-ssh + the calling workflow step):
#   NAS_SSH          full ssh command prefix
#   NAS_SUDO_PASS    NAS sudo password — consumed by `sudo -S` on stdin only, never a
#                     command-line argument
#
# Config (repo/org vars — see _deploy/nas-compose.ejs):
#   NAS_ROOT          compose project root on the NAS (default /volume1/docker/app)
#   SERVICES          space-separated ordered service list for staged
#                      `docker-compose up -d --no-deps <svc>` (first entry is the
#                      "primary" service that gates health); empty = plain `up -d`
#                      bringing every service up together
#   HEALTH_TIMEOUT_S  seconds to wait for the primary service to report healthy
#   BACKUP_CMD        optional shell command run on the NAS before recreating the
#                      stack (app-specific — sqlite `.backup`, pg_dump, etc.);
#                      empty = no-op (ponytail: eval'd as-is, no sandboxing — this is
#                      an admin-configured repo var, not user input)
#
# This file is a SCAFFOLD (skipIfExists): customize it for your app, arbiter will
# not overwrite your edits on re-init.
set -euo pipefail

IMAGE_REF="${1:?usage: deploy.sh <IMAGE_REF>}"
NAS_ROOT="${NAS_ROOT:-/volume1/docker/app}"
SERVICES="${SERVICES:-}"
HEALTH_TIMEOUT_S="${HEALTH_TIMEOUT_S:-90}"
BACKUP_CMD="${BACKUP_CMD:-}"

fail() { printf 'nas-compose deploy: FAIL — %s\n' "$1" >&2; exit 1; }

[[ -n "${NAS_SSH:-}" ]] || fail 'NAS_SSH is not set (expected from .github/actions/nas-ssh)'
[[ -n "${NAS_SUDO_PASS:-}" ]] || fail 'NAS_SUDO_PASS is not set'

# The password is the first line of stdin, consumed by `sudo -S`; bash -s reads the
# rest as the script. Nothing secret ever appears in a command line or in the log.
remote_script=$(cat <<'REMOTE'
set -euo pipefail
IMAGE_REF="$1"
ROOT="$2"
SERVICES="$3"
HEALTH_TIMEOUT_S="$4"
BACKUP_CMD="$5"
DOCKER=/usr/local/bin/docker
COMPOSE=/usr/local/bin/docker-compose

step() { printf '  [nas] %s\n' "$1"; }
die()  { printf '  [nas] FAIL — %s\n' "$1" >&2; exit 1; }

step "pulling ${IMAGE_REF}"
"$DOCKER" pull "$IMAGE_REF" || die "docker pull failed for ${IMAGE_REF}"

# Fail-closed: verification at the destination, on the exact bytes about to run —
# stronger than only verifying in CI (the image already left CI's custody).
command -v cosign >/dev/null 2>&1 || die 'cosign is not installed on the NAS — required for destination admission'
step 'verifying signature on the NAS (destination admission gate)'
cosign verify "$IMAGE_REF" >/dev/null || die "cosign verify failed for ${IMAGE_REF}"

if [[ -n "$BACKUP_CMD" ]]; then
  step 'running pre-deploy backup hook'
  eval "$BACKUP_CMD" || die 'BACKUP_CMD failed'
fi

cd "$ROOT"
[[ -f docker-compose.yml ]] || die "no docker-compose.yml in ${ROOT} — refusing to deploy by hand"
export IMAGE_REF
"$COMPOSE" config >/dev/null || die 'docker-compose config rejected the stack'
"$COMPOSE" pull || die 'docker-compose pull failed'

if [[ -n "$SERVICES" ]]; then
  for svc in $SERVICES; do
    step "recreating service: ${svc}"
    "$COMPOSE" up -d --no-deps "$svc" || die "up -d --no-deps ${svc} failed"
  done
  primary="$(awk '{print $1}' <<< "$SERVICES")"
else
  "$COMPOSE" up -d || die 'docker-compose up -d failed'
  primary=""
fi

if [[ -n "$primary" ]]; then
  step "waiting up to ${HEALTH_TIMEOUT_S}s for ${primary} to be healthy"
  for _ in $(seq 1 "$HEALTH_TIMEOUT_S"); do
    status="$("$DOCKER" inspect "$primary" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || echo '')"
    [[ "$status" == "healthy" || "$status" == "none" ]] && break
    sleep 1
  done
  final="$("$DOCKER" inspect "$primary" --format '{{.State.Running}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || echo 'absent')"
  if [[ "$final" != "true healthy" && "$final" != "true none" ]]; then
    # Stop the restart policy from cycling a broken container while it is inspected —
    # never leave a broken container auto-restarting.
    "$DOCKER" update --restart=no "$primary" 2>/dev/null || true
    "$DOCKER" logs --tail 40 "$primary" 2>&1 || true
    die "${primary} is not running+healthy after ${HEALTH_TIMEOUT_S}s (got '${final}') — restart policy set to 'no'"
  fi
  step "verified: ${primary} healthy"
fi
REMOTE
)

printf 'nas-compose deploy: deploying %s on the NAS\n' "$IMAGE_REF"
printf '%s\n%s' "$NAS_SUDO_PASS" "$remote_script" |
  $NAS_SSH "sudo -S bash -s -- '${IMAGE_REF}' '${NAS_ROOT}' '${SERVICES}' '${HEALTH_TIMEOUT_S}' '${BACKUP_CMD}'" ||
  fail 'NAS deployment failed — see the [nas] lines above'

printf 'nas-compose deploy: PASS — %s is live on the NAS\n' "$IMAGE_REF"
