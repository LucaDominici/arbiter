# containerapp.tpl.yaml — generated by arbiter — Azure Container Apps initial-provisioning spec
# SCAFFOLD (OPTIONAL) — one-time `az containerapp create` seed for the first deployment.
#
# This is NOT the CD deploy path. The generated GitHub Actions deploy workflows
# (`.github/workflows/04-deploy-test.yml`, `10-deploy-prod.yml`) promote new images
# with `az containerapp update --image` directly and do NOT touch this file. This
# template exists only for the initial `az containerapp create` of the resource.
#
# To provision the resource once, run:
#   envsubst < infra/azure/containerapp.tpl.yaml | az containerapp create --yaml -
#
# Required env vars at deploy time:
#   REGISTRY_IMAGE      — fully-qualified image reference, e.g. "myacr.azurecr.io/app:v1.2.3"
#   RESOURCE_GROUP      — Azure resource group name
#   CONTAINER_APP_NAME  — name of the Container App resource (no spaces)
#   ENVIRONMENT         — Container Apps environment name (managed environment)
#   LOCATION            — Azure region, e.g. "westeurope"
#   MIN_REPLICAS        — minimum replica count (e.g. 0)
#   MAX_REPLICAS        — maximum replica count (e.g. 10)
#   TARGET_PORT         — container listening port (e.g. 8080)
#
# Ref: docs/SYSTEM/CI-TIER-MODEL.md §2 (infra slot, Azure target)
# Parent issue: #875 (F11)

# Project: <%= projectName %>

containerApp:
  name: ${CONTAINER_APP_NAME}
  location: ${LOCATION}
  resourceGroup: ${RESOURCE_GROUP}

  environment:
    name: ${ENVIRONMENT}

  configuration:
    activeRevisionsMode: Single

    ingress:
      external: true
      targetPort: ${TARGET_PORT}
      transport: http
      allowInsecure: false

    registries: []
    # Populate with your registry credentials if not using managed identity:
    # registries:
    #   - server: myacr.azurecr.io
    #     identity: system

  template:
    containers:
      - name: <%= projectName %>
        image: ${REGISTRY_IMAGE}
        resources:
          cpu: 0.5
          memory: 1Gi
        env: []
        # Add environment variables as needed:
        # env:
        #   - name: NODE_ENV
        #     value: production
        #   - name: MY_SECRET
        #     secretRef: my-secret-ref

    scale:
      minReplicas: ${MIN_REPLICAS}
      maxReplicas: ${MAX_REPLICAS}
      rules: []
      # Add HTTP scaling rule:
      # rules:
      #   - name: http-scaling
      #     http:
      #       metadata:
      #         concurrentRequests: "100"
