import { defineConfig } from 'vitest/config';

export default defineConfig({
  test: {
    coverage: {
      provider: 'v8',
      // json-summary writes coverage/coverage-summary.json, which the gate's
      // greenfield-aware coverage check (scripts/lib/coverage-gate.mjs, #1319.8)
      // parses at runtime to distinguish "no executable statements" from a real
      // threshold miss.
      reporter: ['text', 'html', 'lcov', 'json-summary'],
      reportsDirectory: './coverage',
      include: ['src/**'],
      // Curated exclude list (#353, Phase 7A — haben parity).
      // Every entry is intentionally excluded with a rationale; do NOT add
      // bare paths. A future lint (`check-coverage-excludes-rationale.mjs`)
      // will enforce the comment-per-entry rule.
      exclude: [
        // Generated type definitions — no executable code to cover.
        '**/*.d.ts',
        // Config files (vitest, eslint, tsup, etc.) — bootstrap-only, untestable.
        '**/*.config.*',
        // Barrel exports — re-export only; coverage is double-counted via the
        // re-exported symbols themselves.
        '**/index.ts',
        // Test files exclude themselves by convention; listed for clarity.
        '**/*.test.ts',
        '**/*.spec.ts',
      ],
      thresholds: {
        // thresholdAutoUpdate:false prevents vitest from silently lowering the
        // floor when coverage drops between runs — regressions must be an
        // explicit edit, never auto-applied (#353, INV-30 spirit).
        thresholdAutoUpdate: false,
        lines: <%= locals.thresholds ? locals.thresholds.lineCoverage : coverageThreshold %>,
        functions: <%= coverageThreshold %>,
        branches: <%= locals.thresholds ? locals.thresholds.branchCoverage : coverageThreshold %>,
        statements: <%= coverageThreshold %>,
      },
    },
  },
});
