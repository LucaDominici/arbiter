<%
// #1127: Vitest browser-mode config for component testing with real Chromium.
// Uses Playwright as the browser provider for true DOM rendering (not jsdom).
const _fw = (typeof frontend !== 'undefined' && frontend && frontend.framework)
  ? frontend.framework : 'react'
%>
// vitest.browser.config.ts — generated by arbiter (#1127)
// Vitest Browser Mode — real Chromium via Playwright provider.
// Runs component tests in a real browser environment (not jsdom).
// See docs/GOVERNANCE/FE_DESIGN_PRINCIPLES.md P7 (Visual Verification).
// Run: npx vitest --config vitest.browser.config.ts

import { defineConfig } from 'vitest/config'
<% if (_fw === 'vue') { %>
import vue from '@vitejs/plugin-vue'
<% } else if (_fw === 'svelte') { %>
import { svelte } from '@sveltejs/vite-plugin-svelte'
<% } else { %>
import react from '@vitejs/plugin-react'
<% } %>

export default defineConfig({
  plugins: [
<% if (_fw === 'vue') { %>
    vue(),
<% } else if (_fw === 'svelte') { %>
    svelte(),
<% } else { %>
    react(),
<% } %>
  ],
  test: {
    // Use Playwright for real Chromium — not jsdom
    browser: {
      enabled: true,
      name: 'chromium',
      provider: 'playwright',
      headless: true,
    },
    // Component tests under src/ — exclude unit tests (vitest.config.ts handles those)
    include: ['src/**/*.browser.test.{ts,tsx,vue,svelte}'],
    // VRT: screenshot comparison via toMatchScreenshot
    // Baselines stored in __tests__/screenshots/
    // Capture: npx vitest --config vitest.browser.config.ts --update-snapshots
    setupFiles: ['./vitest.browser.setup.ts'],
  },
})
