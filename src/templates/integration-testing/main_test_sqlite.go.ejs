// Integration test main — generated by arbiter (#1317, INV-34)
// File: tests/main_test.go
//
// Containerless variant: databaseEngine = "sqlite". No Docker container
// dependency — the test database is an in-process SQLite file under the OS temp
// dir, removed on exit. Switch to the container-backed variant by setting a real
// engine (postgresql/mysql) in arbiter.json.

package tests

import (
	"fmt"
	"os"
	"path/filepath"
	"testing"
)

var testDBURL string

func TestMain(m *testing.M) {
	dir, err := os.MkdirTemp("", "arbiter-it-*")
	if err != nil {
		fmt.Fprintf(os.Stderr, "failed to create temp dir: %v\n", err)
		os.Exit(1)
	}

	dbPath := filepath.Join(dir, "test.db")
	testDBURL = fmt.Sprintf("file:%s?cache=shared&mode=rwc", dbPath)
	os.Setenv("DATABASE_URL", testDBURL)

	// os.Exit skips deferred calls, so run cleanup explicitly between m.Run and exit.
	code := m.Run()
	if err := os.RemoveAll(dir); err != nil {
		fmt.Fprintf(os.Stderr, "failed to remove temp dir: %v\n", err)
	}
	os.Exit(code)
}
