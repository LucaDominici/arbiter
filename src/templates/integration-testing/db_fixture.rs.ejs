use std::sync::OnceLock;
use testcontainers::clients::Cli;
use testcontainers::core::WaitFor;
use testcontainers::GenericImage;
use testcontainers::Container;

static DOCKER: OnceLock<Cli> = OnceLock::new();

/// Starts a PostgreSQL 16-alpine container and returns the connection URL.
/// The container is kept alive for the lifetime of the returned `Container`.
pub fn start_postgres() -> (String, Container<'static, GenericImage>) {
    let docker = DOCKER.get_or_init(Cli::default);
    let image = GenericImage::new("postgres", "16-alpine")
        .with_env_var("POSTGRES_USER", "test")
        .with_env_var("POSTGRES_PASSWORD", "test")
        .with_env_var("POSTGRES_DB", "testdb")
        .with_wait_for(WaitFor::message_on_stderr(
            "database system is ready to accept connections",
        ));
    let container = docker.run(image);
    let port = container.get_host_port_ipv4(5432);
    let url = format!("postgres://test:test@127.0.0.1:{}/testdb", port);
    (url, container)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn postgres_container_starts_and_accepts_connections() {
        let (url, _container) = start_postgres();
        assert!(
            url.starts_with("postgres://"),
            "connection URL must be a PostgreSQL connection string"
        );
    }
}
