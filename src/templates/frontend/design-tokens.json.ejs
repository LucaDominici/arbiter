{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens for <%= projectName %> — W3C DTCG format (semantic layer only). Generated by arbiter #1127.",

  "color": {
    "$description": "Semantic color tokens. Components reference these only — never raw palette values (INV-105).",

    "bg": {
      "primary": { "$value": "#ffffff", "$type": "color" },
      "secondary": { "$value": "#f5f5f5", "$type": "color" },
      "elevated": { "$value": "#fafafa", "$type": "color" },
      "overlay": { "$value": "rgba(0, 0, 0, 0.5)", "$type": "color" },
      "inverse": { "$value": "#1a1a1a", "$type": "color" }
    },

    "text": {
      "primary": { "$value": "#1a1a1a", "$type": "color" },
      "secondary": { "$value": "#666666", "$type": "color" },
      "disabled": { "$value": "#999999", "$type": "color" },
      "inverse": { "$value": "#ffffff", "$type": "color" },
      "link": { "$value": "#0066cc", "$type": "color" },
      "error": { "$value": "#cc0000", "$type": "color" },
      "success": { "$value": "#007700", "$type": "color" },
      "warning": { "$value": "#cc7700", "$type": "color" }
    },

    "border": {
      "default": { "$value": "#dddddd", "$type": "color" },
      "strong": { "$value": "#aaaaaa", "$type": "color" },
      "focus": { "$value": "#0066cc", "$type": "color" },
      "error": { "$value": "#cc0000", "$type": "color" }
    },

    "interactive": {
      "primary": { "$value": "#0066cc", "$type": "color" },
      "primary-hover": { "$value": "#0052a3", "$type": "color" },
      "primary-active": { "$value": "#004080", "$type": "color" },
      "primary-text": { "$value": "#ffffff", "$type": "color" },
      "secondary": { "$value": "#f5f5f5", "$type": "color" },
      "secondary-hover": { "$value": "#e8e8e8", "$type": "color" },
      "secondary-text": { "$value": "#1a1a1a", "$type": "color" },
      "danger": { "$value": "#cc0000", "$type": "color" },
      "danger-hover": { "$value": "#a30000", "$type": "color" },
      "danger-text": { "$value": "#ffffff", "$type": "color" }
    },

    "surface": {
      "card": { "$value": "#ffffff", "$type": "color" },
      "card-hover": { "$value": "#f9f9f9", "$type": "color" },
      "tooltip": { "$value": "#1a1a1a", "$type": "color" },
      "tooltip-text": { "$value": "#ffffff", "$type": "color" }
    },

    "status": {
      "error-bg": { "$value": "#fff0f0", "$type": "color" },
      "success-bg": { "$value": "#f0fff0", "$type": "color" },
      "warning-bg": { "$value": "#fffbf0", "$type": "color" },
      "info-bg": { "$value": "#f0f8ff", "$type": "color" }
    }
  },

  "space": {
    "$description": "Spacing scale tokens.",
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" }
  },

  "radius": {
    "$description": "Border radius tokens.",
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "typography": {
    "$description": "Font size and weight tokens.",
    "size": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "14px", "$type": "dimension" },
      "base": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "18px", "$type": "dimension" },
      "xl": { "$value": "20px", "$type": "dimension" },
      "2xl": { "$value": "24px", "$type": "dimension" },
      "3xl": { "$value": "30px", "$type": "dimension" }
    },
    "weight": {
      "normal": { "$value": 400, "$type": "number" },
      "medium": { "$value": 500, "$type": "number" },
      "semibold": { "$value": 600, "$type": "number" },
      "bold": { "$value": 700, "$type": "number" }
    }
  },

  "shadow": {
    "$description": "Elevation shadow tokens.",
    "sm": { "$value": "0 1px 2px rgba(0,0,0,0.1)", "$type": "shadow" },
    "md": { "$value": "0 4px 6px rgba(0,0,0,0.1)", "$type": "shadow" },
    "lg": { "$value": "0 10px 15px rgba(0,0,0,0.1)", "$type": "shadow" },
    "xl": { "$value": "0 20px 25px rgba(0,0,0,0.15)", "$type": "shadow" }
  }
}
