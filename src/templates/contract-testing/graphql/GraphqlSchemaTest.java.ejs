package <%= basePackage || 'com.example' %>.contracts;

import org.junit.jupiter.api.Test;

import java.io.File;
import java.io.IOException;

import static org.junit.jupiter.api.Assertions.assertEquals;

class GraphqlSchemaTest {

    @Test
    void schemaHasNoBreakingChanges() throws IOException, InterruptedException {
        File reference = new File("contracts/schema-reference.graphql");
        File current = new File("contracts/schema-current.graphql");
        if (!reference.exists() || !current.exists()) {
            System.out.println("[WARN] GraphQL schema files not found — skipping diff");
            return;
        }
        ProcessBuilder pb = new ProcessBuilder(
            "npx", "@graphql-inspector/cli", "diff",
            "contracts/schema-reference.graphql",
            "contracts/schema-current.graphql"
        );
        pb.inheritIO();
        int exitCode = pb.start().waitFor();
        assertEquals(0, exitCode, "GraphQL schema has breaking changes — see diff output above");
    }
}
