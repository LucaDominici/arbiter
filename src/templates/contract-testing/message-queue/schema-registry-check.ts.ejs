import { SchemaRegistry } from '@kafkajs/confluent-schema-registry';

/**
 * Contract test: verify schema compatibility with the Schema Registry (INV-41).
 *
 * Calls testCompatibility() — not just a reachability ping.
 * Requires SCHEMA_REGISTRY_URL environment variable.
 * Subject convention: <%= projectName %>-events-value
 */
describe('<%= projectName %> Schema Registry compatibility', () => {
  const registryUrl = process.env['SCHEMA_REGISTRY_URL'];

  beforeAll(() => {
    if (!registryUrl) {
      console.warn('[WARN] SCHEMA_REGISTRY_URL not set — skipping schema registry checks');
    }
  });

  it('schema is BACKWARD or FULL compatible with latest registered version', async () => {
    if (!registryUrl) return;

    const registry = new SchemaRegistry({ host: registryUrl });
    const subject = '<%= projectName %>-events-value';

    // Fetch current compat level for this subject (falls back to global config)
    const configUrl = `${registryUrl}/config/${encodeURIComponent(subject)}`;
    const resp = await fetch(configUrl);
    if (resp.ok) {
      const { compatibilityLevel } = (await resp.json()) as { compatibilityLevel: string };
      const allowed = ['BACKWARD', 'FULL', 'BACKWARD_TRANSITIVE', 'FULL_TRANSITIVE'];
      expect(allowed).toContain(compatibilityLevel);
    }

    // Retrieve the latest registered schema and run testCompatibility
    const latestId = await registry.getRegistryId(subject, 'latest');
    expect(latestId).toBeGreaterThan(0);

    const schema = await registry.getSchema(latestId);
    const isCompatible = await registry.testCompatibility(subject, schema);
    expect(isCompatible).toBe(true);
  });
});
