// Pact provider verification dependencies (M28 contract testing)
dependencies {
    testImplementation 'au.com.dius.pact.provider:junit5:4.6.14'
    testImplementation 'au.com.dius.pact.provider:junit5spring:4.6.14'
}

test {
    systemProperty 'pact.provider.version', project.version
    systemProperty 'pact.verifier.publishResults', System.getProperty('pact.verifier.publishResults', 'false')
    // INV-42: broker URL/token read from env — gate skips when PACT_BROKER_BASE_URL unset
    if (System.getenv('PACT_BROKER_BASE_URL')) {
        systemProperty 'pact.broker.url', System.getenv('PACT_BROKER_BASE_URL')
        systemProperty 'pact.broker.auth.token', System.getenv('PACT_BROKER_TOKEN') ?: ''
    }
}
