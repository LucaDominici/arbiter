import { Pact } from '@pact-foundation/pact';
import { like } from '@pact-foundation/pact/src/dsl/matchers';
import path from 'node:path';

const provider = new Pact({
  consumer: '<%= projectName %>-consumer',
  provider: '<%= projectName %>-provider',
  dir: path.resolve(process.cwd(), 'pacts'),
  log: path.resolve(process.cwd(), 'pacts', 'pact.log'),
});

describe('<%= projectName %> Pact Consumer', () => {
  beforeAll(() => provider.setup());
  afterAll(() => provider.finalize());
  afterEach(() => provider.verify());

  it('gets a resource', async () => {
    await provider.addInteraction({
      state: 'a resource exists',
      uponReceiving: 'a request for a resource',
      withRequest: {
        method: 'GET',
        path: '/api/resource',
        headers: { Accept: 'application/json' },
      },
      willRespondWith: {
        status: 200,
        headers: { 'Content-Type': 'application/json' },
        body: like({ id: 1, name: 'example' }),
      },
    });

    const response = await fetch(`${provider.mockService.baseUrl}/api/resource`, {
      headers: { Accept: 'application/json' },
    });
    expect(response.status).toBe(200);
  });
});
