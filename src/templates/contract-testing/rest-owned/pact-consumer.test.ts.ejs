import { MatchersV3, PactV3 } from '@pact-foundation/pact'
import { describe, expect, it } from 'vitest'
import path from 'node:path'

const provider = new PactV3({
  consumer: '<%= projectName %>-consumer',
  provider: '<%= projectName %>-provider',
  dir: path.resolve(process.cwd(), 'pacts'),
})

describe('<%= projectName %> Pact Consumer', () => {
  it('gets a resource', async () => {
    provider.addInteraction({
      state: 'a resource exists',
      uponReceiving: 'a request for a resource',
      withRequest: {
        method: 'GET',
        path: '/api/resource',
        headers: { Accept: 'application/json' },
      },
      willRespondWith: {
        status: 200,
        headers: { 'Content-Type': 'application/json' },
        body: MatchersV3.like({ id: 1, name: 'example' }),
      },
    })

    await provider.executeTest(async (mockServer) => {
      const response = await fetch(`${mockServer.url}/api/resource`, {
        headers: { Accept: 'application/json' },
      })
      expect(response.status).toBe(200)
      expect(await response.json()).toEqual({ id: 1, name: 'example' })
    })
  })
})
