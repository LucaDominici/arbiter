// OpenAPI exporter — generates contracts/openapi-current.yaml (INV-43)
// Run: ./gradlew generateOpenApiDocs
// #1887-F: the org.springdoc.openapi-gradle-plugin declaration lives in the root
// build's plugins block (arbiter-managed) — Gradle forbids a `plugins {}` block
// inside an applied script (apply from: 'config/export-openapi-java.gradle').

openApi {
    apiDocsUrl = 'http://localhost:8080/v3/api-docs'
    outputDir = file('contracts')
    outputFileName = 'openapi-current.yaml'
    waitTimeInSeconds = 30
    forkProperties = '-Dspring.profiles.active=openapi-export'
}
