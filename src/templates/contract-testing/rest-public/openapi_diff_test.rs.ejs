#[cfg(test)]
mod openapi_diff_tests {
    use std::env;
    use std::path::Path;
    use std::process::Command;

    /// Contract test: verify no breaking OpenAPI changes (INV-43).
    /// Run exporter first: cargo run --bin export-openapi
    /// Bootstrap first run: ALLOW_OPENAPI_BOOTSTRAP=1 cargo test
    #[test]
    fn no_breaking_changes() {
        let current = Path::new("contracts/openapi-current.yaml");
        let reference = Path::new("contracts/openapi-reference.yaml");

        if !current.exists() {
            panic!("contracts/openapi-current.yaml not found — run exporter first (INV-43)");
        }
        if !reference.exists() {
            if env::var("ALLOW_OPENAPI_BOOTSTRAP").as_deref() == Ok("1") {
                println!("[INFO] ALLOW_OPENAPI_BOOTSTRAP=1 — bootstrap mode, skipping diff");
                return;
            }
            panic!("contracts/openapi-reference.yaml not found — copy current spec as reference once (INV-43)");
        }

        let output = Command::new("npx")
            .args(["openapi-diff", "contracts/openapi-reference.yaml",
                   "contracts/openapi-current.yaml", "--fail-on-incompatible"])
            .output()
            .expect("Failed to run openapi-diff");

        assert!(output.status.success(),
            "Breaking OpenAPI changes detected:\n{}",
            String::from_utf8_lossy(&output.stdout));
    }
}
