import { execFileSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import path from 'node:path';

/**
 * Contract test: verify no breaking changes in the OpenAPI spec (INV-43).
 *
 * Run the exporter first: node export-openapi.mjs
 * Reference spec: contracts/openapi-reference.yaml
 * Current spec:   contracts/openapi-current.yaml
 *
 * First-run bootstrap: ALLOW_OPENAPI_BOOTSTRAP=1 skips the diff until
 * openapi-reference.yaml is committed.
 */
describe('<%= projectName %> OpenAPI breaking-change detection', () => {
  const contractsDir = path.resolve(process.cwd(), 'contracts');
  const referenceSpec = path.join(contractsDir, 'openapi-reference.yaml');
  const currentSpec = path.join(contractsDir, 'openapi-current.yaml');

  it('has no breaking changes vs the reference spec', () => {
    if (!existsSync(currentSpec)) {
      throw new Error(
        'contracts/openapi-current.yaml not found — run: node export-openapi.mjs (INV-43)',
      );
    }
    if (!existsSync(referenceSpec)) {
      if (process.env.ALLOW_OPENAPI_BOOTSTRAP === '1') {
        console.warn('[INFO] ALLOW_OPENAPI_BOOTSTRAP=1 — bootstrap mode, skipping diff');
        return;
      }
      throw new Error(
        'contracts/openapi-reference.yaml not found — copy current spec as reference once (INV-43)',
      );
    }
    const result = execFileSync(
      'npx',
      ['openapi-diff', referenceSpec, currentSpec, '--fail-on-incompatible'],
      { encoding: 'utf-8', stdio: ['pipe', 'pipe', 'pipe'] },
    );
    console.log(result);
  });
});
