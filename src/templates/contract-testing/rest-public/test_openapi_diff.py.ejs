import subprocess
import os
import pytest


@pytest.mark.skipif(
    not (os.path.exists("contracts/openapi-reference.yaml") and
         os.path.exists("contracts/openapi-current.yaml")),
    reason="OpenAPI spec files not found — run export first",
)
def test_no_breaking_changes():
    result = subprocess.run(
        ["npx", "openapi-diff",
         "contracts/openapi-reference.yaml",
         "contracts/openapi-current.yaml",
         "--fail-on-incompatible"],
        capture_output=True,
        text=True,
    )
    assert result.returncode == 0, (
        f"Breaking OpenAPI changes detected:\n{result.stdout}\n{result.stderr}"
    )
