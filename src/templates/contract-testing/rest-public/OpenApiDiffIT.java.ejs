package <%= basePackage || 'com.example' %>.contracts;

import org.junit.jupiter.api.Test;
import org.openapitools.openapidiff.core.OpenApiCompare;
import org.openapitools.openapidiff.core.model.ChangedOpenApi;

import java.nio.file.Path;
import java.nio.file.Paths;

import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.junit.jupiter.api.Assertions.fail;

/**
 * Contract test: verify no breaking OpenAPI changes (INV-43).
 *
 * Run the exporter first: ./gradlew generateOpenApiDocs
 * Bootstrap first run:    ALLOW_OPENAPI_BOOTSTRAP=1 ./gradlew test
 */
class OpenApiDiffIT {

    @Test
    void noBreakingChanges() {
        Path contractsDir = Paths.get("contracts");
        Path referenceSpec = contractsDir.resolve("openapi-reference.yaml");
        Path currentSpec = contractsDir.resolve("openapi-current.yaml");

        if (!currentSpec.toFile().exists()) {
            fail("contracts/openapi-current.yaml not found — run: ./gradlew generateOpenApiDocs (INV-43)");
        }
        if (!referenceSpec.toFile().exists()) {
            if ("1".equals(System.getenv("ALLOW_OPENAPI_BOOTSTRAP"))) {
                System.out.println("[INFO] ALLOW_OPENAPI_BOOTSTRAP=1 — bootstrap mode, skipping diff");
                return;
            }
            fail("contracts/openapi-reference.yaml not found — copy current spec as reference once (INV-43)");
        }

        ChangedOpenApi diff = OpenApiCompare.fromLocations(
            referenceSpec.toString(), currentSpec.toString()
        );
        assertTrue(diff.isCompatible(),
            "Breaking OpenAPI changes detected: " + diff.getIncompatibilities());
    }
}
