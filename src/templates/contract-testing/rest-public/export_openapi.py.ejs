#!/usr/bin/env python3
"""Export current OpenAPI spec to contracts/openapi-current.yaml (INV-43).

Run before contract diff: python export_openapi.py
Requires: pip install pyyaml

Adjust the import below to match your app's FastAPI instance.
"""
import os
import yaml

# Import your FastAPI app instance:
# from src.main import app
# spec = app.openapi()

# Placeholder spec — replace with: spec = app.openapi()
spec = {
    "openapi": "3.0.0",
    "info": {"title": "<%= projectName %>", "version": "1.0.0"},
    "paths": {},
}

os.makedirs("contracts", exist_ok=True)
with open("contracts/openapi-current.yaml", "w") as f:
    yaml.dump(spec, f, default_flow_style=False, allow_unicode=True)

print("[export-openapi] Written: contracts/openapi-current.yaml")
