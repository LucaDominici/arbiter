# clippy.toml — generated by arbiter
# Pedantic static analysis rules for Rust projects (strictnessTier = pedantic).
# Run via: cargo clippy -- -D warnings

[lints.clippy]
# Correctness & panic safety (baseline)
unwrap_used = "warn"
expect_used = "warn"
panic = "warn"
indexing_slicing = "warn"

# Pedantic quality (enabled by strictnessTier = pedantic)
pedantic = "warn"
nursery = "warn"
