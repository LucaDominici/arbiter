{
  "name": "@arbiter/cli",
  "version": "0.1.0",
  "description": "AI development governance framework installer",
  "type": "module",
  "bin": {
    "arbiter": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./plugin": {
      "types": "./dist/types/plugin.d.ts",
      "default": "./dist/types/plugin.js"
    }
  },
  "scripts": {
    "build": "tsc && rm -rf dist/templates && cp -r src/templates dist/templates",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:contract": "vitest run --passWithNoTests __tests__/contract",
    "test:integration": "vitest run --passWithNoTests __tests__/integration",
    "test:behavioral": "vitest run --passWithNoTests __tests__/behavioral",
    "test:watch": "vitest",
    "lint": "eslint src __tests__",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ejs": "^5.0.2",
    "inquirer": "^13.4.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jscpd": "^4.1.1",
    "knip": "^6.12.2",
    "madge": "^8.0.0",
    "prettier": "^3.8.3",
    "smol-toml": "^1.6.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
