{
  "name": "@arbiter/cli",
  "version": "0.1.0",
  "description": "AI development governance framework installer",
  "type": "module",
  "bin": {
    "arbiter": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/templates && cp -r src/templates dist/templates",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src __tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ejs": "^3.1.10",
    "inquirer": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^10.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
