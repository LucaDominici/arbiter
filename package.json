{
  "name": "@arbiter/cli",
  "version": "0.1.0",
  "description": "Framework for serious AI-assisted software development",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "arbiter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./plugin": {
      "types": "./dist/types/plugin.d.ts",
      "import": "./dist/types/plugin.js"
    },
    "./invariants": {
      "types": "./dist/invariants/index.d.ts",
      "import": "./dist/invariants/index.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility/index.d.ts",
      "import": "./dist/compatibility/index.js"
    }
  },
  "scripts": {
    "build": "tsc && rm -rf dist/templates && cp -r src/templates dist/templates && mkdir -p dist/i18n && cp src/i18n/*.json dist/i18n/ && mkdir -p dist/compatibility && cp src/compatibility/*.json dist/compatibility/",
    "check:i18n": "node scripts/check-no-raw-strings.mjs src --inventory __tests__/i18n/_migration-inventory.json",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "pack:size": "node scripts/check-pack-size.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:contract": "vitest run __tests__/contract",
    "test:integration": "vitest run __tests__/integrations",
    "test:behavioral": "vitest run __tests__/behavioral",
    "test:fuzz": "vitest run __tests__/property/",
    "test:e2e:bake": "vitest run --config vitest.integration.config.ts __tests__/integration/e2e/bake/",
    "test:e2e:native": "VITEST_NATIVE=1 vitest run --config vitest.integration.config.ts __tests__/integration/e2e/native/",
    "test:bdd": "node --import tsx/esm node_modules/@cucumber/cucumber/bin/cucumber.js --format progress",
    "test:watch": "vitest",
    "lint": "eslint src __tests__",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks",
    "check:arch": "depcruise src",
    "api:snapshot": "node scripts/check-api-snapshot.mjs --regen",
    "compat:snapshot": "node scripts/snapshot-compat-fixture.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/changeset-channel-tag.mjs && node scripts/sync-changelog.mjs",
    "changeset:publish": "changeset publish",
    "check:anti-telemetry": "node scripts/check-anti-telemetry.mjs",
    "docs:dev": "npm run dev -w @arbiter/website",
    "docs:build": "node scripts/sync-public-governance.mjs && npm run build -w @arbiter/website",
    "docs:preview": "npm run preview -w @arbiter/website",
    "check:doc-set": "node scripts/check-doc-set.mjs",
    "gold:report": "node scripts/gold-report.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "commander": "^15.0.0",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@cucumber/cucumber": "^13.0.0",
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.4.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "fast-check": "4.8.0",
    "jscpd": "5.0.6",
    "knip": "^6.16.1",
    "madge": "^8.0.0",
    "prettier": "^3.8.4",
    "smol-toml": "^1.6.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "website",
    "packages/*"
  ]
}
