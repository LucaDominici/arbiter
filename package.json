{
  "name": "@arbiter/cli",
  "version": "0.1.0",
  "description": "AI development governance framework installer",
  "type": "module",
  "bin": {
    "arbiter": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/templates && cp -r src/templates dist/templates",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src __tests__",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ejs": "^5.0.2",
    "inquirer": "^13.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^10.2.0",
    "knip": "^6.3.1",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.3",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
