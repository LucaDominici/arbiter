{
  "name": "@arbiter/cli",
  "version": "0.5.0",
  "description": "Governance installer for AI-assisted software development, with an optional orchestration layer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucaDominici/arbiter.git"
  },
  "homepage": "https://github.com/LucaDominici/arbiter#readme",
  "bugs": {
    "url": "https://github.com/LucaDominici/arbiter/issues"
  },
  "keywords": [
    "ai-governance",
    "cli",
    "quality-gates",
    "invariants",
    "agent-orchestration",
    "developer-tools"
  ],
  "type": "module",
  "packageManager": "npm@10.9.8",
  "bin": {
    "arbiter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/check-doc-set.mjs",
    "scripts/gold-audit.mjs",
    "scripts/check-doc-freshness.mjs",
    "scripts/check-arc42-slots.mjs",
    "scripts/check-doc-style.mjs",
    "scripts/lib",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "PRIVACY.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./plugin": {
      "types": "./dist/types/plugin.d.ts",
      "import": "./dist/types/plugin.js"
    },
    "./invariants": {
      "types": "./dist/invariants/index.d.ts",
      "import": "./dist/invariants/index.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility/index.d.ts",
      "import": "./dist/compatibility/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/build-kit.mjs && tsc && cp -r src/templates dist/templates && mkdir -p dist/i18n && cp src/i18n/*.json dist/i18n/ && mkdir -p dist/compatibility && cp src/compatibility/*.json dist/compatibility/ && mkdir -p dist/generators && cp src/generators/*.json dist/generators/ && mkdir -p dist/kit && cp src/kit/catalog.json src/kit/derived.json src/kit/canonical-mapping.json dist/kit/ && chmod +x dist/cli.js && node scripts/write-dist-manifest.mjs",
    "check:i18n": "node scripts/check-no-raw-strings.mjs src --inventory __tests__/i18n/_migration-inventory.json",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build && node scripts/gen-third-party-licenses.mjs --check && node scripts/publish-package-json.mjs strip",
    "postpack": "node scripts/publish-package-json.mjs restore",
    "licenses:third-party": "node scripts/gen-third-party-licenses.mjs",
    "prepublishOnly": "node scripts/check-pack-size.mjs --strict && node scripts/check-tarball-contents.mjs --strict",
    "pack:size": "node scripts/check-pack-size.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:contract": "vitest run __tests__/contract",
    "test:integration": "vitest run __tests__/integrations",
    "test:behavioral": "vitest run __tests__/behavioral",
    "test:fuzz": "vitest run __tests__/property/",
    "test:e2e:bake": "vitest run --config vitest.integration.config.ts __tests__/integration/e2e/bake/",
    "test:e2e:native": "VITEST_NATIVE=1 vitest run --config vitest.integration.config.ts __tests__/integration/e2e/native/",
    "test:bdd": "node --import tsx/esm node_modules/@cucumber/cucumber/bin/cucumber.js --format progress",
    "test:watch": "vitest",
    "lint": "eslint src __tests__ scripts",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null; node scripts/prepare-lifecycle.mjs",
    "check:arch": "depcruise src",
    "api:snapshot": "node scripts/check-api-snapshot.mjs --regen",
    "compat:snapshot": "node scripts/snapshot-compat-fixture.mjs",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs && node scripts/changeset-channel-tag.mjs && node scripts/sync-changelog.mjs",
    "changeset:publish": "changeset publish",
    "check:anti-telemetry": "node scripts/check-anti-telemetry.mjs",
    "docs:dev": "npm run dev -w @arbiter/website",
    "docs:build": "node scripts/sync-public-governance.mjs && npm run build -w @arbiter/website",
    "docs:build:verify": "npm run build -w @arbiter/website",
    "docs:preview": "npm run preview -w @arbiter/website",
    "check:doc-set": "node scripts/check-doc-set.mjs",
    "gold:audit": "node scripts/gold-audit.mjs",
    "gold:report": "node scripts/gold-report.mjs",
    "examples:regenerate": "node scripts/regenerate-examples.mjs",
    "examples:check": "node scripts/regenerate-examples.mjs --check",
    "consumer:prepare": "node scripts/prepare-consumer-reliability.mjs",
    "consumer:reliability": "node scripts/consumer-reliability-bar.mjs",
    "test:consumer-reliability": "node scripts/run-consumer-reliability.mjs",
    "regen": "node scripts/regen.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "15.0.0",
    "ejs": "6.0.1",
    "prettier": "3.9.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    },
    "vite": "^8.1.3",
    "esbuild": "^0.28.1",
    "qs": "^6.15.2",
    "read-yaml-file": {
      "js-yaml": "^3.15.0"
    },
    "vitepress": {
      "vite": "^8.1.3",
      "esbuild": "^0.28.1",
      "@vitejs/plugin-vue": {
        "vite": "^8.1.3"
      }
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9",
    "@stryker-mutator/vitest-runner": "^9",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "4.9.0",
    "js-yaml": "^5.3.0",
    "jscpd": "5.0.16",
    "knip": "^6.32.2",
    "madge": "^8.0.0",
    "smol-toml": "^1.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "website",
    "packages/*"
  ]
}
