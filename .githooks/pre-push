#!/usr/bin/env bash
# pre-push: checks clean working tree and runs L2 gate before push
set -e

if [ ! -d "node_modules" ]; then
  echo "Skipping pre-push: node_modules not installed. Run npm install."
  exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "Error: working tree is dirty. Commit or stash changes before pushing."
  exit 1
fi

node scripts/check-all.mjs L2
