#!/usr/bin/env bash
# pre-commit: gitleaks secret scan + L1 gate before each commit
set -e

if [ ! -d "node_modules" ]; then
  echo "Skipping pre-commit: node_modules not installed. Run npm install."
  exit 0
fi

# Secret scanning on staged files
if command -v gitleaks &>/dev/null; then
  gitleaks protect --staged --config .gitleaks.toml \
    --gitleaks-ignore-path suppressions/.gitleaksignore --verbose \
    || { echo "gitleaks: secrets detected — commit blocked"; exit 1; }
else
  echo "WARNING: gitleaks not installed — skipping staged secret scan (CI enforces it)"
  echo "         Install: https://github.com/gitleaks/gitleaks#installing"
fi

# Unset git hook env vars so integration tests can create and operate on
# independent temp repositories without GIT_DIR poisoning their git calls.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

# Vite/vitest (v5+) cannot handle '#' in the project root path — it treats '#'
# as a URL fragment and mangles all module IDs. Worktrees named '#NNN' trigger
# this. Rsync to a temporary '#'-free path and run the gate from there.
if [[ "$PWD" == *"#"* ]]; then
  ORIG_DIR="$(pwd)"
  TMP_DIR=$(mktemp -d /tmp/arbiter-hook-XXXXXX)
  trap 'rm -rf "$TMP_DIR"' EXIT
  rsync -a --exclude .git --exclude node_modules --exclude dist . "$TMP_DIR/"
  cp -al "$ORIG_DIR/node_modules" "$TMP_DIR/node_modules"
  cd "$TMP_DIR"
  ARBITER_HOOK_GIT_CWD="$ORIG_DIR" node scripts/check-all.mjs L1
  exit $?
fi

node scripts/check-all.mjs L1
