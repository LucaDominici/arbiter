#!/usr/bin/env bash
# pre-commit: gitleaks secret scan + L1 gate before each commit
set -e

if [ ! -d "node_modules" ]; then
  echo "Skipping pre-commit: node_modules not installed. Run npm install."
  exit 0
fi

# Secret scanning on staged files
if command -v gitleaks &>/dev/null; then
  gitleaks protect --staged --config .gitleaks.toml \
    --gitleaks-ignore-path suppressions/.gitleaksignore --verbose \
    || { echo "gitleaks: secrets detected — commit blocked"; exit 1; }
else
  echo "WARNING: gitleaks not installed — skipping staged secret scan (CI enforces it)"
  echo "         Install: https://github.com/gitleaks/gitleaks#installing"
fi

# Unset git hook env vars so integration tests can create and operate on
# independent temp repositories without GIT_DIR poisoning their git calls.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

# #2051: a genuine RED commit contains a test that FAILS — the L1 gate blocks exactly
# the commit `arbiter task record-red` must point at. Let that one commit shape through:
# phase=red AND every staged path is a test. The secret scan above still ran, and the
# GREEN commit that follows runs the full gate over the whole tree.
_phase=$(node -e "const f=require('fs'),p='.claude/.task/status.json';if(!f.existsSync(p)){process.stdout.write('unknown')}else{try{process.stdout.write(JSON.parse(f.readFileSync(p,'utf-8')).phase||'unknown')}catch{process.stdout.write('corrupt')}}" 2>/dev/null || echo "unknown")
if [ "$_phase" = "red" ]; then
  _staged_red=$(git diff --cached --name-only)
  if [ -n "$_staged_red" ] && ! printf '%s\n' "$_staged_red" |
    grep -qivE '(^|[^[:alpha:]])(tests?|specs?)([^[:alpha:]]|$)'; then
    echo "[pre-commit] phase=red, staged paths are tests only — L1 gate skipped so the failing RED test can land (#2051)."
    exit 0
  fi
fi

# In git worktrees, node_modules is a symlink to the main repo's node_modules.
# This causes `npm ls` to report all packages with `file:` resolved paths, which
# breaks gen-third-party-licenses and its tests (#1695). Skip the L1 gate in
# worktrees — CI enforces the canonical gate on the integration branch.
if [ -f ".git" ]; then
  echo "[pre-commit] git worktree detected — skipping L1 gate (CI enforces it, see #1695)"
  exit 0
fi

# Vite/vitest (v5+) cannot handle '#' in the project root path — it treats '#'
# as a URL fragment and mangles all module IDs. Worktrees named '#NNN' trigger
# this. Rsync to a temporary '#'-free path and run the gate from there.
if [[ "$PWD" == *"#"* ]]; then
  ORIG_DIR="$(pwd)"
  TMP_DIR=$(mktemp -d /tmp/arbiter-hook-XXXXXX)
  trap 'rm -rf "$TMP_DIR"' EXIT
  rsync -a --exclude .git --exclude node_modules --exclude dist . "$TMP_DIR/"
  cp -al "$ORIG_DIR/node_modules" "$TMP_DIR/node_modules"
  # E2E tests need the compiled dist/ binary; hard-link it if present.
  [ -d "$ORIG_DIR/dist" ] && cp -al "$ORIG_DIR/dist" "$TMP_DIR/dist"
  cd "$TMP_DIR"
  ARBITER_HOOK_GIT_CWD="$ORIG_DIR" node scripts/check-all.mjs L1
  exit $?
fi

node scripts/check-all.mjs L1
