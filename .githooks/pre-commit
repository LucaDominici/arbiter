#!/usr/bin/env bash
# pre-commit: staged secret and format checks; qualification runs on the final candidate
set -e

if [ ! -d "node_modules" ]; then
  echo "Skipping pre-commit: node_modules not installed. Run npm install."
  exit 0
fi

# Secret scanning on staged files
if command -v gitleaks &>/dev/null; then
  gitleaks protect --staged --config .gitleaks.toml \
    --gitleaks-ignore-path suppressions/.gitleaksignore --verbose \
    || { echo "gitleaks: secrets detected — commit blocked"; exit 1; }
else
  echo "WARNING: gitleaks not installed — skipping staged secret scan (CI enforces it)"
  echo "         Install: https://github.com/gitleaks/gitleaks#installing"
fi

# Unset git hook env vars so integration tests can create and operate on
# independent temp repositories without GIT_DIR poisoning their git calls.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR

# #2654: Prettier on the exact staged set, for EVERY checkpoint commit shape (RED test-only
# commits and worktree commits included). Full L1 belongs to the frozen candidate, so this
# staged check catches formatting slips early. NUL-delimited so paths with spaces stay whole;
# unknown types are skipped.
if git diff --cached --name-only --diff-filter=ACMR -z | grep -qz . 2>/dev/null; then
  if ! git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 npx prettier --check --ignore-unknown >/dev/null 2>&1; then
    echo "[pre-commit] prettier --check failed on staged files — run: git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 npx prettier --write (#2654)"
    exit 1
  fi
fi

# Commits are recoverable checkpoints, including RED and plan commits.
# Full qualification belongs to the frozen reviewed candidate before push/PR.
echo "[pre-commit] staged checks passed"
