# Copy this file to scripts/runner/.env and fill values.
# This file is intentionally non-sensitive; real values go into .env (gitignored).

# https://github.com/<owner>/<repo>
REPO_URL=https://github.com/LucaDominici/arbiter

# No long-lived credential is stored here. farm.sh mints a short-lived
# (60-min) RUNNER_TOKEN via the GitHub API at `compose up` time
# (pattern: coach-system#434). Prerequisite: `gh auth login` on the host,
# with admin access to this repo (registration-token endpoint requirement).

# Runner labels visible in GitHub UI (matches the docker-ci-build pool
# referenced by the CI_BUILD_RUNNER_LABEL repo variable, ADR-023).
LABELS=self-hosted,linux,x64,docker-ci-build

# Optional behavior.
DISABLE_AUTO_UPDATE=true
DISABLE_AUTOMATIC_DEREGISTRATION=true
