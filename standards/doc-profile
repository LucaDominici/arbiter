# Overlays enabled for THIS repo (arbiter is a CLI/tooling project that exposes a plugin API
# and ships generated API docs). Conditional checks only apply when their overlay is listed.
#
# Available overlays (gate conditional doc families in standards/gold-doc-set.yml):
#   has-plugin-api  — project exposes a public plugin/extension API
#   has-api         — project ships an HTTP/RPC API (docs/api reference)
#   customer-data   — project stores/processes customer or personal data
#                     → data + security families (ER, classification, retention, PII,
#                       threat-model, encryption, vuln-mgmt, risk-register)  [GDPR/ISO 27001]
#   deploys         — project is deployed/operated (not a library)
#                     → operations + legal/supply-chain + delivery + anti-falso-green families
#                       (observability, SLO, DR-BCP, backup, incidents, SBOM, release notes)
#   gxp             — regulated GxP context → GAMP 5 / 21 CFR Part 11 (CSV, audit-trail)
#   has-ai          — ships AI/ML features → model card + AI risk assessment
#   has-mobile      — ships a mobile app → store compliance + Playwright coverage
#   self-charter    — arbiter-specific: the 5 foundational docs that define this very capability
#                     (the standard, the methodology, and the 3 gold-doc design docs). NOT a
#                     general-purpose overlay — inert for any repo that copies this manifest shape
#                     (gold-doc-tranches-t3-t5.md §3.2).
overlays:
  - has-plugin-api
  - has-api
  - self-charter
# allow: extra doc paths intentionally present that the audit should NOT flag (derogations).
allow: []
# tier_floor (T1b): arbiter is an npm-published framework exposing a plugin API, consumed by many
# — Self = Enterprise always, regardless of arbiter.json's own collaborationMode (trunk-solo, a
# solo-maintainer fact about THIS repo's own dev process, not about who consumes it). Without this
# floor, self silently grades itself on the SOLO column (live-verified regression, gold-doc-self-
# tier-and-coherence.md §1.1) — 8 always-rows go dormant and self passes a materially weaker bar
# than the standard it enforces on others. A floor only RAISES the column, never lowers it.
tier_floor: enterprise
