{
  "threshold": 5,
  "minTokens": 50,
  "reporters": ["json", "consoleFull"],
  "absolute": true,
  "path": ["src", "scripts", ".claude/hooks"],
  "format": ["typescript", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "dist/**",
    "coverage/**",
    "__tests__/fixtures/**",
    "src/templates/**",
    ".claude/hooks/logs/**"
  ]
}
