{
  "version": "0.2",
  "tools": ["claude", "codex"],
  "governanceLevel": "L2",
  "decomposition": {
    "backend": "github"
  },
  "features": {
    "debtGates": true,
    "suppressions": true,
    "securityScanning": true,
    "mutationTesting": true,
    "contractTesting": false,
    "evidenceHarness": false,
    "soloDevMode": true
  },
  "thresholds": {
    "lineCoverage": 80,
    "branchCoverage": 70,
    "mutationScore": 80,
    "cyclomaticComplexity": 15,
    "methodLength": 65,
    "maxParams": 7
  },
  "invariantTiers": ["architectural", "governance", "data", "operational"],
  "archetype": "library",
  "architectureStyle": "none",
  "isMultiTenant": false,
  "hasDatabase": false,
  "hasPublicApi": false,
  "contractType": "none",
  "lanes": ["docs"],
  "collaborationMode": "trunk-solo",
  "solo": {
    "mergeMode": "pr-ff"
  },
  "permitGitHub": true,
  "$schemaVersion": 4,
  "kit": {
    "measure": {}
  },
  "automation": {
    "autonomy": "L3"
  }
}
