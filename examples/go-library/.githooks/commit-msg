#!/usr/bin/env bash
# commit-msg: validates the commit message against Conventional Commits.
# Two layers:
#   1. Universal regex (works on every stack, no Node required) — #355
#   2. Richer commitlint validation when Node + commitlint are available
#
# Bypass: messages starting with "Merge " or "Revert " (auto-generated by
# git for merge commits and `git revert`) skip both layers.
set -e

# Read first line using bash builtin (avoids dependency on `head`).
IFS= read -r MSG < "$1" || true

# Bypass for merge/revert commits (auto-generated by git)
if [[ "$MSG" =~ ^(Merge|Revert)\  ]]; then
  exit 0
fi

# Layer 1: Conventional Commits regex enforcement.
# Types match @commitlint/config-conventional (11) plus 'cluster' for
# arbiter's batch-merge convention. Scope is permissive ([^)]+) so things
# like (#123), (W3A), (deps-dev), (#262-#270) all pass; Layer 2 enforces
# stricter scope rules where commitlint is installed.
if [[ ! "$MSG" =~ ^(build|chore|ci|cluster|docs|feat|fix|perf|refactor|revert|style|test)(\([^\)]+\))?!?:[[:space:]].+ ]]; then
  echo "commit-msg rejected: subject must look like 'type(scope): description'"
  echo "  types: build|chore|ci|cluster|docs|feat|fix|perf|refactor|revert|style|test"
  echo "  scope: optional, parenthesized free text"
  echo "  Got: $MSG"
  exit 1
fi

# Layer 2: richer commitlint validation is optional on every stack. Only run it
# when this repository supplies both a configuration and a local executable.
COMMITLINT_CONFIG_FOUND=false
for COMMITLINT_CONFIG in \
  commitlint.config.js commitlint.config.cjs commitlint.config.mjs commitlint.config.ts \
  .commitlintrc .commitlintrc.json .commitlintrc.yml .commitlintrc.yaml \
  .commitlintrc.js .commitlintrc.cjs .commitlintrc.mjs .commitlintrc.ts; do
  if [ -f "$COMMITLINT_CONFIG" ]; then
    COMMITLINT_CONFIG_FOUND=true
    break
  fi
done

if [ "$COMMITLINT_CONFIG_FOUND" = false ] && [ -f package.json ] && \
  grep -Eq '"commitlint"[[:space:]]*:' package.json; then
  COMMITLINT_CONFIG_FOUND=true
fi

if [ "$COMMITLINT_CONFIG_FOUND" = false ]; then
  echo "commit-msg layer 2 skipped: commitlint config missing"
  exit 0
fi

if [ ! -x node_modules/.bin/commitlint ]; then
  echo "commit-msg layer 2 skipped: commitlint not installed"
  exit 0
fi

node_modules/.bin/commitlint --edit "$1"
