# .env.example — arbiter local CI environment variables for go-library
# Generated by arbiter (INV-87). Copy to .env and edit as needed.
# .env is gitignored; .env.example is committed.

# ARBITER_GOVERNANCE_LEVEL — governance level override (L1, L2, L3, L4).
# Default: the governanceLevel declared in arbiter.json.
# ARBITER_GOVERNANCE_LEVEL=L2

# NODE_ENV — Node.js environment string.
# Not set by default (enables development behavior).
# NODE_ENV=production
