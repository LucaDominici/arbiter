#!/usr/bin/env bash
# pre-commit: cheap staged checks; final qualification runs before push/PR.
set -e

if command -v gitleaks >/dev/null 2>&1; then
  _scan=(protect --staged)
  [ ! -f .gitleaks.toml ] || _scan+=(--config .gitleaks.toml)
  [ ! -f suppressions/.gitleaksignore ] || _scan+=(--gitleaks-ignore-path suppressions/.gitleaksignore)
  gitleaks "${_scan[@]}" || { echo "gitleaks: staged secret scan failed — commit blocked"; exit 1; }
else
  echo "WARNING: gitleaks unavailable — staged scan unavailable; full gate still required"
fi

unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR


# Use the installed formatter; do not fetch tools during a checkpoint commit.
if [ -x node_modules/.bin/prettier ]; then
  if git diff --cached --name-only --diff-filter=ACMR -z | grep -qz . 2>/dev/null; then
    git diff --cached --name-only --diff-filter=ACMR -z |
      xargs -0 node_modules/.bin/prettier --check --ignore-unknown || exit 1
  fi
else
  echo "WARNING: local prettier unavailable — format proof remains due before qualification"
fi


# gold-align (#1506 yamllint / #1507 shellcheck): mirror the CI config-lint lane
# locally so YAML/shell style defects fail before CI, not after a round-trip. Each
# linter is best-effort-on-absence (skip with a note when the tool isn't installed,
# matching the node/node_modules guards above) but BLOCKING when present.
_staged=$(git diff --cached --name-only --diff-filter=ACM)
if command -v shellcheck >/dev/null 2>&1; then
  _sh=$(echo "$_staged" | grep -E '\.sh$' || true)
  if [ -n "$_sh" ]; then
    echo "$_sh" | xargs shellcheck --severity=warning || exit 1
  fi
fi
if command -v yamllint >/dev/null 2>&1; then
  _yml=$(echo "$_staged" | grep -E '\.ya?ml$' | grep -v '^\.github/workflows/' || true)
  if [ -n "$_yml" ]; then
    if [ -f .yamllint.yml ] || [ -f .yamllint.yaml ] || [ -f .yamllint ]; then
      echo "$_yml" | xargs yamllint || exit 1
    else
      echo "$_yml" | xargs yamllint -d relaxed || exit 1
    fi
  fi
fi

# Plan and RED commits need no evidence from future phases. The lifecycle controls
# admission and delivery; saving a commit does not qualify it for push or merge.
echo "[pre-commit] staged checks passed"
