{
  "name": "ts-library-fixture",
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "test:unit": "vitest run src",
    "test:contract": "vitest run --passWithNoTests __tests__/contract",
    "test:integration": "vitest run --passWithNoTests __tests__/integrations",
    "test:behavioral": "vitest run --passWithNoTests __tests__/behavioral",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "prepare": "git config core.hooksPath .githooks"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.62.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7",
    "@types/node": "^22.0.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.10.0"
  }
}
